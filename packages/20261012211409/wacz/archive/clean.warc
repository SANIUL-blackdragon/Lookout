SRC-W0105","SRC-W0075","SRC-W0077","SRC-W0072","SRC-W0075","SRC-W0069","SRC-W0063","SRC-W0065"]}],"summary":"The F-16I Sufa is the Lockheed Martin fighter Israel bought 102 of from 2004, at about $70M each in 2006 prices, with avionics by Elbit Systems and conformal fuel tanks by IAI. It is a bomb truck: UN Special Rapporteur Francesca Albanese reported in 2025 that F-35s and F-16s were integral to equipping Israel to drop an estimated 85,000 tons of bombs on Gaza. Bellingcat documented an Israeli F-16 armed with a RAMPAGE air-launched missile in imagery from 28 February 2026, the first day of the US-Israeli war on Iran. As with the F-35, individual strikes on homes, schools and shelters are rarely attributed to a specific jet, so no single event in this catalogue is assigned to the F-16; its role is as the platform delivering the JDAM, Mk-80 and GBU-39 bombs documented at those sites.","transfers":[],"status":"documented"},{"id":"ARS-AH64","name":"AH-64 Apache (Peten / Saraf)","aka":["AH-64A Peten","AH-64D Saraf"],"class":"helicopter","form":"helicopter","dims":{"length_m":14.7,"diameter_m":null,"span_m":14.6,"weight_kg":10433},"specs":[{"k":"Length / rotor diameter","v":"14.7 m / 14.6 m","src":["SRC-W0142"]},{"k":"Max operating weight","v":"10,433 kg","src":["SRC-W0142"]},{"k":"Armament","v":"up to 16 Hellfire, 76 2.75-in rockets, 1,200 30mm rounds","src":["SRC-W0142"]},{"k":"Israeli fleet","v":"about 48 AH-64A/D at Ramon Air Base (2023 account)","src":["SRC-W0143"]},{"k":"Customers","v":"Israel among 19 operators","src":["SRC-W0142"]}],"makers":[{"entity":"COM-00003","role":"prime","src":["SRC-W0142"]},{"entity":"General Electric (T700 engines)","role":"engine","src":["SRC-W0144"]}],"parts":[{"name":"Nose sensors and cockpit","maker":"COM-00003","start":0,"end":0.3,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0071","SRC-W0071","SRC-W0071","SRC-W0070","SRC-W0091","SRC-W0076","SRC-W0068","SRC-W0072","SRC-W0069","SRC-W0078","SRC-W0070","SRC-W0082","SRC-W0076","SRC-W0096","SRC-W0067","SRC-W0074","SRC-W0068","SRC-W0093","SRC-W0068","SRC-W0069","SRC-W0065","SRC-W0068","SRC-W0067","SRC-W0075","SRC-W0062","SRC-W0092","SRC-W0108","SRC-W0097","SRC-W0092","SRC-W0075","SRC-W0064","SRC-W0075","SRC-W0082","SRC-W0062","SRC-W0068"]},{"name":"30mm chain gun","maker":"unattributed","start":0.15,"end":0.25,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0071","SRC-W0071","SRC-W0071","SRC-W0070","SRC-W0091","SRC-W0076","SRC-W0068","SRC-W0072","SRC-W0069","SRC-W0078","SRC-W0070","SRC-W0082","SRC-W0076","SRC-W0096","SRC-W0067","SRC-W0074","SRC-W0068","SRC-W0093","SRC-W0068","SRC-W0069","SRC-W0065","SRC-W0068","SRC-W0067","SRC-W0075","SRC-W0062","SRC-W0092","SRC-W0108","SRC-W0097","SRC-W0092","SRC-W0075","SRC-W0064","SRC-W0075","SRC-W0082","SRC-W0062","SRC-W0068"]},{"name":"Stub wings with Hellfire / rockets","maker":"COM-00002 (Hellfire)","start":0.35,"end":0.5,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0071","SRC-W0071","SRC-W0071","SRC-W0070","SRC-W0091","SRC-W0076","SRC-W0068","SRC-W0072","SRC-W0069","SRC-W0078","SRC-W0070","SRC-W0082","SRC-W0076","SRC-W0096","SRC-W0067","SRC-W0074","SRC-W0068","SRC-W0093","SRC-W0068","SRC-W0069","SRC-W0065","SRC-W0068","SRC-W0067","SRC-W0075","SRC-W0062","SRC-W0092","SRC-W0108","SRC-W0097","SRC-W0092","SRC-W0075","SRC-W0064","SRC-W0075","SRC-W0082","SRC-W0062","SRC-W0068"]},{"name":"T700 engines","maker":"General Electric","start":0.4,"end":0.55,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0068","SRC-W0069","SRC-W0070","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0064","SRC-W0068","SRC-W0074","SRC-W0072","SRC-W0075","SRC-W0070","SRC-W0076","SRC-W0077","SRC-W0078","SRC-W0067","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0067","SRC-W0115","SRC-W0076","SRC-W0068","SRC-W0072","SRC-W0069","SRC-W0078","SRC-W0080","SRC-W0083","SRC-W0127","SRC-W0092","SRC-W0108","SRC-W0097","SRC-W0080","SRC-W0083","SRC-W0064","SRC-W0075","SRC-W0082","SRC-W0062","SRC-W0068"]},{"name":"Tail boom","maker":"COM-00003","start":0.55,"end":1,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0071","SRC-W0071","SRC-W0071","SRC-W0070","SRC-W0091","SRC-W0076","SRC-W0068","SRC-W0072","SRC-W0069","SRC-W0078","SRC-W0070","SRC-W0082","SRC-W0076","SRC-W0096","SRC-W0067","SRC-W0074","SRC-W0068","SRC-W0093","SRC-W0068","SRC-W0069","SRC-W0065","SRC-W0068","SRC-W0067","SRC-W0075","SRC-W0062","SRC-W0092","SRC-W0108","SRC-W0097","SRC-W0092","SRC-W0075","SRC-W0064","SRC-W0075","SRC-W0082","SRC-W0062","SRC-W0068"]}],"summary":"The AH-64 Apache is Boeing's attack helicopter; Israel flies about 48 AH-64A Peten and AH-64D Saraf from Ramon Air Base, according to its commanders. Each can carry 16 Hellfire missiles, Lockheed Martin's AGM-114 that the US notified Israel of 3,000 more of in February 2025, plus rockets and a 30mm cannon. Apache crews told The War Zone they flew 48 sorties on 7 October 2023, and Israel's Apaches have flown over Gaza since. Bellingcat's 2026 investigation found Hellfires in Gaza strikes on a clinic, on tents near Al-Aqsa Martyrs Hospital and at Cairo Basic School, but did not attribute those launches to helicopters rather than drones. This page therefore links the Apache to the Hellfire supply chain and records its use as reported, without assigning specific deaths to it.","transfers":[],"status":"reported"},{"id":"ARS-H450","name":"Elbit Hermes 450","aka":["Zik"],"class":"drone","form":"drone","dims":{"length_m":6.1,"diameter_m":null,"span_m":10.5,"weight_kg":550},"specs":[{"k":"Length / span","v":"6.1 m / 10.5 m","src":["SRC-V0109"]},{"k":"Gross weight / payload","v":"550 kg / 180 kg","src":["SRC-V0109"]},{"k":"Endurance","v":"17 hours (450LE: 30 hours)","src":["SRC-V0109"]},{"k":"Armament","v":"up to 4 Spike missiles (reported)","src":["SRC-V0109"]},{"k":"Role in Israel","v":"'the military's aerial workhorse' for surveillance and strikes (AOAV)","src":["SRC-V0268"]},{"k":"Elbit share","v":"Elbit provides 85% of the air force's combat drones (AOAV)","src":["SRC-V0268"]}],"makers":[{"entity":"COM-00007","role":"prime","src":["SRC-V0109"]}],"parts":[{"name":"Sensor turret","maker":"COM-00007","start":0,"end":0.2,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0068","SRC-W0069","SRC-W0070","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0064","SRC-W0068","SRC-W0074","SRC-W0072","SRC-W0075","SRC-W0070","SRC-W0076","SRC-W0077","SRC-W0078","SRC-W0067","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0067","SRC-W0145","SRC-W0090","SRC-W0091","SRC-W0072","SRC-W0063","SRC-W0080","SRC-W0127","SRC-W0068","SRC-W0077","SRC-W0096","SRC-W0068","SRC-W0065","SRC-W0080","SRC-W0097","SRC-W0088","SRC-W0087"]},{"name":"Fuselage and payload bay","maker":"COM-00007","start":0.2,"end":0.75,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0068","SRC-W0069","SRC-W0070","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0064","SRC-W0068","SRC-W0074","SRC-W0072","SRC-W0075","SRC-W0070","SRC-W0076","SRC-W0077","SRC-W0078","SRC-W0067","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0067","SRC-W0145","SRC-W0090","SRC-W0091","SRC-W0072","SRC-W0063","SRC-W0080","SRC-W0127","SRC-W0068","SRC-W0077","SRC-W0096","SRC-W0068","SRC-W0065","SRC-W0080","SRC-W0097","SRC-W0088","SRC-W0087"]},{"name":"Wankel engine and pusher propeller","maker":"unattributed (R902(W))","start":0.75,"end":1,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0068","SRC-W0069","SRC-W0070","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0064","SRC-W0068","SRC-W0074","SRC-W0072","SRC-W0075","SRC-W0070","SRC-W0076","SRC-W0077","SRC-W0078","SRC-W0067","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0067","SRC-W0145","SRC-W0090","SRC-W0091","SRC-W0072","SRC-W0063","SRC-W0080","SRC-W0127","SRC-W0068","SRC-W0077","SRC-W0096","SRC-W0068","SRC-W0065","SRC-W0080","SRC-W0097","SRC-W0088","SRC-W0087"]}],"summary":"The Hermes 450 is Elbit Systems' armed surveillance drone, called 'Zik' in the Israeli military and described by AOAV as its aerial workhorse; Elbit supplies about 85% of the air force's combat drones. It can stay up 17 hours and carry Spike missiles. Haaretz reported that a Hermes 450 carried out the 1 April 2024 strikes on the World Central Kitchen convoy in Deir al-Balah, which hit three cars in turn and killed seven aid workers. The IDF admitted the strike, called it a misidentification and dismissed two officers. Bellingcat found the damage consistent with a precision, low-yield munition but could not identify the missile without fragments, so the munition stays unresolved here and the drone link is marked as reported. Hermes 450s have also been shot down over Lebanon, confirming their use there.","transfers":[],"status":"reported"},{"id":"ARS-H900","name":"Elbit Hermes 900","aka":["Kochav"],"class":"drone","form":"drone","dims":{"length_m":8.3,"diameter_m":null,"span_m":15,"weight_kg":1180},"specs":[{"k":"Length / span","v":"8.3 m / 15 m","src":["SRC-W0146"]},{"k":"Max takeoff weight / payload","v":"1,180 kg / 350 kg","src":["SRC-W0146"]},{"k":"Endurance","v":"36 hours","src":["SRC-W0146"]},{"k":"Losses","v":"shot down over Lebanon (Apr, Jun, Oct 2024) and Iran (18 and 23 June 2025)","src":["SRC-W0146"]}],"makers":[{"entity":"COM-00007","role":"prime","src":["SRC-W0146"]}],"parts":[{"name":"Sensor turret","maker":"COM-00007","start":0,"end":0.2,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0068","SRC-W0069","SRC-W0070","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0064","SRC-W0068","SRC-W0074","SRC-W0072","SRC-W0075","SRC-W0070","SRC-W0076","SRC-W0077","SRC-W0078","SRC-W0067","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0067","SRC-W0145","SRC-W0090","SRC-W0091","SRC-W0072","SRC-W0063","SRC-W0080","SRC-W0127","SRC-W0068","SRC-W0077","SRC-W0096","SRC-W0068","SRC-W0065","SRC-W0080","SRC-W0102","SRC-W0087","SRC-W0087"]},{"name":"Fuselage and payload bay","maker":"COM-00007","start":0.2,"end":0.8,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0068","SRC-W0069","SRC-W0070","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0064","SRC-W0068","SRC-W0074","SRC-W0072","SRC-W0075","SRC-W0070","SRC-W0076","SRC-W0077","SRC-W0078","SRC-W0067","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0067","SRC-W0145","SRC-W0090","SRC-W0091","SRC-W0072","SRC-W0063","SRC-W0080","SRC-W0127","SRC-W0068","SRC-W0077","SRC-W0096","SRC-W0068","SRC-W0065","SRC-W0080","SRC-W0102","SRC-W0087","SRC-W0087"]},{"name":"Engine / propeller","maker":"unattributed","start":0.8,"end":1,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0068","SRC-W0069","SRC-W0070","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0064","SRC-W0068","SRC-W0074","SRC-W0072","SRC-W0075","SRC-W0070","SRC-W0076","SRC-W0077","SRC-W0078","SRC-W0067","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0067","SRC-W0145","SRC-W0090","SRC-W0091","SRC-W0072","SRC-W0063","SRC-W0080","SRC-W0127","SRC-W0068","SRC-W0077","SRC-W0096","SRC-W0068","SRC-W0065","SRC-W0080","SRC-W0102","SRC-W0087","SRC-W0087"]}],"summary":"The Hermes 900 is Elbit Systems' larger long-endurance drone, able to fly 36 hours with a 350 kg payload, and Elbit's main export drone. Its presence over all three fronts is documented by its losses: Hezbollah shot down Hermes 900s over Lebanon on 6 April, 1 June and 29 October 2024, and Iran downed one over Isfahan on 18 June 2025 and two more on 23 June 2025 during Israel's Twelve-Day War on Iran. Public evidence ties it to surveillance and targeting over Gaza and Lebanon, but no investigation reviewed here attributes a specific civilian-harm strike to a Hermes 900, so it is marked as reported and has no events attached. It belongs in the arsenal as part of the drone surveillance layer that feeds the strike chain, and because Elbit markets it as combat-proven.","transfers":[],"status":"reported"},{"id":"WPN-00015","name":"PULS / Lahav rocket launcher","aka":["Lahav","Precise & Universal Launching System"],"class":"launcher","form":"launcher","dims":{"length_m":null,"diameter_m":null,"span_m":null,"weight_kg":null},"specs":[{"k":"Munitions","v":"36 x 122mm, 26 x 160mm AccuLAR, 8 x 306mm EXTRA, 2 Delilah or 4 x 370mm Predator Hawk","src":["SRC-W0147"]},{"k":"Max range","v":"300 km","src":["SRC-W0147"]},{"k":"Israeli service","v":"in service since 2020 as Lahav on HEMTT trucks; first used operationally Feb 2024","src":["SRC-W0147"]},{"k":"Bar (EXTRA) rocket accuracy","v":"about 5 m","src":["SRC-V0091"]},{"k":"2026 Lebanon use","v":"more than 50 Bar (EXTRA) rockets at the start of the 2026 operation (Elbit / N12)","src":["SRC-V0091"]},{"k":"Exports","v":"Greece 36 launchers, $750M (Apr 2026); Netherlands, Denmark, Germany","src":["SRC-W0147"]}],"makers":[{"entity":"COM-00007","role":"prime","src":["SRC-W0147"]}],"parts":[{"name":"Truck chassis (HEMTT in Israel)","maker":"unattributed","start":0,"end":0.45,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0068","SRC-W0069","SRC-W0070","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0064","SRC-W0068","SRC-W0074","SRC-W0072","SRC-W0075","SRC-W0070","SRC-W0076","SRC-W0077","SRC-W0078","SRC-W0067","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0067","SRC-W0106","SRC-W0117","SRC-W0116","SRC-W0107","SRC-W0080","SRC-W0128","SRC-W0096","SRC-W0085","SRC-W0090","SRC-W0063","SRC-W0072","SRC-W0064","SRC-W0090","SRC-W0068","SRC-W0080","SRC-W0077","SRC-W0076","SRC-W0082","SRC-W0073","SRC-W0068","SRC-W0063","SRC-W0080","SRC-W0090","SRC-W0075","SRC-W0085","SRC-W0069","SRC-W0082","SRC-W0062","SRC-W0068","SRC-W0077","SRC-W0129"]},{"name":"Launch module and pods","maker":"COM-00007","start":0.45,"end":1,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0068","SRC-W0069","SRC-W0070","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0064","SRC-W0068","SRC-W0074","SRC-W0072","SRC-W0075","SRC-W0070","SRC-W0076","SRC-W0077","SRC-W0078","SRC-W0067","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0067","SRC-W0106","SRC-W0117","SRC-W0116","SRC-W0107","SRC-W0080","SRC-W0128","SRC-W0096","SRC-W0085","SRC-W0090","SRC-W0063","SRC-W0072","SRC-W0064","SRC-W0090","SRC-W0068","SRC-W0080","SRC-W0077","SRC-W0076","SRC-W0082","SRC-W0073","SRC-W0068","SRC-W0063","SRC-W0080","SRC-W0090","SRC-W0075","SRC-W0085","SRC-W0069","SRC-W0082","SRC-W0062","SRC-W0068","SRC-W0077","SRC-W0129"]}],"summary":"PULS, called Lahav in Israel, is Elbit Systems' truck-mounted launcher for rockets and missiles of 122mm to 370mm, with ranges up to 300 km. Israel brought it into service in 2020 and first fired it operationally in February 2024; Arms industry Europe reported that month it was being used 'extensively' in Gaza and Lebanon. An Elbit-published N12 article says Lahav batteries fired more than 50 of the new Bar (EXTRA) rockets at Hezbollah targets, 'anti-tank squads' and buildings at the start of the 2026 operation in Lebanon. The Guardian, reviewed by six arms experts, reported Elbit's 227mm Ra'am Eitan cluster rocket remnants south of the Litani in late 2025. The owner reports OSMP/ARES tie one to a Lahav launcher, but we could not verify that link. Use in the genocide doubles as a sales pitch: Greece signed for 36 launchers ($750M) in April 2026.","transfers":[],"status":"documented"},{"id":"ARS-ROEM","name":"Ro'em 155mm self-propelled howitzer","aka":["Roem"],"class":"howitzer","form":"launcher","dims":{"length_m":null,"diameter_m":0.155,"span_m":null,"weight_kg":null},"specs":[{"k":"Calibre","v":"155mm","src":["SRC-V0077"]},{"k":"Rate of fire","v":"6-8 rounds per minute","src":["SRC-V0077"]},{"k":"Range","v":"up to 40 km","src":["SRC-V0077"]},{"k":"Crew","v":"3 (vs 8 on the M109 it replaces)","src":["SRC-V0077"]},{"k":"Chassis","v":"wheeled 10x10","src":["SRC-V0077"]},{"k":"First combat use","v":"Lebanon, April 2026","src":["SRC-V0077"]}],"makers":[{"entity":"COM-00007","role":"prime (developed from 2019)","src":["SRC-V0077"]}],"parts":[{"name":"10x10 truck chassis","maker":"unattributed","start":0,"end":0.6,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0091","SRC-W0077","SRC-W0068","SRC-W0075","SRC-W0073","SRC-W0072","SRC-W0069","SRC-W0078","SRC-W0074","SRC-W0068","SRC-W0093","SRC-W0068","SRC-W0069","SRC-W0065","SRC-W0068","SRC-W0070","SRC-W0082","SRC-W0076","SRC-W0096","SRC-W0067","SRC-W0086","SRC-W0087","SRC-W0086","SRC-W0108","SRC-W0067","SRC-W0087","SRC-W0097","SRC-W0067","SRC-W0072","SRC-W0065","SRC-W0077","SRC-W0075","SRC-W0068","SRC-W0090","SRC-W0065","SRC-W0092","SRC-W0069","SRC-W0068","SRC-W0071","SRC-W0092","SRC-W0075","SRC-W0085","SRC-W0063","SRC-W0076","SRC-W0096","SRC-W0075","SRC-W0063","SRC-W0072","SRC-W0082","SRC-W0092","SRC-W0077","SRC-W0076","SRC-W0068","SRC-W0096","SRC-W0092","SRC-W0062","SRC-W0076","SRC-W0071","SRC-W0072","SRC-W0063","SRC-W0103","SRC-W0068","SRC-W0077","SRC-W0092","SRC-W0085","SRC-W0065","SRC-W0068","SRC-W0074","SRC-W0092","SRC-W0093","SRC-W0076","SRC-W0077","SRC-W0092","SRC-W0093","SRC-W0072","SRC-W0077","SRC-W0065","SRC-W0063","SRC-W0092","SRC-W0063","SRC-W0072","SRC-W0096","SRC-W0068","SRC-W0092","SRC-W0072","SRC-W0069","SRC-W0092","SRC-W0082","SRC-W0076","SRC-W0096","SRC-W0091","SRC-W0075","SRC-W0063","SRC-W0067"]},{"name":"Automated 155mm turret and gun","maker":"COM-00007","start":0.4,"end":1,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0091","SRC-W0077","SRC-W0068","SRC-W0075","SRC-W0073","SRC-W0072","SRC-W0069","SRC-W0078","SRC-W0074","SRC-W0068","SRC-W0093","SRC-W0068","SRC-W0069","SRC-W0065","SRC-W0068","SRC-W0070","SRC-W0082","SRC-W0076","SRC-W0096","SRC-W0067","SRC-W0086","SRC-W0087","SRC-W0086","SRC-W0108","SRC-W0067","SRC-W0087","SRC-W0097","SRC-W0067","SRC-W0072","SRC-W0065","SRC-W0077","SRC-W0075","SRC-W0068","SRC-W0090","SRC-W0065","SRC-W0092","SRC-W0069","SRC-W0068","SRC-W0071","SRC-W0092","SRC-W0075","SRC-W0085","SRC-W0063","SRC-W0076","SRC-W0096","SRC-W0075","SRC-W0063","SRC-W0072","SRC-W0082","SRC-W0092","SRC-W0077","SRC-W0076","SRC-W0068","SRC-W0096","SRC-W0092","SRC-W0062","SRC-W0076","SRC-W0071","SRC-W0072","SRC-W0063","SRC-W0103","SRC-W0068","SRC-W0077","SRC-W0092","SRC-W0085","SRC-W0065","SRC-W0068","SRC-W0074","SRC-W0092","SRC-W0093","SRC-W0076","SRC-W0077","SRC-W0092","SRC-W0093","SRC-W0072","SRC-W0077","SRC-W0065","SRC-W0063","SRC-W0092","SRC-W0063","SRC-W0072","SRC-W0096","SRC-W0068","SRC-W0092","SRC-W0072","SRC-W0069","SRC-W0092","SRC-W0082","SRC-W0076","SRC-W0096","SRC-W0091","SRC-W0075","SRC-W0063","SRC-W0067"]}],"summary":"The Ro'em is Elbit Systems' automated 155mm wheeled howitzer, developed from 2019 to replace the Israeli army's M109s. It fires six to eight rounds a minute out to 40 km with a crew of three instead of eight. Breaking Defense reported in April 2026 that the Israeli army carried out its first operational firing during operations in Lebanon, during the 2026 offensive in which HRW also verified renewed white phosphorus airbursts over South Lebanese villages. No investigation reviewed here attributes a specific civilian-harm strike to the Ro'em, so it has no events attached. It is included because its combat debut came in the destruction of South Lebanon, and because a weapon described as 'used for the first time in combat' becomes a marketing asset for Elbit. It replaces the ATMOS card, for which no battlefield evidence was found.","transfers":[],"status":"documented"},{"id":"ARS-RAAMEITAN","name":"Ra'am Eitan 227mm cluster rocket","aka":["Raam Eitan"],"class":"rocket","form":"rocket","dims":{"length_m":null,"diameter_m":0.227,"span_m":null,"weight_kg":null},"specs":[{"k":"Calibre","v":"227mm guided rocket","src":["SRC-W0148"]},{"k":"Submunitions","v":"reportedly 64 bomblets","src":["SRC-W0148"]},{"k":"Developed","v":"2017","src":["SRC-W0149"]},{"k":"Failure rate","v":"up to 10% in field conditions, per experts cited","src":["SRC-W0149"]},{"k":"Found","v":"Wadi Zibqin, Wadi Barghouz, Wadi Deir Siryan, south of the Litani","src":["SRC-W0149"]}],"makers":[{"entity":"COM-00007","role":"prime (reported)","src":["SRC-W0148"]}],"parts":[{"name":"Guidance section","maker":"COM-00007","start":0,"end":0.15,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0071","SRC-W0071","SRC-W0071","SRC-W0070","SRC-W0098","SRC-W0093","SRC-W0068","SRC-W0068","SRC-W0074","SRC-W0070","SRC-W0082","SRC-W0076","SRC-W0096","SRC-W0067","SRC-W0069","SRC-W0068","SRC-W0071","SRC-W0065","SRC-W0092","SRC-W0072","SRC-W0065","SRC-W0077","SRC-W0075","SRC-W0068","SRC-W0090","SRC-W0067","SRC-W0072","SRC-W0065","SRC-W0077","SRC-W0075","SRC-W0068","SRC-W0090","SRC-W0092","SRC-W0082","SRC-W0090","SRC-W0085","SRC-W0065","SRC-W0063","SRC-W0068","SRC-W0077","SRC-W0092","SRC-W0096","SRC-W0085","SRC-W0069","SRC-W0072","SRC-W0063","SRC-W0072","SRC-W0076","SRC-W0069","SRC-W0065","SRC-W0092","SRC-W0090","SRC-W0068","SRC-W0091","SRC-W0075","SRC-W0069","SRC-W0076","SRC-W0069"]},{"name":"Cargo section (64 bomblets)","maker":"COM-00007","start":0.15,"end":0.55,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0071","SRC-W0071","SRC-W0071","SRC-W0070","SRC-W0098","SRC-W0093","SRC-W0068","SRC-W0068","SRC-W0074","SRC-W0070","SRC-W0082","SRC-W0076","SRC-W0096","SRC-W0067","SRC-W0069","SRC-W0068","SRC-W0071","SRC-W0065","SRC-W0092","SRC-W0072","SRC-W0065","SRC-W0077","SRC-W0075","SRC-W0068","SRC-W0090","SRC-W0067","SRC-W0072","SRC-W0065","SRC-W0077","SRC-W0075","SRC-W0068","SRC-W0090","SRC-W0092","SRC-W0082","SRC-W0090","SRC-W0085","SRC-W0065","SRC-W0063","SRC-W0068","SRC-W0077","SRC-W0092","SRC-W0096","SRC-W0085","SRC-W0069","SRC-W0072","SRC-W0063","SRC-W0072","SRC-W0076","SRC-W0069","SRC-W0065","SRC-W0092","SRC-W0090","SRC-W0068","SRC-W0091","SRC-W0075","SRC-W0069","SRC-W0076","SRC-W0069"]},{"name":"Rocket motor","maker":"unattributed","start":0.55,"end":1,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0071","SRC-W0071","SRC-W0071","SRC-W0070","SRC-W0098","SRC-W0093","SRC-W0068","SRC-W0068","SRC-W0074","SRC-W0070","SRC-W0082","SRC-W0076","SRC-W0096","SRC-W0067","SRC-W0069","SRC-W0068","SRC-W0071","SRC-W0065","SRC-W0092","SRC-W0072","SRC-W0065","SRC-W0077","SRC-W0075","SRC-W0068","SRC-W0090","SRC-W0067","SRC-W0072","SRC-W0065","SRC-W0077","SRC-W0075","SRC-W0068","SRC-W0090","SRC-W0092","SRC-W0082","SRC-W0090","SRC-W0085","SRC-W0065","SRC-W0063","SRC-W0068","SRC-W0077","SRC-W0092","SRC-W0096","SRC-W0085","SRC-W0069","SRC-W0072","SRC-W0063","SRC-W0072","SRC-W0076","SRC-W0069","SRC-W0065","SRC-W0092","SRC-W0090","SRC-W0068","SRC-W0091","SRC-W0075","SRC-W0069","SRC-W0076","SRC-W0069"]}],"summary":"The Ra'am Eitan is a 227mm guided rocket developed in 2017 that scatters dozens of bomblets, reportedly 64, and is attributed to Elbit Systems. The Guardian reported in November 2025, with six independent arms experts confirming the identification, that remnants were found in forested valleys south of the Litani (Wadi Zibqin, Wadi Barghouz and Wadi Deir Siryan), alongside Elbit's M999 Barak Eitan cluster shells. Lebanon's National Human Rights Commission called it the first known Israeli use of such weapons in nearly twenty years and warned that up to 10% of bomblets can fail to explode, leaving them to kill and maim returning residents. Lebanon has joined the Convention on Cluster Munitions; Israel and the US have not. The owner reports that OSMP/ARES identified one recovered in Lebanon as fired from Elbit's Lahav/PULS launcher; we could not fetch that entry.","transfers":[],"status":"reported"},{"id":"ARS-M999","name":"M999 Barak Eitan 155mm cluster shell","aka":["Barak Eitan"],"class":"artillery shell","form":"shell","dims":{"length_m":null,"diameter_m":0.155,"span_m":null,"weight_kg":null},"specs":[{"k":"Calibre","v":"155mm","src":["SRC-W0148"]},{"k":"Submunitions","v":"9, each fragmenting into tungsten shards (1,200 per submunition reported)","src":["SRC-W0148"]},{"k":"Produced","v":"2019","src":["SRC-W0149"]},{"k":"Found","v":"south of the Litani, South Lebanon (Guardian, Nov 2025)","src":["SRC-W0149"]}],"makers":[{"entity":"COM-00007","role":"prime (reported)","src":["SRC-W0148"]}],"parts":[{"name":"Fuze","maker":"unattributed","start":0,"end":0.12,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0071","SRC-W0071","SRC-W0071","SRC-W0070","SRC-W0098","SRC-W0093","SRC-W0068","SRC-W0068","SRC-W0074","SRC-W0070","SRC-W0082","SRC-W0076","SRC-W0096","SRC-W0067","SRC-W0069","SRC-W0068","SRC-W0071","SRC-W0065","SRC-W0092","SRC-W0072","SRC-W0065","SRC-W0077","SRC-W0075","SRC-W0068","SRC-W0090","SRC-W0067","SRC-W0072","SRC-W0065","SRC-W0077","SRC-W0075","SRC-W0068","SRC-W0090","SRC-W0092","SRC-W0082","SRC-W0090","SRC-W0085","SRC-W0065","SRC-W0063","SRC-W0068","SRC-W0077","SRC-W0092","SRC-W0096","SRC-W0085","SRC-W0069","SRC-W0072","SRC-W0063","SRC-W0072","SRC-W0076","SRC-W0069","SRC-W0065","SRC-W0092","SRC-W0090","SRC-W0068","SRC-W0091","SRC-W0075","SRC-W0069","SRC-W0076","SRC-W0069"]},{"name":"Carrier body with 9 submunitions","maker":"COM-00007","start":0.12,"end":0.9,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0071","SRC-W0071","SRC-W0071","SRC-W0070","SRC-W0098","SRC-W0093","SRC-W0068","SRC-W0068","SRC-W0074","SRC-W0070","SRC-W0082","SRC-W0076","SRC-W0096","SRC-W0067","SRC-W0069","SRC-W0068","SRC-W0071","SRC-W0065","SRC-W0092","SRC-W0072","SRC-W0065","SRC-W0077","SRC-W0075","SRC-W0068","SRC-W0090","SRC-W0067","SRC-W0072","SRC-W0065","SRC-W0077","SRC-W0075","SRC-W0068","SRC-W0090","SRC-W0092","SRC-W0082","SRC-W0090","SRC-W0085","SRC-W0065","SRC-W0063","SRC-W0068","SRC-W0077","SRC-W0092","SRC-W0096","SRC-W0085","SRC-W0069","SRC-W0072","SRC-W0063","SRC-W0072","SRC-W0076","SRC-W0069","SRC-W0065","SRC-W0092","SRC-W0090","SRC-W0068","SRC-W0091","SRC-W0075","SRC-W0069","SRC-W0076","SRC-W0069"]},{"name":"Base","maker":"unattributed","start":0.9,"end":1,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0071","SRC-W0071","SRC-W0071","SRC-W0070","SRC-W0098","SRC-W0093","SRC-W0068","SRC-W0068","SRC-W0074","SRC-W0070","SRC-W0082","SRC-W0076","SRC-W0096","SRC-W0067","SRC-W0069","SRC-W0068","SRC-W0071","SRC-W0065","SRC-W0092","SRC-W0072","SRC-W0065","SRC-W0077","SRC-W0075","SRC-W0068","SRC-W0090","SRC-W0067","SRC-W0072","SRC-W0065","SRC-W0077","SRC-W0075","SRC-W0068","SRC-W0090","SRC-W0092","SRC-W0082","SRC-W0090","SRC-W0085","SRC-W0065","SRC-W0063","SRC-W0068","SRC-W0077","SRC-W0092","SRC-W0096","SRC-W0085","SRC-W0069","SRC-W0072","SRC-W0063","SRC-W0072","SRC-W0076","SRC-W0069","SRC-W0065","SRC-W0092","SRC-W0090","SRC-W0068","SRC-W0091","SRC-W0075","SRC-W0069","SRC-W0076","SRC-W0069"]}],"summary":"The M999 Barak Eitan is an Elbit Systems 155mm artillery shell, produced from 2019, that releases nine submunitions which break into tungsten fragments. The Guardian reported in November 2025 that its remnants were found with Ra'am Eitan cluster rockets in valleys south of the Litani in South Lebanon; six independent arms experts confirmed the identifications from photographs. Lebanon's National Human Rights Commission said this was the first known Israeli cluster-munition use in nearly twenty years and warned of failure rates that can reach 10%, which leaves unexploded bomblets in farmland and woods long after the shelling. The dates of firing and any casualties are not established in the sources reviewed, so the card records the remnants as a destruction-and-contamination event rather than a casualty event. Elbit, by AOAV's account, supplies about 80% of the Israeli army's land weapons and equipment.","transfers":[],"status":"reported"},{"id":"WPN-NEW-TOMAHAWK","name":"Tomahawk Land Attack Missile","aka":["TLAM","RGM/UGM-109","Block IV / Block V"],"class":"missile","form":"missile","dims":{"length_m":6.25,"diameter_m":null,"span_m":null,"weight_kg":null},"specs":[{"k":"Length","v":"5.56 m without booster; 6.25 m with booster","src":["SRC-W0151"]},{"k":"Warhead","v":"1,000-lb class unitary warhead (Block IV)","src":["SRC-W0152"]},{"k":"Range","v":"900 nmi (1,600 km), Block IV/V","src":["SRC-W0152"]},{"k":"Guidance","v":"INS, TERCOM, DSMAC and GPS","src":["SRC-W0152"]},{"k":"Accuracy","v":"CEP about 10 m","src":["SRC-W0151"]},{"k":"Unit cost","v":"$1.87M (FY2017 Block IV); $2.5M (FY2026 Block V)","src":["SRC-W0151"]},{"k":"Operational use","v":"used more than 2,350 times (Raytheon)","src":["SRC-V0006"]}],"makers":[{"entity":"COM-00001","role":"prime (Raytheon, Tucson AZ)","src":["SRC-W0152"]},{"entity":"Ball Aerospace (now owned by BAE Systems, COM-00006)","role":"satellite data link (SDL) antenna, found at Minab","src":["SRC-W0153"]},{"entity":"Globe Motors (Dayton, Ohio)","role":"DC motor found at Minab","src":["SRC-W0153"]},{"entity":"Raytheon UK (Glenrothes)","role":"guidance and electronic components","src":["SRC-W0153"]}],"parts":[{"name":"Guidance / navigation section","mak