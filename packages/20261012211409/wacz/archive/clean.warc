,"SRC-W0096"]},{"name":"Base plate (ejected)","maker":"unattributed","start":0.85,"end":1,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0071","SRC-W0071","SRC-W0071","SRC-W0070","SRC-W0078","SRC-W0090","SRC-W0076","SRC-W0091","SRC-W0075","SRC-W0090","SRC-W0065","SRC-W0068","SRC-W0082","SRC-W0085","SRC-W0077","SRC-W0072","SRC-W0063","SRC-W0094","SRC-W0070","SRC-W0076","SRC-W0077","SRC-W0078","SRC-W0067","SRC-W0096","SRC-W0072","SRC-W0090","SRC-W0072","SRC-W0063","SRC-W0075","SRC-W0077","SRC-W0094","SRC-W0067","SRC-W0065","SRC-W0094","SRC-W0065","SRC-W0063","SRC-W0068","SRC-W0096","SRC-W0065","SRC-W0067","SRC-W0096","SRC-W0085","SRC-W0069","SRC-W0072","SRC-W0063","SRC-W0072","SRC-W0076","SRC-W0069","SRC-W0065","SRC-W0067","SRC-W0096","SRC-W0100","SRC-W0086","SRC-W0088","SRC-W0070","SRC-W0062","SRC-W0063","SRC-W0096"]}],"summary":"The M825 series is a US 155mm artillery shell that airbursts and scatters 116 felt wedges soaked in white phosphorus, which burns at 815 C. Amnesty found M825A1 shells from US depots in Arkansas and Louisiana at Dhayra, South Lebanon, after the 16 October 2023 attack that injured at least nine civilians; the Washington Post reached the same conclusion on US manufacture. HRW had verified white phosphorus use in at least 17 South Lebanon municipalities by June 2024, with unlawful airbursts over homes in five, and Lebanon's Health Ministry counted 173 people injured by 28 May 2024. Use continued: HRW verified two airbursts over a neighbourhood in Yohmor on 3 March 2026, with a smoke pattern 'entirely consistent' with M825-series shells, and HRW and Harvard's clinic verified 23 incidents in March-May 2026.","transfers":[],"status":"documented"},{"id":"WPN-NEW-F35","name":"F-35I Adir (F-35 Lightning II)","aka":["F-35I","Adir"],"class":"aircraft","form":"aircraft","dims":{"length_m":15.7,"diameter_m":null,"span_m":10.7,"weight_kg":null},"specs":[{"k":"Length / span","v":"15.7 m / 10.7 m (F-35A)","src":["SRC-W0135"]},{"k":"Weapons payload","v":"8,160 kg (18,000 lb)","src":["SRC-W0135"]},{"k":"Range","v":"over 2,200 km","src":["SRC-W0135"]},{"k":"Engine","v":"Pratt & Whitney F135-PW-100","src":["SRC-W0135"]},{"k":"Israeli fleet","v":"25 more ordered July 2023 for about $3B, taking the fleet to 75","src":["SRC-W0136"]},{"k":"Supply chain","v":"Lockheed Martin prime with at least 1,650 other companies (UN Special Rapporteur)","src":["SRC-V0004"]}],"makers":[{"entity":"COM-00002","role":"prime","src":["SRC-V0004"]},{"entity":"COM-00005","role":"centre fuselage (delivered for first Israeli F-35)","src":["SRC-V0105"]},{"entity":"COM-00006","role":"rear fuselage; 13-15% workshare","src":["SRC-V0107"]},{"entity":"COM-00001","role":"engine (Pratt & Whitney F135)","src":["SRC-V0095"]}],"parts":[{"name":"Forward fuselage / cockpit","maker":"COM-00002","start":0,"end":0.35,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0071","SRC-W0071","SRC-W0071","SRC-W0070","SRC-W0076","SRC-W0062","SRC-W0082","SRC-W0062","SRC-W0077","SRC-W0070","SRC-W0076","SRC-W0077","SRC-W0078","SRC-W0067","SRC-W0065","SRC-W0072","SRC-W0063","SRC-W0068","SRC-W0065","SRC-W0067","SRC-W0074","SRC-W0068","SRC-W0093","SRC-W0075","SRC-W0085","SRC-W0090","SRC-W0063","SRC-W0067","SRC-W0093","SRC-W0072","SRC-W0090","SRC-W0068","SRC-W0065","SRC-W0067","SRC-W0074","SRC-W0076","SRC-W0082","SRC-W0085","SRC-W0096","SRC-W0068","SRC-W0069","SRC-W0063","SRC-W0065","SRC-W0067","SRC-W0062","SRC-W0077","SRC-W0091","SRC-W0076","SRC-W0074","SRC-W0072","SRC-W0068","SRC-W0065","SRC-W0067","SRC-W0062","SRC-W0077","SRC-W0082","SRC-W0076","SRC-W0085","SRC-W0069","SRC-W0082","SRC-W0072","SRC-W0090","SRC-W0067","SRC-W0065","SRC-W0068","SRC-W0065","SRC-W0065","SRC-W0072","SRC-W0076","SRC-W0069","SRC-W0065","SRC-W0092","SRC-W0077","SRC-W0068","SRC-W0078","SRC-W0085","SRC-W0090","SRC-W0075","SRC-W0077","SRC-W0067","SRC-W0065","SRC-W0068","