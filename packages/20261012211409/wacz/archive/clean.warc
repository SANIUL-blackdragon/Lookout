Public domain","url":"https://commons.wikimedia.org/wiki/File:Tom_Malinowski,_official_portrait,_116th_congress_(cropped).jpg"},"PER-00065":{"data":"img/a7cf97cd3b78759b.jpg","credit":"Photo: U.S. Congress / Wikimedia Commons, Public domain","url":"https://commons.wikimedia.org/wiki/File:Donna_Edwards.jpg"},"PER-00066":{"data":"img/26f4f1ed09d8b688.jpg","credit":"Photo: Franmarie Metzler; U.S. House Office of Photography / Wikimedia Commons, Public domain","url":"https://commons.wikimedia.org/wiki/File:Andy_Levin,_official_portrait,_116th_Congress_(cropped).jpg"},"PER-00067":{"data":"img/41e3367e0292766a.jpg","credit":"Photo: U.S. House of Representatives / Wikimedia Commons, Public domain","url":"https://commons.wikimedia.org/wiki/File:Rep._Summer_Lee_-_118th_Congress_(cropped).jpg"},"PER-00068":{"data":"img/03916fbf49e5bf07.jpg","credit":"Photo: U.S. House of Representatives / Wikimedia Commons, Public domain","url":"https://commons.wikimedia.org/wiki/File:Rep._Shri_Thanedar_-_118th_Congress_(cropped).jpg"},"PER-00069":{"data":"img/ff6e8f4f087e7f40.jpg","credit":"Photo: California State Senate / Wikimedia Commons, Public domain","url":"https://commons.wikimedia.org/wiki/File:Dave_Min_official_portrait_(cropped).jpg"},"PER-N-BELL":{"data":"img/5e5630edfdb7253b.jpg","credit":"Photo: Ike Hayman, House Creative Services / Wikimedia Commons, Public domain","url":"https://commons.wikimedia.org/wiki/File:Bell_Wesley_119th_Congress_(cropped).jpg"},"PER-N-BOWMAN":{"data":"img/046fe4932c7fcebd.jpg","credit":"Photo: House Creative Committee / Wikimedia Commons, Public domain","url":"https://commons.wikimedia.org/wiki/File:Jamaal_Bowman_117th_U.S_Congress_(cropped).jpg"},"PER-N-BUSH":{"data":"img/f38422dbd05465d7.jpg","credit":"Photo: House Creative Committee / Wikimedia Commons, Public domain","url":"https://commons.wikimedia.org/wiki/File:Cori_Bush_117th_U.S_Congress_(cropped).jpg"},"PER-N-LATIMER":{"data":"img/7e08057cc2c90d62.jpg","credit":"Photo: Nate Payne, House Creati