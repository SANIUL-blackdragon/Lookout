  </header>

  <aside id="rail" aria-label="Filter network"></aside>
  <div id="zoomlbl" class="tiny"></div>
  <div id="names" role="group" aria-label="Names on map"><span class="tiny">NAMES</span><button data-l="off" aria-pressed="true">OFF</button><button data-l="key" aria-pressed="false">KEY</button><button data-l="all" aria-pressed="false">ALL</button></div>
  <div id="photo" hidden></div>
  <div id="paperwrap" hidden><button id="paper" aria-label="Open the full case file"></button></div>
  <aside id="dossier" aria-live="polite"></aside>

  <div id="ctrls" aria-label="Map controls">
    <button id="zin" title="Zoom in" aria-label="Zoom in">+</button>
