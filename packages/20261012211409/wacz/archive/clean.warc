SRC-W0064","SRC-W0068","SRC-W0074","SRC-W0072","SRC-W0075","SRC-W0070","SRC-W0076","SRC-W0077","SRC-W0078","SRC-W0067","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0067","SRC-W0084","SRC-W0106","SRC-W0124","SRC-W0088","SRC-W0087","SRC-W0087"]},{"name":"Guidance kit (JDAM)","maker":"COM-00003","start":0.7,"end":1,"note":"Antenna component by AeroAntenna (CAGE 0UVG2) at Rafah, 19 Apr 2024.","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0071","SRC-W0071","SRC-W0071","SRC-W0070","SRC-W0075","SRC-W0096","SRC-W0069","SRC-W0068","SRC-W0065","SRC-W0063","SRC-W0094","SRC-W0085","SRC-W0065","SRC-W0075","SRC-W0070","SRC-W0076","SRC-W0077","SRC-W0078","SRC-W0067","SRC-W0064","SRC-W0077","SRC-W0068","SRC-W0065","SRC-W0065","SRC-W0092","SRC-W0077","SRC-W0068","SRC-W0090","SRC-W0068","SRC-W0075","SRC-W0065","SRC-W0068","SRC-W0065","SRC-W0067","SRC-W0072","SRC-W0065","SRC-W0077","SRC-W0075","SRC-W0068","SRC-W0090","SRC-W0072","SRC-W0092","SRC-W0075","SRC-W0072","SRC-W0077","SRC-W0092","SRC-W0065","SRC-W0063","SRC-W0077","SRC-W0072","SRC-W0073","SRC-W0068","SRC-W0065","SRC-W0092","SRC-W0063","SRC-W0062","SRC-W0075","SRC-W0063","SRC-W0092","SRC-W0073","SRC-W0072","SRC-W0090","SRC-W0090","SRC-W0068","SRC-W0074","SRC-W0092","SRC-W0097","SRC-W0097","SRC-W0092","SRC-W0082","SRC-W0072","SRC-W0105","SRC-W0072","SRC-W0090","SRC-W0072","SRC-W0075","SRC-W0069","SRC-W0065","SRC-W0092","SRC-W0093","SRC-W0085","SRC-W0077","SRC-W0063","SRC-W0062","SRC-W0068","SRC-W0077","SRC-W0092","SRC-W0068","SRC-W0105","SRC-W0072","SRC-W0074","SRC-W0068","SRC-W0069","SRC-W0082","SRC-W0068","SRC-W0092","SRC-W0076","SRC-W0093","SRC-W0092","SRC-W0071","SRC-W0075","SRC-W0077","SRC-W0092","SRC-W0082","SRC-W0077","SRC-W0072","SRC-W0096","SRC-W0068","SRC-W0065","SRC-W0092","SRC-W0069","SRC-W0068","SRC-W0071","SRC-W0092","SRC-W0072","SRC-W0069","SRC-W0105","SRC-W0068","SRC-W0065","SRC-W0063","SRC-W0072","SRC-W0078","SRC-W0075","SRC-W0063","SRC-W0072","SRC-W0076","SRC-W0069","SRC-W0067"]}],"summary":"The MPR-500 is a 500-lb bomb made by Elbit Systems, which absorbed its original maker IMI Systems, and it shows how Israeli bomb bodies and US guidance combine. HRW found an Elbit-marked MPR-500 fitted with a Boeing JDAM kit at Habbarieh, South Lebanon, where a strike killed seven emergency and relief volunteers on 27 March 2024. In Rafah on 19 April 2024 Amnesty identified an MPR-500 whose guidance package carried CAGE code 0UVG2 of California's AeroAntenna; nine members of the Abu Radwan family, six of them children, were killed. The owner's outline linked the MPR-500 to the 16 April 2024 al-Maghazi strike, but Amnesty attributes that strike to small drone-launched precision munitions, not an MPR-500. Elbit supplies, by AOAV's account, about 80% of the Israeli army's land weapons and equipment.","transfers":[],"status":"documented"},{"id":"WPN-00007","name":"AGM-114 Hellfire","aka":["Hellfire","R9X variant"],"class":"missile","form":"missile","dims":{"length_m":1.6,"diameter_m":0.18,"span_m":0.33,"weight_kg":49},"specs":[{"k":"Weight","v":"45-49 kg (100-108 lb)","src":["SRC-V0259"]},{"k":"Warheads","v":"shaped charge, tandem anti-armour, metal-augmented charge or blast fragmentation (about 18-20 lb)","src":["SRC-V0259"]},{"k":"Guidance","v":"semi-active laser or millimetre-wave radar","src":["SRC-V0259"]},{"k":"Range","v":"0.5-11 km","src":["SRC-V0259"]},{"k":"Unit cost","v":"about $150,000 (FY2021)","src":["SRC-V0259"]},{"k":"Israeli launchers","v":"AH-64 Apache helicopters and drones","src":["SRC-V0259"]},{"k":"Feb 2025 sale","v":"3,000 missiles, $660M, deliveries from 2028","src":["SRC-0029"]}],"makers":[{"entity":"COM-00002","role":"prime (Troy, Alabama)","src":["SRC-0029"]},{"entity":"COM-00005","role":"seeker (AGM-114L Longbow only)","src":["SRC-V0259"]}],"parts":[{"name":"Seeker","maker":"COM-00002 (COM-00005 for AGM-114L)","start":0,"end":0.15,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0