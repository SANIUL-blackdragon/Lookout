-24.53,115.89,259.29,121.64,-249.62,-385.71,-250.86,-367.66,-7.29,-289.47,17.73,-211.44,-117.26,-381.96,-74.03,-385.85,-101.12,-382.33,231.29,-512.05,243.92,-496.81,-265.74,-457.75,-249.92,-468.53,274.77,-356.79,305.27,-383.83,298.25,-366.69,-264.79,30.5,-277.99,-5.09,31.7,-562.11,18.13,-558.81,9.47,-566,219.51,-84.66,187.26,-206.98,201.98,-88.99,-21.8,150.51,233.16,388.92,-497.14,-18.71,271.31,272.69,-302.37,288.25,-599.43,104.45,196.79,-59.57,-148.02,599.41,-116.41,462.75,225.32,-251.52,-154.35,341.41,68.18,-609.24,60.71,491.35,-343.23,243.14,-366.65,240.47,-169.44,316.4,-174.32,310.65,-170.46,333.24,-474.77,125.79,-479.57,122.57,-492.98,127.88]}}</script>
<script src="tips-config.js"></script>
<script src="d3.min.js"></script>
<script>
(()=>{
const D=JSON.parse(document.getElementById('data').textContent);
D.series=D.series||[];D.reports=D.reports||{};D.images=D.images||{};
const RM=matchMedia('(prefers-reduced-motion: reduce)').matches;
const root=document.documentElement;
const css=n=>getComputedStyle(root).getPropertyValue(n).trim();
const C={bg:css('--bg'),fg:css('--fg'),fg2:css('--fg2'),fg3:css('--fg3'),line:css('--line'),signal:css('--signal'),sel:css('--sel')};
const HEADLINE=D.headline||'The Genocide Economy, Mapped.';
const PHQ=matchMedia('(max-width:760px)'),PHM=()=>PHQ.matches;
const SUBHEAD=D.subhead||'Who is profiting from Israel’s genocidal campaign on the Middle East?';
const FX={USD:1,EUR:1.16,GBP:1.34,ILS:.3},FXNOTE='$1.16 per € and $1.34 per £';
const TYPES=[
 ['Company','COMPANIES','company'],['Person','PEOPLE','person'],['Fund/Asset Manager','ASSET MANAGERS','fund'],
 ['Country','COUNTRIES','country'],['Government','GOVERNMENTS','gov'],['Weapon/System','WEAPON SYSTEMS','weapon'],['Contract/Deal','CONTRACTS & DEALS','contract'],
 ['Organization','PACS / ORGANIZATIONS','org'],['Aggregate','BUDGET FLOWS','agg'],['Family','FAMILIES','person']];
const TKEY={},TLAB={};TYPES.forEach(([t,l,k])=>{TKEY[t]=k;TLAB[t]=l});
const FAMS=['own','contract','money','politics','role','tech'];
/* palettes: node map colours the viewer can switch */
const PAL={
 acid:{label:'ACID',company:'#e8ff00',person:'#a7d8e0',fund:'#ff5c2b',country:'#b48cff',gov:'#4f9dff',weapon:'#e5322d',contract:'#e2e2da',org:'#6fd38a',agg:'#8b8b86',
   own:'#ff5c2b',contract_f:'#e5322d',money:'#ffc93c',politics:'#6fd38a',oppose:'#ff3b8d',role:'#a7d8e0',tech:'#4f9dff'},
 bone:{label:'BONE',company:'#f1f1ed',person:'#9fd3dc',fund:'#a596cf',country:'#e3b37f',gov:'#d29a62',weapon:'#d2493f',contract:'#c9cd6f',org:'#8fae8b',agg:'#7a7a78',
   own:'#a596cf',contract_f:'#d2493f',money:'#c9cd6f',politics:'#8fae8b',oppose:'#d2493f',role:'#9fd3dc',tech:'#d29a62'},
 thermal:{label:'HEAT',company:'#ffd400',person:'#ffc2b0',fund:'#ff7a00',country:'#ff9e6d',gov:'#ff4d1a',weapon:'#ff0040',contract:'#fff1dc',org:'#ff8fab',agg:'#8a7a74',
   own:'#ff7a00',contract_f:'#ff0040',money:'#ffd400',politics:'#ff8fab',oppose:'#ff0040',role:'#ffc2b0',tech:'#ff4d1a'},
 mono:{label:'MONO',company:'#ffffff',person:'#bdbdb8',fund:'#e8ff00',country:'#d6d6d0',gov:'#9a9a95',weapon:'#ffffff',contract:'#8a8a86',org:'#c8c8c2',agg:'#5c5c5a',
   own:'#e8ff00',contract_f:'#bdbdb8',money:'#ffffff',politics:'#9a9a95',oppose:'#e8ff00',role:'#6f6f6b',tech:'#8a8a86'}};
let palKey='acid';try{const s=localStorage.getItem('bm_pal');if(s&&PAL[s])palKey=s}catch(_){}
const TCOL={},FCOL={};
function applyPalette(){const P=PAL[palKey];TYPES.forEach(([t,,k])=>{TCOL[t]=P[k]});
  FAMS.forEach(f=>FCOL[f]=P[f==='contract'?'contract_f':f]);FCOL.oppose=P.oppose;
  ['company','person','fund','country','gov','weapon','contract','org','agg'].forEach(k=>root.style.setProperty('--c-'+k,P[k]))}
applyPalette();
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const CUR={USD:'$',GBP:'£',EUR:'€',ILS:'₪'};
function money(a,c){if(a==null||isNaN(a))return null;a=+a;if(c==='units')return a.toLocaleString('en-US')+' units';
  const s=CUR[c]??'',u=s?'':(c?' '+c:''),neg=a<0?'-':'',x=Math.abs(a);const f=(v,d)=>(+v.toFixed(d)).toLocaleString('en-US');
  if(x>=1e12)return neg+s+f(x/1e12,2)+'T'+u;if(x>=1e9)return neg+s+f(x/1e9,2)+'B'+u;if(x>=1e6)return neg+s+f(x/1e6,1)+'M'+u;if(x>=1e3)return neg+s+f(x/1e3,1)+'K'+u;return neg+s+f(x,0)+u}
const relName=r=>(r||'').replace(/_/g,' ').toUpperCase();
const SRC=Object.fromEntries(D.sources.map(s=>[s.id,s]));

/* ---------- graph model ---------- */
const nodes=[],byId={};
D.entities.forEach((e,i)=>{const n={...e,kind:'e',idx:i,deg:0,rels:[],facts:[],money:0};nodes.push(n);byId[e.id]=n});
const rels=D.rels.filter(r=>byId[r.a]&&byId[r.b]).map(r=>({...r,A:byId[r.a],B:byId[r.b]}));
rels.forEach(r=>{r.A.deg++;r.B.deg++;r.A.rels.push(r);r.B.rels.push(r);if(r.amt&&(r.cur==='USD'||!r.cur)){r.A.money+=Math.abs(r.amt);r.B.money+=Math.abs(r.amt)}});
D.facts.forEach(f=>{const e=byId[f.a];if(e)e.facts.push(f)});
const fnodes=[],snodes={};
const links=[];
rels.forEach(r=>{const f={kind:'f',rel:r,id:'F'+r.id};r.F=f;fnodes.push(f);links.push({source:r.A,target:f,d:26},{source:f,target:r.B,d:26})});
D.facts.forEach(fx=>{const e=byId[fx.a];if(!e)return;const f={kind:'f',single:fx,id:'F'+fx.id,owner:e};fnodes.push(f);links.push({source:e,target:f,d:18})});
fnodes.forEach(f=>{const ev=(f.rel?f.rel.ev:f.single.ev)||[];f.srcs=[];ev.forEach(x=>{if(!SRC[x.s])return;let s=snodes[x.s];if(!s){s=snodes[x.s]={kind:'s',id:x.s,src:SRC[x.s],facts:[]}}s.facts.push(f);f.srcs.push(s);links.push({source:f,target:s,d:9})})});
const all=[...nodes,...fnodes,...Object.values(snodes)];
nodes.forEach(n=>{n.r=1.6+Math.sqrt(n.deg+n.facts.length*.4)*2.1+(+n.boost||0)});
const maxMoney=d3.max(nodes,n=>n.money)||1;
let sizeBy='connections';
function radius(n){if(n.kind!=='e')return n.kind==='f'?1.15:.8;
  if(sizeBy==='money')return n.money>0?2.2+10*Math.log10(1+n.money/1e7)/Math.log10(1+maxMoney/1e7):1.8;return n.r}
const rank=[...nodes].sort((a,b)=>b.deg-a.deg);rank.forEach((n,i)=>n.rank=i);

/* ---------- force layout (computed once, then held) ---------- */
const sim=d3.forceSimulation(all)
 .force('link',d3.forceLink(links).distance(l=>l.d).strength(l=>l.target.kind==='s'?.5:.35))
 .force('charge',d3.forceManyBody().strength(n=>n.kind==='e'?-90-n.deg*6:n.kind==='f'?-7:-3).distanceMax(420))
 .force('collide',d3.forceCollide(n=>n.kind==='e'?n.r+3:1.5))
 .force('x',d3.forceX(0).strength(.035)).force('y',d3.forceY(0).strength(.035))
 .stop();
all.forEach((n,i)=>{const a=i*2.399,rr=6*Math.sqrt(i);n.x=Math.cos(a)*rr;n.y=Math.sin(a)*rr});
/* positions are precomputed at build time (D.pos) so the intro starts at once; the same simulation runs here if they are missing or stale */
const POSK=all.length+':'+all.map(n=>n.id).join('|').length,PP=D.pos&&D.pos.k===POSK&&D.pos.p;
if(PP)all.forEach((n,i)=>{n.x=PP[2*i];n.y=PP[2*i+1]});
else{for(let i=0;i<420;i++)sim.tick();
{const cx=d3.mean(nodes,n=>n.x),cy=d3.mean(nodes,n=>n.y);all.forEach(n=>{n.x-=cx;n.y-=cy})}}
all.forEach(n=>{n.nx=n.x;n.ny=n.y;n.ph=Math.random()*6.283;n.al=1;n.ta=1;n.dl=0;n.at=0});

/* ---------- canvas + camera ---------- */
const cv=document.getElementById('net'),ctx=cv.getContext('2d');
let W=0,H=0,DPR=1;
function resize(){DPR=Math.min(2,devicePixelRatio||1);W=cv.clientWidth;H=cv.clientHeight;cv.width=W*DPR;cv.height=H*DPR}
resize();addEventListener('resize',()=>{resize();draw()});
let T=d3.zoomIdentity,theta=0,spin=!RM;
const zoom=d3.zoom().scaleExtent([.25,8]).on('zoom',e=>{T=e.transform;if(e.sourceEvent)hideInsp()});
const sel=d3.select(cv).call(zoom).on('dblclick.zoom',null);
const centerX=()=>W<=900?W/2:(224+(W-360))/2;
function fitT(pts,pad=80,full=false){
  const xs=pts.map(p=>p[0]),ys=pts.map(p=>p[1]);
  const x0=d3.min(xs),x1=d3.max(xs),y0=d3.min(ys),y1=d3.max(ys);
  const mob=W<=900;
  const avW=full?(mob?W-24:W*.84):mob?W-32:W-224-360-60,avH=full?(mob?H*.66:H-90):mob?H*.5:H-170;
  let aw=avW,ah=avH,cxs=0,ph=pad,pv=pad,cyM=(110+H*.48)/2;if(!full&&!mob&&focus&&mode!=='holdings'&&!kase){aw-=150;cxs=-75}
  // phones: fit into the strip between the header and the bottom sheet, leaving room for labels on both sides
  if(mob&&!full){const top=104,bot=H-((focus||kase||mode==='holdings')?H*.56+56:150);ah=bot-top;cyM=(top+bot)/2;if(focus&&mode!=='holdings'){aw=W-220;ph=0;pv=40}}
  const k=Math.max(.3,Math.min(4,Math.min(aw/(x1-x0+ph*2),ah/(y1-y0+pv*2))));
  const cx=full?W/2:centerX()+cxs,cy=full?H/2:mob?cyM:H/2+6;
  return d3.zoomIdentity.translate(cx-k*(x0+x1)/2,cy-k*(y0+y1)/2).scale(k)}
function fitTo(pts,dur=1100,pad=80){
  if(!pts.length)return;const t=fitT(pts,pad);
  sel.transition().duration(RM?0:dur).ease(d3.easeCubicInOut).call(zoom.transform,t);
}
const rot=(x,y,a)=>[x*Math.cos(a)-y*Math.sin(a),x*Math.sin(a)+y*Math.cos(a)];

/* ---------- state ---------- */
let mode='network',focus=null,hoverN=null,hoverR=null,selRel=null,journey=[],hlType=null,kase=null,pinN=null,pinR=null,labelMode='off';
const app=document.getElementById('app');
const F={types:new Set(TYPES.map(t=>t[0])),fam:new Set(FAMS),st:new Set(['documented','reported'])};
function fam(r){const t=r.t,rl=(r.rel||'').toLowerCase();
  if(t==='ownership'||/owner|stake\b|shareholder|controls|economic_interest|owns|subsidiary|parent/.test(rl))return 'own';
  if(t==='money'||t==='financial'||/aid|appropriat|funds_or|grant|transfer/.test(rl))return 'money';
  if(t==='election'||t==='donation'||/donat|lobby|pac|spent|support|oppos|endorse/.test(rl))return 'politics';
  if(/ceo|chair|board|founder|president|director|officer|executive|member|role|vice|leads|head/.test(rl)||t==='benefit'||t==='consumer')return 'role';
  if(t==='tech'||/cloud|\bai\b|partnership|models|software|data/.test(rl))return 'tech';
  return 'contract'}
rels.forEach(r=>{r.fam=fam(r);r.opp=/oppos/.test((r.rel||'').toLowerCase())});
const visE=n=>F.types.has(n.type);
const visR=r=>F.fam.has(r.fam)&&F.st.has(r.st)&&visE(r.A)&&visE(r.B);
const relVal=r=>[r.pct?(+r.pct).toFixed(2)+'%':'',r.amt?money(r.amt,r.cur):''].filter(Boolean).join(' · ');
const usd=r=>r.amt&&r.cur==='USD'?Math.abs(r.amt):0;
const usdx=r=>r.amt&&FX[r.cur]?Math.abs(r.amt)*FX[r.cur]:0;
const since23=r=>{const ys=(String(r.date||'')+' '+(r.ctx||'').slice(0,0)).match(/(19|20)\d\d/g);return !ys||ys.some(y=>+y>=2023)};
const TRACKED=D.tracked?{total:D.tracked.usd,parts:D.tracked.parts}:(()=>{const rs=rels.filter(r=>usdx(r)&&r.fam!=='own'&&r.t!=='financial'&&since23(r)&&!/cumulative_aid|since_1946|long.?term/i.test(r.rel));return{total:d3.sum(rs,usdx),parts:[]}})();
// money-tracked bar on the overview and phone page uses the HEAT palette
const HEATB=(p=>[p.company,p.fund,p.weapon,p.country,p.gov,p.org,p.person,p.contract])(PAL.thermal);
const BLOCK=['#e8ff3a','#ff5a36','#ff8fb1','#7fd1ff','#c9b8ff','#9dffb0','#ffc44d','#bdbdb5'];
const fcol=r=>r.opp?FCOL.oppose:FCOL[r.fam];

/* ---------- holdings: asset managers × arms companies ---------- */
const HOLD=(()=>{const rs=rels.filter(r=>r.fam==='own'&&r.A.type==='Fund/Asset Manager'&&r.B.type==='Company');
  const funds=[...new Set(rs.map(r=>r.A))],cos=[...new Set(rs.map(r=>r.B))];
  funds.forEach(f=>f.held=rs.filter(r=>r.A===f));cos.forEach(c=>c.holders=rs.filter(r=>r.B===c));
  funds.sort((a,b)=>b.held.length-a.held.length||d3.sum(b.held,usd)-d3.sum(a.held,usd));
  cos.sort((a,b)=>b.holders.length-a.holders.length||b.deg-a.deg);
  return{rs:new Set(rs),funds,cos,set:new Set([...funds,...cos])}})();

/* ---------- case files ---------- */
const has=(r,ids)=>ids.includes(r.a)||ids.includes(r.b);
const EUROPE=nodes.filter(n=>(n.type==='Country'||n.type==='Government')&&/Germany|Finland|Denmark|Slovakia|Greece|Italy|France|United Kingdom|Netherlands|Spain|Czech|Romania|Belgium|Poland|Austria|Cyprus|Hungary|Bulgaria|Sweden|Norway|Portugal|Ireland|Croatia|Switzerland/.test(n.name)).map(n=>n.id);
const CASES=[
 {k:'01',tab:'Owners',title:'Who owns the arms makers',holdings:true,
  blurb:'The same handful of asset managers owns large stakes in every major Western weapons manufacturer in this database. Every bomb dropped on Gaza, Lebanon and Iran by these companies’ products pays dividends to their shareholders.'},
 {k:'02',tab:'US aid',title:'US military money to Israel',pick:r=>['MF-0011','MF-0013','MF-0018'].includes(r.id)||has(r,['CTR-00001','CTR-00002','CTR-00003'])||/aid|appropriat/i.test(r.rel||'')&&has(r,['GOV-00005','CTY-00001']),
  blurb:'Billions in US military aid, emergency appropriations and arms packages flowed to Israel after October 2023, sustaining the genocide in Gaza, the destruction of South Lebanon and the war on Iran.'},
 {k:'03',tab:'AIPAC',paper:'yellow',title:'AIPAC’s super PAC in the primaries',pick:r=>r.t==='election'||has(r,['ORG-00001','ORG-00002','ORG-00003']),
  blurb:'United Democracy Project, the super PAC AIPAC launched in 2022, spends millions to defeat candidates who criticise Israel and to elect those who back it unconditionally.'},
 {k:'04',tab:'Elbit',paper:'kraft',title:'Elbit Systems and the Federmanns',pick:r=>has(r,['COM-00007','COM-00035','FAM-N0001'])&&(r.fam==='own'||r.fam==='role'),
  blurb:'Israel’s largest private arms maker is controlled by one family. Its drones, artillery and munitions are used across Gaza and Lebanon, and its share price climbed as the bombing went on.'},
 {k:'05',tab:'Big Tech',title:'Big Tech, cloud and military AI',pick:r=>r.fam==='tech'||has(r,['CTR-00004','COM-00010']),
  blurb:'Cloud, AI and data contracts put Silicon Valley inside Israel’s military: storing surveillance of Palestinians, powering targeting systems and selling the infrastructure of automated killing.'},
 {k:'06',tab:'Arms sales',paper:'yellow',title:'US bombs for Israel',pick:r=>has(r,['CTR-00001','CTR-00002','CTR-00003']),
  blurb:'US arms packages for Israel: guidance kits, bunker-busting bomb bodies and missiles, with the companies paid to make them.'},
 {k:'07',tab:'Europe',title:'Europe arms Israel',pick:r=>has(r,['CTR-00006','CTR-00007','CTR-00008','CTR-00009','CTR-00010','LBL-EUROPE',...EUROPE]),
  blurb:'European governments kept exporting parts and weapons to Israel and buying Israeli systems tested in Gaza, while issuing statements of concern.'},
 {k:'08',tab:'War costs',title:'What the wars cost',pick:r=>['MF-0001','MF-0005','MF-0006','MF-0010','MF-0012','MF-0019'].includes(r.id),
  blurb:'The headline counts each US dollar once: military aid, regional operations, new 2026 money for Israel and the war on Iran. The record below adds budget-level totals (all US military spending, Pentagon contracts) that overlap and are not payments to Israel.'},
 {k:'09',tab:'Top pay',title:'Pay at the top',pick:r=>r.t==='benefit'&&/compensation/i.test(r.rel||''),
  blurb:'What the chief executives of weapons manufacturers took home while their products were used on Gaza, Lebanon and Iran.'},
 {k:'10',tab:'AI Kill Chain',title:'The AI kill chain',special:true,paper:'yellow',pick:r=>r.fam==='tech'&&/target|maven|lavender|gospel|nimbus|ai\b|military/i.test((r.rel||'')+' '+(r.ctx||'')+' '+r.A.name+' '+r.B.name),
  blurb:'How surveillance data, cloud computing and AI targeting systems turned the killing of Palestinians, Lebanese and Iranians into an industrial process, and which companies built each link.'},
 {k:'11',tab:'Profiteers',title:'The war profiteers',special:true,paper:'cream',pick:r=>/donat|grant|bond|compensation|chief_exec|ceo/i.test(r.rel||''),
  blurb:'The asset managers, executives and billionaires who own, run and bankroll the companies arming the genocide, and what they took home.'},
 {k:'12',tab:'Global',title:'Complicit beyond Europe',pick:r=>/^CTY-G-/.test(r.A.id)||/^CTY-G-/.test(r.B.id),
  blurb:'The governments in Asia, Africa and South America that kept buying Israeli weapons and surveillance, selling it fuel, coal and parts, or shielding it diplomatically while the genocide went on.'}];
// Global sits beside Europe; Netanyahu's own file closes the drawer; tabs are numbered by position, rk keeps the data key
{const gi=CASES.findIndex(c=>c.k==='12');const G=CASES.splice(gi,1)[0];CASES.splice(CASES.findIndex(c=>c.k==='07')+1,0,G);
 const nb=byId['PER-N-NETANYAHU'];if(nb)CASES.push({k:'NB',tab:'Netanyahu',title:nb.name,special:true,entity:nb,pick:r=>r.A===nb||r.B===nb,blurb:nb.role||''});
   const lb=byId['CTY-NEW-LEBANON'];if(D.reports.caseSL)CASES.push({k:'SL',tab:'South Lebanon',title:D.reports.caseSL.title,special:true,pick:r=>!!lb&&(r.A===lb||r.B===lb),blurb:D.reports.caseSL.dek||''});
 CASES.forEach((c,i)=>{c.rk=c.k;c.k=String(i+1).padStart(2,'0')})}
CASES.forEach(c=>{const R=D.reports['case'+c.rk];if(R&&R.title&&c.special)c.title=R.title;if(c.holdings){c.rels=HOLD.rs;c.set=HOLD.set;return}c.rels=new Set(rels.filter(c.pick));c.set=new Set();c.rels.forEach(r=>{c.set.add(r.A);c.set.add(r.B)})});

/* ---------- layouts (targets in view space, then un-rotated) ---------- */
let tween=null;
function setTargets(map,dur=1300,ease=d3.easeCubicInOut){
  all.forEach(n=>{n.sx0=n.x;n.sy0=n.y;const p=map.get(n);if(p){const w=rot(p[0],p[1],-theta);n.tx=w[0];n.ty=w[1]}else{n.tx=n.x;n.ty=n.y}});
  tween={t0:performance.now(),dur:RM?1:dur,ease};
}
function placeMicro(m){
  fnodes.forEach(f=>{let p;if(f.rel){const a=m.get(f.rel.A),b=m.get(f.rel.B);if(!a||!b)return;const h=(f.rel.id.charCodeAt(f.rel.id.length-1)%7-3)*3;p=[(a[0]+b[0])/2+h,(a[1]+b[1])/2-h]}
    else{const o=m.get(f.owner);if(!o)return;const k=f.owner.facts.indexOf(f.single),a=k*2.4+1;p=[o[0]+Math.cos(a)*(radius(f.owner)+10+k%3*4),o[1]+Math.sin(a)*(radius(f.owner)+10+k%3*4)]}
    m.set(f,p)});
  Object.values(snodes).forEach((s,i)=>{const f=s.facts[0],p=m.get(f);if(!p)return;const a=i*1.7;m.set(s,[p[0]+Math.cos(a)*7,p[1]+Math.sin(a)*7])});
  return m}
function layoutNetwork(){const m=new Map();all.forEach(n=>{const p=rot(n.nx,n.ny,theta);m.set(n,p)});return m}
function pushOut(m,R){nodes.forEach(n=>{if(m.has(n))return;const p=rot(n.nx,n.ny,theta);const a=Math.atan2(p[1],p[0]),d=Math.hypot(p[0],p[1]);m.set(n,[Math.cos(a)*(R+d),Math.sin(a)*(R+d)])})}
function layoutClusters(){
  const m=new Map(),groups=d3.groups(nodes.filter(visE),n=>n.type).sort((a,b)=>b[1].length-a[1].length);
  const R=Math.max(260,groups.length*48);
  groups.forEach(([t,arr],gi)=>{const a=gi/groups.length*Math.PI*2-Math.PI/2,cx=Math.cos(a)*R,cy=Math.sin(a)*R;
    arr.sort((x,y)=>y.deg-x.deg).forEach((n,i)=>{const rr=Math.sqrt(i)*15,aa=i*2.39996;m.set(n,[cx+Math.cos(aa)*rr,cy+Math.sin(aa)*rr])});
    clusterLabels.push({t,x:cx,y:cy-Math.sqrt(arr.length)*15-22,n:arr.length})});
  nodes.filter(n=>!visE(n)).forEach(n=>m.set(n,rot(n.nx*2.2,n.ny*2.2,theta)));
  return placeMicro(m)}
const FLOWCOL=['Country','Government','Aggregate','Contract/Deal','Weapon/System','Company','Fund/Asset Manager','Family','Organization','Person'];
const FLOWLAB={Country:'COUNTRIES',Government:'GOVERNMENTS',Aggregate:'BUDGET / FLOWS','Contract/Deal':'CONTRACTS','Weapon/System':'WEAPONS',Company:'MANUFACTURERS','Fund/Asset Manager':'SHAREHOLDERS',Family:'FAMILIES',Organization:'PACS / ORGS',Person:'PEOPLE'};
function layoutFlow(){
  const m=new Map(),cols=FLOWCOL.filter(t=>nodes.some(n=>n.type===t&&visE(n)));const gap=150,x0=-(cols.length-1)*gap/2;
  cols.forEach((t,ci)=>{const arr=nodes.filter(n=>n.type===t&&visE(n)).sort((a,b)=>b.deg-a.deg);const step=Math.min(22,520/arr.length);
    arr.forEach((n,i)=>m.set(n,[x0+ci*gap+((i%2)?8:-8),(i-(arr.length-1)/2)*step]));clusterLabels.push({t,x:x0+ci*gap,y:-(arr.length-1)/2*step-36,n:arr.length,flow:true})});
  nodes.filter(n=>!visE(n)).forEach(n=>m.set(n,rot(n.nx*2.2,n.ny*2.2,theta)));
  return placeMicro(m)}
function layoutHoldings(){
  const m=new Map(),nf=HOLD.funds.length,gy=Math.min(118,620/nf);
  if(W<=900){HOLD.funds.forEach((f,i)=>{m.set(f,[-45,(i-(nf-1)/2)*64]);f.hs='l'});const nc=HOLD.cos.length;HOLD.cos.forEach((c,i)=>{m.set(c,[45,(i-(nc-1)/2)*64]);c.hs='r'});
    clusterLabels.push({txt:'MANAGERS',x:-95,y:-(nf-1)/2*64-34,col:TCOL['Fund/Asset Manager']},{txt:'COMPANIES',x:95,y:-(nc-1)/2*64-34,col:TCOL.Company});return placeMicro(m)}
  HOLD.funds.forEach((f,i)=>{m.set(f,[0,(i-(nf-1)/2)*gy]);f.hs='c'});
  const L=HOLD.cos.filter((_,i)=>i%2===0),Rt=HOLD.cos.filter((_,i)=>i%2===1);
  [[L,-1],[Rt,1]].forEach(([arr,s])=>{const g=Math.min(160,640/arr.length);arr.forEach((c,i)=>{m.set(c,[s*380,(i-(arr.length-1)/2)*g+(s>0?g/2:0)]);c.hs=s<0?'l':'r'});
    clusterLabels.push({txt:'WEAPONS MANUFACTURERS',x:s*380,y:-(arr.length-1)/2*g-48,col:TCOL.Company})});
  clusterLabels.push({txt:'ASSET MANAGERS',x:0,y:-(nf-1)/2*gy-52,col:TCOL['Fund/Asset Manager']});
  return placeMicro(m)}
function layoutCase(c){
  const ns=[...c.set].map(n=>({n,x:n.nx,y:n.ny})),ix=new Map(ns.map(o=>[o.n,o]));
  const ls=[...c.rels].map(r=>({source:ix.get(r.A),target:ix.get(r.B)})).filter(l=>l.source&&l.target);
  const s=d3.forceSimulation(ns).force('l',d3.forceLink(ls).distance(130).strength(.5)).force('c',d3.forceManyBody().strength(-760))
    .force('x',d3.forceX(0).strength(.07)).force('y',d3.forceY(0).strength(.07)).force('col',d3.forceCollide(o=>30+Math.min(o.n.name.length,32)*2.4)).stop();
  for(let i=0;i<340;i++)s.tick();
  const cx=d3.mean(ns,o=>o.x),cy=d3.mean(ns,o=>o.y),m=new Map();ns.forEach(o=>{m.set(o.n,[o.x-cx,o.y-cy]);o.n.hs=o.x-cx<-40?'l':'r'});
  pushOut(m,(d3.max(ns,o=>Math.hypot(o.x-cx,o.y-cy))||200)+420);return placeMicro(m)}
const RING=[['Country','COUNTRIES'],['Fund/Asset Manager','INVESTORS'],['Government','GOVERNMENTS'],['Contract/Deal','CONTRACTS'],['Weapon/System','WEAPONS'],['Company','COMPANIES'],['Organization','ORGANIZATIONS'],['Person','PEOPLE'],['Family','FAMILIES'],['Aggregate','FLOWS']];
let ringLabels=[],clusterLabels=[];
function neighborhood(c){const n1=new Set(),n2=new Set();c.rels.forEach(r=>{if(!visR(r))return;n1.add(r.A===c?r.B:r.A)});n1.forEach(n=>n.rels.forEach(r=>{if(!visR(r))return;const o=r.A===n?r.B:r.A;if(o!==c&&!n1.has(o))n2.add(o)}));return{n1,n2}}
const LW=n=>Math.min(n.name.length,34)*7.3+18;
function layoutOrbit(c){
  const m=new Map();const {n1,n2}=neighborhood(c);m.set(c,[0,0]);c.hs='r';
  const groups=RING.map(([t,l])=>[t,l,[...n1].filter(n=>n.type===t)]).filter(g=>g[2].length);
  const total=d3.sum(groups,g=>g[2].length)||1;const R1=Math.max(180,Math.min(360,80+total*9));
  let a0=-Math.PI/2;ringLabels=[];const P=[];
  const LWo=n=>{const r0=n.rels.find(q=>q.A===c||q.B===c);const sub=r0?(relName(r0.rel).slice(0,30)+'  '+(relVal(r0)||'')).length*6.1:0;return Math.max(LW(n),sub+12)};
  groups.forEach(([t,l,arr])=>{const span=Math.max(.55,arr.length/total*Math.PI*2);arr.sort((a,b)=>b.deg-a.deg);
    arr.forEach((n,i)=>{const a=a0+span*(i+.5)/arr.length;P.push({n,a,r:R1+(i%2)*34})});
    const am=a0+span/2;ringLabels.push({l,n:arr.length,a:am,x:0,y:0,w:d3.max(arr,LWo)});a0+=span});
  // push labels apart: lines may grow so every name stays readable
  const box=o=>{const x=Math.cos(o.a)*o.r,y=Math.sin(o.a)*o.r,w=LWo(o.n);o.n.hs=x<-8?'l':'r';return o.n.hs==='l'?[x-w-8,y-13,w,30]:[x+8,y-13,w,30]};
  const hit=(a,b)=>a[0]<b[0]+b[2]&&a[0]+a[2]>b[0]&&a[1]<b[1]+b[3]&&a[1]+a[3]>b[1];
  const FB=[8,-16,LW(c)*1.45+40,26];
  for(let it=0;it<120;it++){let moved=false;const B=P.map(box);
    for(let i=0;i<P.length;i++)if(hit(B[i],FB)){P[i].r+=9;moved=true;B[i]=box(P[i])}
    for(let i=0;i<P.length;i++)for(let j=i+1;j<P.length;j++)if(hit(B[i],B[j])){P[j].r+=9;moved=true;B[j]=box(P[j])}
    if(!moved)break}
  const Rmax=d3.max(P,o=>o.r)||R1;
  P.forEach(o=>m.set(o.n,[Math.cos(o.a)*o.r,Math.sin(o.a)*o.r]));
  ringLabels.forEach(l=>{const ca=Math.abs(Math.cos(l.a)),rr=Rmax+60;l.skip=ca>.45;l.x=Math.cos(l.a)*rr;l.y=Math.sin(l.a)*rr;l.R=Rmax});
  const R2=Rmax+190;[...n2].forEach(n=>{const anc=[...n1].find(x=>x.rels.some(r=>r.A===n||r.B===n));const p=m.get(anc)||[0,R2];const a=Math.atan2(p[1],p[0])+(Math.random()-.5)*.35;m.set(n,[Math.cos(a)*R2*(1+Math.random()*.15),Math.sin(a)*R2*(1+Math.random()*.15)])});
  pushOut(m,R2+260);
  return{m:placeMicro(m),n1,n2}}

/* ---------- applying a view ---------- */
let nb={n1:new Set(),n2:new Set()};
function apply(fit=true){
  clusterLabels=[];ringLabels=[];nodes.forEach(n=>n.hs=null);spin=!RM&&mode==='network'&&!focus&&!kase;let m,dur=1300;
  if(mode==='holdings'){m=layoutHoldings();nb=focus?neighborhood(focus):{n1:new Set(),n2:new Set()};dur=1700}
  else if(kase){m=layoutCase(kase);nb={n1:new Set(),n2:new Set()}}
  else if(focus&&(mode==='orbit'||mode==='network')){const o=layoutOrbit(focus);m=o.m;nb={n1:o.n1,n2:o.n2}}
  else{nb={n1:new Set(),n2:new Set()};m=mode==='clusters'?layoutClusters():mode==='flow'?layoutFlow():layoutNetwork();
    if(focus){const o=neighborhood(focus);nb=o}}
  setTargets(m,dur);
  all.forEach(n=>{n.ta=targetAlpha(n)});
  if(fit){let pts=[];
    if(mode==='holdings')HOLD.set.forEach(n=>pts.push(m.get(n)));
    else if(kase)kase.set.forEach(n=>pts.push(m.get(n)));
    else if(focus){pts.push(m.get(focus));nb.n1.forEach(n=>pts.push(m.get(n)))}else nodes.filter(visE).forEach(n=>pts.push(m.get(n)));
    fitTo(pts.filter(Boolean),dur,mode==='holdings'?(W<=900?170:190):kase?170:focus?180:30)}
  renderModes();renderCrumbs();renderPaper();
}
function targetAlpha(n){
  if(mode==='holdings'){if(n.kind==='e')return HOLD.set.has(n)?1:0;if(n.kind==='f')return n.rel&&HOLD.rs.has(n.rel)?1:0;return 0}
  if(kase){if(n.kind==='e')return kase.set.has(n)?1:.05;if(n.kind==='f')return n.rel&&kase.rels.has(n.rel)?1:.03;return d3.max(n.facts.map(targetAlpha))*.9}
  if(n.kind==='e'){if(!visE(n))return 0;if(!focus)return 1;return n===focus||nb.n1.has(n)?1:nb.n2.has(n)?.32:.07}
  if(n.kind==='f'){const r=n.rel;if(r){if(!visR(r))return 0;if(!focus)return 1;return (r.A===focus||r.B===focus)?1:(nb.n1.has(r.A)&&nb.n1.has(r.B))?.3:.05}
    return visE(n.owner)?(!focus||n.owner===focus?1:.06):0}
  return d3.max(n.facts.map(targetAlpha))*.9}

/* ---------- drawing ---------- */
let last=performance.now(),clock=0,particles=[],boost=0,chipHits=[],intro=null;
function seedParticles(){particles=[];rels.filter(r=>r.amt&&(r.fam==='money'||r.fam==='own'||r.fam==='contract'||r.fam==='politics')).sort((a,b)=>usd(b)-usd(a)).slice(0,40).forEach(r=>{for(let j=0;j<2;j++)particles.push({r,t:Math.random(),v:.03+Math.random()*.04})})}
seedParticles();
function screen(n){const p=rot(n.x,n.y,theta);let x=p[0],y=p[1];if(!RM&&n.kind!=='e'||(!RM&&!focus&&!kase&&mode==='network')){x+=Math.sin(clock*.6+n.ph)*(n.kind==='e'?.9:1.4);y+=Math.cos(clock*.5+n.ph)*(n.kind==='e'?.9:1.4)}return[T.applyX(x),T.applyY(y)]}
function curvePts(r){const a=r.A.s,b=r.B.s,f=r.F.s;return[a,[2*f[0]-(a[0]+b[0])/2,2*f[1]-(a[1]+b[1])/2],b]}
function qAt(p,t){const u=1-t;return[u*u*p[0][0]+2*u*t*p[1][0]+t*t*p[2][0],u*u*p[0][1]+2*u*t*p[1][1]+t*t*p[2][1]]}
let tp=1;
function frame(now){
  const dt=Math.min(.05,(now-last)/1000);last=now;clock+=dt;
  boost*=Math.pow(.45,dt);
  if(spin&&!hoverN&&!hoverR&&!document.hidden)theta+=dt*(0.0085+boost);
  tp=1;if(tween){const el=now-tween.t0;tp=Math.min(1,el/tween.dur);let done=true;all.forEach(n=>{const k=Math.max(0,Math.min(1,(el-(n.dl||0))/tween.dur));if(k<1)done=false;const e=tween.ease(k);n.x=n.sx0+(n.tx-n.sx0)*e;n.y=n.sy0+(n.ty-n.sy0)*e});if(done){tween=null;all.forEach(n=>n.dl=0)}}
  all.forEach(n=>{const tg=now<(n.at||0)?0:n.ta;n.al+=(tg-n.al)*Math.min(1,dt*(mode==='holdings'&&tg===0?7:4))});
  particles.forEach(p=>{p.t+=p.v*dt;if(p.t>1)p.t-=1});
  draw(now);requestAnimationFrame(frame)}
const nodeR=n=>{let r=radius(n)*Math.max(.7,Math.min(1.8,Math.sqrt(T.k)));if(focus&&n!==focus&&!nb.n1.has(n)&&mode!=='holdings')r*=.45;else if(focus&&nb.n1.has(n)&&mode!=='holdings')r=Math.max(r*1.25,5);if(mode==='holdings')r=Math.max(r,n.type==='Fund/Asset Manager'?9:6);if(kase&&kase.set.has(n))r=Math.max(r,5);return r};
const dimByType=n=>hlType&&n.type!==hlType?.18:1;
function rr(x,y,w,h,r){ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath()}
const overlap=(b,q)=>b[0]<q[0]+q[2]+2&&b[0]+b[2]+2>q[0]&&b[1]<q[1]+q[3]+2&&b[1]+b[3]+2>q[1];
function draw(now=performance.now()){
  ctx.setTransform(DPR,0,0,DPR,0,0);ctx.fillStyle=C.bg;ctx.fillRect(0,0,W,H);
  all.forEach(n=>{n.s=screen(n)});
  const k=T.k,mono=css('--mono'),sans=css('--sans');
  // intro ring: the database loads as beads around a dial, then bursts into the network
  if(intro){const e=now-intro.t0,p=Math.min(1,e/1500),fade=e<1700?1:Math.max(0,1-(e-1700)/700);
    if(fade>0){ctx.strokeStyle=`rgba(232,255,0,${.55*fade})`;ctx.lineWidth=1;ctx.beginPath();ctx.arc(W/2,H/2,intro.R,-Math.PI/2,-Math.PI/2+p*6.283);ctx.stroke();
      ctx.strokeStyle=`rgba(52,52,52,${fade})`;ctx.beginPath();ctx.arc(W/2,H/2,intro.R+9,0,6.283);ctx.stroke();
      for(let i=0;i<60;i++){const a=i/60*6.283-Math.PI/2;if(i/60>p)break;const r1=intro.R+6,r2=intro.R+(i%5?11:16);ctx.strokeStyle=`rgba(148,148,148,${.6*fade})`;ctx.beginPath();ctx.moveTo(W/2+Math.cos(a)*r1,H/2+Math.sin(a)*r1);ctx.lineTo(W/2+Math.cos(a)*r2,H/2+Math.sin(a)*r2);ctx.stroke()}
      const a=-Math.PI/2+p*6.283;ctx.fillStyle=`rgba(232,255,0,${fade})`;ctx.beginPath();ctx.arc(W/2+Math.cos(a)*intro.R,H/2+Math.sin(a)*intro.R,2.4,0,6.283);ctx.fill()}}
  // evidence threads
  ctx.lineWidth=.4;
  if(mode!=='holdings')Object.values(snodes).forEach(s=>{if(s.al<.02)return;s.facts.forEach(f=>{if(f.al<.02)return;ctx.strokeStyle=`rgba(148,148,148,${.16*Math.min(s.al,f.al)})`;ctx.beginPath();ctx.moveTo(f.s[0],f.s[1]);ctx.lineTo(s.s[0],s.s[1]);ctx.stroke()})});
  fnodes.forEach(f=>{if(f.single&&f.al>.02){ctx.strokeStyle=`rgba(120,120,118,${.35*f.al})`;ctx.lineWidth=.5;ctx.beginPath();ctx.moveTo(f.owner.s[0],f.owner.s[1]);ctx.lineTo(f.s[0],f.s[1]);ctx.stroke()}});
  // relationships
  const hot=new Set();if(hoverN)hoverN.rels.forEach(r=>hot.add(r));if(focus)focus.rels.forEach(r=>hot.add(r));if(pinN)pinN.rels.forEach(r=>hot.add(r));if(pinR)hot.add(pinR);
  const chips=[];
  rels.forEach(r=>{let a=Math.min(r.A.al,r.B.al,r.F.al);if(mode==='holdings'&&tp<1)a*=Math.max(0,(tp-.6)/.4);if(a<.02)return;const p=curvePts(r);const isHot=hot.has(r)||r===hoverR||r===selRel;
    const inCase=kase&&kase.rels.has(r);
    ctx.setLineDash(r.st==='reported'?[3,3]:[]);
    let w=.6,col=hexA(fcol(r),.34*a);
    if(mode==='holdings'){w=.5+(r.pct||1.5)*.2;col=hexA(TCOL.Company,a*((focus||hoverN||pinN)?(isHot?.95:.07):.42))}
    else if(inCase){w=1.1;col=hexA(fcol(r),.85)}
    if(hlType&&r.A.type!==hlType&&r.B.type!==hlType)col=hexA(fcol(r),.07*a);
    if(isHot&&mode!=='holdings'){w=focus&&r.amt?Math.min(3.2,.9+Math.log10(1+usd(r)/1e6)*.45):1.2;col=hexA(fcol(r),.95*a)}
    if(r===selRel||r===hoverR||r===pinR)col=C.sel;
    ctx.lineWidth=w;ctx.strokeStyle=col;ctx.beginPath();ctx.moveTo(p[0][0],p[0][1]);ctx.quadraticCurveTo(p[1][0],p[1][1],p[2][0],p[2][1]);ctx.stroke();
    if((isHot||inCase)&&r.fam!=='role'){const q=qAt(p,.86),q2=qAt(p,.83);r.opp?bar(q2,q,col):arrow(q2,q,col)}
    const want=(r.amt||r.pct)&&(r===hoverR||r===selRel||r===pinR||(focus&&isHot&&mode!=='holdings'&&r.A!==focus&&r.B!==focus)||(inCase&&mode!=='holdings')||(mode==='holdings'&&isHot)||(hoverN&&isHot&&!focus)||(k>=2.8&&a>.6&&!focus&&!kase&&mode==='network'));
    if(want)chips.push({r,p,pri:r===selRel||r===hoverR||r===pinR?2:isHot?1:0})});
  ctx.setLineDash([]);
  // particles on major money paths
  if(!RM&&mode!=='holdings')particles.forEach(p=>{const r=p.r;const a=Math.min(r.A.al,r.B.al);if(a<.3)return;const q=qAt(curvePts(r),p.t);ctx.fillStyle=hot.has(r)?C.sel:hexA(fcol(r),.85*a*dimByType(r.A));ctx.fillRect(q[0]-1,q[1]-1,2,2)});
  // micro nodes
  if(mode!=='holdings'){fnodes.forEach(f=>{if(f.al<.02)return;ctx.fillStyle=`rgba(200,200,196,${.55*f.al})`;const r=f.rel===selRel?2.4:1.1*Math.min(1.6,Math.max(.8,k*.7));ctx.fillRect(f.s[0]-r/2,f.s[1]-r/2,r,r)});
  Object.values(snodes).forEach(s=>{if(s.al<.02)return;ctx.fillStyle=`rgba(148,148,148,${.45*s.al})`;ctx.beginPath();ctx.arc(s.s[0],s.s[1],.7,0,6.283);ctx.fill()})}
  // entities
  nodes.forEach(n=>{if(n.al<.02)return;const r=nodeR(n);const isSel=n===focus||n===pinN;
    let col=TCOL[n.type]||C.fg;
    ctx.globalAlpha=n.al*dimByType(n);
    if(hlType===n.type){ctx.strokeStyle=col;ctx.lineWidth=1;ctx.beginPath();ctx.arc(n.s[0],n.s[1],r+4,0,6.283);ctx.stroke()}
    if(isSel){ctx.strokeStyle=C.sel;ctx.lineWidth=1.2;ctx.beginPath();ctx.arc(n.s[0],n.s[1],r+6,0,6.283);ctx.stroke();ctx.beginPath();ctx.arc(n.s[0],n.s[1],r+10,0,6.283);ctx.globalAlpha*=.4;ctx.stroke();ctx.globalAlpha=n.al}
    if(r>3.2&&n.al>.5&&!RM){ctx.shadowColor=col;ctx.shadowBlur=Math.min(14,r*2)}
    if(n.type==='Weapon/System'||n.type==='Contract/Deal'){ctx.fillStyle=col;ctx.save();ctx.translate(n.s[0],n.s[1]);ctx.rotate(Math.PI/4);ctx.fillRect(-r*.8,-r*.8,r*1.6,r*1.6);ctx.restore()}
    else if(n.type==='Aggregate'){ctx.strokeStyle=col;ctx.lineWidth=1.2;ctx.beginPath();ctx.arc(n.s[0],n.s[1],r,0,6.283);ctx.stroke()}
    else if(n.type==='Country'){ctx.fillStyle=col;ctx.beginPath();ctx.arc(n.s[0],n.s[1],r,0,6.283);ctx.fill();ctx.shadowBlur=0;ctx.strokeStyle=C.bg;ctx.lineWidth=Math.max(1,r*.18);ctx.beginPath();ctx.arc(n.s[0],n.s[1],r*.55,0,6.283);ctx.stroke()}
    else{ctx.fillStyle=col;ctx.beginPath();ctx.arc(n.s[0],n.s[1],r,0,6.283);ctx.fill();ctx.shadowBlur=0;if(n.type==='Person'&&r>3){ctx.fillStyle=C.bg;ctx.beginPath();ctx.arc(n.s[0],n.s[1],r*.45,0,6.283);ctx.fill()}}
    ctx.shadowBlur=0;ctx.globalAlpha=1});
  // labels
  const placed=[];const lab=[];
  nodes.forEach(n=>{if(n.al<.25)return;const inF=focus&&(n===focus||nb.n1.has(n));
    const forced=inF||n===hoverN||n===pinN||hlType===n.type||(kase&&kase.set.has(n))||mode==='holdings';
    const byMode=labelMode==='all'||(labelMode==='key'&&n.rank<16);
    if(!forced&&!(byMode&&(!focus||(nb.n2.has(n)&&k>1.6))))return;
    lab.push({n,inF,forced,top:n===focus||n===pinN||n===hoverN})});
  // optional names (KEY / ALL) only go where there is room: forced names first, then by links; zoom in to reveal more
  if(mode==='holdings'&&tp<.8)lab.length=0;
  {const L0=W>900?232:0,R0=W>900?W-360:W,acc=[],boxes=[];ctx.font='11.5px '+sans;
   lab.sort((a,b)=>b.top-a.top||b.forced-a.forced||(a.n.rank??999)-(b.n.rank??999)).forEach(o=>{
    const n=o.n,r=nodeR(n),w=ctx.measureText(n.name.toUpperCase()).width,x=n.hs==='l'?n.s[0]-r-7-w:n.s[0]+r+7,b=[x,n.s[1]-8,w,13];
    if(o.forced){acc.push(o);boxes.push(b);return}
    if(x<L0||x+w>R0||n.s[1]<70||n.s[1]>H-60)return;
    if(boxes.some(q=>overlap(b,q)))return;boxes.push(b);acc.push(o)});
   lab.length=0;lab.push(...acc)}
  lab.sort((a,b)=>a.top-b.top);
  lab.forEach(({n,inF,forced,top})=>{
    const r=nodeR(n),big=n===focus;let name=n.name.toUpperCase();
    if((mode==='holdings'&&W<=900)&&name.length>17)name=name.slice(0,15).trim()+'…';
    let fs=big?'500 16px ':top?'500 14px ':inF||(kase&&kase.set.has(n))?'500 13px ':'11.5px ';
    let al=n.hs==='l'?'right':'left',x=al==='right'?n.s[0]-r-7:n.s[0]+r+7,y=n.s[1]+4;
    let fill=top?C.sel:`rgba(241,241,237,${Math.min(1,n.al)*(forced?.97:.75)*dimByType(n)})`;
    if(mode==='holdings'){const ref=focus||hoverN||pinN;const hotN=!ref||n===ref||ref.rels.some(q=>q.A===n||q.B===n);
      if(n.hs==='c'){fs='600 19px ';al='center';x=n.s[0];y=n.s[1]+r+22}
      else{fs=(W<=900?'500 12px ':'500 14px ');al=n.hs==='l'?'right':'left';x=n.hs==='l'?n.s[0]-r-10:n.s[0]+r+10}
      fill=hexA(TCOL[n.type],hotN?1:.3);if(n===focus||n===pinN)fill=C.sel}
    ctx.font=fs+sans;ctx.textAlign=al;let w=ctx.measureText(name).width;
    {const lim=al==='left'?(W>900?W-372:W-8)-x:al==='right'?x-(W>900?226:8):1e9;if(w>lim&&lim>40){while(name.length>4&&ctx.measureText(name+'…').width>lim)name=name.slice(0,-1);name=name.trim()+'…';w=ctx.measureText(name).width}}
    ctx.lineWidth=4;ctx.strokeStyle='rgba(8,8,8,.88)';ctx.lineJoin='round';ctx.strokeText(name,x,y);
    ctx.fillStyle=fill;ctx.fillText(name,x,y);
    let h=14;
    if(inF&&!big){const rr0=n.rels.find(q=>q.A===focus||q.B===focus);if(rr0){const v=relVal(rr0),t=relName(rr0.rel).slice(0,30);ctx.font='9.5px '+mono;ctx.fillStyle=C.fg2;ctx.strokeText(t,x,y+13);ctx.fillText(t,x,y+13);h=28;
      if(v){const tw=ctx.measureText(t+'  ').width;ctx.font='500 10.5px '+mono;ctx.fillStyle=C.signal;const vx=al==='right'?x-tw:x+tw;ctx.strokeText(v,vx,y+13);ctx.fillText(v,vx,y+13)}}}
    const bx=al==='right'?x-w:al==='center'?x-w/2:x;placed.push([bx,y-12,Math.max(w,120),h+2])});
  // value chips on the lines: only where there is room, never over a name
  chipHits=[];ctx.font='500 11.5px '+mono;ctx.textAlign='left';
  chips.sort((a,b)=>b.pri-a.pri||usd(b.r)-usd(a.r)).forEach(({r,p,pri})=>{const lb=relVal(r);const tw=ctx.measureText(lb).width+12,th=18;
    let spot=null;for(const t of [.5,.42,.58,.34,.66,.26,.74]){const m=qAt(p,t);const b=[m[0]-tw/2,m[1]-th/2,tw,th];if(!placed.some(q=>overlap(b,q))){spot=b;break}}
    if(!spot){if(pri<2)return;const m=qAt(p,.5);spot=[m[0]-tw/2,m[1]-th/2,tw,th]}
    placed.push(spot);chipHits.push({r,b:spot});const on=r===selRel||r===hoverR||r===pinR;
    ctx.fillStyle='rgba(8,8,8,.94)';rr(spot[0],spot[1],tw,th,3);ctx.fill();ctx.strokeStyle=on?C.sel:hexA(fcol(r),.9);ctx.lineWidth=1;ctx.setLineDash(r.st==='reported'?[2,2]:[]);ctx.stroke();ctx.setLineDash([]);
    ctx.fillStyle=on?C.sel:C.fg;ctx.fillText(lb,spot[0]+6,spot[1]+13)});
  // ring / cluster captions
  ctx.font='10px '+mono;ctx.textAlign='center';
  const capA=tween?Math.min(1,(performance.now()-tween.t0)/tween.dur):1;
  ringLabels.forEach(l=>{if(!focus||mode==='holdings'||l.skip)return;const w=rot(l.x,l.y,0);const s=[T.applyX(w[0]),T.applyY(w[1])];const t=l.l+' · '+l.n,tw=ctx.measureText(t).width;
    let b=[s[0]-tw/2,s[1]-10,tw,13];if(placed.some(q=>overlap(b,q))){const s2=[T.applyX(w[0]*1.18),T.applyY(w[1]*1.18)];s[0]=s2[0];s[1]=s2[1]}
    ctx.fillStyle=`rgba(232,255,0,${.75*capA})`;ctx.fillText(t,s[0],s[1])});
  clusterLabels.forEach(l=>{const w=rot(l.x,l.y,0);const s=[T.applyX(w[0]),T.applyY(w[1])];ctx.font=(l.txt?'11px ':'10px ')+mono;
    ctx.fillStyle=l.txt?hexA(l.col,.9*capA):hexA(TCOL[l.t]||C.fg2,(hlType&&hlType!==l.t?.3:.95)*capA);
    const txt=l.txt||((l.flow?FLOWLAB[l.t]:TLAB[l.t])+' · '+l.n);ctx.fillText(txt,s[0],s[1]);l.b=[s[0]-txt.length*3.3,s[1]-10,txt.length*6.6,14]});
  if(focus&&ringLabels.length&&mode!=='holdings'){ctx.strokeStyle='rgba(52,52,52,.6)';ctx.lineWidth=.5;ctx.setLineDash([1,4]);const c=focus.s;const R=ringLabels[0].R;[R,R+190].forEach(rr=>{ctx.beginPath();ctx.arc(c[0],c[1],rr*T.k,0,6.283);ctx.stroke()});ctx.setLineDash([])}
  updateMeta();
}
function arrow(a,b,col){const ang=Math.atan2(b[1]-a[1],b[0]-a[0]);ctx.fillStyle=col;ctx.beginPath();ctx.moveTo(b[0],b[1]);ctx.lineTo(b[0]-6*Math.cos(ang-.4),b[1]-6*Math.sin(ang-.4));ctx.lineTo(b[0]-6*Math.cos(ang+.4),b[1]-6*Math.sin(ang+.4));ctx.closePath();ctx.fill()}
function bar(a,b,col){const ang=Math.atan2(b[1]-a[1],b[0]-a[0])+Math.PI/2;ctx.strokeStyle=col;ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(b[0]-Math.cos(ang)*6,b[1]-Math.sin(ang)*6);ctx.lineTo(b[0]+Math.cos(ang)*6,b[1]+Math.sin(ang)*6);ctx.stroke()}
function hexA(h,a){if(!h||h[0]!=='#')return `rgba(148,148,148,${a})`;const v=parseInt(h.slice(1),16);return `rgba(${v>>16&255},${v>>8&255},${v&255},${a})`}

/* ---------- picking: value chips first, then points, then lines ---------- */
function pick(mx,my){
  for(let i=chipHits.length-1;i>=0;i--){const b=chipHits[i].b;if(mx>=b[0]-2&&mx<=b[0]+b[2]+2&&my>=b[1]-2&&my<=b[1]+b[3]+2)return{r:chipHits[i].r}}
  let best=null,bd=1e9;
  nodes.forEach(n=>{if(n.al<.3)return;const d=Math.hypot(n.s[0]-mx,n.s[1]-my)-nodeR(n);if(d<bd){bd=d;best=n}});
  if(bd<4)return{n:best};
  let br=null,brd=1e9;rels.forEach(r=>{if(Math.min(r.A.al,r.B.al,r.F.al)<.3)return;const p=curvePts(r);for(let i=0;i<14;i++){const a=qAt(p,i/14),b=qAt(p,(i+1)/14);const d=segD(mx,my,a,b);if(d<brd){brd=d;br=r}}});
  if(brd<7)return{r:br};
  if(bd<9)return{n:best};
  const cl=clusterLabels.find(l=>l.t&&l.b&&mx>=l.b[0]&&mx<=l.b[0]+l.b[2]&&my>=l.b[1]&&my<=l.b[1]+l.b[3]);if(cl)return{t:cl.t};
  return null}
function segD(px,py,a,b){const dx=b[0]-a[0],dy=b[1]-a[1];const t=Math.max(0,Math.min(1,((px-a[0])*dx+(py-a[1])*dy)/(dx*dx+dy*dy||1)));return Math.hypot(px-a[0]-t*dx,py-a[1]-t*dy)}
let mouse=[0,0];
cv.addEventListener('pointermove',e=>{const b=cv.getBoundingClientRect();mouse=[e.clientX-b.left,e.clientY-b.top];const h=pick(...mouse);hoverN=h&&h.n||null;hoverR=h&&h.r||null;cv.classList.toggle('hovering',!!h)});
cv.addEventListener('pointerleave',()=>{hoverN=hoverR=null});
let downAt=null;cv.addEventListener('pointerdown',e=>downAt=[e.clientX,e.clientY]);
cv.addEventListener('click',e=>{if(app.classList.contains('intro'))return endIntro();if(downAt&&Math.hypot(e.clientX-downAt[0],e.clientY-downAt[1])>5)return;const b=cv.getBoundingClientRect();const h=pick(e.clientX-b.left,e.clientY-b.top);
  if(h&&h.n)select(h.n);else if(h&&h.r)openRel(h.r,e.clientX-b.left,e.clientY-b.top);else if(h&&h.t){setHl(hlType===h.t?null:h.t)}
  else{hideInsp();if(focus&&mode==='holdings'){focus=null;apply(false);renderDossier()}else if(focus)clearFocus()}});

/* ---------- selection ---------- */
function select(n,fromPath){if(!n)return;if(n!==focus)photoTucked=false;selRel=null;hideInsp();pinN=null;if(!fromPath){const i=journey.indexOf(n);if(i>=0)journey=journey.slice(0,i+1);else journey.push(n)}
  if(mode==='holdings'&&HOLD.set.has(n)){focus=n;nb=neighborhood(n);apply(false);renderDossier();return}
  focus=n;kase=null;renderRail();
  if(mode==='clusters'||mode==='flow'||mode==='network'||mode==='holdings')mode='orbit';apply();renderDossier();try{history.replaceState(null,'','#'+(n.slug||n.id))}catch(_){}}
function clearFocus(){focus=null;selRel=null;if(mode==='orbit')mode='network';apply();renderDossier();try{history.replaceState(null,'',location.pathname)}catch(_){}}
function setMode(m){kase=m==='holdings'?CASES[0]:null;if(m==='clusters'||m==='flow'){focus=null;selRel=null}if(m==='orbit'&&!focus){focus=rank[0];journey=[focus]}if(m==='holdings')focus=null;mode=m;apply();renderDossier();renderRail()}
function openCase(c){hideInsp();selRel=null;focus=null;hlType=null;if(c.holdings){mode='holdings';kase=c}else{mode='network';kase=c}apply();renderDossier();renderRail()}
function setHl(t){hlType=t;renderRail()}
function renderModes(){document.querySelectorAll('#modes button').forEach(b=>{const on=b.dataset.mode===mode;b.setAttribute('aria-pressed',on);b.textContent=(on?'● ':'○ ')+b.dataset.mode.toUpperCase()})}
document.getElementById('modes').addEventListener('click',e=>{const b=e.target.closest('button');if(!b||b.disabled)return;const m=b.dataset.mode;if((m==='network'||m==='holdings')&&focus){focus=null;selRel=null}setMode(m)});
function renderCrumbs(){const el=document.getElementById('crumbs');const canBack=journey.length>1||focus||kase;document.getElementById('backbtn').hidden=!canBack;el.innerHTML=`<button data-w>WORLD</button>`+(kase?` / <span style="color:var(--signal)">CASE ${esc(kase.k)} · ${esc(kase.tab.toUpperCase())}</span>`:'')+(focus?` / <span style="color:var(--fg)">${esc(focus.name.toUpperCase())}</span>`:'')}
function goBack(){if(journey.length>1&&focus){journey.pop();return select(journey[journey.length-1],true)}if(focus){focus=null;journey=[];if(mode==='orbit')mode='network';apply();renderDossier();renderRail();return}if(kase){kase=null;mode='network';apply();renderDossier();renderRail();return}}
document.getElementById('backbtn').addEventListener('click',goBack);
document.getElementById('crumbs').addEventListener('click',e=>{if(e.target.closest('[data-w]')){kase=null;focus=null;journey=[];mode='network';apply();renderDossier();renderRail()}});
document.getElementById('names').addEventListener('click',e=>{const b=e.target.closest('[data-l]');if(!b)return;labelMode=b.dataset.l;document.querySelectorAll('#names [data-l]').forEach(x=>x.setAttribute('aria-pressed',x===b))});

/* ---------- relationship inspector ---------- */
const insp=document.getElementById('insp');
function plain(r){const A=`<button data-go="${esc(r.A.id)}" class="lk">${esc(r.A.name)}</button>`,B=`<button data-go="${esc(r.B.id)}" class="lk">${esc(r.B.name)}</button>`,v=x=>`<em>${esc(x)}</em>`,rl=(r.rel||'').toLowerCase();
  if(r.fam==='own'&&r.pct)return `${A} holds ${v((+r.pct).toFixed(2)+'%')} of ${B}${r.shares?`, ${(+r.shares).toLocaleString('en-US')} shares`:''}${r.amt?`, worth ${v(money(r.amt,r.cur))}`:''}${r.date?` as of ${esc(r.date)}`:''}.`;
  if(r.fam==='own'&&r.amt)return `${A}’s stake in ${B} was worth ${v(money(r.amt,r.cur))}${r.shares?` (${(+r.shares).toLocaleString('en-US')} shares)`:''}${r.date?` as of ${esc(r.date)}`:''}.`;
  if(r.t==='election')return `${A} spent ${v(money(r.amt,r.cur))} ${r.opp?'to defeat':'to elect'} ${B}${r.date?` (${esc(r.date.split(' · ')[0])})`:''}.`;
  if(r.fam==='money')return `${A} → ${B}: ${v(money(r.amt,r.cur))}, recorded as “${esc((r.rel||'').replace(/_/g,' '))}”.`;
  if(r.t==='benefit'&&/compensation/i.test(rl))return `${B} took home ${v(money(r.amt,r.cur))} in ${esc((r.rel||'').toLowerCase())} from ${A}${r.date?` (${esc(r.date)})`:''}.`;
  if(r.t==='benefit')return `${esc((r.rel||'').replace(/_/g,' '))}: ${B} ← ${A}${r.amt?`, ${v(money(r.amt,r.cur))}`:''}.`;
  if(rl==='includes')return `${A} includes ${r.amt?v(money(r.amt,r.cur))+' of ':''}${B}.`;
  return `${A} ${esc(rl.replace(/_/g,' '))} ${B}${r.amt?`, ${v(money(r.amt,r.cur))}`:''}.`}
function srcLine(x){const s=SRC[x.s];if(!s)return '';return `${x.ex?`<div class="ex">${esc(x.ex)}</div>`:''}<div class="tiny" style="display:flex;justify-content:space-between;gap:8px"><span>${esc(s.id)} · ${esc(s.tier.replace('_',' '))}${s.date?' · '+esc(s.date):''}</span></div><div style="margin:2px 0 8px;font-size:12px;color:var(--fg2)">${esc(s.pub||'')} — ${esc(s.title||'')}</div><a href="${esc(s.url)}" target="_blank" rel="noopener noreferrer">OPEN SOURCE →</a>`}
function openRel(r,x,y){selRel=r;
  const other=[r.A,r.B].filter(n=>n.type==='Person'||n.type==='Company'||n.type==='Fund/Asset Manager');
  insp.innerHTML=`<div style="display:flex;justify-content:space-between"><span class="tiny">RELATIONSHIP ${esc(r.id)}</span><button class="closebtn" id="ic">CLOSE ×</button></div>
  <p class="plain">${plain(r)}</p>
  ${r.ctx?`<p class="prose" style="font-size:12.5px;margin:4px 0 8px">${esc(r.ctx)}</p>`:''}
  <dl class="kv" style="grid-template-columns:72px 1fr;margin-top:8px">${r.date?`<dt>DATE</dt><dd>${esc(r.date)}</dd>`:''}
  <dt>STATUS</dt><dd>${r.st==='documented'?'● Confirmed by a primary source':'○ Reported by media or a data provider'}</dd></dl>
  ${other.length?`<div class="tiny" style="display:flex;gap:12px;flex-wrap:wrap;margin:4px 0 10px">${other.map(n=>`<button data-go="${esc(n.id)}" style="color:var(--fg)">OPEN ${esc(n.name.toUpperCase())} FILE →</button>`).join('')}</div>`:''}
  ${(r.ev||[]).slice(0,2).map(srcLine).join('<div style="height:10px"></div>')}`;
  insp.hidden=false;const bw=insp.offsetWidth,bh=insp.offsetHeight;insp.style.left=Math.max(16,Math.min(W-bw-16,x+14))+'px';insp.style.top=Math.max(90,Math.min(H-bh-70,y-20))+'px';insp.scrollTop=0;
  document.getElementById('ic').onclick=hideInsp}
function hideInsp(){insp.hidden=true;selRel=null}
insp.addEventListener('click',e=>{const g=e.target.closest('[data-go]');if(g){select(byId[g.dataset.go])}});

/* ---------- photo tab (slides out to the left of the dossier) ---------- */
const photo=document.getElementById('photo');let photoTucked=false;
const FLAGCODE={'USA':'US','United States':'US','U.S.':'US','Israel':'IL','Germany':'DE','Finland':'FI','Denmark':'DK','Slovakia':'SK','Greece':'GR','United Kingdom':'GB','UK':'GB','Italy':'IT','France':'FR','Netherlands':'NL','Spain':'ES','Czechia':'CZ','Czech Republic':'CZ','Romania':'RO','Belgium':'BE','Poland':'PL','Austria':'AT','Cyprus':'CY','Hungary':'HU','Bulgaria':'BG','Sweden':'SE','Norway':'NO','Portugal':'PT','Ireland':'IE','Croatia':'HR','Switzerland':'CH'};
function flagOf(n){if(n.flag)return n.flag;const s=n.name+' '+(n.country||'');if(/^U\.S\.|United States|USA/.test(n.name))return 'US';if(/Israel/.test(n.name))return 'IL';for(const k in FLAGCODE)if(new RegExp('\\b'+k.replace('.','\\.')+'\\b').test(n.name))return FLAGCODE[k];if(n.type==='Country'||n.type==='Government')return FLAGCODE[n.country]||null;return null}
function tri(cols,vertical){const n=cols.length;return cols.map((c,i)=>vertical?`<rect x="${i*90/n}" y="0" width="${90/n+.5}" height="60" fill="${c}"/>`:`<rect x="0" y="${i*60/n}" width="90" height="${60/n+.5}" fill="${c}"/>`).join('')}
function nordic(bg,c1,c2){return `<rect width="90" height="60" fill="${bg}"/><rect x="25" y="0" width="12" height="60" fill="${c1}"/><rect x="0" y="24" width="90" height="12" fill="${c1}"/>${c2?`<rect x="28" y="0" width="6" height="60" fill="${c2}"/><rect x="0" y="27" width="90" height="6" fill="${c2}"/>`:''}`}
function flagSVG(c){let b='';
  switch(c){
  case 'US':for(let i=0;i<13;i++)b+=`<rect y="${i*60/13}" width="90" height="${60/13+.2}" fill="${i%2?'#fff':'#b22234'}"/>`;b+=`<rect width="38" height="${60*7/13}" fill="#3c3b6e"/>`;for(let r=0;r<5;r++)for(let q=0;q<6;q++)b+=`<circle cx="${4+q*6}" cy="${3.6+r*6}" r="1.1" fill="#fff"/>`;break;
  case 'IL':b=`<rect width="90" height="60" fill="#fff"/><rect y="6" width="90" height="9" fill="#0038b8"/><rect y="45" width="90" height="9" fill="#0038b8"/><path d="M45 19 L54 34.6 L36 34.6Z M45 41 L36 25.4 L54 25.4Z" fill="none" stroke="#0038b8" stroke-width="2.4"/>`;break;
  case 'DE':b=tri(['#000','#dd0000','#ffce00']);break;case 'NL':b=tri(['#ae1c28','#fff','#21468b']);break;case 'AT':b=tri(['#ed2939','#fff','#ed2939']);break;
  case 'HU':b=tri(['#ce2939','#fff','#477050']);break;case 'BG':b=tri(['#fff','#00966e','#d62612']);break;case 'PL':b=tri(['#fff','#dc143c']);break;
  case 'IT':b=tri(['#009246','#fff','#ce2b37'],1);break;case 'FR':b=tri(['#0055a4','#fff','#ef4135'],1);break;case 'BE':b=tri(['#000','#fdda24','#ef3340'],1);break;
  case 'RO':b=tri(['#002b7f','#fcd116','#ce1126'],1);break;case 'IE':b=tri(['#169b62','#fff','#ff883e'],1);break;
  case 'ES':b=`<rect width="90" height="60" fill="#aa151b"/><rect y="15" width="90" height="30" fill="#f1bf00"/>`;break;
  case 'PT':b=`<rect width="90" height="60" fill="#da291c"/><rect width="36" height="60" fill="#046a38"/><circle cx="36" cy="30" r="10" fill="#ffe900"/>`;break;
  case 'FI':b=nordic('#fff','#002f6c');break;case 'DK':b=nordic('#c8102e','#fff');break;case 'SE':b=nordic('#006aa7','#fecc02');break;case 'NO':b=nordic('#ba0c2f','#fff','#00205b');break;
  case 'CH':b=`<rect width="90" height="60" fill="#da291c"/><rect x="39" y="14" width="12" height="32" fill="#fff"/><rect x="29" y="24" width="32" height="12" fill="#fff"/>`;break;
  case 'CZ':b=`<rect width="90" height="30" fill="#fff"/><rect y="30" width="90" height="30" fill="#d7141a"/><path d="M0 0 L45 30 L0 60Z" fill="#11457e"/>`;break;
  case 'SK':b=tri(['#fff','#0b4ea2','#ee1c25'])+`<path d="M22 14 h22 v18 q0 12 -11 16 q-11 -4 -11 -16z" fill="#ee1c25" stroke="#fff" stroke-width="1.5"/><rect x="31.5" y="18" width="3" height="24" fill="#fff"/><rect x="26" y="23" width="14" height="2.6" fill="#fff"/><rect x="24" y="29" width="18" height="2.6" fill="#fff"/>`;break;
  case 'GR':for(let i=0;i<9;i++)b+=`<rect y="${i*60/9}" width="90" height="${60/9+.2}" fill="${i%2?'#fff':'#0d5eaf'}"/>`;b+=`<rect width="33.3" height="33.3" fill="#0d5eaf"/><rect x="13.3" width="6.7" height="33.3" fill="#fff"/><rect y="13.3" width="33.3" height="6.7" fill="#fff"/>`;break;
  case 'GB':b=`<rect width="90" height="60" fill="#012169"/><path d="M0 0L90 60M90 0L0 60" stroke="#fff" stroke-width="12"/><path d="M0 0L90 60M90 0L0 60" stroke="#c8102e" stroke-width="4"/><path d="M45 0V60M0 30H90" stroke="#fff" stroke-width="18"/><path d="M45 0V60M0 30H90" stroke="#c8102e" stroke-width="10"/>`;break;
  case 'HR':b=tri(['#ff0000','#fff','#171796'])+`<rect x="38" y="18" width="14" height="18" fill="#fff" stroke="#ff0000"/>`;break;
  case 'CY':b=`<rect width="90" height="60" fill="#fff"/><path d="M28 26 q10 -8 24 -6 q8 1 12 -3 q-2 9 -14 12 q-12 3 -22 -3z" fill="#d57800"/><path d="M33 42 q12 6 24 0" stroke="#4e5b31" stroke-width="2.5" fill="none"/>`;break;
  default:return null}
  return `<svg viewBox="0 0 90 60" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">${b}</svg>`}
const SILHOUETTE=`<svg viewBox="0 0 70 90" xmlns="http://www.w3.org/2000/svg"><rect width="70" height="90" fill="#3a3934"/><circle cx="35" cy="34" r="15" fill="#5a5850"/><path d="M8 90 q4 -28 27 -28 q23 0 27 28z" fill="#5a5850"/><text x="35" y="41" text-anchor="middle" font-family="monospace" font-size="18" fill="#2a2926">?</text></svg>`;
const NOIMG=t=>`<svg viewBox="0 0 70 90" xmlns="http://www.w3.org/2000/svg"><rect width="70" height="90" fill="#33322d"/><path d="M0 90 L70 0" stroke="#45443e" stroke-width="1"/><path d="M0 0 L70 90" stroke="#45443e" stroke-width="1"/><rect x="10" y="34" width="50" height="22" fill="#33322d"/>${t.split("|").map((s,i)=>`<text x="35" y="${43+i*8}" text-anchor="middle" font-family="IBM Plex Mono,monospace" font-size="5.6" letter-spacing=".4" fill="#8a887e">${s}</text>`).join("")}</svg>`;
function renderPhoto(){const n=focus;if(!n||n.type==='Contract/Deal'||n.type==='Aggregate'||innerWidth<=900||!document.getElementById('index').hidden){photo.hidden=true;return}
  const img=D.images[n.id];let pic,cls='';
  if(img){pic=`<img src="${img.data||img}" alt="${esc(n.name)}">`;cls=n.type==='Person'||n.type==='Family'?'person':''}
  else if(n.type==='Person'||n.type==='Family')pic=SILHOUETTE;
  else{const f=(n.type==='Country'||n.type==='Government')&&flagSVG(flagOf(n));pic=f||NOIMG('NO IMAGE|ON FILE')}
  photo.innerHTML=`<button class="arrow" aria-label="${photoTucked?'Show':'Hide'} photo">‹</button><div class="card"><span class="clip"></span><div class="lab"><span>FILE Nº</span><span>${esc(n.id)}</span></div><div class="pic ${cls}">${pic}</div><div class="nm">${esc(n.name)}</div>${img&&img.credit?`<a class="cr" href="${esc(img.url||'#')}" target="_blank" rel="noopener noreferrer">${esc(img.credit)}</a>`:''}${n.type==='Person'?'<span class="stamp">CASE FILE</span>':''}</div>`;
  photo.classList.toggle('tucked',photoTucked);photo.hidden=false}
photo.addEventListener('click',e=>{if(e.target.closest('.arrow')){photoTucked=!photoTucked;photo.classList.toggle('tucked',photoTucked)}});

/* ---------- dossier ---------- */
const dos=document.getElementById('dossier');
const FAMLAB={own:'OWNERSHIP & STAKES',contract:'CONTRACTS & SUPPLY',money:'MONEY FLOWS',politics:'ELECTIONS & POLITICAL SPENDING',role:'ROLES, PAY & CONTROL',tech:'TECHNOLOGY'};
const short=(s,n=170)=>s&&s.length>n?s.slice(0,n-1).replace(/\s+\S*$/,'')+'…':s||'';
function relRow(r,n,ctx=true){const o=n?(r.A===n?r.B:r.A):null,out=n&&r.A===n;
  return `<button class="rel" data-rel="${esc(r.id)}"><span class="g" title="${r.st}">${r.st==='documented'?'●':'○'}</span><span class="who">${n?(out?'→ ':'← ')+esc(o.name):esc(r.A.name)+' → '+esc(r.B.name)}</span><span class="amt" style="color:var(--signal)">${esc(relVal(r))}</span><span class="what">${esc(relName(r.rel))}${r.date?' · '+esc(r.date):''}</span>${ctx&&r.ctx?`<span class="ctx">${esc(short(r.ctx))}</span>`:''}</button>`}
function holdRow(r,label){const p=r.pct?+r.pct:null;return `<button class="hold" data-rel="${esc(r.id)}"><span class="who">${esc(label)}</span><span class="v">${p!=null?p.toFixed(2)+'%':r.amt?esc(money(r.amt,r.cur)):'—'}</span><span class="bar"><i style="width:${p!=null?Math.min(100,p*5):0}%"></i></span><span class="sub">${[r.shares?(+r.shares).toLocaleString('en-US')+' SH':'',r.amt?money(r.amt,r.cur):'',r.date||'',r.st==='documented'?'● FILING':'○ REPORTED'].filter(Boolean).join(' · ')}</span></button>`}
function overview(){const nE=nodes.length,nR=rels.length+D.facts.length,nS=Object.keys(snodes).length,doc=rels.filter(r=>r.st==='documented').length;
  return `<div class="intro"><div class="idrow"><span class="tiny">INDEX / OVERVIEW</span><span class="tiny">BUILT ${esc(D.built)}</span></div>
    <h1>${esc(HEADLINE)}</h1>
    <p class="sub">${esc(SUBHEAD)}</p>
    <div class="stat3"><div><b>${nE}</b><span class="tiny">entities</span></div><div><b>${nR}</b><span class="tiny">facts</span></div><div><b>${nS}</b><span class="tiny">sources</span></div></div>
    <div class="moneystat"><b>${esc(money(TRACKED.total,'USD'))}</b><span class="tiny">money tracked, Oct 2023 to 2026</span>${TRACKED.parts.length?`<div class="blocks" role="img" aria-label="Breakdown of money tracked">${TRACKED.parts.map((p,i)=>`<i style="flex:${p.usd};background:${HEATB[i%8]}" title="${esc(p.label)}"></i>`).join('')}</div><ul class="mparts">${TRACKED.parts.map((p,i)=>`<li><span class="sw" style="background:${HEATB[i%8]}"></span><span class="l">${esc(p.label)}</span><span class="v">${esc(money(p.usd,'USD'))}</span></li>`).join('')}</ul>`:''}<span class="note">Money tied to the genocide in Gaza, the destruction of South Lebanon and the war on Iran: aid, arms sales and licences, war spending and lobby money. Each flow counted once; stakes, company revenue and whole US military budgets are left out. Euro and pound figures converted at ${esc(FXNOTE)}.</span></div>
    <p>Every point is a record, coloured by type: <span style="color:var(--c-company)">weapons manufacturers and companies</span>, <span style="color:var(--c-fund)">asset managers</span>, <span style="color:var(--c-country)">countries</span>, <span style="color:var(--c-gov)">governments</span>, <span style="color:var(--c-weapon)">weapon systems</span>, <span style="color:var(--c-org)">PACs and lobby groups</span> and <span style="color:var(--c-person)">people</span>. Lines are coloured by what connects them.</p>
    <p>Solid lines are confirmed by a primary source such as a filing or official record (${doc}). Dashed lines are reported by media or a data provider (${rels.length-doc}).</p>
    <p>Open a case file on the left, or click any point. Click a figure on a line to see what it means and where it comes from. Press <span class="mono" style="color:var(--signal)">/</span> to search.</p></div>
    <div class="sec"><h4><span>MOST CONNECTED</span><span>LINKS</span></h4>${rank.slice(0,10).map(n=>`<button class="rel" data-go="${esc(n.id)}"><span class="g" style="color:${TCOL[n.type]}">●</span><span class="who">${esc(n.name)}</span><span class="amt">${n.deg}</span><span class="what">${esc(TLAB[n.type]||n.type)}</span></button>`).join('')}</div>`}
function holdingsPanel(){const ab={'BlackRock':'BLK','Vanguard':'VGD','State Street':'SST','Fidelity / FMR':'FMR','Capital Group':'CAP','Longview Asset Management':'LVW'};
  const cols=HOLD.funds.filter(f=>f.held.length>1),others=HOLD.funds.filter(f=>f.held.length<=1);
  const cell=(f,c)=>{const r=f.held.find(x=>x.B===c);if(!r)return '<td><span style="display:block;padding:6px 3px;color:var(--fg3)">·</span></td>';const p=r.pct?+r.pct:null;
    return `<td><button data-rel="${esc(r.id)}" style="background:${p!=null?hexA(TCOL['Fund/Asset Manager'],Math.min(.75,.08+p/20)):'transparent'};color:${p!=null&&p>8?'#111':'var(--fg)'}" title="${esc(f.name)} in ${esc(c.name)}${r.amt?': '+esc(money(r.amt,r.cur)):''}">${p!=null?p.toFixed(1):'$'}${r.st==='documented'?'':'°'}</button></td>`};
  const tot=c=>{const ps=c.holders.filter(r=>r.pct);return ps.length?d3.sum(ps,r=>+r.pct):null};
  const val=f=>d3.sum(f.held,usd);
  return `<div class="case"><div class="idrow"><span class="tiny">CASE FILE 01 · HOLDINGS</span><button class="closebtn" id="dclose">CLOSE ×</button></div>
  <h1>Who owns the arms makers</h1>
  <p class="prose">${esc(CASES[0].blurb)}</p>
  <button class="rel" data-report="0" style="grid-template-columns:1fr;color:var(--signal)">OPEN THE FULL CASE FILE →</button>
  <div class="sec"><h4><span>% OF SHARES HELD</span><span>LATEST FILING</span></h4><div class="tblwrap"><table class="mx"><thead><tr><th>COMPANY</th>${cols.map(f=>`<th title="${esc(f.name)}">${esc(ab[f.name]||f.name.slice(0,3).toUpperCase())}</th>`).join('')}<th>TOTAL</th></tr></thead>
  <tbody>${HOLD.cos.map(c=>`<tr><td class="co"><button data-go="${esc(c.id)}">${esc(c.name)}</button></td>${cols.map(f=>cell(f,c)).join('')}<td class="tot">${tot(c)!=null?'≥'+tot(c).toFixed(1)+'%':'—'}</td></tr>`).join('')}</tbody></table></div>
  <p class="tiny" style="line-height:1.7;margin-top:8px">${others.map(f=>f.held.map(r=>`ALSO: <button data-rel="${esc(r.id)}" style="color:var(--fg)">${esc(f.name)} ${r.pct?(+r.pct).toFixed(2)+'%':''} OF ${esc(r.B.name)}</button><br>`).join('')).join('')}${cols.map(f=>`${esc(ab[f.name]||'')} ${esc(f.name)}`).join(' · ')}<br>° REPORTED BY A DATA PROVIDER, NOT YET A FILING · TOTAL = SUM OF KNOWN % ONLY</p></div>
  <div class="sec"><h4><span>STAKE VALUE ON RECORD</span><span>USD</span></h4>${HOLD.funds.map(f=>`<button class="hold" data-go="${esc(f.id)}"><span class="who">${esc(f.name)}</span><span class="v">${val(f)?esc(money(val(f),'USD')):'—'}</span><span class="sub">${f.held.length} COMPANIES · VALUE ON RECORD FOR ${f.held.filter(usd).length}</span></button>`).join('')}</div></div>`}
// one clear dollar figure per case: a curated total when the data has one, else the deduplicated money in the file
function caseTotal(c){const T=(D.case_totals||{})[c.rk];if(T&&T.usd)return T;const seen=new Set();let own=0,flow=0;
  [...(c.rels||[])].forEach(r=>{const v=usdx(r);if(!v)return;const k=Math.round(v/1e5)+'|'+r.B.id;if(seen.has(k))return;seen.add(k);if(r.fam==='own')own+=v;else flow+=v});
  if(c.holdings||(own&&!flow))return own?{usd:own,label:'value of the stakes on record'}:null;return flow?{usd:flow,label:'money on record in this file, each flow counted once'}:null}
function totalHTML(T){return T?`<div class="moneystat casetot"><b>${esc(money(T.usd,'USD'))}</b><span class="tiny">${esc(T.label||'')}${T.period?' · '+esc(T.period):''}</span>${(T.parts||[]).length?`<ul class="mparts">${T.parts.map((p,i)=>`<li><span class="sw" style="background:${BLOCK[i%BLOCK.length]}"></span><span>${esc(p.label)}</span><span class="v">${esc(money(p.usd,'USD'))}</span></li>`).join('')}</ul>`:''}${T.note?`<p class="note">${esc(T.note)}</p>`:''}</div>`:''}
function profitHTML(n){const P=(D.profits||{})[n.id];if(!P||!P.usd)return '';const src=P.src&&(SRC[P.src]?SRC[P.src].url:/^https?:/.test(P.src)?P.src:null);
  return `<div class="moneystat profit"><b>${esc(money(P.usd,'USD'))}</b><span class="tiny">${esc(P.metric||'profit since 2023')}${P.period?' · '+esc(P.period):''}</span>${P.note?`<p class="note">${esc(P.note)}${src?` <a href="${esc(src)}" target="_blank" rel="noopener noreferrer">source ↗</a>`:''}</p>`:src?`<p class="note"><a href="${esc(src)}" target="_blank" rel="noopener noreferrer">source ↗</a></p>`:''}</div>`}
function casePanel(c){const rs=[...c.rels].sort((a,b)=>usd(b)-usd(a)||(b.pct||0)-(a.pct||0));const doc=rs.filter(r=>r.st==='documented').length;
  const ents=[...c.set].sort((a,b)=>b.deg-a.deg);
  return `<div class="case"><div class="idrow"><span class="tiny">CASE FILE ${esc(c.k)}</span><button class="closebtn" id="dclose">CLOSE ×</button></div>
  <h1>${esc(c.title)}</h1>${totalHTML(caseTotal(c))}<p class="prose">${esc(c.blurb)}</p>
  <button class="rel" data-report="${CASES.indexOf(c)}" style="grid-template-columns:1fr;color:var(--signal)">OPEN THE FULL CASE FILE →</button>
  <div class="nums"><div><b class="dim">${rs.length}</b><span class="tiny">facts</span></div><div><b class="dim">${doc}</b><span class="tiny">primary</span></div><div><b class="dim">${rs.length-doc}</b><span class="tiny">reported</span></div></div>
  <div class="sec"><h4><span>IN THIS FILE</span><span>${ents.length}</span></h4><div class="chips">${ents.map(n=>`<button data-go="${esc(n.id)}"><i style="background:${TCOL[n.type]}"></i>${esc(n.name)}</button>`).join('')}</div></div>
  <div class="sec"><h4><span>THE RECORD</span><span>VALUE</span></h4>${rs.map(r=>relRow(r,null)).join('')}</div></div>`}
function politicsGroups(arr,n){const sup=arr.filter(r=>r.t==='election'&&!r.opp),opp=arr.filter(r=>r.t==='election'&&r.opp),rest=arr.filter(r=>r.t!=='election');
  const blk=(lab,col,a)=>a.length?`<div class="grp"><i style="background:${col}"></i>${lab} · ${a.length} · ${esc(money(d3.sum(a,usd),'USD'))}</div>${a.sort((x,y)=>usd(y)-usd(x)).map(r=>relRow(r,n)).join('')}`:'';
  return blk('SPENT TO ELECT',FCOL.politics,sup)+blk('SPENT TO DEFEAT',FCOL.oppose,opp)+(rest.length?`<div class="grp"><i style="background:${FCOL.politics}"></i>${FAMLAB.politics} · ${rest.length}</div>${rest.map(r=>relRow(r,n)).join('')}`:'')}
function renderDossier(){
  renderPhoto();if(PHM()){dos.classList.toggle('page',!!focus);phBack.hidden=!focus}
  if(!focus){dos.innerHTML=mode==='holdings'?holdingsPanel():kase?casePanel(kase):overview();if(innerWidth<=900){dos.classList.remove('full');dos.classList.toggle('collapsed',mode!=='holdings'&&!kase)}const d=document.getElementById('dclose');if(d)d.onclick=()=>{kase=null;mode='network';apply();renderDossier();renderRail()};return}
  const n=focus,rs=n.rels.filter(visR).sort((a,b)=>usd(b)-usd(a)||(b.pct||0)-(a.pct||0));
  const holders=rs.filter(r=>r.fam==='own'&&r.B===n&&(r.pct||r.amt)).sort((a,b)=>(b.pct||0)-(a.pct||0)||usd(b)-usd(a));
  const held=rs.filter(r=>r.fam==='own'&&r.A===n&&(r.pct||r.amt)).sort((a,b)=>(b.pct||0)-(a.pct||0)||usd(b)-usd(a));
  const out=d3.sum(rs.filter(r=>r.A===n&&r.fam!=='own'),usd),inn=d3.sum(rs.filter(r=>r.B===n&&r.fam!=='own'),usd),stake=d3.sum(held,usd);
  const knownPct=holders.filter(r=>r.pct).length?d3.sum(holders.filter(r=>r.pct),r=>+r.pct):null;
  const nums=[];if(stake)nums.push([money(stake,'USD'),'value of stakes held']);if(knownPct!=null)nums.push(['≥'+knownPct.toFixed(1)+'%','owned by tracked holders']);
  const elIn=rs.filter(r=>r.t==='election'&&r.B===n);if(elIn.length){const sp=d3.sum(elIn.filter(r=>!r.opp),usd),op=d3.sum(elIn.filter(r=>r.opp),usd);if(sp)nums.push([money(sp,'USD'),'spent to elect them']);if(op)nums.push([money(op,'USD'),'spent to defeat them']);}
  if(out)nums.push([money(out,'USD'),'paid or spent, in this file']);if(inn&&!elIn.length)nums.push([money(inn,'USD'),'received, in this file']);nums.push([String(rs.length),'documented links']);
  const cnt=d3.rollups([...nb.n1],v=>v.length,x=>x.type).sort((a,b)=>b[1]-a[1]);
  const fin=n.facts.filter(f=>f.amt).slice(0,6);
  const rest=rs.filter(r=>!holders.includes(r)&&!held.includes(r));
  const groups=d3.groups(rest,r=>r.fam);
  const rep=D.reports[n.id]||D.series.some(s=>s.case===n.id)||n.deg>=7;
  dos.innerHTML=`<div class="idrow"><span class="tiny">ENTITY / ${esc(n.type.toUpperCase())}</span><button class="closebtn" id="dclose">CLOSE ×</button></div>
  <div class="tiny" style="margin-top:4px;color:${TCOL[n.type]}">● ${esc(n.id)}</div><h1>${esc(n.name)}</h1>${(D.wanted||{})[n.id]?`<div class="wantedS"><b>WANTED</b><span>${esc(D.wanted[n.id].by||'')}</span></div>`:''}${profitHTML(n)}
  <dl class="kv">${n.role?`<dt>ROLE</dt><dd>${esc(n.role)}</dd>`:''}${n.country?`<dt>COUNTRY</dt><dd>${esc(n.country)}</dd>`:''}<dt>LINKS</dt><dd>${cnt.map(([t,c])=>`${c} ${esc((TLAB[t]||t).toLowerCase())}`).join(' · ')||'none visible'}</dd></dl>
  <div class="nums">${nums.slice(0,3).map(([a,b])=>`<div><b>${esc(a)}</b><span class="tiny">${esc(b)}</span></div>`).join('')}</div>
  ${(out||inn)?`<p class="tiny" style="line-height:1.6;margin:-4px 0 8px;text-transform:none;letter-spacing:.02em">“In this file” totals add up the payments, contracts and spending recorded in this database. They are not company-wide figures.</p>`:''}
  ${rep?`<button class="rel" data-report="e:${esc(n.id)}" style="grid-template-columns:1fr;color:var(--signal)">OPEN THE FULL CASE FILE →</button>`:''}${(()=>{const w=((D.arsenal||{}).weapons||[]).find(w=>w.entity===n.id||w.id===n.id);return w?`<button class="rel" data-arsw="${esc(w.id)}" style="grid-template-columns:1fr;color:#7fb4ff">OPEN IN THE ARSENAL →</button>`:''})()}
  <div class="sec"><h4><span>PROFILE</span><span>${n.profile_status==='documented'?'SOURCED':'DRAFT'}</span></h4>${n.profile?`<p class="prose">${esc(n.profile)}</p><div class="srcs">${(n.profile_src||[]).map((u,i)=>`<a href="${esc(u)}" target="_blank" rel="noopener noreferrer">SRC ${String(i+1).padStart(2,'0')} · ${esc(u.replace(/^https?:\/\/(www\.)?/,'').split('/')[0])}</a>`).join('')}</div>`:'<p class="prose" style="color:var(--fg3)">Profile being written.</p>'}</div>
  ${held.length?`<div class="sec"><h4><span>HOLDINGS IN THIS DATABASE</span><span>% OF COMPANY</span></h4>${held.map(r=>holdRow(r,r.B.name)).join('')}</div>`:''}
  ${holders.length?`<div class="sec"><h4><span>WHO OWNS ${esc(n.name.toUpperCase())}</span><span>% HELD</span></h4>${holders.map(r=>holdRow(r,r.A.name)).join('')}</div>`:''}
  ${fin.length?`<div class="sec"><h4><span>REPORTED FIGURES</span><span>COMPANY-WIDE</span></h4>${fin.map(f=>`<div style="display:flex;justify-content:space-between;gap:10px;padding:4px 0;font-size:12px"><span style="color:var(--fg2)">${esc(relName(f.rel))} · ${esc(f.date||'')}</span><span class="mono" style="color:var(--signal)">${esc(money(f.amt,f.cur))}</span></div>`).join('')}</div>`:''}
  ${groups.length?`<div class="sec"><h4><span>RELATIONSHIPS</span><span>VALUE</span></h4>${groups.map(([f,arr])=>f==='politics'?politicsGroups(arr,n):`<div class="grp"><i style="background:${FCOL[f]}"></i>${FAMLAB[f]} · ${arr.length}</div>${arr.map(r=>relRow(r,n)).join('')}`).join('')}</div>`:''}
  ${journey.length>1?`<div class="sec"><h4><span>YOUR PATH</span><span>${journey.length}</span></h4><div class="path">${journey.map((j,i)=>`${i?'→ ':''}<button data-path="${esc(j.id)}">${esc(j.name.toUpperCase())}</button>`).join('<br>')}</div></div>`:''}
  <div class="sec tiny" style="line-height:1.7">● CONFIRMED BY PRIMARY SOURCE<br>○ MEDIA / DATA PROVIDER ONLY</div>`;
  document.getElementById('dclose').onclick=()=>{if(mode==='holdings'){focus=null;apply(false);renderDossier()}else clearFocus()};
  dos.scrollTop=0;if(innerWidth<=900)dos.classList.remove('collapsed','full');
}
dos.addEventListener('click',e=>{const rp=e.target.closest('[data-report]');if(rp){const v=rp.dataset.report;return openReport(v.startsWith('e:')?{entity:byId[v.slice(2)]}:CASES[+v])}
  const aw=e.target.closest('[data-arsw]');if(aw)return openArsenal(aw.dataset.arsw);
  const g=e.target.closest('[data-go]');if(g)return select(byId[g.dataset.go]);const p=e.target.closest('[data-path]');if(p)return select(byId[p.dataset.path],true);
  const r=e.target.closest('[data-rel]');if(r){const rel=rels.find(x=>x.id===r.dataset.rel);const b=r.getBoundingClientRect();openRel(rel,innerWidth<=900?16:b.left-400,innerWidth<=900?120:b.top)}});
// hovering a row in the sidebar lights up that point or line on the map
dos.addEventListener('pointerover',e=>{const g=e.target.closest('[data-go]'),r=e.target.closest('[data-rel]');pinN=g?byId[g.dataset.go]||null:null;pinR=r?rels.find(x=>x.id===r.dataset.rel)||null:null});
dos.addEventListener('pointerleave',()=>{pinN=null;pinR=null});

/* ---------- case-file paper + report ---------- */
const pw=document.getElementById('paperwrap'),paper=document.getElementById('paper'),repEl=document.getElementById('report');
function renderPaper(){if(!kase||app.classList.contains('intro')){pw.hidden=true;return}
  paper.innerHTML=`<div class="k">CASE FILE Nº ${esc(kase.k)}</div><div class="t">${esc(kase.title)}</div><div class="lines"></div><div class="go">OPEN REPORT →</div><span class="edge">CASE ${esc(kase.k)}</span>`;pw.hidden=false}
paper.addEventListener('click',()=>kase&&openReport(kase));
// reports are duotone: ink and acid yellow, with yellow tones when a chart needs more colours
const INK='#141412',ACID='#e8ff00',OLIVE='#6f7a00',RED=ACID,PINK='#f2ff8a';
const PIECOL=['#141412','#e8ff00','#6f7a00','#f2ff8a','#3b3b35','#b9cc00','#8a877c','#d4e65c','#262622','#a4ad5a'];
const isLight=c=>{const h=c.replace('#','');const r=parseInt(h.slice(0,2),16),g=parseInt(h.slice(2,4),16),b=parseInt(h.slice(4,6),16);return .299*r+.587*g+.114*b>150};
const SANS='Hanken Grotesk,Helvetica,sans-serif';
const PHONE=()=>innerWidth<=600,CW=()=>PHONE()?360:680,WIDE=()=>PHONE()?' class="wide"':'';
// labels sit on their own line above each bar, so long names are never cut
function barSVG(rows,{fmt=v=>money(v,'USD'),w=CW(),col=INK}={}){if(!rows.length)return '';const bh=12,row=40,h=rows.length*row+4,mc=Math.floor((w-10)/6.6);
  const x=d3.scaleLinear().domain([0,d3.max(rows,r=>Math.abs(r.value))||1]).range([0,w-110]);
  return `<svg viewBox="0 0 ${w} ${h}" font-family="IBM Plex Mono,monospace" font-size="11">${rows.map((r,i)=>{const y=i*row,bw=Math.max(1,x(Math.abs(r.value))),lab=r.label.length>mc?r.label.slice(0,mc-1)+'…':r.label;return `<text x="0" y="${y+12}" fill="${INK}" font-family="${SANS}" font-size="12.5">${esc(lab)}</text><rect x="0" y="${y+18}" width="${bw}" height="${bh}" fill="${r.col||col}"/><text x="${bw+6}" y="${y+28}" fill="${INK}">${esc(fmt(r.value))}</text>`}).join('')}</svg>`}
// donut with a legend that lists every share; text wraps by row, never clipped
function pieSVG(rows,{fmt=v=>money(v,'USD'),w=680}={}){rows=rows.filter(r=>r.value>0);if(!rows.length)return '';if(PHONE())return piePhone(rows,fmt);const tot=d3.sum(rows,r=>r.value),R=104,cx=R+8,cy=R+8,lx=2*R+44,lh=22,h=Math.max(2*R+16,rows.length*lh+10);
  const arcs=d3.pie().sort(null).value(r=>r.value)(rows),arc=d3.arc().innerRadius(R*.56).outerRadius(R).padAngle(.006);
  const mc=Math.floor((w-lx-120)/6.6);
  return `<svg viewBox="0 0 ${w} ${h}" font-family="IBM Plex Mono,monospace" font-size="11"><g transform="translate(${cx},${cy})">${arcs.map((a,i)=>`<path d="${arc(a)}" fill="${rows[i].col||PIECOL[i%PIECOL.length]}"/>`).join('')}<text text-anchor="middle" y="-2" font-size="17" fill="${INK}" font-family="${SANS}" font-weight="500">${esc(fmt(tot))}</text><text text-anchor="middle" y="15" font-size="9" letter-spacing="1" fill="#5d5b54">TOTAL</text></g>${rows.map((r,i)=>{const y=6+i*lh,lab=r.label.length>mc?r.label.slice(0,mc-1)+'…':r.label;return `<rect x="${lx}" y="${y}" width="11" height="11" fill="${r.col||PIECOL[i%PIECOL.length]}"/><text x="${lx+18}" y="${y+10}" fill="${INK}" font-family="${SANS}" font-size="12.5">${esc(lab)}</text><text x="${w}" y="${y+10}" text-anchor="end" fill="${INK}">${esc(fmt(r.value))} · ${(100*r.value/tot).toFixed(r.value/tot<.01?1:0)}%</text>`}).join('')}</svg>`}
// phones: donut on top, legend underneath at full width
function piePhone(rows,fmt){const w=360,tot=d3.sum(rows,r=>r.value),R=92,cx=w/2,cy=R+6,ly=2*R+28,lh=24,h=ly+rows.length*lh,mc=Math.floor((w-130)/6.6);
  const arcs=d3.pie().sort(null).value(r=>r.value)(rows),arc=d3.arc().innerRadius(R*.56).outerRadius(R).padAngle(.006);
  return `<svg viewBox="0 0 ${w} ${h}" font-family="IBM Plex Mono,monospace" font-size="11"><g transform="translate(${cx},${cy})">${arcs.map((a,i)=>`<path d="${arc(a)}" fill="${rows[i].col||PIECOL[i%PIECOL.length]}"/>`).join('')}<text text-anchor="middle" y="-2" font-size="17" fill="${INK}" font-family="${SANS}" font-weight="500">${esc(fmt(tot))}</text><text text-anchor="middle" y="15" font-size="9" letter-spacing="1" fill="#5d5b54">TOTAL</text></g>${rows.map((r,i)=>{const y=ly+i*lh,lab=r.label.length>mc?r.label.slice(0,mc-1)+'…':r.label;return `<rect x="0" y="${y}" width="11" height="11" fill="${r.col||PIECOL[i%PIECOL.length]}"/><text x="18" y="${y+10}" fill="${INK}" font-family="${SANS}" font-size="12.5">${esc(lab)}</text><text x="${w}" y="${y+10}" text-anchor="end" fill="${INK}">${esc(fmt(r.value))} · ${(100*r.value/tot).toFixed(r.value/tot<.01?1:0)}%</text>`}).join('')}</svg>`}
// colour-block treemap: area is money; names inside when they fit, listed below otherwise
function blocksSVG(rows,{fmt=v=>money(v,'USD'),w=CW(),h=PHONE()?300:260}={}){rows=rows.filter(r=>r.value>0);if(!rows.length)return '';
  const root=d3.hierarchy({children:rows}).sum(d=>d.value||0).sort((a,b)=>b.value-a.value);d3.treemap().size([w,h]).paddingInner(3).tile(d3.treemapSquarify.ratio(1.4))(root);
  const cols=PIECOL,light=isLight;
  return `<svg viewBox="0 0 ${w} ${h}" font-family="IBM Plex Mono,monospace">${root.leaves().map((l,i)=>{const c=l.data.col||cols[i%cols.length],bw=l.x1-l.x0,bh=l.y1-l.y0,fg=light(c)?INK:'#f1efe6',mc=Math.floor((bw-12)/6.4),fit=bw>70&&bh>38;
    return `<rect x="${l.x0}" y="${l.y0}" width="${bw}" height="${bh}" fill="${c}"/>${fit?`<text x="${l.x0+7}" y="${l.y0+17}" fill="${fg}" font-size="${bw>200&&bh>70?17:12}" font-family="${SANS}" font-weight="500">${esc(fmt(l.data.value))}</text><text x="${l.x0+7}" y="${l.y0+32}" fill="${fg}" font-size="9.5" letter-spacing=".4">${esc(l.data.label.length>mc?l.data.label.slice(0,mc-1)+'…':l.data.label).toUpperCase()}</text>`:''}`}).join('')}</svg>`+
  `<div class="bkey">${root.leaves().map((l,i)=>`<span><i style="background:${l.data.col||cols[i%cols.length]}"></i>${esc(l.data.label)} <b>${esc(fmt(l.data.value))}</b></span>`).join('')}</div>`}
function columnSVG(s,w=CW()){const pts=s.points||[];if(!pts.length)return '';const h=240,pl=60,pb=30,y=d3.scaleLinear().domain([0,d3.max(pts,p=>p.y)||1]).nice().range([h-pb,14]),bw=(w-pl-10)/pts.length;
  const fmt=v=>/^(USD|EUR|GBP|ILS)$/.test(s.unit)?money(v,s.unit):s.unit==='%'?v+'%':(+v).toLocaleString('en-US');
  return `<svg viewBox="0 0 ${w} ${h}" font-family="IBM Plex Mono,monospace" font-size="10">${y.ticks(4).map(t=>`<line x1="${pl}" x2="${w}" y1="${y(t)}" y2="${y(t)}" stroke="rgba(20,20,18,.18)"/><text x="${pl-6}" y="${y(t)+3}" text-anchor="end" fill="#5d5b54">${esc(fmt(t))}</text>`).join('')}${pts.map((p,i)=>`<rect x="${pl+i*bw+bw*.15}" y="${y(p.y)}" width="${bw*.7}" height="${h-pb-y(p.y)}" fill="${i===pts.length-1?OLIVE:INK}"/><text x="${pl+i*bw+bw/2}" y="${h-pb+14}" text-anchor="middle" fill="${INK}">${esc(String(p.x).split(' ')[0])}</text>`).join('')}</svg>`}
function seriesChart(s,ci=0){const fmt=v=>s.unit==='%'?v+'%':/^(USD|EUR|GBP|ILS)$/.test(s.unit)?money(v,s.unit):(+v).toLocaleString('en-US');const rows=(s.points||[]).map(p=>({label:String(p.x),value:+p.y}));
  let k=s.kind||(rows.length>8?'bar':'col');if(k==='bar'&&s.unit!=='%'&&rows.length>=3&&rows.length<=10&&/gift|donat|net worth|assets under|aum\b/i.test(s.label))k='blocks';
  return k==='pie'?pieSVG(rows,{fmt}):k==='blocks'?blocksSVG(rows,{fmt}):k==='bar'?barSVG(rows,{fmt,col:[INK,OLIVE,'#3b3b35'][ci%3]}):columnSVG(s)}
function chainHTML(ch){return `<ol class="chain">${ch.map((s,i)=>`<li><span class="n">${String(i+1).padStart(2,'0')}</span><div><h4>${esc(s.step||s.h||'')}</h4>${s.what?`<p>${esc(s.what)}</p>`:''}<div class="chips">${[].concat(s.systems||[]).map(x=>`<span class="sys">${esc(x)}</span>`).join('')}${[].concat(s.who||[]).map(x=>`<span class="who">${esc(x)}</span>`).join('')}</div></div></li>`).join('')}</ol>`}
function picOf(n){const img=D.images[n.id],src=img&&(img.data||img);
  if(src)return `<img src="${src}" alt="${esc(n.name)}"${n.type==='Person'||n.type==='Family'?' class="person"':''}>`;
  if(n.type==='Person'||n.type==='Family')return SILHOUETTE;const f=(n.type==='Country'||n.type==='Government')&&flagSVG(flagOf(n));return f||NOIMG('NO IMAGE|ON FILE')}
function openReport(c){hideInsp();const ent=c.entity;const title=ent?ent.name:c.title,k=ent?ent.id:c.k;
  const rs=ent?ent.rels.slice():[...(c.rels||[])];rs.sort((a,b)=>usdx(b)-usdx(a)||(b.pct||0)-(a.pct||0));
  const doc=rs.filter(r=>r.st==='documented').length,srcs=new Map();rs.forEach(r=>(r.ev||[]).forEach(x=>{const s=SRC[x.s];if(s)srcs.set(s.id,s)}));
  const R=D.reports[ent?ent.id:'case'+c.rk]||{};
  (R.sections||[]).forEach(s=>(s.src||[]).forEach(i=>{const x=SRC[i];if(x)srcs.set(x.id,x)}));
  const fn=[...srcs.keys()],fnum=i=>fn.indexOf(i)+1;
  let charts='';const H=(a,b)=>`<h2><span>${esc(a)}</span><span>${esc(b||'')}</span></h2>`;
  if(c.holdings){const keys=HOLD.funds.filter(f=>f.held.length>1),cols=PIECOL;
    const rows=HOLD.cos.map(co=>{const o={label:co.name};keys.forEach(f=>{const r=f.held.find(x=>x.B===co);o[f.name]=r&&r.pct?+r.pct:0});return o});
    charts+=H('SHARE OF EACH COMPANY HELD BY THE MANAGERS','% OF SHARES')+`<div class="chart">${stackSVG(rows,keys.map(f=>f.name),cols)}</div>`;
    charts+=H('STAKE VALUE ON RECORD','USD')+`<div class="chart">${blocksSVG(HOLD.funds.map(f=>({label:f.name,value:d3.sum(f.held,usdx)})).filter(x=>x.value))}</div>`}
  else if(!c.special){const el=rs.filter(r=>r.t==='election'&&r.amt);
    if(el.length>2)charts+=H('WHO THE MONEY TARGETED','USD')+`<div class="chart">${divergingSVG(el.map(r=>({label:r.B.name,value:usdx(r),opp:r.opp})).sort((a,b)=>b.value-a.value))}</div>`;
    const ex=rs.filter(r=>r.t==='money'&&/exports_to|licensed_arms|dual_use/i.test(r.rel||'')&&usdx(r));
    if(ex.length>3){const by=d3.rollups(ex,v=>d3.max(v,usdx),r=>r.A.name).map(([l,v])=>({label:l,value:v})).sort((a,b)=>b.value-a.value);charts+=H('ARMS LICENCES AND EXPORTS TO ISRAEL, LARGEST FIGURE PER COUNTRY','USD')+`<div class="chart">${pieSVG(by)}</div>`}
    const seenA=new Set(),am=rs.filter(r=>{if(!usdx(r)||r.t==='election')return false;const k=Math.round(usdx(r)/1e5)+'|'+r.B.id;if(seenA.has(k))return false;seenA.add(k);return true});if(am.length)charts+=H('MONEY ON RECORD','USD')+`<div class="chart">${barSVG(am.slice(0,16).map(r=>({label:(ent?(r.A===ent?'→ '+r.B.name:'← '+r.A.name)+' · '+relName(r.rel).toLowerCase():r.A.name+' → '+r.B.name),value:usdx(r),col:r.st==='documented'?INK:'#8a877c'})))}</div>`;
    const pc=rs.filter(r=>r.pct&&r.fam==='own');if(pc.length)charts+=H('STAKES ON RECORD','% OF COMPANY')+`<div class="chart">${barSVG(pc.map(r=>({label:r.A.name+' in '+r.B.name,value:+r.pct})),{fmt:v=>(+v).toFixed(2)+'%',col:OLIVE})}</div>`}
  D.series.filter(s=>s.case&&s.case===(ent?ent.id:c.rk)).forEach((s,ci)=>{charts+=H(s.label.toUpperCase(),s.unit)+`<div class="chart">${seriesChart(s,ci)}</div>${s.src?`<p class="cap">Source: ${esc([].concat(s.src).join(', ').replace(/\s*\(via data\.json\)/g,''))}</p>`:''}`});
  const figs=(R.figures||[]).map(f=>[f.value,f.label]);
  {const sk=new Set();rs.filter(r=>{const k=Math.round(usdx(r)/1e5)+'|'+r.B.id;if(!usdx(r)||sk.has(k))return false;sk.add(k);return true}).slice(0,Math.max(0,4-figs.length)).forEach(r=>figs.push([money(usdx(r),'USD'),(ent?(r.A===ent?r.B.name:r.A.name):r.B.name)+' · '+relName(r.rel).toLowerCase().slice(0,60)]))}
  // related people and companies with photos, used to break up long reading
  const pics=[];{const seen=new Set([ent&&ent.id]);rs.forEach(r=>[r.A,r.B].forEach(n=>{if(!n||seen.has(n.id))return;seen.add(n.id);if(D.images[n.id])pics.push(n)}))}
  const secs=R.sections||[],qs=(R.quotes||[]).slice(),words=secs.reduce((t,s)=>t+[].concat(s.body||s.p||[]).join(' ').length,0);
  const figHTML=n=>{const im=D.images[n.id];return `<figure class="inter rv"><div class="ph">${picOf(n)}</div><figcaption><b data-go="${esc(n.id)}">${esc(n.name)}</b>${n.role?`<span>${esc(n.role)}</span>`:''}${im&&im.credit?`<a class="cr" href="${esc(im.url||'#')}" target="_blank" rel="noopener noreferrer">${esc(im.credit)}</a>`:''}</figcaption></figure>`};
  const qHTML=q=>`<blockquote class="rv"><p>${esc(q.text||q.q||'')}</p>${q.who?`<cite>${esc(q.who)}</cite>`:''}</blockquote>`;
  // a photo break shows someone or something named in the section right below it
  const usedPic=new Set([ent&&ent.id]);const allTxt=secs.map(x=>(x.h||'')+' '+[].concat(x.body||x.p||[]).join(' ')).join(' ')+' '+(R.dek||'');
  const PK=PICKEYS.filter(([k,n,al])=>!al||new RegExp('\\b'+n.name.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+'\\b').test(allTxt));const picFor=sx=>{const txt=((sx.h||'')+' '+[].concat(sx.body||sx.p||[]).join(' '));let best=null,bi=1e9;
    PK.forEach(([key,n])=>{if(usedPic.has(n.id))return;const m=txt.search(key);if(m>=0&&m<bi){bi=m;best=n}});if(best)usedPic.add(best.id);return best};
  let pi=0;const nIntro=secs.filter(x=>x.intro).length;const sec=secs.map((s,i)=>{const body=[].concat(s.body||s.p||[]);
    let o=`<section class="rs rv${s.intro?' introsec':''}"><div class="sn">${s.intro?'THE SUBJECT':'§'+String(i+1-nIntro).padStart(2,'0')}</div>${s.h?`<h3>${esc(s.h)}</h3>`:''}${body.map((p,j)=>`<p${i===0&&j===0?' class="dc"':''}>${esc(p)}</p>`).join('')}${(s.src||[]).length?`<p class="fn">${s.src.filter(i=>SRC[i]).map(i=>`<a href="#rs-${esc(i)}">[${fnum(i)}]</a>`).join(' ')}</p>`:''}</section>`;
    if(i<secs.length-1){let added=false;if(i%2===0&&qs.length){o+=qHTML(qs.shift());added=true}
      const nx=picFor(secs[i+1]);if(nx){o+=figHTML(nx);added=true}
      if(!added)o+=`<div class="brk" aria-hidden="true"><span>${ent?esc(k):'CF-'+esc(k)}</span></div>`}
    return o}).join('')+qs.map(qHTML).join('');
  const thin=secs.length<3||words<1500;
  const pend=`<div class="pending">THIS REPORT IS STILL IN PROGRESS. ${secs.length?'WHAT IS FILED SO FAR IS SHOWN ABOVE; ':''}THE RECORD BELOW IS DRAWN LIVE FROM THE DATABASE.</div>`;
  const status=ent?(ent.profile_status==='documented'?'SOURCED':'DRAFT'):(secs.length?(thin?'REPORT IN PROGRESS':'REPORT FILED'):'RECORD ONLY');
  const fileNo=ent?k:'CF-'+k,want=ent&&WANTED[ent.id];
  repEl.innerHTML=`<button class="x" id="rx">CLOSE ×</button><article class="doc">
   <div class="spine" aria-hidden="true"><div><b>${esc(fileNo)}</b><span>BL00D.MONEY · RECORD OF COMPLICITY</span></div></div>
   <div class="hd"><span>BL00D.MONEY · INVESTIGATION FILE</span><button class="dl" id="rdl">DOWNLOAD REPORT ↓</button></div>
   <div class="dossier${ent?' withpic':''}"><span class="tabno">No. ${esc(fileNo)}</span>${ent?`<div class="dpic"><span class="clip"></span><div class="pic">${picOf(ent)}</div>${D.images[ent.id]&&D.images[ent.id].credit?`<a class="cr" href="${esc(D.images[ent.id].url||'#')}" target="_blank" rel="noopener noreferrer">${esc(D.images[ent.id].credit)}</a>`:''}</div>`:''}
    <dl class="fields"><div class="wide"><dt>SUBJECT</dt><dd>${esc(title)}</dd></div><div><dt>FILE TYPE</dt><dd>${ent?esc(ent.type.toUpperCase()):'CASE FILE'}</dd></div><div><dt>STATUS</dt><dd>${status}</dd></div><div><dt>RECORD</dt><dd>${rs.length} FACTS · ${doc} PRIMARY</dd></div><div><dt>SOURCES</dt><dd>${srcs.size}</dd></div><div><dt>FILED</dt><dd>${esc(D.built)}</dd></div>${ent&&ent.country?`<div><dt>COUNTRY</dt><dd>${esc(ent.country.toUpperCase())}</dd></div>`:'<div><dt>ACCESS</dt><dd>PUBLIC RECORD</dd></div>'}</dl>${want?wantedHTML(want):''}</div>
   <h1><mark>${esc(R.title||title)}</mark></h1><p class="dek">${esc(R.dek||(ent?(ent.profile||''):c.blurb))}</p>${R.lead?`<blockquote class="lead"><p>“${esc(R.lead.text)}”</p>${R.lead.who?`<cite>${esc(R.lead.who)}</cite>`:''}</blockquote>`:''}
   ${figs.length?`<div class="kf rv">${figs.slice(0,4).map(([v,l])=>`<div><b>${esc(v)}</b><span>${esc(l)}</span></div>`).join('')}</div>`:''}
   ${R.chain?H('THE KILL CHAIN, STEP BY STEP',R.chain.length+' STEPS')+chainHTML(R.chain):''}
   ${charts}
   ${sec?H('THE INVESTIGATION',thin?'IN PROGRESS':'REPORT')+sec+(thin?pend:''):H('THE INVESTIGATION','IN PROGRESS')+pend}
   ${rs.length?H('THE RECORD',rs.length)+recordTable(rs):''}
   ${H('SOURCES',srcs.size)}<ol class="src">${[...srcs.values()].map(s=>`<li id="rs-${esc(s.id)}">${esc(s.pub||'')} · <a href="${esc(s.url)}" target="_blank" rel="noopener noreferrer">${esc(s.title||s.url)}</a>${s.tier?' · '+esc(String(s.tier).replace('_',' ')):''}</li>`).join('')}</ol>
   <div class="endmark">END OF FILE · ${esc(fileNo)}</div>
  </article>`;
  repEl.classList.toggle('solid',!document.getElementById('caselist').hidden);repEl.hidden=false;repEl.scrollTop=0;document.getElementById('rx').onclick=()=>{repEl.hidden=true};
  document.getElementById('rdl').onclick=()=>downloadReport(fileNo,R.title||title);
  repEl.querySelectorAll('.chart').forEach(x=>x.classList.add('rv'));
  revealIn(repEl)}
// sections, charts and figures ease in as they scroll into view; without IntersectionObserver they are simply shown
// name patterns for every node with a photo: full name, plus a distinctive surname or brand word
const PICKEYS=(()=>{const out=[],STOP=/^(United|Israel|Israeli|Government|General|American|National|International|Friends|Ministry|Department|Federal|State|Bank|Group|Capital|Advanced|Systems|Global|Republic|Kingdom|Elbit|Fix|For|New|The|Defend|Sensible)$/i,first=new Map();
  nodes.forEach(n=>{if(!D.images[n.id])return;const w=n.name.split(/[\s,(]+/)[0];first.set(w,(first.get(w)||0)+1)});
  const rx=s=>new RegExp('\\b'+s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+'\\b');
  const last=new Map();nodes.forEach(n=>{if(n.type!=='Person')return;const p=n.name.split(/[\s,(]+/).filter(Boolean);const l=p[p.length-1];last.set(l,(last.get(l)||0)+1)});
  nodes.forEach(n=>{if(!D.images[n.id])return;out.push([rx(n.name),n,false]);const p=n.name.split(/[\s,(]+/).filter(Boolean);
    // a surname alone only counts once the full name has appeared in the same report (see picFor)
    if((n.type==='Person')&&p.length>1&&p[p.length-1].length>3&&last.get(p[p.length-1])===1)out.push([rx(p[p.length-1]),n,true]);
    const ac=n.name.match(/\(([A-Z]{2,5})\)/);if(ac)out.unshift([rx(ac[1]),n,false]);
    else if(n.type!=='Person'&&p.length>1&&p[0].length>4&&first.get(p[0])===1&&!STOP.test(p[0]))out.push([rx(p[0]),n])});return out})();
function revealIn(root){const els=root.querySelectorAll('.rv');if(!('IntersectionObserver' in window)||matchMedia('(prefers-reduced-motion: reduce)').matches){els.forEach(e=>e.classList.add('in'));return}
  const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{root,rootMargin:'0px 0px 35% 0px'});els.forEach(e=>io.observe(e));
  // fast scrolling can outrun the observer: anything at or above the fold is revealed at once, so the paper never shows blank
  let tk=0;const sweep=()=>{tk=0;const lim=root.getBoundingClientRect().bottom+root.clientHeight*.5;root.querySelectorAll('.rv:not(.in)').forEach(e=>{if(e.getBoundingClientRect().top<lim){e.classList.add('in');io.unobserve(e)}})};
  if(root._sweep)root.removeEventListener('scroll',root._sweep);root._sweep=()=>{if(!tk)tk=requestAnimationFrame(sweep)};root.addEventListener('scroll',root._sweep,{passive:true})}
// saves the open report as one self-contained HTML file (blocked inside the preview viewer, works on the live site)
function downloadReport(no,title){try{const css=[...document.querySelectorAll('style')].map(x=>x.textContent).join('\n');const d=repEl.querySelector('.doc').cloneNode(true);d.querySelectorAll('.rv').forEach(e=>e.classList.add('in'));d.querySelector('#rdl')&&d.querySelector('#rdl').remove();d.querySelectorAll('img').forEach(i=>i.setAttribute('src',i.src));
  const html=`<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${esc(no)} · ${esc(title)} · BL00D.MONEY</title><style>${css}\nhtml,body{height:auto;overflow:auto}#report{position:static;background:#080808}</style></head><body><div id="report">${d.outerHTML}</div></body></html>`;
  const fname=`bl00d-money-${String(no).toLowerCase()}.html`,blob=new Blob([html],{type:'text/html'});
  // inside the claude.ai viewer saves go through its downloads capability; on the live site a plain blob link works
  const plain=()=>{const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=fname;document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove()},1500)};
  const btn=document.getElementById('rdl');
  if(window.claude&&window.claude.use){window.claude.use('downloads').then(dl=>{if(!dl)return plain();dl.save({filename:fname,data:blob}).catch(e=>{if(btn&&e&&e.code!=='declined'){btn.textContent='DOWNLOAD UNAVAILABLE HERE';btn.disabled=true}})}).catch(plain)}else plain()}catch(_){}}
const WANTED=D.wanted||{};
function wantedHTML(w){return `<div class="wanted" role="note"><b>WANTED</b><span>${esc(w.by||'')}</span><i>${esc(w.charge||'')}</i></div>`}
function divergingSVG(rows,w=680){if(!rows.length)return '';const bh=20,gap=8,h=rows.length*(bh+gap)+28,mid=w/2,mx=d3.max(rows,r=>r.value)||1,x=d3.scaleLinear().domain([0,mx]).range([0,mid-150]);
  return `<svg${WIDE()} viewBox="0 0 ${w} ${h}" font-family="IBM Plex Mono,monospace" font-size="11"><text x="${mid-10}" y="12" text-anchor="end" fill="${INK}" font-size="10" letter-spacing="1">◄ SPENT TO DEFEAT</text><text x="${mid+10}" y="12" fill="${INK}" font-size="10" letter-spacing="1">SPENT TO ELECT ►</text><line x1="${mid}" x2="${mid}" y1="18" y2="${h}" stroke="${INK}"/>${rows.map((r,i)=>{const y=22+i*(bh+gap),bw=Math.max(1,x(r.value));return r.opp?`<rect x="${mid-bw}" y="${y}" width="${bw}" height="${bh}" fill="${ACID}" stroke="${INK}" stroke-width=".8"/><text x="${mid-bw-6}" y="${y+14}" text-anchor="end" fill="${INK}" font-family="Hanken Grotesk,Helvetica,sans-serif" font-size="12">${esc(r.label)} · ${esc(money(r.value,'USD'))}</text>`:`<rect x="${mid}" y="${y}" width="${bw}" height="${bh}" fill="${INK}"/><text x="${mid+bw+6}" y="${y+14}" fill="${INK}" font-family="Hanken Grotesk,Helvetica,sans-serif" font-size="12">${esc(r.label)} · ${esc(money(r.value,'USD'))}</text>`}).join('')}</svg>`}
function stackSVG(rows,keys,cols,w=680){const lw=150,bh=22,gap=10,h=rows.length*(bh+gap)+34,mx=d3.max(rows,r=>d3.sum(keys,k=>r[k]||0))||1,x=d3.scaleLinear().domain([0,Math.max(mx,40)]).range([0,w-lw-70]);
  let lg=keys.map((k,i)=>`<rect x="${lw+i*100}" y="0" width="10" height="10" fill="${cols[i]}"/><text x="${lw+i*100+14}" y="9" font-size="10" fill="${INK}">${esc(k)}</text>`).join('');
  return `<svg${WIDE()} viewBox="0 0 ${w} ${h}" font-family="IBM Plex Mono,monospace" font-size="11">${lg}${rows.map((r,i)=>{const y=24+i*(bh+gap);let x0=lw;const segs=keys.map((k,j)=>{const v=r[k]||0,bw=x(v);const s=`<rect x="${x0}" y="${y}" width="${bw}" height="${bh}" fill="${cols[j]}"/>${bw>26?`<text x="${x0+bw/2}" y="${y+15}" text-anchor="middle" fill="${isLight(cols[j])?INK:'#f1efe6'}" font-size="10">${v.toFixed(1)}</text>`:''}`;x0+=bw;return s}).join('');const tot=d3.sum(keys,k=>r[k]||0);
    return `<text x="${lw-8}" y="${y+15}" text-anchor="end" fill="${INK}" font-family="Hanken Grotesk,Helvetica,sans-serif" font-size="12">${esc(r.label)}</text>${segs}<text x="${x0+6}" y="${y+15}" fill="${INK}">≥${tot.toFixed(1)}%</text>`}).join('')}</svg>`}
function recordTable(rs){return `<div class="tblwrap"><table><thead><tr><th>FROM</th><th>TO</th><th>WHAT</th><th style="text-align:right">VALUE</th><th>DATE</th><th>EVIDENCE</th></tr></thead><tbody>${rs.map(r=>{const s=(r.ev||[])[0]&&SRC[r.ev[0].s];return `<tr><td>${esc(r.A.name)}</td><td>${esc(r.B.name)}</td><td>${esc((r.rel||'').replace(/_/g,' '))}</td><td class="v">${esc(relVal(r))}</td><td>${esc((r.date||'').split(' · ')[0])}</td><td>${s?`<a href="${esc(s.url)}" target="_blank" rel="noopener noreferrer">${r.st==='documented'?'● ':'○ '}${esc(s.pub||'source')}</a>`:''}</td></tr>`}).join('')}</tbody></table></div>`}
repEl.addEventListener('click',e=>{if(e.target===repEl){repEl.hidden=true;return}const g=e.target.closest('[data-go]');if(g&&byId[g.dataset.go]){repEl.hidden=true;select(byId[g.dataset.go])}});

/* ---------- arsenal: weapons catalogue + events ---------- */
const ARS=D.arsenal||{weapons:[],events:[]};
const ars=document.getElementById('arsenal');
let arsTab='weapons',arsW=null,arsStyle='blueprint',arsExploded=false,arsTheatre='ALL';
try{arsStyle=localStorage.getItem('bm_ars')||arsStyle}catch(_){}
const WBY=Object.fromEntries(ARS.weapons.map(w=>[w.id,w]));
const EVBY=Object.fromEntries(ARS.events.map(v=>[v.id,v]));
const evOfW=w=>ARS.events.filter(v=>(v.weapons||[]).includes(w.id)).sort((a,b)=>String(a.date).localeCompare(String(b.date)));
const entOf=x=>{if(!x)return null;if(byId[x])return byId[x];const l=String(x).toLowerCase();return nodes.find(n=>n.name.toLowerCase()===l)||nodes.find(n=>n.name.toLowerCase().startsWith(l))||null};
const srcLinks=ids=>(ids||[]).filter(i=>SRC[i]).map((i,k)=>`<a href="${esc(SRC[i].url)}" target="_blank" rel="noopener noreferrer">${esc(SRC[i].pub||SRC[i].title||'source')}</a>`).join(' · ');
const CLASSES=[['bomb','Bombs and guidance kits'],['missile','Missiles'],['rocket','Rockets'],['shell','Artillery shells'],['drone','Drones'],['aircraft','Aircraft'],['helicopter','Helicopters'],['launcher','Launchers and guns'],['device','Other devices']];
// profile radius (fraction of max radius) along the body, t from nose (0) to tail (1)
const PROF={
 bomb:t=>t<.14?Math.sqrt(t/.14)*.98+.02:t<.74?1:t<.9?1-(t-.74)/.16*.42:.58,
 missile:t=>t<.1?Math.sqrt(t/.1)*.95+.05:1,
 rocket:t=>t<.08?Math.sqrt(t/.08)*.95+.05:1,
 shell:t=>t<.36?Math.sqrt(t/.36)*.9+.1:t<.88?1:1-(t-.88)/.12*.16,
 drone:t=>t<.08?Math.sqrt(t/.08)*.9+.1:t<.7?1:1-(t-.7)/.3*.75,
 aircraft:t=>t<.18?Math.sqrt(t/.18)*.9+.1:t<.85?1:1-(t-.85)/.15*.4,
 helicopter:t=>t<.12?Math.sqrt(t/.12):t<.5?1:t<.55?1-(t-.5)/.05*.75:.25,
 launcher:t=>1,device:t=>1};
// fins and wings: [t0,t1,span as multiple of radius, sweep]
const FINS={bomb:[[.8,1,2.1,.5]],missile:[[.3,.42,1.9,.3],[.88,1,2.3,.4]],rocket:[[.86,1,2.4,.5]],shell:[],drone:[[.36,.5,0,0]],aircraft:[[.45,.75,0,0],[.86,1,3.2,.5]],helicopter:[],launcher:[],device:[]};
// illustrative proportions when a dimension is not on record (never labelled as a measurement)
const BPDEF={bomb:[3,.12],missile:[3,.06],rocket:[4,.06],shell:[.8,.19],drone:[7,.08,1.6],aircraft:[18,.09,.7],helicopter:[15,.17,.9],launcher:[7,.4],device:[.12,.5]};
const MAKERNIL=/^(unattributed|unresolved|unknown|n\/a|none)\b/i;
function makerLabel(s){if(!s||MAKERNIL.test(s))return{txt:'maker not on record',id:null};let id=null;
  const txt=String(s).replace(/\bsee\s+/i,'').replace(/\b([A-Z]{3}-[A-Z0-9]+(?:-[A-Z0-9]+)*)\b/g,(m)=>{if(byId[m]){id=id||m;return byId[m].name}if(WBY&&WBY[m])return WBY[m].name;return m});
  if(!id){const e=entOf(s);if(e)id=e.id}return{txt,id}}
/* ---------- detailed blueprints: shared drawing engine ----------
   Each weapon has a spec in BPXS[id]. All geometry is in metres: x runs from the nose (0) to the tail (L),
   y is the offset from the centreline (negative = up). The engine scales to fit, then adds the standard sheet:
   length dimension, station scale, side views column, title block, schematic note and exploded-view callouts. */
const BPXS={};
function bpxDraw(w,ex,mk){
  const S=BPXS[w.id];if(!S)return null;
  const W=1200,F=v=>(+v).toFixed(1),viewsW=S.views&&S.views.length?220:0;
  const L=S.L,ext=S.ext||[-.02*L,1.02*L],hy=S.hy||.3;            // drawn x extent and max |y| (m) of the main view
  const s=Math.min((W-150-viewsW-40)/(ext[1]-ext[0]),(S.maxH||250)/(2*hy));
  const ox=Math.max(40,(W-viewsW-(ext[1]-ext[0])*s)/2-ext[0]*s),top0=70+(S.padTop||0),cy=Math.round(top0+30+hy*s);
  const X=m=>ox+m*s,Y=m=>cy+m*s,Z=m=>m*s;
  const P=(x,y)=>F(X(x))+','+F(Y(y));
  // radius function from stations [[x,r],...] with smooth (cosine) blending between stations
  const prof=(st,smooth=true)=>x=>{if(x<=st[0][0])return st[0][1];for(let i=1;i<st.length;i++){const[a,ra]=st[i-1],[b,rb]=st[i];if(x<=b){const u=b>a?(x-a)/(b-a):1,k=smooth?(1-Math.cos(Math.PI*u))/2:u;return ra+(rb-ra)*k}}return st[st.length-1][1]};
  // tangent ogive nose of length l ending at radius R at station x1, blunted to radius r0 at the tip
  const ogive=(x0,l,R,r0=0)=>x=>{const rho=(R*R+l*l)/(2*R),u=Math.min(l,Math.max(0,x-x0));return Math.max(r0,Math.sqrt(Math.max(0,rho*rho-(l-u)**2))+R-rho)};
  const pts=(f,a,b,sg,k=1,n=60)=>{const o=[];for(let i=0;i<=n;i++){const x=a+(b-a)*i/n;o.push(P(x,sg*f(x)*k))}return o};
  const K={X,Y,Z,F,P,s,cy,L,prof,ogive,
    body:(f,a,b,c='b')=>`<path class="${c}" d="M${pts(f,a,b,-1).join('L')}L${pts(f,a,b,1).reverse().join('L')}Z"/>`,
    half:(f,a,b,sg=-1,k=1,c='sm')=>`<path class="${c}" d="M${pts(f,a,b,sg,k).join('L')}"/>`,
    halfD:(f,a,b,sg=-1,k=1)=>'M'+pts(f,a,b,sg,k).join('L'),
    shade:(f,a,b,ks=[.35,.6,.82])=>ks.map(k=>`<path class="sh" d="M${pts(f,a,b,-1,k).join('L')}"/>`).join(''),
    ring:(x,r,c='sm',up=false)=>`<line class="${c}" x1="${F(X(x))}" x2="${F(X(x))}" y1="${F(Y(-r))}" y2="${F(Y(up?0:r))}"/>`,
    line:(x1,y1,x2,y2,c='sm')=>`<line class="${c}" x1="${F(X(x1))}" y1="${F(Y(y1))}" x2="${F(X(x2))}" y2="${F(Y(y2))}"/>`,
    poly:(p,c='dt',close=true)=>`<path class="${c}" d="M${p.map(([x,y])=>P(x,y)).join('L')}${close?'Z':''}"/>`,
    rect:(x0,y0,x1,y1,c='dt')=>`<rect class="${c}" x="${F(Math.min(X(x0),X(x1)))}" y="${F(Math.min(Y(y0),Y(y1)))}" width="${F(Math.abs(Z(x1-x0)))}" height="${F(Math.abs(Z(y1-y0)))}"/>`,
    circ:(x,y,r,c='dt')=>`<circle class="${c}" cx="${F(X(x))}" cy="${F(Y(y))}" r="${F(Z(r))}"/>`,
    dot:(x,y,rp=1.2)=>`<circle class="rt" cx="${F(X(x))}" cy="${F(Y(y))}" r="${rp}"/>`,
    rivets:(x,r,n=7)=>{let o='';for(let q=0;q<n;q++){const y=-r*.85+1.7*r*q/(n-1);o+=`<circle class="rt" cx="${F(X(x))}" cy="${F(Y(y))}" r="1.1"/>`}return o},
    // suspension lug on top of the body at station x (body radius r)
    lug:(x,r)=>{const c=X(x),y=Y(-r);return `<path class="dt" d="M${F(c-10)},${F(y)}L${F(c-6.5)},${F(y-12)}L${F(c+6.5)},${F(y-12)}L${F(c+10)},${F(y)}Z"/><circle class="dt" cx="${F(c)}" cy="${F(y-6.5)}" r="2.8"/>`},
    // trapezoid fin: root a..b at |y|=r0, tip le..te at |y|=rt, sg -1 top / +1 bottom; hinge line optional
    fin:(a,b,r0,le,te,rt,sg,hinge)=>`<path class="f fin" d="M${P(a,sg*r0)}L${P(le,sg*rt)}L${P(te,sg*rt)}L${P(b,sg*r0)}Z"/>${hinge!=null?`<line class="hg" x1="${F(X(hinge))}" x2="${F(X(hinge))}" y1="${F(Y(sg*r0))}" y2="${F(Y(sg*rt*.97))}"/>`:''}`,
    nb:(x,y,t,an='start')=>`<text class="nb" x="${F(X(x))}" y="${F(Y(y))}" text-anchor="${an}">${t}</text>`,
    dimx:(x1,x2,y,t)=>`<line class="hg" x1="${F(X(x1))}" x2="${F(X(x2))}" y1="${F(Y(y))}" y2="${F(Y(y))}" marker-start="url(#ah)" marker-end="url(#ah)"/><text class="nb" x="${F(X((x1+x2)/2))}" y="${F(Y(y)-4)}" text-anchor="middle">${t}</text>`,
    cutbg:(f,a,b)=>`<path class="cutbg" d="M${pts(f,a,b,1).join('L')}L${P(b,0)}L${P(a,0)}Z"/>`,
    hatch:(d)=>`<path class="hx" d="${d}"/><path class="sm" d="${d}"/>`,
    // closed region between y=f(x) (lower half) and y=y0, a..b: used for fills inside a cutaway
    region:(f,a,b,y0=0,k=1)=>'M'+pts(f,a,b,1,k).join('L')+`L${P(b,y0)}L${P(a,y0)}Z`,
    cn:(x,y,n,r=9)=>`<circle class="cn" cx="${F(X(x))}" cy="${F(Y(y))}" r="${r}"/><text class="cn" x="${F(X(x))}" y="${F(Y(y)+3.5)}" text-anchor="middle">${n}</text>`};
  const out=S.draw(K);                       // {groups:[{part,dx,dy,svg,lab:[x_m,y_m,anchor]}], extra, cut}
  let o='';
  out.groups.forEach((g,i)=>{o+=`<g class="part${g.inner?' in':''}${g.fill?' fill':''}" style="--dx:${g.dx||0}px;--dy:${g.dy||0}px;--d:${i*70}ms">${g.svg}</g>`});
  o=`<line class="cl" x1="${F(X(ext[0])-30)}" x2="${F(X(ext[1])+30)}" y1="${cy}" y2="${cy}"/>`+o+(out.extra?`<g class="asm">${out.extra}</g>`:'');
  // overall length and station scale
  const dm=w.dims||{},Lr=+dm.length_m>0?+dm.length_m:null,Dr=+dm.diameter_m>0?+dm.diameter_m:null;
  const yt=top0;let sheet=`<g class="dim"><line x1="${F(X(0))}" x2="${F(X(L))}" y1="${yt}" y2="${yt}" marker-start="url(#ah)" marker-end="url(#ah)"/><line class="ext" x1="${F(X(0))}" x2="${F(X(0))}" y1="${yt-6}" y2="${cy}"/><line class="ext" x1="${F(X(L))}" x2="${F(X(L))}" y1="${yt-6}" y2="${cy}"/><rect class="bg" x="${F(X(L/2)-80)}" y="${yt-9}" width="160" height="18"/><text x="${F(X(L/2))}" y="${yt+4}" text-anchor="middle">${Lr?`L ${Lr} m`:'LENGTH NOT ON RECORD'}</text>${S.dia!==false&&Dr&&S.diaAt!=null?`<line class="hg" x1="${F(X(S.diaAt))}" x2="${F(X(S.diaAt))}" y1="${F(Y(-Dr/2))}" y2="${F(Y(Dr/2))}"/><text x="${F(X(S.diaAt)+5)}" y="${F(Y(Dr/2)+15)}">Ø ${Dr} m</text>`:''}</g>`;
  const sy=Math.round(cy+hy*s+26),step=[.01,.02,.05,.1,.2,.5,1,2][[.01,.02,.05,.1,.2,.5,1,2].findIndex(v=>v*s>=12)]||2,lab=step*5;
  let st=`<g class="sta asm"><line x1="${F(X(0))}" x2="${F(X(L))}" y1="${sy}" y2="${sy}"/>`;
  for(let i=0;i*step<=L+1e-9;i++){const m=i*step,big=i%5===0;st+=`<line x1="${F(X(m))}" x2="${F(X(m))}" y1="${sy}" y2="${sy+(big?7:3.5)}"/>`;if(big)st+=`<text x="${F(X(m))}" y="${sy+18}" text-anchor="middle">${Math.round(m*1000)}</text>`}
  st+=`<text x="${F(X(L)+12)}" y="${sy+4}">STA mm</text></g>`;
  // side views column (end view, sections): each view draws itself centred at (cx,cy) with px-per-metre k
  let vy=top0+10,views='';(S.views||[]).forEach(v=>{const k=Math.min(v.k||9e9,(v.size||90)/v.r);const h=v.r*k*2;const c=vy+h/2+(v.pad||8);views+=`<g class="view asm">${v.draw(W-120,c,k,F)}<text class="nb" x="${W-120}" y="${F(c+h/2+16)}" text-anchor="middle">${v.title}</text>${v.sub?`<text class="nb" x="${W-120}" y="${F(c+h/2+27)}" text-anchor="middle">${v.sub}</text>`:''}</g>`;vy=c+h/2+48});
  const H=Math.max(sy+(sy+30>vy?95:60),vy+70,S.H||0);
  const tb=`<g class="tblock"><rect x="${W-430}" y="${H-58}" width="410" height="44"/><line x1="${W-430}" x2="${W-20}" y1="${H-36}" y2="${H-36}"/><line x1="${W-300}" x2="${W-300}" y1="${H-58}" y2="${H-14}"/><text x="${W-420}" y="${H-43}">BL00D.MONEY</text><text x="${W-420}" y="${H-21}">${w.id}</text><text x="${W-290}" y="${H-43}">${S.short||w.name}</text><text x="${W-290}" y="${H-21}">${S.title||'SIDE ELEVATION'}</text></g><text class="nb" x="20" y="${H-18}">${S.note||"SCHEMATIC FROM PUBLISHED DIMENSIONS, NOT A MANUFACTURER'S DRAWING"}</text>`;
  // exploded-view callouts, one per group that names a part (index into w.parts)
  const calls=out.groups.map((g,i)=>{if(g.part==null||!g.lab)return '';const p=(w.parts||[])[g.part];if(!p)return '';const m=mk(p.maker),[lx,ly,an]=g.lab,n=g.n||g.part+1;
    const nm=(g.name||p.name).toUpperCase(),t=nm.length>40?nm.slice(0,39)+'…':nm;
    return `<g class="call" style="--d:${600+i*90}ms"><text class="pn" x="${F(X(lx)+(g.dx||0))}" y="${F(Y(ly)+(g.dy||0))}" text-anchor="${an||'middle'}">${n} · ${t}</text><text class="mk"${m.id?` data-go="${m.id}"`:''} x="${F(X(lx)+(g.dx||0))}" y="${F(Y(ly)+(g.dy||0)+14)}" text-anchor="${an||'middle'}">${m.txt}${m.id?' ↗':''}</text></g>`}).join('');
  return `<svg class="bp bpx${ex?' ex':''}" viewBox="0 0 ${W} ${H}" role="img" aria-label="Detailed line drawing of ${w.name}${ex?', exploded into parts with their makers':''}"><defs><pattern id="hx2" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="5" stroke="currentColor" stroke-width=".7" opacity=".6"/></pattern><marker id="ah" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,2L10,5L0,8" fill="none" stroke="currentColor"/></marker></defs>${o}${sheet}${st}${views}${calls}${tb}</svg>`;
}
// helpers for the views column (cx,cy in px, k px per metre)
const BPXV={
  disc:(cx,cy,k,r,c='b')=>`<circle class="${c}" cx="${cx}" cy="${cy}" r="${(r*k).toFixed(1)}"/>`,
  fins:(cx,cy,k,r0,r1,angles,t=.02)=>angles.map(a=>{const c=Math.cos(a*Math.PI/180),s=Math.sin(a*Math.PI/180),w=t*k,R0=r0*k,R1=r1*k;
    return `<path class="f fin" d="M${(cx+c*R0-s*w).toFixed(1)},${(cy+s*R0+c*w).toFixed(1)}L${(cx+c*R1-s*w*.6).toFixed(1)},${(cy+s*R1+c*w*.6).toFixed(1)}L${(cx+c*R1+s*w*.6).toFixed(1)},${(cy+s*R1-c*w*.6).toFixed(1)}L${(cx+c*R0+s*w).toFixed(1)},${(cy+s*R0-c*w).toFixed(1)}Z"/>`}).join(''),
  hatchDisc:(cx,cy,k,r)=>`<circle class="hx" cx="${cx}" cy="${cy}" r="${(r*k).toFixed(1)}"/><circle class="sm" cx="${cx}" cy="${cy}" r="${(r*k).toFixed(1)}"/>`,
  lugTop:(cx,cy,k,r)=>`<path class="dt" d="M${cx-9},${(cy-r*k).toFixed(1)}L${cx-6},${(cy-r*k-10).toFixed(1)}L${cx+6},${(cy-r*k-10).toFixed(1)}L${cx+9},${(cy-r*k).toFixed(1)}Z"/>`};


// AH-64 Apache (Peten / Saraf): plan view with main rotor disc. L = 14.7 m (record), rotor diameter 14.6 m (record).
// Parts (data order): 0 nose sensors and cockpit, 1 30mm chain gun, 2 stub wings with Hellfire / rockets, 3 T700 engines, 4 tail boom
(()=>{
const mir=h=>h.concat(h.slice().reverse().map(([x,y])=>[x,-y]));
const VW=(cx,cy,k)=>{const f=v=>(+v).toFixed(1),P=([x,y])=>f(cx+x*k)+','+f(cy+y*k);return{
  p:(pts,c='b',cl=true)=>`<path class="${c}" d="M${pts.map(P).join('L')}${cl?'Z':''}"/>`,
  m:(pts,c='b',cl=true)=>`<path class="${c}" d="M${pts.concat(pts.slice().reverse().map(([x,y])=>[-x,y])).map(P).join('L')}${cl?'Z':''}"/>`,
  c:(x,y,r,c='dt')=>`<circle class="${c}" cx="${f(cx+x*k)}" cy="${f(cy+y*k)}" r="${f(r*k)}"/>`,
  e:(x,y,rx,ry,c='dt')=>`<ellipse class="${c}" cx="${f(cx+x*k)}" cy="${f(cy+y*k)}" rx="${f(rx*k)}" ry="${f(ry*k)}"/>`,
  l:(x1,y1,x2,y2,c='sm')=>`<line class="${c}" x1="${f(cx+x1*k)}" y1="${f(cy+y1*k)}" x2="${f(cx+x2*k)}" y2="${f(cy+y2*k)}"/>`}};
const L=14.7,R=7.3,MX=5.2;
BPXS['ARS-AH64']={L,ext:[-2.3,15.6],hy:7.55,maxH:560,padTop:12,H:800,short:'AH-64 APACHE · PETEN / SARAF',title:'PLAN VIEW · ROTOR DISC',
 draw(K){
  // ---- 1 nose sensors (TADS/PNVS turret) and tandem cockpit, 0 to 4.4 m
  let ns=K.poly(mir([[.15,0],[.2,.28],[.45,.42],[1.0,.46],[2.0,.52],[3.2,.58],[4.4,.62],[4.4,0]]),'b');
  ns+=K.circ(.62,0,.38,'dt')+K.rect(.28,-.58,.95,-.38,'dt')+K.rect(.28,.38,.95,.58,'dt')+K.circ(.62,0,.12,'sm');
  ns+=K.nb(.25,-.8,'TADS / PNVS','end');
  // flat-plate canopy panes: co-pilot/gunner forward, pilot aft and raised
  ns+=K.poly(mir([[1.05,0],[1.1,.3],[1.3,.4],[2.55,.42],[2.55,0]]),'dt win')+K.poly(mir([[2.6,0],[2.6,.44],[4.05,.46],[4.15,.3],[4.15,0]]),'dt win');
  ns+=K.line(1.3,-.4,1.3,.4,'sm')+K.line(1.95,-.42,1.95,.42,'sh')+K.line(3.35,-.45,3.35,.45,'sh')+K.line(1.1,0,4.15,0,'sh');
  ns+=K.nb(1.2,.95,'CPG','middle')+K.nb(3.3,.95,'PILOT','middle');
  ns+=K.cn(3.8,.0,1,7);
  // ---- 2 30mm chain gun (under the chin, hidden in plan)
  let gn=K.circ(3.05,0,.3,'b')+K.rect(2.2,-.1,3.05,.1,'b')+K.rect(.95,-.035,2.2,.035,'b')+K.rect(.95,-.06,1.1,.06,'b');
  gn+=K.line(2.45,-.1,2.45,.1)+K.line(2.7,-.1,2.7,.1);
  // ---- static centre fuselage with mast and hub
  let cf=K.poly(mir([[4.4,0],[4.4,.62],[5.0,.66],[7.4,.66],[8.1,.55],[8.1,0]]),'b');
  cf+=K.circ(MX,0,.34,'dt')+K.circ(MX,0,.14,'sm')+K.line(4.5,-.5,7.8,-.5,'sh')+K.line(4.5,.5,7.8,.5,'sh');
  cf+=K.rect(7.0,-.25,7.9,.25,'sm')+K.nb(7.45,.05,'APU','middle');
  // ---- 3 stub wings with Hellfire launchers (2 per wing, 4 rails each) and rocket pod capability
  const wing=sg=>{let w=K.poly([[5.05,sg*.66],[5.15,sg*2.62],[6.35,sg*2.62],[6.45,sg*.66]],'b');
    w+=K.poly([[6.0,sg*.7],[6.05,sg*2.55],[6.35,sg*2.55]],'sm',false)+K.line(5.1,sg*1.9,6.4,sg*1.9,'sh');
    [1.45,2.3].forEach(y=>{w+=K.rect(5.25,sg*(y-.08),6.2,sg*(y+.08),'dt');           // pylon / launcher
      [-.15,.15].forEach(o=>{const yy=sg*(y+o);w+=K.poly([[4.62,yy],[4.72,yy-.09],[6.25,yy-.09],[6.25,yy+.09],[4.72,yy+.09]],'b')+K.line(4.85,yy-.09,4.85,yy+.09,'sh')+K.line(6.0,yy-.09,6.0,yy+.09,'sh')})});
    w+=K.circ(6.4,sg*2.62,.06,'dt');return w};
  // ---- 4 T700 engine nacelles with IR-suppressing exhausts
  const eng=sg=>{let e=K.poly([[5.5,sg*.62],[5.65,sg*1.05],[6.0,sg*1.18],[7.6,sg*1.18],[7.9,sg*1.0],[7.8,sg*.62]],'b');
    e+=K.poly([[5.55,sg*.72],[5.65,sg*1.0],[5.85,sg*1.0],[5.8,sg*.72]],'dt');                     // intake
    e+=K.poly([[7.6,sg*.95],[8.6,sg*1.45],[8.75,sg*1.3],[7.9,sg*.75]],'dt');                        // exhaust
    e+=K.line(6.4,sg*.64,6.4,sg*1.17,'sh')+K.line(7.1,sg*.64,7.1,sg*1.17,'sh')+K.line(5.9,sg*.9,7.6,sg*.9,'sh');
    return e};
  // ---- 5 tail boom, vertical fin, stabilator, tail rotor (left side)
  let tb=K.poly(mir([[8.1,0],[8.1,.55],[10.0,.4],[12.6,.28],[14.2,.22],[14.7,.12],[14.7,0]]),'b');
  tb+=K.shade(x=>.1,8.4,14.4,[]);
  tb+=K.line(8.4,0,14.5,0,'sh')+[9.3,10.6,11.9].map(x=>K.line(x,-.38,x,.38,'sh')).join('');
  tb+=K.poly(mir([[12.95,0],[12.95,1.72],[13.85,1.72],[13.9,.2]]),'f fin')+K.line(13.6,-1.68,13.6,1.68,'hg');
  tb+=K.poly(mir([[12.3,0],[12.7,.1],[14.5,.1],[14.7,0]]),'f fin');
  tb+=K.rect(12.1,.12,14.9,.26,'dt')+K.circ(13.5,.19,.12,'dt')+K.line(12.3,.19,14.7,.19,'sh');
  tb+=K.nb(13.4,2.05,'STABILATOR','middle')+K.nb(14.95,.6,'TAIL ROTOR');
  // ---- main rotor disc and four blades (assembly only)
  let ro=`<circle class="hg" cx="${K.F(K.X(MX))}" cy="${K.F(K.Y(0))}" r="${K.F(K.Z(R))}"/>`;
  [35,125,215,305].forEach(a=>{const c=Math.cos(a*Math.PI/180),s=Math.sin(a*Math.PI/180),ch=.27;
    const pt=(r,o)=>[MX+c*r-s*o,s*r+c*o];
    ro+=K.poly([pt(.45,-ch*.7),pt(6.9,-ch),pt(R,-ch*.3),pt(R,ch*.6),pt(6.9,ch),pt(.45,ch*.7)],'f')+K.poly([pt(1.0,0),pt(6.95,0)],'sh',false)});
  ro+=K.circ(MX,0,.42,'dt')+K.circ(MX,0,.12,'rt');
  ro+=K.nb(MX+R*.72,-R*.72-.15,'MAIN ROTOR DISC','start');
  ro+=`<line class="hg" x1="${K.F(K.X(MX-R))}" x2="${K.F(K.X(MX+R))}" y1="${K.F(K.Y(R)+14)}" y2="${K.F(K.Y(R)+14)}" marker-start="url(#ah)" marker-end="url(#ah)"/><text class="nb" x="${K.F(K.X(MX))}" y="${K.F(K.Y(R)+10)}" text-anchor="middle">ROTOR Ø 14.6 m</text>`;
  ro+=K.line(MX-R,R*.2,MX-R,R+.5,'sh')+K.line(MX+R,R*.2,MX+R,R+.5,'sh');
  return {groups:[
    {part:0,dx:-80,svg:ns,lab:[2.4,-1.3,'middle']},
    {part:1,dx:-70,dy:120,svg:gn,inner:1,lab:[2.0,.75,'middle']},
    {part:null,svg:cf},
    {part:2,dy:-95,svg:wing(-1)+K.cn(5.75,-1.9,3,7),lab:[5.75,-3.35,'middle']},
    {part:2,dy:95,svg:wing(1)},
    {part:3,dx:70,dy:-55,svg:eng(-1)+K.cn(6.75,-.9,4,7),lab:[8.95,-1.05,'start']},
    {part:3,dx:70,dy:55,svg:eng(1)},
    {part:4,dx:110,svg:tb+K.cn(10.4,0,5,7),lab:[11.4,-1.1,'middle']}],
   extra:ro}},
 views:[
  {r:2.6,k:13,size:40,title:'FRONT VIEW',sub:'HELLFIRE RAILS · CHIN GUN',draw:(cx,cy,k)=>{const v=VW(cx,cy,k);let o='';
    o+=v.p([[-7.3,-2.05],[7.3,-2.05],[7.3,-1.97],[-7.3,-1.97]],'f fin')+v.p([[-.12,-2.0],[.12,-2.0],[.15,-1.3],[-.15,-1.3]],'dt')+v.c(0,-2.05,.2,'dt');
    o+=v.m([[0,-1.35],[.35,-1.3],[.5,-.9],[.55,-.2],[.62,.55],[.45,.9],[0,.95]],'b');
    o+=v.m([[0,-1.05],[.3,-1.0],[.42,-.55],[0,-.5]],'dt win');
    [-1,1].forEach(s=>{
      o+=v.p([[s*.55,-.95],[s*1.2,-.85],[s*1.2,-.3],[s*.55,-.25]],'b')+v.c(s*.88,-.58,.2,'dt');
      o+=v.p([[s*.55,-.05],[s*2.62,.05],[s*2.62,.15],[s*.55,.12]],'b');
      [1.45,2.3].forEach(y=>{o+=v.l(s*y,.13,s*y,.32,'sm');[[-.15,.42],[.15,.42],[-.15,.68],[.15,.68]].forEach(([dx,dy])=>o+=v.c(s*y+dx,dy,.09,'dt'))});
      o+=v.l(s*.5,.9,s*1.1,1.75,'sm')+v.c(s*1.15,1.82,.3,'b')});
    o+=v.c(0,1.12,.22,'b')+v.l(0,1.12,0,1.45,'sm')+v.c(0,-.05,.3,'dt');
    return o}},
  {r:2.4,k:11,size:40,title:'SIDE ELEVATION',sub:'TAIL ROTOR · STABILATOR',draw:(cx,cy,k)=>{const v=VW(cx,cy,k),T=p=>p.map(([x,y])=>[x-7.35,y]);let o='';
    o+=v.p(T([[MX-R,-1.98],[MX+R,-1.98],[MX+R,-1.92],[MX-R,-1.92]]),'f fin')+v.p(T([[MX-.12,-1.95],[MX+.12,-1.95],[MX+.2,-1.25],[MX-.2,-1.25]]),'dt');
    o+=v.p(T([[13.0,-.05],[13.6,-2.2],[14.6,-2.2],[14.6,.0]]),'f fin');
    o+=v.p(T([[.15,.0],[.2,-.45],[1.0,-.55],[1.4,-1.0],[2.6,-1.05],[2.7,-1.25],[4.1,-1.3],[4.6,-1.25],[7.6,-1.15],[8.2,-.8],[13.0,-.35],[14.6,-.3],[14.7,.05],[13.0,.12],[8.1,.3],[7.0,.62],[3.0,.65],[1.0,.45],[.4,.35]]),'b');
    o+=v.p(T([[1.0,-.55],[1.4,-1.0],[2.6,-1.05],[2.6,-.55]]),'dt win')+v.p(T([[2.7,-.62],[2.7,-1.25],[4.1,-1.3],[4.1,-.68]]),'dt win');
    o+=v.c(.6-7.35,-.05,.38,'dt')+v.c(13.5-7.35,-1.3,1.395,'hg')+v.c(13.5-7.35,-1.3,.1,'dt');
    o+=v.p(T([[12.95,-.38],[13.9,-.38],[13.9,-.3],[12.95,-.3]]),'sm');
    o+=v.p(T([[5.05,.1],[6.45,.1],[6.45,.22],[5.05,.22]]),'sm')+v.p(T([[4.65,.3],[6.25,.3],[6.25,.5],[4.65,.5]]),'dt');
    o+=v.c(3.05-7.35,.85,.25,'b')+v.l(3.05-7.35,.85,.95-7.35,.9,'sm');
    o+=v.l(4.6-7.35,.6,4.4-7.35,1.65,'sm')+v.c(4.4-7.35,1.65,.3,'b')+v.l(13.8-7.35,.1,14.0-7.35,.55,'sm')+v.c(14.0-7.35,.6,.12,'b');
    o+=v.p(T([[5.6,-1.2],[7.9,-1.2],[7.9,-.75],[5.6,-.75]]),'sm');
    return o}}]};
})();

// AR-924 pager, drawn as the ordinary consumer device (front elevation). Parts: 0 casing and electronics, 1 battery pack
(()=>{const rr=(K,x0,y0,x1,y1,r,c='b')=>{const X=K.X,Y=K.Y,F=K.F,R=K.Z(r);return `<rect class="${c}" x="${F(X(x0))}" y="${F(Y(y0))}" width="${F(K.Z(x1-x0))}" height="${F(K.Z(y1-y0))}" rx="${F(R)}"/>`};
BPXS['ARS-AR924']={L:.075,ext:[-.004,.079],hy:.034,maxH:300,short:'AR-924 PAGER · CONSUMER DEVICE',title:'FRONT ELEVATION · ORDINARY PAGER',
 note:"ILLUSTRATIVE DRAWING OF AN ORDINARY AR-924-TYPE PAGER, NOT THE MODIFIED DEVICE",
 draw(K){let c=rr(K,0,-.025,.075,.025,.006)+rr(K,.003,-.022,.072,.022,.0045,'sm');
  // screen bezel and LCD with sample message lines
  c+=rr(K,.008,-.019,.067,.001,.002,'dt')+rr(K,.011,-.016,.064,-.002,.001,'dt win');
  [-.013,-.009,-.005].forEach((y,i)=>c+=K.line(.014,y,.014+[.04,.032,.022][i],y,'sh'));
  c+=K.nb(.0375,.0065,'GOLD APOLLO',"middle");
  // keypad: four arrow keys around a select key, a read and a power key
  c+=K.circ(.0375,.0145,.0055,'dt')+K.circ(.0375,.0145,.0025,'sm');
  [[-1,0],[1,0],[0,-1],[0,1]].forEach(([a,b])=>c+=K.poly([[.0375+a*.0042-b*.0012,.0145+b*.0042-a*.0012],[.0375+a*.0049,.0145+b*.0049],[.0375+a*.0042+b*.0012,.0145+b*.0042+a*.0012]],'sm'));
  c+=rr(K,.012,.011,.022,.018,.002,'dt')+rr(K,.053,.011,.063,.018,.002,'dt')+K.nb(.017,.023,'READ','middle')+K.nb(.058,.023,'POWER','middle');
  // grip ridges, lanyard eye, LED, speaker slots
  [.0015,.0735].forEach(x=>{for(let y=-.016;y<=.016;y+=.004)c+=K.line(x-.0007,y,x+.0007,y,'sh')});
  c+=K.circ(.069,-.0215,.0011,'sm')+K.circ(.005,-.0215,.0013,'dt');
  [.03,.035,.04,.045].forEach(x=>c+=K.line(x,.0215,x+.003,.0215,'sm'));
  c+=K.cn(.026,-.009,1,8);
  // battery door (drawn dashed behind, explodes downward): AAA cell outline
  let b=rr(K,.043,-.012,.07,.012,.0015,'b')+K.line(.046,-.012,.046,.012,'hg')+rr(K,.047,-.0053,.0675,.0053,.0018,'hg')+K.rect(.0675,-.0018,.069,.0018,'hg')+K.nb(.057,.0005,'AAA','middle')+K.cn(.057,-.0085,2,8)+K.nb(.057,.0105,'IN REAR','middle');
  return {groups:[{part:0,dx:-30,svg:c,lab:[.0375,.03,'middle']},{part:1,dx:230,dy:-30,svg:b,inner:1,lab:[.057,.0185,'middle'],name:'BATTERY PACK · PETN CHARGE'}]}},
 views:[{r:.034,size:70,title:'SIDE VIEW',sub:'BELT CLIP · USB PORT',draw:(cx,cy,k)=>{const w=.011*k,h=.025*k;return `<rect class="b" x="${(cx-w).toFixed(1)}" y="${(cy-h).toFixed(1)}" width="${(2*w).toFixed(1)}" height="${(2*h).toFixed(1)}" rx="${(.004*k).toFixed(1)}"/><path class="f fin" d="M${(cx+w).toFixed(1)},${(cy-h*.8).toFixed(1)}L${(cx+w+.004*k).toFixed(1)},${(cy-h*.7).toFixed(1)}L${(cx+w+.004*k).toFixed(1)},${(cy+h*.8).toFixed(1)}L${(cx+w).toFixed(1)},${(cy+h*.9).toFixed(1)}"/><rect class="dt" x="${(cx-w*.4).toFixed(1)}" y="${(cy+h-3).toFixed(1)}" width="${(w*.8).toFixed(1)}" height="3"/>`}},
  {r:.03,size:60,title:'REAR VIEW',sub:'BATTERY DOOR · 1 x AAA (LISTED SPECS)',draw:(cx,cy,k)=>{const w=.0375*k,h=.025*k;return `<rect class="b" x="${(cx-w).toFixed(1)}" y="${(cy-h).toFixed(1)}" width="${(2*w).toFixed(1)}" height="${(2*h).toFixed(1)}" rx="${(.006*k).toFixed(1)}"/><rect class="dt" x="${(cx+.006*k).toFixed(1)}" y="${(cy-.012*k).toFixed(1)}" width="${(.027*k).toFixed(1)}" height="${(.024*k).toFixed(1)}" rx="2"/><rect class="sm" x="${(cx-.03*k).toFixed(1)}" y="${(cy-.016*k).toFixed(1)}" width="${(.03*k).toFixed(1)}" height="${(.008*k).toFixed(1)}"/>`}}]};
})();

// BLU-109 2,000-lb penetrator with KMU-557 JDAM tail kit, held to the 2.41 m on record (part fractions as recorded).
// Parts (data order): 0 thick steel case, 1 Tritonal fill, 2 FMU-143 delayed tail fuze, 3 KMU-557 tail kit
BPXS['ARS-BLU109']={L:2.41,padTop:40,ext:[-.03,2.45],hy:.30,diaAt:.72,short:'BLU-109 · 2,000-LB PENETRATOR',title:'SIDE ELEVATION · HALF SECTION',
 draw(K){const R=.185,wall=.025,og=K.ogive(-.02,.52,R,.03);
  const rB=x=>x<.5?og(x):R;
  const rIn=x=>x<.30?0:Math.max(.035,rB(x)-wall);
  const rT=K.prof([[1.79,R+.008],[1.83,R+.008],[2.06,.142],[2.37,.142],[2.41,.112]],false);
  // 1 case: exterior on top; cutaway below shows the solid nose and 25 mm wall
  let b=K.body(rB,0,1.81)+K.shade(rB,.06,1.80)+K.ring(.5,R,'sm',true)+K.half(x=>rB(x)*.93,.03,1.80,-1,1,'sh hi');
  b+=K.lug(.52,R)+K.lug(1.282,R)+K.poly([[.012,-.03],[-.012,-.024],[-.022,-.01],[-.022,.01],[-.012,.024],[.012,.03]]);
  b+=K.cutbg(rB,0,1.81)+K.half(x=>x<.30?0:rIn(x),.30,1.79,1)+K.line(.30,0,.30,rIn(.30),'sm')+K.line(1.79,0,1.79,R,'sm')+K.line(1.81,-R,1.81,R,'sm');
  for(let x=.02;x<.30;x+=.025)b+=K.line(x,Math.min(rB(x),.004+x*.0),x+.02,rB(x+.02)*.96,'sh');
  for(let x=.34;x<1.76;x+=.05)b+=K.line(x,rIn(x)+.003,x+.02,R-.003,'sh');
  b+=K.nb(.04,R+.075,'SOLID STEEL NOSE')+K.nb(1.04,R+.075,'WALL ≈ 25 mm')+K.line(1.04,R+.055,.98,R-.012,'hg');
  b+=K.line(.33,.02,1.66,.02,'hg')+K.cn(.75,-R*.45,1);
  // 2 fill
  const fill=K.hatch(K.region(rIn,.33,1.66,.02))+K.cn(.90,.10,2,8);
  // 3 FMU-143 tail fuze in the aft closure, nose protruding into the kit adapter
  let fz=K.rect(1.68,-.055,1.85,.055);[1.72,1.76,1.80].forEach(x=>fz+=K.ring(x,.055));fz+=K.poly([[1.85,-.04],[1.89,-.03],[1.89,.03],[1.85,.04]],'sm')+K.circ(1.70,0,.012)+K.cn(1.765,.10,3,8);
  // 4 KMU-557 tail kit: adapter shroud, guidance bay, X fins
  let tk=K.body(rT,1.79,2.41,'b tk');[1.83,2.06,2.37].forEach(x=>tk+=K.ring(x,rT(x)));tk+=K.shade(rT,1.84,2.40,[.5,.8])+K.rivets(1.81,rT(1.81),6);
  tk+=K.poly([[1.95,-rT(1.95)],[1.97,-rT(1.97)-.028],[2.05,-rT(2.05)-.028],[2.07,-rT(2.07)]])+K.rect(1.86,-rT(1.86)-.016,1.91,-rT(1.86)+.004);
  const tip=.32*Math.SQRT1_2+.142*(1-Math.SQRT1_2);
  [-1,1].forEach(sg=>{tk+=K.fin(2.08,2.36,.142,2.22,2.36,tip,sg,2.27)+K.line(2.18,sg*(.142+tip)/2,2.34,sg*(.142+tip)/2)+K.rect(2.23,sg*.142,2.30,sg*(.142+.02))});
  tk+=K.cn(1.96,.04,4);
  return {groups:[
    {part:0,dx:-50,svg:b,lab:[.8,R+.16,'middle']},
    {part:1,dx:-50,dy:140,svg:fill,inner:1,fill:1,lab:[1.0,.24,'middle']},
    {part:2,dx:40,dy:140,svg:fz,inner:1,lab:[1.93,.01,'start']},
    {part:3,dx:100,svg:tk,lab:[2.2,-.40,'middle']}],
   extra:K.dimx(.52,1.282,-R-.07,'30 in · 762 mm')+`<line class="hg" x1="${K.F(K.X(1.5))}" x2="${K.F(K.X(1.5))}" y1="${K.F(K.Y(-R)-16)}" y2="${K.F(K.Y(R)+16)}"/>`+K.nb(1.505,-R-.06,'A')+K.nb(1.505,R+.09,'A')}},
 views:[
  {r:.32,size:62,title:'VIEW FROM AFT',sub:'KMU-557 TAIL KIT',draw:(cx,cy,k)=>BPXV.disc(cx,cy,k,.185)+BPXV.disc(cx,cy,k,.142,'sm')+BPXV.disc(cx,cy,k,.05,'dt')+BPXV.fins(cx,cy,k,.142,.32,[45,135,225,315])+BPXV.lugTop(cx,cy,k,.185)},
  {r:.185,size:46,title:'SECTION A–A',sub:'THICK STEEL CASE · TRITONAL',draw:(cx,cy,k)=>{let o=BPXV.disc(cx,cy,k,.185)+BPXV.disc(cx,cy,k,.16,'sm');
    for(let a=0;a<360;a+=15){const c=Math.cos(a*Math.PI/180),s=Math.sin(a*Math.PI/180);o+=`<line class="sh" x1="${(cx+c*.163*k).toFixed(1)}" y1="${(cy+s*.163*k).toFixed(1)}" x2="${(cx+c*.182*k).toFixed(1)}" y2="${(cy+s*.182*k).toFixed(1)}"/>`}
    return o+BPXV.hatchDisc(cx,cy,k,.158)}}]};

// F-15I Ra'am / F-15IA: two-seat F-15E-family strike jet with conformal fuel tanks. Plan view.
// Parts (data order): 0 airframe. No dimensions on record: drawn at the published F-15E size (about 19.4 m long, 13.05 m span); no figures printed.
(()=>{
const mir=h=>h.concat(h.slice().reverse().map(([x,y])=>[x,-y]));
const VW=(cx,cy,k)=>{const f=v=>(+v).toFixed(1),P=([x,y])=>f(cx+x*k)+','+f(cy+y*k);return{
  p:(pts,c='b',cl=true)=>`<path class="${c}" d="M${pts.map(P).join('L')}${cl?'Z':''}"/>`,
  m:(pts,c='b',cl=true)=>`<path class="${c}" d="M${pts.concat(pts.slice().reverse().map(([x,y])=>[-x,y])).map(P).join('L')}${cl?'Z':''}"/>`,
  c:(x,y,r,c='dt')=>`<circle class="${c}" cx="${f(cx+x*k)}" cy="${f(cy+y*k)}" r="${f(r*k)}"/>`,
  e:(x,y,rx,ry,c='dt')=>`<ellipse class="${c}" cx="${f(cx+x*k)}" cy="${f(cy+y*k)}" rx="${f(rx*k)}" ry="${f(ry*k)}"/>`,
  l:(x1,y1,x2,y2,c='sm')=>`<line class="${c}" x1="${f(cx+x1*k)}" y1="${f(cy+y1*k)}" x2="${f(cx+x2*k)}" y2="${f(cy+y2*k)}"/>`}};
const L=19.43,HS=6.525;
const wLE=y=>8.2+(y-1.95),wTE=y=>14.9-(y-1.95)*.15;
BPXS['ARS-F15I']={L,ext:[-.9,20.4],hy:6.9,maxH:500,padTop:10,H:760,short:"F-15I RA'AM / F-15IA",title:'PLAN VIEW',
 draw(K){
  const bodyH=[[0,0],[.5,.15],[1.5,.38],[2.6,.55],[3.6,.66],[4.6,.72],[5.5,.8],[5.6,1.75],[6.2,1.86],[8.2,1.95],[14.9,1.92],[16.4,1.82],[18.4,1.74],[18.6,1.56],[18.35,1.25],[17.7,1.22],[17.5,.25],[17.2,0]];
  let o=K.poly(mir(bodyH),'b');
  [-1,1].forEach(sg=>{
    // wing with raked tip
    o+=K.poly([[8.2,sg*1.95],[wLE(6.3),sg*6.3],[13.25,sg*HS],[14.1,sg*HS],[wTE(6.3),sg*6.3],[wTE(1.95),sg*1.95]],'b');
    // aileron and plain flap
    o+=K.poly([[wTE(4.6),sg*4.6],[wTE(4.6)-.65,sg*4.6],[wTE(6.2)-.6,sg*6.2],[wTE(6.2),sg*6.2]],'sm');
    o+=K.poly([[wTE(2.15),sg*2.15],[wTE(2.15)-.8,sg*2.15],[wTE(4.45)-.75,sg*4.45],[wTE(4.45),sg*4.45]],'sm');
    // spar / panel lines, wing pylon (hidden)
    o+=K.line(wLE(2.3)+1.0,sg*2.3,wLE(6.0)+.4,sg*6.0,'sh')+K.line(wLE(2.1)+3.4,sg*2.1,wTE(5.9)-1.0,sg*5.9,'sh');
    o+=K.rect(11.3,sg*(3.45-.07),13.2,sg*(3.45+.07),'hg');
    // intake ramp face and splitter
    o+=K.poly([[5.5,sg*.82],[5.6,sg*1.75],[5.95,sg*1.8],[5.85,sg*.86]],'dt')+K.line(5.85,sg*.86,8.2,sg*.95,'sh');
    // conformal fuel tank: visible ahead of the wing, hidden below it; tangential stations
    o+=K.poly([[6.4,sg*1.86],[7.0,sg*2.1],[8.3,sg*2.18]],'sm',false)+K.poly([[8.3,sg*2.18],[14.4,sg*2.18],[14.8,sg*2.0]],'hg',false);
    [9.0,10.4,11.8,13.2].forEach(x=>o+=K.rect(x-.25,sg*2.18,x+.25,sg*2.3,'hg'));
    // hidden engines
    o+=K.rect(12.4,sg*.13,17.6,sg*1.18,'hg');
    // nozzles
    o+=K.rect(17.6,sg*.12,18.95,sg*1.2,'dt')+[17.95,18.3,18.65].map(x=>K.line(x,sg*.14,x,sg*1.18,'sh')).join('');
    // stabilator with dog-tooth
    o+=K.poly([[16.0,sg*1.74],[16.45,sg*1.74],[16.6,sg*2.1],[18.2,sg*4.3],[19.2,sg*4.3],[19.43,sg*1.74]],'f fin');
    o+=K.circ(17.6,sg*2.05,.07,'dt');
    // vertical tail seen from above, rudder hinge
    o+=K.poly([[15.3,sg*1.6],[16.4,sg*1.53],[18.9,sg*1.53],[19.1,sg*1.6],[18.9,sg*1.67],[16.4,sg*1.67]],'f fin')+K.line(18.1,sg*1.53,18.1,sg*1.67,'sm');
    // chine / body panel lines
    o+=K.poly([[1.5,sg*.3],[3.6,sg*.55],[5.5,sg*.68]],'sh',false)+K.line(8.2,sg*1.5,16.5,sg*1.45,'sh')});
  // canopy (two seat), frames, seats
  const can=[];for(let i=0;i<=24;i++){const t=i/24;can.push([3.0+t*4.3,.5*Math.pow(Math.sin(Math.PI*Math.pow(t,.8)),.6)])}
  o+=K.poly(mir(can),'dt win')+K.line(3.75,-.42,3.75,.42,'sm')+K.circ(4.5,0,.17,'sm')+K.circ(5.95,0,.17,'sm');
  // dorsal speedbrake, radome joint, M61 gun (right wing root)
  o+=K.poly(mir([[7.6,0],[7.75,.5],[10.4,.62],[10.4,0]]),'sm')+K.nb(9.0,-.8,'SPEEDBRAKE','middle');
  o+=K.line(2.0,-.46,2.0,.46,'sm')+K.circ(8.4,-1.75,.07,'dt')+K.line(8.4,-1.75,10.2,-1.7,'sh')+K.nb(8.2,-2.25,'M61 GUN','end');
  o+=K.rect(9.6,-.08,12.0,.08,'hg')+K.nb(14.6,.42,'ENGINES (2)','middle');
  o+=K.nb(5.2,2.15,'INTAKE','end')+K.nb(7.9,2.75,'CFT','end')+K.nb(10.0,2.8,'CFT STATIONS (HIDDEN)','start');
  o+=K.nb(wLE(3.6)-.3,-3.6,'WING PYLON','end')+K.nb(wTE(3.2)+.3,-3.0,'FLAP')+K.nb(wTE(5.3)+.3,-5.3,'AILERON')+K.nb(19.6,-3.0,'STABILATOR','start');
  o+=K.cn(10.8,-4.2,1,8);
  const ext=K.line(14.1,-HS,20.15,-HS,'sh')+K.line(14.1,HS,20.15,HS,'sh')+
     `<line class="hg" x1="${K.F(K.X(20.0))}" x2="${K.F(K.X(20.0))}" y1="${K.F(K.Y(-HS))}" y2="${K.F(K.Y(HS))}" marker-start="url(#ah)" marker-end="url(#ah)"/>`+
     `<text class="nb" x="${K.F(K.X(20.0)-5)}" y="${K.F(K.Y(0))}" text-anchor="middle" transform="rotate(-90 ${K.F(K.X(20.0)-5)} ${K.F(K.Y(0))})">SPAN NOT ON RECORD</text>`;
  return {groups:[{part:0,svg:o,lab:[3.6,-3.3,'middle']}],extra:ext}},
 views:[
  {r:3.3,k:14,size:60,title:'FRONT VIEW',sub:'TWIN FINS · CFTS',draw:(cx,cy,k)=>{const v=VW(cx,cy,k);let o='';
    [-1,1].forEach(s=>{
      o+=v.p([[s*1.55,-.6],[s*1.62,-3.15],[s*1.75,-3.15],[s*1.7,-.6]],'f fin');
      o+=v.p([[s*1.85,-.62],[s*6.52,-.5],[s*6.52,-.43],[s*1.85,-.42]],'b');
      o+=v.p([[s*1.2,.0],[s*4.3,-.08],[s*4.3,-.02],[s*1.2,.08]],'sm');
      o+=v.p([[s*.9,-.6],[s*1.88,-.6],[s*1.88,.55],[s*.9,.55]],'b')+v.p([[s*1.0,-.5],[s*1.8,-.5],[s*1.8,.38],[s*1.0,.38]],'dt');
      o+=v.e(s*2.05,.15,.26,.42,'b');
      o+=v.l(s*3.45,-.42,s*3.45,-.15,'hg')});
    o+=v.m([[0,-1.55],[.32,-1.45],[.5,-1.1],[.72,-.75],[.85,-.4],[.85,.3],[.55,.6],[0,.65]],'b');
    o+=v.m([[0,-1.55],[.32,-1.45],[.48,-1.1],[0,-1.08]],'dt win')+v.c(0,-.3,.5,'sm')+v.c(0,-.3,.07,'rt');
    return o}},
  {r:1.9,k:9,size:40,title:'SIDE ELEVATION',sub:'F-15E-FAMILY PROFILE',draw:(cx,cy,k)=>{const v=VW(cx,cy,k),T=p=>p.map(([x,y])=>[x-9.7,y]);let o='';
    o+=v.p(T([[15.3,-.85],[17.6,-3.4],[18.9,-3.4],[19.1,-.8]]),'f fin')+v.l(18.1-9.7,-.85,18.3-9.7,-3.3,'hg');
    o+=v.p(T([[0,.1],[1.2,-.3],[3.0,-.62],[4.2,-1.32],[5.6,-1.42],[7.3,-1.12],[9,-1.0],[15,-.88],[17.6,-.7],[18.95,-.55],[18.95,.35],[17.6,.42],[15,.6],[9,.85],[6.0,.8],[5.4,.55],[3.0,.42],[1.2,.3]]),'b');
    o+=v.p(T([[3.0,-.62],[4.2,-1.32],[5.6,-1.42],[7.3,-1.1],[6.0,-.75],[3.4,-.62]]),'dt win')+v.l(3.75-9.7,-.62,4.1-9.7,-1.28,'sm');
    o+=v.p(T([[5.4,-.62],[5.7,.55],[6.5,.6],[6.5,-.55]]),'dt');
    o+=v.p(T([[6.6,.3],[7.4,.15],[14.4,.15],[14.8,.4],[14.4,.62],[7.4,.62]]),'sm');
    o+=v.p(T([[16.0,-.1],[18.2,-.18],[19.43,-.12],[19.43,-.05],[16.0,.0]]),'sm');
    return o}}]};
})();

// F-16I Sufa: two-seat F-16 with dorsal spine and conformal fuel tanks. Plan view.
// Parts (data order): 0 cockpit avionics (helmet sight, HUD), 1 airframe, 2 conformal fuel tanks
(()=>{
const mir=h=>h.concat(h.slice().reverse().map(([x,y])=>[x,-y]));
const flip=p=>p.map(([x,y])=>[x,-y]);
const VW=(cx,cy,k)=>{const f=v=>(+v).toFixed(1),P=([x,y])=>f(cx+x*k)+','+f(cy+y*k);return{
  p:(pts,c='b',cl=true)=>`<path class="${c}" d="M${pts.map(P).join('L')}${cl?'Z':''}"/>`,
  m:(pts,c='b',cl=true)=>`<path class="${c}" d="M${pts.concat(pts.slice().reverse().map(([x,y])=>[-x,y])).map(P).join('L')}${cl?'Z':''}"/>`,
  c:(x,y,r,c='dt')=>`<circle class="${c}" cx="${f(cx+x*k)}" cy="${f(cy+y*k)}" r="${f(r*k)}"/>`,
  e:(x,y,rx,ry,c='dt')=>`<ellipse class="${c}" cx="${f(cx+x*k)}" cy="${f(cy+y*k)}" rx="${f(rx*k)}" ry="${f(ry*k)}"/>`,
  l:(x1,y1,x2,y2,c='sm')=>`<line class="${c}" x1="${f(cx+x1*k)}" y1="${f(cy+y1*k)}" x2="${f(cx+x2*k)}" y2="${f(cy+y2*k)}"/>`}};
const L=14.8,HS=4.9,WT=4.6;
const wLE=y=>7.4+(y-1.4)*.839,wTE=11.1;
BPXS['ARS-F16I']={L,ext:[-.8,15.9],hy:5.25,maxH:500,padTop:10,H:720,short:'F-16I SUFA',title:'PLAN VIEW',
 draw(K){
  // ---- 2 airframe
  const bodyH=[[0,0],[.35,.1],[1.0,.25],[1.8,.37],[2.8,.46],[3.8,.52],[4.3,.55],[5.2,.68],[6.2,.88],[6.9,1.1],[7.4,1.4],[7.6,1.0],[11.1,.98],[11.5,.95],[13.2,.8],[13.9,.68],[13.9,.5],[14.8,.45],[14.8,0]];
  let af=K.poly(mir(bodyH),'b');
  [-1,1].forEach(sg=>{
    af+=K.poly([[7.4,sg*1.4],[wLE(WT),sg*WT],[wTE,sg*WT],[wTE,sg*.98],[7.6,sg*1.0]],'b');
    // wingtip launcher rail and missile (station 1 / 9)
    af+=K.rect(wLE(WT)-.3,sg*WT,wTE+.4,sg*(WT+.1),'dt');
    af+=K.poly([[wLE(WT)-1.0,sg*(WT+.17)],[wLE(WT)-.75,sg*(WT+.1)],[wTE+.3,sg*(WT+.1)],[wTE+.3,sg*(WT+.24)],[wLE(WT)-.75,sg*(WT+.24)]],'hg');
    af+=K.poly([[wTE+.05,sg*(WT+.24)],[wTE+.25,sg*(HS)],[wTE+.35,sg*HS],[wTE+.3,sg*(WT+.24)]],'hg');
    // leading-edge flap hinge, flaperon
    af+=K.line(wLE(1.5)+.45,sg*1.5,wLE(4.5)+.4,sg*4.5,'hg');
    af+=K.poly([[wTE,sg*1.15],[wTE-.65,sg*1.15],[wTE-.65,sg*3.45],[wTE,sg*3.45]],'sm');
    // spar and rib lines
    af+=K.line(wLE(1.3)+1.5,sg*1.2,wLE(4.4)+.5,sg*4.4,'sh')+K.line(9.2,sg*1.1,9.2,sg*2.55,'sh');
    // under-wing stations (hidden)
    [1.95,2.95,3.85].forEach(y=>{const xm=(wLE(y)+wTE)/2-.25;af+=K.rect(xm-.7,sg*(y-.06),xm+.7,sg*(y+.06),'hg')});
    // horizontal stabilator
    af+=K.poly([[11.5,sg*.95],[13.05,sg*2.79],[13.85,sg*2.79],[14.35,sg*1.05],[13.6,sg*.85]],'f fin');
    af+=K.circ(13.2,sg*1.05,.06,'dt');
    // split speedbrakes beside the nozzle
    af+=K.poly([[13.75,sg*.5],[13.75,sg*.82],[14.55,sg*.7],[14.55,sg*.5]],'dt');
    // LERX edge / chine
    af+=K.poly([[1.8,sg*.3],[3.8,sg*.44],[5.4,sg*.6]],'sh',false);
    // ventral intake (hidden)
    af+=K.poly([[3.35,sg*.55],[3.7,sg*.58],[5.2,sg*.58]],'hg',false)});
  af+=K.line(3.35,-.55,3.35,.55,'hg')+K.nb(2.4,-.85,'VENTRAL INTAKE','middle');
  // dorsal spine (two-seat avionics spine)
  af+=K.poly(mir([[5.55,0],[5.8,.22],[6.6,.33],[10.6,.33],[11.2,.18],[11.6,0]]),'sm');
  [7.0,8.4,9.8].forEach(x=>af+=K.line(x,-.33,x,.33,'sh'));
  // vertical fin seen from above, rudder hinge
  af+=K.poly(mir([[10.8,0],[11.7,.08],[14.25,.08],[14.55,0]]),'f fin')+K.line(13.35,-.08,13.35,.08,'sm');
  // nozzle
  af+=K.line(14.15,-.47,14.15,.47,'sh')+K.line(14.5,-.46,14.5,.46,'sh');
  // radome joint, M61 gun port (left side), centreline station
  af+=K.line(1.6,-.35,1.6,.35,'sm')+K.poly([[4.5,.5],[4.8,.62],[5.6,.68]],'sm',false)+K.circ(4.5,.48,.05,'dt')+K.nb(4.0,.95,'M61 GUN','end');
  af+=K.rect(7.5,-.07,9.3,.07,'hg')+K.nb(wTE+.25,3.4,'UNDERWING STATIONS')+K.nb(wTE+.25,3.6,'(UNDERSIDE)');
  af+=K.nb(wTE+.25,-2.3,'FLAPERON')+K.nb(wLE(3.6)-.25,-3.6,'LE FLAP','end')+K.nb(wTE+.6,-4.45,'WINGTIP RAIL')+K.nb(14.0,-3.05,'STABILATOR','middle')+K.nb(12.0,-.5,'SPINE','middle');
  af+=K.cn(9.9,-2.2,2,8);
  // ---- 1 cockpit: two-seat canopy, HUD, seats
  const can=[];for(let i=0;i<=24;i++){const t=i/24;can.push([1.95+t*3.65,.43*Math.pow(Math.sin(Math.PI*Math.pow(t,.75)),.6)])}
  let ck=K.poly(mir(can),'dt win');
  ck+=K.rect(2.2,-.17,2.38,.17,'dt')+K.circ(2.95,0,.16,'sm')+K.circ(4.3,0,.16,'sm')+K.rect(3.45,-.22,3.6,.22,'sm');
  ck+=K.cn(3.7,.0,1,7);
  // ---- 3 conformal fuel tanks (upper shoulders)
  const cft=sg=>K.poly([[5.8,sg*.6],[6.3,sg*.78],[7.1,sg*.93],[10.2,sg*.93],[10.7,sg*.8],[10.85,sg*.6],[10.55,sg*.42],[6.4,sg*.42]],'b')+
    K.line(6.5,sg*.68,10.5,sg*.68,'sh')+[7.2,8.6,9.8].map(x=>K.line(x,sg*.44,x,sg*.91,'sh')).join('')+
    [6.9,7.9,8.9,9.9].map(x=>K.rect(x-.08,sg*.89,x+.08,sg*.97,'dt')).join('');
  return {groups:[
    {part:0,dx:-90,dy:-105,svg:ck,lab:[3.7,.75,'middle']},
    {part:1,svg:af,lab:[12.4,3.95,'start']},
    {part:2,dx:-190,dy:-150,svg:cft(-1)+K.cn(8.2,-.68,3,7),lab:[8.2,-1.6,'middle']},
    {part:2,dx:-190,dy:150,svg:cft(1)}],
   extra:K.line(wTE+.4,-HS,15.4,-HS,'sh')+K.line(wTE+.4,HS,15.4,HS,'sh')+
     `<line class="hg" x1="${K.F(K.X(15.25))}" x2="${K.F(K.X(15.25))}" y1="${K.F(K.Y(-HS))}" y2="${K.F(K.Y(HS))}" marker-start="url(#ah)" marker-end="url(#ah)"/>`+
     `<text class="nb" x="${K.F(K.X(15.25)-5)}" y="${K.F(K.Y(0))}" text-anchor="middle" transform="rotate(-90 ${K.F(K.X(15.25)-5)} ${K.F(K.Y(0))})">SPAN 9.8 m</text>`}},
 views:[
  {r:2.6,k:17,size:60,title:'FRONT VIEW',sub:'CFTS ON UPPER FUSELAGE',draw:(cx,cy,k)=>{const v=VW(cx,cy,k);let o='';
    o+=v.p([[-.08,-.45],[-.1,-3.35],[.1,-3.35],[.08,-.45]],'f fin');
    [-1,1].forEach(s=>{
      o+=v.p([[s*.9,-.05],[s*4.6,.02],[s*4.6,.09],[s*.9,.16]],'b');
      o+=v.p([[s*.7,.2],[s*2.79,.55],[s*2.79,.6],[s*.7,.27]],'sm');
      o+=v.c(s*4.78,.06,.12,'dt')+v.l(s*4.66,.06,s*4.9,.06,'sm');
      o+=v.p([[s*.5,.55],[s*.75,1.05],[s*.82,1.03],[s*.6,.55]],'f fin');
      [1.95,2.95,3.85].forEach(x=>o+=v.l(s*x,.13,s*x,.4,'hg'));
      o+=v.e(s*.82,-.42,.32,.24,'b')});
    o+=v.m([[0,-.98],[.28,-.9],[.45,-.6],[.62,-.45],[.95,-.15],[1.0,.12],[.75,.42],[.5,.55],[0,.58]],'b');
    o+=v.m([[0,-.98],[.28,-.9],[.42,-.58],[0,-.56]],'dt win');
    o+=v.m([[0,.6],[.55,.62],[.58,.9],[.4,1.08],[0,1.1]],'dt')+v.c(0,-.1,.32,'sm')+v.c(0,-.1,.06,'rt');
    return o}},
  {r:1.9,k:11.5,size:40,title:'SIDE ELEVATION',sub:'DORSAL SPINE · CFT',draw:(cx,cy,k)=>{const v=VW(cx,cy,k),T=p=>p.map(([x,y])=>[x-7.4,y]);let o='';
    o+=v.p(T([[10.6,-.72],[12.6,-3.0],[13.6,-3.15],[13.95,-3.0],[14.3,-.6]]),'f fin')+v.l(13.25-7.4,-.62,13.6-7.4,-2.95,'hg');
    o+=v.p(T([[0,.05],[.9,-.2],[1.9,-.42],[2.8,-.95],[4.0,-1.05],[5.4,-.92],[6.5,-.85],[10.6,-.72],[13.9,-.5],[14.8,-.38],[14.8,.32],[13.9,.4],[11.5,.55],[9,.75],[6,.82],[5.2,.95],[3.4,.95],[3.3,.6],[2.0,.4],[.8,.2]]),'b');
    o+=v.p(T([[1.95,-.42],[2.8,-.95],[4.0,-1.05],[5.6,-.88],[5.0,-.62],[2.2,-.42]]),'dt win');
    o+=v.p(T([[5.6,-.62],[6.5,-.68],[10.2,-.62],[10.9,-.4],[10.6,-.15],[6.2,-.2]]),'sm');
    o+=v.p(T([[3.3,.6],[3.4,.95],[3.75,.95],[3.6,.6]]),'dt');
    o+=v.p(T([[11.5,.0],[13.05,-.08],[14.35,-.02],[14.35,.05],[11.5,.07]]),'sm');
    o+=v.l(1.6-7.4,-.32,1.6-7.4,.3,'sh')+v.l(13.9-7.4,-.5,13.9-7.4,.4,'sm');
    return o}}]};
})();

// GBU-57A/B Massive Ordnance Penetrator. Parts (data order): 0 hardened penetrator body, 1 explosive fill, 2 guidance tail kit and fins
BPXS['ARS-GBU57']={L:6.2,padTop:40,ext:[-.06,6.25],hy:.62,diaAt:3.2,short:'GBU-57A/B MOP',title:'SIDE ELEVATION · HALF SECTION',
 draw(K){const R=.4,wall=.06,og=K.ogive(-.04,1.64,R,.045);
  const rB=x=>x<1.6?og(x):x<4.78?R:K.prof([[4.78,R],[4.96,.37]])(x);
  const rIn=x=>x<1.0?0:Math.max(.05,rB(x)-wall);
  const rT=K.prof([[4.92,.378],[4.96,.378],[5.50,.31],[6.14,.31],[6.2,.25]],false);
  // 1 body: exterior with cable raceway and heavy lugs; cutaway shows the solid nose and thick case
  let b=K.body(rB,0,4.96)+K.shade(rB,.15,4.94)+K.ring(1.6,R,'sm',true)+K.ring(3.2,R,'sm',true)+K.half(x=>rB(x)*.93,.08,4.95,-1,1,'sh hi');
  b+=K.poly([[.012,-.045],[-.03,-.035],[-.045,-.015],[-.045,.015],[-.03,.035],[.012,.045]]);
  b+=K.rect(1.75,-R-.03,4.70,-R,'sm')+K.line(1.75,-R-.015,4.70,-R-.015,'sh');
  b+=K.lug(2.55,R+.03)+K.lug(3.85,R+.03);
  b+=K.cutbg(rB,0,4.96)+K.half(x=>rIn(x),1.0,4.90,1)+K.line(1.0,0,1.0,rIn(1.0),'sm')+K.line(4.90,0,4.90,rB(4.90),'sm')+K.line(4.96,-rB(4.96),4.96,rB(4.96),'sm');
  for(let x=.05;x<1.0;x+=.05)b+=K.line(x,0,x+.04,rB(x+.04)*.96,'sh');
  for(let x=1.05;x<4.86;x+=.12)b+=K.line(x,rIn(x)+.004,x+.05,rB(x+.05)-.006,'sh');
  b+=K.rect(4.40,.0,4.86,.10,'dt')+[4.48,4.56,4.64,4.72].map(x=>K.line(x,0,x,.10,'sm')).join('')+K.nb(4.47,.165,'FUZE');
  b+=K.line(1.24,.03,4.34,.03,'hg')+K.nb(.18,R+.10,'SOLID STEEL NOSE')+K.cn(1.2,-R*.45,1);
  // 2 fill
  const fill=K.hatch(K.region(rIn,1.24,4.34,.03))+K.cn(2.4,.2,2);
  // 3 tail kit: adapter, guidance bay, four lattice fins in X
  let tk=K.body(rT,4.92,6.2,'b tk');[4.96,5.50,6.14].forEach(x=>tk+=K.ring(x,rT(x)));tk+=K.shade(rT,4.97,6.18,[.5,.8])+K.rivets(4.94,rT(4.94),7);
  tk+=K.rect(5.05,-rT(5.05)-.03,5.30,-rT(5.05)+.01,'sm');
  const tip=.31+.42*Math.SQRT1_2;
  [-1,1].forEach(sg=>{const a=5.66,c=6.10,r0=.31;tk+=K.rect(a,sg*r0,c,sg*tip,'f fin');
    for(let i=1;i<6;i++){const x=a+(c-a)*i/6;tk+=K.line(x,sg*r0,x,sg*tip,'sm')}
    for(let j=1;j<4;j++){const y=r0+(tip-r0)*j/4;tk+=K.line(a,sg*y,c,sg*y,'sm')}
    tk+=K.line(a-.06,sg*r0,a,sg*(r0+.04),'sm')+K.line(a-.06,sg*r0,a,sg*r0,'sm')});
  tk+=K.cn(5.3,.1,3);
  return {groups:[
    {part:0,dx:-50,svg:b,lab:[1.3,R+.33,'middle']},
    {part:1,dx:-50,dy:130,svg:fill,inner:1,fill:1,lab:[2.8,.62,'middle']},
    {part:2,dx:90,svg:tk,lab:[5.6,.95,'middle']}],
   extra:`<line class="hg" x1="${K.F(K.X(2.0))}" x2="${K.F(K.X(2.0))}" y1="${K.F(K.Y(-R)-16)}" y2="${K.F(K.Y(R)+16)}"/>`+K.nb(2.02,-R-.14,'A')+K.nb(2.02,R+.22,'A')}},
 views:[
  {r:.75,size:70,title:'VIEW FROM AFT',sub:'FOUR LATTICE FINS IN X',draw:(cx,cy,k)=>{let o=BPXV.disc(cx,cy,k,.4)+BPXV.disc(cx,cy,k,.31,'sm')+BPXV.disc(cx,cy,k,.25,'dt')+BPXV.lugTop(cx,cy,k,.43);
    [45,135,225,315].forEach(a=>{const c=Math.cos(a*Math.PI/180),s=Math.sin(a*Math.PI/180),r0=.31*k,r1=.73*k,w=.035*k;
      o+=`<path class="f fin" d="M${(cx+c*r0-s*w).toFixed(1)},${(cy+s*r0+c*w).toFixed(1)}L${(cx+c*r1-s*w).toFixed(1)},${(cy+s*r1+c*w).toFixed(1)}L${(cx+c*r1+s*w).toFixed(1)},${(cy+s*r1-c*w).toFixed(1)}L${(cx+c*r0+s*w).toFixed(1)},${(cy+s*r0-c*w).toFixed(1)}Z"/>`});return o}},
  {r:.4,size:46,title:'SECTION A–A',sub:'THICK CASE · EXPLOSIVE FILL',draw:(cx,cy,k)=>{let o=BPXV.disc(cx,cy,k,.4)+BPXV.disc(cx,cy,k,.34,'sm');
    for(let a=0;a<360;a+=12){const c=Math.cos(a*Math.PI/180),s=Math.sin(a*Math.PI/180);o+=`<line class="sh" x1="${(cx+c*.345*k).toFixed(1)}" y1="${(cy+s*.345*k).toFixed(1)}" x2="${(cx+c*.395*k).toFixed(1)}" y2="${(cy+s*.395*k).toFixed(1)}"/>`}
    return o+BPXV.hatchDisc(cx,cy,k,.335)+BPXV.disc(cx,cy,k,.03,'dt')}}]};

// Elbit Hermes 450: plan view. L 6.1 m, span 10.5 m (record). Straight high-aspect wing, V-tail, rear pusher propeller.
// Parts (data order): 0 sensor turret, 1 fuselage and payload bay (with wing and tail), 2 rotary (Wankel) engine and pusher propeller
(()=>{
const mir=h=>h.concat(h.slice().reverse().map(([x,y])=>[x,-y]));
const VW=(cx,cy,k)=>{const f=v=>(+v).toFixed(1),P=([x,y])=>f(cx+x*k)+','+f(cy+y*k);return{
  p:(pts,c='b',cl=true)=>`<path class="${c}" d="M${pts.map(P).join('L')}${cl?'Z':''}"/>`,
  m:(pts,c='b',cl=true)=>`<path class="${c}" d="M${pts.concat(pts.slice().reverse().map(([x,y])=>[-x,y])).map(P).join('L')}${cl?'Z':''}"/>`,
  c:(x,y,r,c='dt')=>`<circle class="${c}" cx="${f(cx+x*k)}" cy="${f(cy+y*k)}" r="${f(r*k)}"/>`,
  e:(x,y,rx,ry,c='dt')=>`<ellipse class="${c}" cx="${f(cx+x*k)}" cy="${f(cy+y*k)}" rx="${f(rx*k)}" ry="${f(ry*k)}"/>`,
  l:(x1,y1,x2,y2,c='sm')=>`<line class="${c}" x1="${f(cx+x1*k)}" y1="${f(cy+y1*k)}" x2="${f(cx+x2*k)}" y2="${f(cy+y2*k)}"/>`}};
const L=6.1,HS=5.25;
const wLE=y=>1.9+y*.01,wTE=y=>2.55-(y-.27)*.05;
BPXS['ARS-H450']={L,ext:[-.3,6.5],hy:5.55,maxH:560,padTop:12,short:'HERMES 450',title:'PLAN VIEW',
 draw(K){
  // ---- 2 fuselage, payload bay, wing, V-tail
  let fu=K.poly(mir([[0,0],[.06,.12],[.2,.2],[.5,.25],[1.2,.27],[4.2,.26],[4.6,.23],[4.6,0]]),'b');
  fu+=K.line(.5,-.25,.5,.25,'sm')+K.line(1.22,-.27,1.22,.27,'sh');
  fu+=K.rect(1.35,-.18,1.85,.18,'sm')+K.rect(2.7,-.18,3.9,.18,'hg')+K.nb(3.3,.48,'PAYLOAD BAY','middle');  // avionics hatch, payload bay (under)
  fu+=K.circ(1.0,0,.04,'dt')+K.circ(3.0,0,.04,'dt')+K.line(.8,0,1.15,0,'sm')+K.line(3.9,0,4.3,0,'sm');      // antennas
  [-1,1].forEach(sg=>{
    fu+=K.poly([[wLE(.27),sg*.27],[wLE(HS),sg*HS],[wTE(HS)-.05,sg*HS],[wTE(HS),sg*(HS-.06)],[wTE(.27),sg*.27]],'b');
    fu+=K.poly([[wTE(.45),sg*.45],[wTE(.45)-.16,sg*.45],[wTE(3.0)-.15,sg*3.0],[wTE(3.0),sg*3.0]],'sm');   // flap
    fu+=K.poly([[wTE(3.1),sg*3.1],[wTE(3.1)-.14,sg*3.1],[wTE(5.0)-.13,sg*5.0],[wTE(5.0),sg*5.0]],'sm');   // aileron
    fu+=K.line(2.08,sg*.3,2.08,sg*(HS-.1),'sh');
    [1.2,2.0].forEach(y=>fu+=K.rect(1.75,sg*(y-.04),2.45,sg*(y+.04),'hg'));                                 // hardpoints (reported)
    fu+=K.poly([[5.05,sg*.16],[5.45,sg*1.08],[5.75,sg*1.08],[5.85,sg*.14]],'f fin')+K.line(5.55,sg*.25,5.67,sg*1.0,'hg');
    fu+=K.circ(2.2,sg*.6,.06,'hg')});
  fu+=K.poly(mir([[4.6,.23],[5.9,.13],[5.9,0]]).filter(([x])=>x>=4.6),'sm');
  fu+=K.nb(2.35,-3.6,'FLAP / AILERON')+K.nb(2.65,1.62,'HARDPOINTS (REPORTED)')+K.nb(5.9,-1.25,'V-TAIL','middle');
  fu+=K.cn(3.3,-.0,2,7);
  // ---- 1 sensor turret (gimballed ball under the nose)
  let tu=K.circ(.62,0,.2,'b')+K.circ(.62,0,.13,'sm')+K.rect(.54,-.08,.7,.08,'dt')+K.circ(.62,0,.03,'rt');
  // ---- 3 rear cowling with rotary engine and two-blade pusher propeller
  const rC=K.prof([[4.6,.23],[5.9,.12]]);
  let en=K.body(rC,4.6,5.9,'b')+K.rect(4.75,-.13,5.35,.13,'hg')+K.nb(5.05,.42,'ENGINE','middle');
  [5.0,5.5].forEach(x=>en+=K.circ(x,-.17,.03,'dt'));
  en+=K.poly([[5.9,-.1],[6.1,0],[5.9,.1]],'dt');
  en+=K.poly([[5.97,-.75],[6.03,-.72],[6.03,.72],[5.97,.75],[5.94,0]],'f fin')+K.line(6.0,-.7,6.0,.7,'sh');
  return {groups:[
    {part:0,dx:-120,dy:60,svg:tu,inner:1,lab:[.62,.5,'middle']},
    {part:1,svg:fu,lab:[2.9,-2.5,'start']},
    {part:2,dx:120,svg:en,lab:[5.3,1.15,'start']}],
   extra:K.line(2.6,-HS,6.75,-HS,'sh')+K.line(2.6,HS,6.75,HS,'sh')+
     `<line class="hg" x1="${K.F(K.X(6.6))}" x2="${K.F(K.X(6.6))}" y1="${K.F(K.Y(-HS))}" y2="${K.F(K.Y(HS))}" marker-start="url(#ah)" marker-end="url(#ah)"/>`+
     `<text class="nb" x="${K.F(K.X(6.6)-5)}" y="${K.F(K.Y(0))}" text-anchor="middle" transform="rotate(-90 ${K.F(K.X(6.6)-5)} ${K.F(K.Y(0))})">SPAN 10.5 m</text>`}},
 views:[
  {r:1.1,k:18,size:40,title:'FRONT VIEW',sub:'V-TAIL · FIXED GEAR · TURRET',draw:(cx,cy,k)=>{const v=VW(cx,cy,k);let o='';
    o+=v.c(0,0,.75,'hg');
    [-1,1].forEach(s=>{o+=v.p([[s*.08,-.2],[s*.85,-1.0],[s*.9,-.95],[s*.15,-.15]],'f fin');
      o+=v.p([[s*.25,-.14],[s*5.25,-.2],[s*5.25,-.13],[s*.25,-.06]],'b');
      [1.2,2.0].forEach(y=>o+=v.l(s*y,-.1,s*y,.05,'hg'));
      o+=v.l(s*.2,.2,s*.75,.75,'sm')+v.e(s*.78,.82,.05,.12,'b')});
    o+=v.c(0,0,.27,'b')+v.c(0,.32,.17,'dt')+v.c(0,.32,.06,'sm')+v.l(0,.25,0,.85,'sm')+v.e(0,.92,.05,.1,'b');
    return o}},
  {r:1.2,k:26,size:40,title:'SIDE ELEVATION',draw:(cx,cy,k)=>{const v=VW(cx,cy,k),T=p=>p.map(([x,y])=>[x-3.05,y]);let o='';
    o+=v.p(T([[5.05,-.1],[5.5,-.95],[5.78,-.95],[5.85,-.08]]),'f fin');
    o+=v.p(T([[0,.0],[.05,-.12],[.25,-.25],[.8,-.3],[4.2,-.26],[5.9,-.1],[5.9,.08],[4.2,.2],[.8,.27],[.15,.18]]),'b');
    o+=v.p(T([[1.9,-.3],[2.55,-.3],[2.55,-.25],[1.9,-.25]]),'sm');
    o+=v.c(.62-3.05,.38,.15,'dt')+v.l(.62-3.05,.27,.62-3.05,.23,'sm');
    o+=v.l(6.0-3.05,-.65,6.0-3.05,.65,'sm')+v.l(.6-3.05,.27,.6-3.05,.65,'sm')+v.c(.6-3.05,.7,.07,'b')+v.l(2.3-3.05,.25,2.45-3.05,.7,'sm')+v.c(2.45-3.05,.75,.09,'b');
    return o}}]};
})();

// Elbit Hermes 900: plan view. L 8.3 m, span 15 m (record). Long straight wing, V-tail with ventral fin, rear pusher propeller.
// Parts (data order): 0 sensor turret, 1 fuselage and payload bay (with wing and tail), 2 engine / propeller
(()=>{
const mir=h=>h.concat(h.slice().reverse().map(([x,y])=>[x,-y]));
const VW=(cx,cy,k)=>{const f=v=>(+v).toFixed(1),P=([x,y])=>f(cx+x*k)+','+f(cy+y*k);return{
  p:(pts,c='b',cl=true)=>`<path class="${c}" d="M${pts.map(P).join('L')}${cl?'Z':''}"/>`,
  m:(pts,c='b',cl=true)=>`<path class="${c}" d="M${pts.concat(pts.slice().reverse().map(([x,y])=>[-x,y])).map(P).join('L')}${cl?'Z':''}"/>`,
  c:(x,y,r,c='dt')=>`<circle class="${c}" cx="${f(cx+x*k)}" cy="${f(cy+y*k)}" r="${f(r*k)}"/>`,
  e:(x,y,rx,ry,c='dt')=>`<ellipse class="${c}" cx="${f(cx+x*k)}" cy="${f(cy+y*k)}" rx="${f(rx*k)}" ry="${f(ry*k)}"/>`,
  l:(x1,y1,x2,y2,c='sm')=>`<line class="${c}" x1="${f(cx+x1*k)}" y1="${f(cy+y1*k)}" x2="${f(cx+x2*k)}" y2="${f(cy+y2*k)}"/>`}};
const L=8.3,HS=7.5,XE=6.64;
const wLE=y=>2.75+(y-.34)*.014,wTE=y=>3.7-(y-.34)*.056;
BPXS['ARS-H900']={L,ext:[-.4,8.8],hy:7.8,maxH:580,padTop:12,short:'HERMES 900',title:'PLAN VIEW',
 draw(K){
  // ---- 2 fuselage, payload bay, wing, V-tail
  let fu=K.poly(mir([[0,0],[.08,.15],[.3,.27],[.8,.33],[1.6,.345],[5.6,.33],[XE,.27],[XE,0]]),'b');
  fu+=K.poly(mir([[.35,0],[.45,.14],[.8,.21],[1.3,.2],[1.55,.1],[1.6,0]]),'sm')+K.nb(1.0,-.55,'SATCOM FAIRING','middle');
  fu+=K.line(.3,-.27,.3,.27,'sh')+K.line(1.66,-.345,1.66,.345,'sh')+K.line(5.4,-.33,5.4,.33,'sh');
  fu+=K.rect(1.85,-.2,2.55,.2,'sm')+K.rect(3.95,-.22,5.3,.22,'hg')+K.nb(4.6,.58,'PAYLOAD BAY','middle');
  fu+=K.rect(.95,-.12,1.5,.12,'hg')+K.circ(2.2,0,.04,'dt')+K.circ(4.0,0,.04,'dt')+K.line(5.5,0,6.0,0,'sm');
  [-1,1].forEach(sg=>{
    fu+=K.poly([[wLE(.34),sg*.34],[wLE(HS),sg*HS],[wTE(HS)-.06,sg*HS],[wTE(HS),sg*(HS-.08)],[wTE(.34),sg*.34]],'b');
    fu+=K.poly([[wTE(.55),sg*.55],[wTE(.55)-.22,sg*.55],[wTE(4.2)-.2,sg*4.2],[wTE(4.2),sg*4.2]],'sm');     // flap
    fu+=K.poly([[wTE(4.3),sg*4.3],[wTE(4.3)-.18,sg*4.3],[wTE(7.2)-.15,sg*7.2],[wTE(7.2),sg*7.2]],'sm');   // aileron
    fu+=K.line(3.0,sg*.36,3.0,sg*(HS-.1),'sh')+K.line(wLE(2.4),sg*2.4,wTE(2.4),sg*2.4,'sh')+K.line(wLE(5.4),sg*5.4,wTE(5.4),sg*5.4,'sh');
    fu+=K.rect(3.1,sg*.45,3.6,sg*.75,'hg');                                                                 // main gear bay (under)
    fu+=K.poly([[6.95,sg*.22],[7.5,sg*1.5],[7.85,sg*1.5],[7.95,sg*.2]],'f fin')+K.line(7.62,sg*.3,7.72,sg*1.42,'hg')});
  fu+=K.poly([[XE,.27],[8.0,.14],[8.0,-.14],[XE,-.27]],'sm',false)+K.line(7.0,0,8.0,0,'hg');
  fu+=K.nb(wTE(5.6)+.2,-5.6,'AILERON')+K.nb(wTE(2.6)+.2,-2.6,'FLAP')+K.nb(7.7,-1.85,'V-TAIL','middle')+K.nb(6.9,-.55,'VENTRAL FIN (UNDER)','end')+K.nb(3.75,1.05,'MAIN GEAR BAY');
  fu+=K.cn(3.2,-0.0,2,7);
  // ---- 1 sensor turret under the nose
  let tu=K.circ(.8,0,.26,'b')+K.circ(.8,0,.17,'sm')+K.rect(.7,-.1,.9,.1,'dt')+K.circ(.8,0,.035,'rt');
  // ---- 3 engine cowling and pusher propeller
  const rC=K.prof([[XE,.27],[8.0,.14]]);
  let en=K.body(rC,XE,8.0,'b')+K.rect(6.8,-.17,7.6,.17,'hg');
  [7.0,7.5].forEach(x=>en+=K.circ(x,-.2,.035,'dt'));
  en+=K.poly([[8.0,-.13],[8.3,0],[8.0,.13]],'dt');
  en+=K.poly([[8.08,-.95],[8.15,-.92],[8.15,.92],[8.08,.95],[8.04,0]],'f fin')+K.line(8.11,-.9,8.11,.9,'sh');
  return {groups:[
    {part:0,dx:-130,dy:70,svg:tu,inner:1,lab:[.8,.6,'middle']},
    {part:1,svg:fu,lab:[4.3,-3.6,'start']},
    {part:2,dx:120,svg:en,lab:[7.3,1.3,'start']}],
   extra:K.line(3.4,-HS,8.95,-HS,'sh')+K.line(3.4,HS,8.95,HS,'sh')+
     `<line class="hg" x1="${K.F(K.X(8.8))}" x2="${K.F(K.X(8.8))}" y1="${K.F(K.Y(-HS))}" y2="${K.F(K.Y(HS))}" marker-start="url(#ah)" marker-end="url(#ah)"/>`+
     `<text class="nb" x="${K.F(K.X(8.8)-5)}" y="${K.F(K.Y(0))}" text-anchor="middle" transform="rotate(-90 ${K.F(K.X(8.8)-5)} ${K.F(K.Y(0))})">SPAN 15 m</text>`}},
 views:[
  {r:1.4,k:13,size:40,title:'FRONT VIEW',sub:'V-TAIL · VENTRAL FIN · TURRET',draw:(cx,cy,k)=>{const v=VW(cx,cy,k);let o='';
    o+=v.c(0,0,.95,'hg');
    [-1,1].forEach(s=>{o+=v.p([[s*.08,-.22],[s*.95,-1.3],[s*1.0,-1.25],[s*.15,-.15]],'f fin');
      o+=v.p([[s*.3,-.18],[s*7.5,-.3],[s*7.5,-.22],[s*.3,-.08]],'b');
      o+=v.l(s*.25,.25,s*.85,.95,'sm')+v.e(s*.88,1.02,.06,.15,'b')});
    o+=v.p([[-.04,.2],[.04,.2],[.03,.95],[-.03,.95]],'f fin');
    o+=v.c(0,0,.34,'b')+v.e(0,-.36,.2,.08,'sm')+v.c(0,.42,.24,'dt')+v.c(0,.42,.08,'sm')+v.l(0,.3,0,1.0,'sm')+v.e(0,1.08,.06,.12,'b');
    return o}},
  {r:1.5,k:20,size:40,title:'SIDE ELEVATION',sub:'GEAR EXTENDED',draw:(cx,cy,k)=>{const v=VW(cx,cy,k),T=p=>p.map(([x,y])=>[x-4.15,y]);let o='';
    o+=v.p(T([[6.95,-.14],[7.5,-1.3],[7.85,-1.3],[7.95,-.1]]),'f fin')+v.p(T([[7.1,.12],[7.6,.95],[7.85,.95],[7.95,.1]]),'f fin');
    o+=v.p(T([[0,.02],[.08,-.15],[.35,-.3],[.6,-.45],[1.3,-.48],[1.7,-.36],[5.6,-.32],[8.0,-.12],[8.0,.1],[5.6,.25],[1.6,.33],[.3,.25],[.05,.15]]),'b');
    o+=v.p(T([[2.75,-.36],[3.7,-.36],[3.7,-.3],[2.75,-.3]]),'sm');
    o+=v.c(.8-4.15,.5,.2,'dt')+v.l(.8-4.15,.33,.8-4.15,.31,'sm');
    o+=v.l(8.12-4.15,-.9,8.12-4.15,.9,'sm')+v.l(1.0-4.15,.3,1.0-4.15,.85,'sm')+v.c(1.0-4.15,.92,.08,'b')+v.l(3.35-4.15,.25,3.5-4.15,.95,'sm')+v.c(3.5-4.15,1.03,.1,'b');
    return o}}]};
})();

// IC-V82-style handheld VHF radio, drawn as the ordinary consumer device lying on its side (front elevation). Parts: 0 casing and electronics, 1 battery pack
(()=>{const rr=(K,x0,y0,x1,y1,r,c='b')=>`<rect class="${c}" x="${K.F(K.X(x0))}" y="${K.F(K.Y(y0))}" width="${K.F(K.Z(x1-x0))}" height="${K.F(K.Z(y1-y0))}" rx="${K.F(K.Z(r))}"/>`;
BPXS['ARS-ICV82']={L:.33,ext:[-.01,.34],hy:.045,short:'IC-V82-TYPE RADIO · CONSUMER DEVICE',title:'FRONT ELEVATION · SHOWN LYING',
 note:"ILLUSTRATIVE DRAWING OF AN ORDINARY IC-V82-TYPE HANDHELD RADIO, NOT THE MODIFIED DEVICE",
 draw(K){// x runs from the antenna tip (0) to the base of the battery pack
  let c='';
  // antenna: tapered rubber whip and its base
  c+=K.poly([[.0,-.004],[.15,-.0065],[.15,.0065],[.0,.004]],'b')+K.circ(.002,0,.0045,'dt');
  for(let x=.03;x<.15;x+=.02)c+=K.line(x,-.0045-(x/.15)*.002,x,.0045+(x/.15)*.002,'sh');
  c+=K.rect(.15,-.009,.165,.009,'dt');
  // top: volume and channel knobs, PTT on the side
  c+=K.rect(.165,.012,.178,.024,'dt')+K.rect(.165,-.024,.176,-.012,'dt');
  [.0135,.0165,.0195,.0225].forEach(y=>c+=K.line(.165,y,.178,y,'sh'));
  // main body
  c+=rr(K,.178,-.029,.292,.029,.006)+rr(K,.181,-.026,.289,.026,.0045,'sm');
  c+=K.rect(.195,-.012,.205,.012,'dt')+K.nb(.2,-.016,'LED','middle');
  // LCD and keypad
  c+=rr(K,.21,-.02,.235,.02,.002,'dt')+rr(K,.213,-.017,.232,.017,.001,'dt win')+K.nb(.2225,.0015,'CH 16','middle');
  for(let i=0;i<4;i++)for(let j=0;j<3;j++)c+=rr(K,.241+i*.0085,-.016+j*.011,.247+i*.0085,-.009+j*.011,.0015,'dt');
  // speaker grille
  for(let y=-.02;y<=.02;y+=.004)c+=K.line(.274,y,.286,y,'sm');
  c+=K.rect(.2,-.029,.228,-.033,'dt')+K.nb(.214,-.036,'PTT','middle');
  c+=K.nb(.25,.024,'ICOM-STYLE LABEL','middle')+K.cn(.258,-.022,1,8);
  // battery pack clipped to the base
  let b=rr(K,.292,-.028,.33,.028,.004)+K.line(.295,-.028,.295,.028,'sm')+K.rect(.3,-.031,.31,-.028,'dt')+K.rect(.3,.028,.31,.031,'dt');
  [-.016,-.008,0,.008,.016].forEach(y=>b+=K.line(.315,y,.326,y,'sh'));b+=K.nb(.312,.038,'BATTERY PACK','middle')+K.cn(.312,-.016,2,8);
  return {groups:[{part:0,dx:-40,svg:c,lab:[.2,.048,'middle']},{part:1,dx:70,svg:b,lab:[.312,-.05,'middle'],name:'BATTERY PACK · PETN'}]}},
 views:[{r:.07,size:70,title:'SIDE VIEW',sub:'BELT CLIP · BATTERY PACK',draw:(cx,cy,k)=>{const w=.017*k,h=.06*k;return `<rect class="b" x="${(cx-w).toFixed(1)}" y="${(cy-h).toFixed(1)}" width="${(2*w).toFixed(1)}" height="${(1.7*h).toFixed(1)}" rx="4"/><rect class="dt" x="${(cx-w).toFixed(1)}" y="${(cy+.7*h).toFixed(1)}" width="${(2*w+4).toFixed(1)}" height="${(.3*h).toFixed(1)}" rx="3"/><path class="f fin" d="M${(cx+w).toFixed(1)},${(cy-h*.6).toFixed(1)}L${(cx+w+5).toFixed(1)},${(cy-h*.5).toFixed(1)}L${(cx+w+5).toFixed(1)},${(cy+h*.5).toFixed(1)}L${(cx+w).toFixed(1)},${(cy+h*.6).toFixed(1)}"/><line class="sm" x1="${cx}" x2="${cx}" y1="${(cy-h).toFixed(1)}" y2="${(cy-h-14).toFixed(1)}"/>`}}]};})();

// M339 120 mm HE-MP-T: programmable nose fuze, HE body, fin-stabilised tail inside a combustible case on a steel stub base.
// Parts (data order): 0 fuze, 1 HE projectile body, 2 combustible case / propellant
BPXS['ARS-M339']={L:.984,ext:[-.02,1.0],hy:.2,padTop:6,diaAt:.36,short:'M339 · 120 mm HE-MP-T',title:'SIDE ELEVATION · HALF SECTION',
 draw(K){const R=.06;
  const fz=K.prof([[0,.011],[.012,.016],[.10,.034]],false);
  const og=K.ogive(.10,.19,R,.034);
  const rB=x=>x<.10?fz(x):x<.29?Math.max(.034,og(x)):x<.465?R:x<.53?K.prof([[.465,R],[.53,.046]],false)(x):.046;
  const rBoom=.021,fin0=.70,fin1=.80;
  const rC=K.prof([[.50,.061],[.535,.069],[.925,.069]],false);
  const hidden=(d)=>`<path class="hg" d="${d}"/>`;
  // 1 fuze
  let f=K.body(fz,0,.10)+K.shade(fz,.006,.098,[.5])+K.ring(.03,fz(.03),'sh')+K.ring(.062,fz(.062),'sh');
  f+=K.rect(.004,-.004,.016,.004,'sm')+K.cn(.068,0,1,7);
  // 2 body: exterior top, cutaway bottom; tail boom and fins inside the case (hidden above, cut below)
  const rIn=x=>Math.max(.012,rB(x)-.007);
  let b=K.body(rB,.10,.53)+K.shade(rB,.11,.52,[.4,.75])+K.ring(.29,R,'sm',true)+K.half(x=>rB(x)*.9,.12,.52,-1,1,'sh hi');
  b+=K.rect(.405,-R-.0025,.44,-R+.004,'dt')+K.rect(.405,R-.004,.44,R+.0025,'dt');           // obturator band
  b+=K.cutbg(rB,.10,.53)+K.half(rIn,.106,.525,1);
  b+=K.rect(.10,-.012,.13,.012,'sm');
  // tail boom, fins, tracer
  b+=hidden(`M${K.P(.53,-rBoom)}L${K.P(fin1,-rBoom)}`)+K.line(.53,rBoom,fin1,rBoom)+K.line(.53,0,fin1,0,'sh');
  b+=hidden(`M${K.P(fin0,-rBoom)}L${K.P(fin0+.025,-.057)}L${K.P(fin1,-.057)}L${K.P(fin1,-rBoom)}`);
  b+=`<path class="f fin" d="M${K.P(fin0,rBoom)}L${K.P(fin0+.025,.057)}L${K.P(fin1,.057)}L${K.P(fin1,rBoom)}Z"/>`+K.line(fin0+.03,.04,fin1-.004,.04,'sh');
  b+=K.rect(fin1,-.013,fin1+.022,.013,'dt');
  b+=K.cn(.2,-.03,2);
  // 2 fill (CLX663)
  const fill=K.hatch(K.region(rIn,.13,.455,0))+K.cn(.36,.03,2,8);
  // 3 case: combustible body (exterior above, wall and propellant grains below), steel stub base, primer
  let c=`<path class="b" d="${K.halfD(rC,.50,.925,-1)}L${K.P(.925,0)}L${K.P(.50,0)}Z"/>`+K.shade(rC,.51,.92,[.45,.8]);
  const cbg=K.cutbg(rC,.50,.925);c+=K.half(rC,.50,.925,1)+K.half(x=>rC(x)-.006,.506,.925,1,1,'sm');
  [.60,.75].forEach(x=>c+=K.ring(x,rC(x),'sh',true));
  for(let x=.555;x<.915;x+=.022)for(let y=.03;y<.06;y+=.014){if(x>fin0-.01&&x<fin1+.03&&y<.06)continue;c+=K.circ(x,y,.0035,'sm')}
  const st=K.prof([[.925,.071],[.975,.071],[.976,.078],[.984,.078]],false);
  c+=K.body(st,.925,.984,'b tk')+K.ring(.95,.071,'sh')+K.rect(.97,-.009,.984,.009,'dt')+K.line(.84,0,.97,0,'hg');
    c+=K.cn(.66,-.035,3);
  return {groups:[
    {part:0,dx:-80,dy:0,svg:f,lab:[.02,.105,'start']},
    {part:2,dx:90,dy:0,svg:cbg,inner:1},
    {part:1,dx:-30,dy:-90,svg:b,lab:[.30,-.10,'middle']},
    {part:1,dx:-30,dy:120,svg:fill,inner:1,fill:1},
    {part:2,dx:90,dy:0,svg:c,lab:[.74,.145,'middle']}],
   extra:`<line class="hg" x1="${K.F(K.X(.26))}" x2="${K.F(K.X(.26))}" y1="${K.F(K.Y(-R)-16)}" y2="${K.F(K.Y(R)+16)}"/>`+K.nb(.255,-R-.032,'A')+K.nb(.255,R+.04,'A')+K.nb(.405,-R-.012,'OBTURATOR')+K.nb(.20,.022,'CLX663 2.3 kg')+K.nb(.62,.085,'FIN TAIL','middle')+K.nb(.80,.085,'TRACER','middle')+K.nb(.955,.11,'STEEL STUB BASE','middle')+K.nb(.835,-.011,'PRIMER TUBE')
    +K.nb(0,-.1,'FUZE: PD · PD DELAY · AIRBURST (PROGRAMMABLE)')}},
 views:[
  {r:.078,size:52,title:'VIEW FROM AFT',sub:'STUB BASE · PRIMER',draw:(cx,cy,k)=>BPXV.disc(cx,cy,k,.078)+BPXV.disc(cx,cy,k,.071,'sm')+BPXV.disc(cx,cy,k,.03,'sm')+BPXV.disc(cx,cy,k,.009,'dt')},
  {r:.06,size:44,title:'SECTION A–A',sub:'BODY · CLX663 FILL',draw:(cx,cy,k)=>BPXV.disc(cx,cy,k,.06)+BPXV.hatchDisc(cx,cy,k,.053)}]};

// M825 / M825A1 155 mm white phosphorus: base-ejecting carrier, nose time fuze and expelling charge,
// canister of 116 WP-impregnated felt wedges around an X-rib, ejectable base plate.
// Parts (data order): 0 fuze, 1 carrier body, 2 116 WP felt wedges, 3 base plate. Length not on record: 0.87 m drawn.
BPXS['ARS-M825']={L:.87,ext:[-.02,.89],hy:.17,padTop:6,diaAt:.45,short:'M825A1 · 155 mm WP',title:'SIDE ELEVATION · HALF SECTION',
 draw(K){const R=.0775,wall=.0095,xb=.83;
  const fz=K.prof([[0,.008],[.015,.014],[.10,.033]],false);
  const og=K.ogive(.10,.25,R,.033);
  const rB=x=>x<.10?fz(x):x<.35?Math.max(.033,og(x)):R;
  const rIn=x=>Math.max(.02,rB(x)-wall);
  // 1 fuze (time fuze, ogival)
  let f=K.body(fz,0,.10)+K.shade(fz,.005,.098,[.5])+K.ring(.035,fz(.035),'sh')+K.ring(.07,fz(.07),'sm');
  [.075,.082,.089].forEach(x=>f+=K.ring(x,fz(x),'sh'));f+=K.cn(.068,0,1,7);
  // 2 carrier body: exterior top, cut wall below, expelling charge, pusher plate, canister liner, X-rib hub
  let b=K.body(rB,.10,xb)+K.shade(rB,.11,xb-.005,[.4,.72])+K.ring(.35,R,'sm',true)+K.half(x=>rB(x)*.9,.12,xb-.005,-1,1,'sh hi');
  b+=K.rect(.37,-R-.002,.39,-R+.004,'dt')+K.rect(.37,R-.004,.39,R+.002,'dt');                 // bourrelet
  b+=K.rect(.765,-R-.003,.795,-R+.005,'dt')+K.rect(.765,R-.005,.795,R+.003,'dt');             // rotating band
  [.772,.78,.788].forEach(x=>b+=K.ring(x,R+.002,'sh'));
  b+=K.cutbg(rB,.10,xb)+K.half(rIn,.105,xb,1);
  b+=K.rect(.10,-.012,.125,.012,'sm')+K.poly([[.125,0],[.125,.022],[.175,.04],[.19,.04],[.19,0]],'dt');  // fuze adapter / expelling charge
  b+=K.rect(.19,0,.20,R-wall,'sm');                                                       // pusher plate
  b+=K.line(.20,R-wall-.004,xb,R-wall-.004,'sm');                                         // canister liner
  b+=K.rect(.20,0,xb,.007,'sm');                                                          // X-rib hub
  b+=K.cn(.26,-.035,2);
  // 3 wedges: four layers, slices of felt wedges in the cut plane
  let wg='';const x0=.205,x1=.825,nL=4,lw=(x1-x0)/nL,ri=.0095,ro=R-wall-.006;
  for(let i=0;i<nL;i++){const a=x0+i*lw+.003,c=x0+(i+1)*lw-.003;for(let j=0;j<2;j++){const p=a+(c-a)*j/2+.002,q=a+(c-a)*(j+1)/2-.002;
    wg+=K.hatch(`M${K.P(p,ri)}L${K.P(q,ri)}L${K.P(q,ro)}L${K.P(p,ro)}Z`)}}
  wg+=K.cn(.50,.035,3,8);
  // 4 base plate (ejected)
  let bp=K.body(x=>R,xb,.87,'b tk')+K.ring(xb+.012,R,'sh')+K.ring(.86,R*.96,'sm');
  [xb+.004,xb+.008].forEach(x=>bp+=K.ring(x,R-.002,'sh'));
  bp+=K.rect(.84,-.012,.87,.012,'dt')+K.cn(.85,-.04,4,7);
  return {groups:[
    {part:0,dx:-70,svg:f,lab:[.02,.095,'start']},
    {part:1,dx:-20,dy:-70,svg:b,lab:[.42,-.115,'middle']},
    {part:2,dx:-20,dy:110,svg:wg,inner:1,lab:[.50,.115,'middle']},
    {part:3,dx:80,svg:bp,lab:[.85,.13,'middle']}],
   extra:`<line class="hg" x1="${K.F(K.X(.56))}" x2="${K.F(K.X(.56))}" y1="${K.F(K.Y(-R)-16)}" y2="${K.F(K.Y(R)+16)}"/>`+K.nb(.555,-R-.03,'C')+K.nb(.555,R+.036,'C')
    +K.nb(.15,.105,'EXPELLING CHARGE','middle')+K.nb(.37,-R-.01,'BOURRELET')+K.nb(.78,-R-.01,'ROTATING BAND','middle')
    +K.nb(.85,.105,'EJECTS AFT','middle')+K.nb(0,-.12,'116 FELT WEDGES · ABOUT 12.75 lb WP · BURNS AT 815 C')}},
 views:[
  {r:.0775,size:50,title:'VIEW FROM AFT',sub:'BASE PLATE',draw:(cx,cy,k)=>BPXV.disc(cx,cy,k,.0775)+BPXV.disc(cx,cy,k,.0775*.96,'sm')+BPXV.disc(cx,cy,k,.012,'dt')},
  {r:.0775,size:60,title:'SECTION C–C',sub:'FELT WEDGES · X-RIB',draw:(cx,cy,k)=>{let o=BPXV.disc(cx,cy,k,.0775)+BPXV.disc(cx,cy,k,.0775-.0095,'sm');
    const ro=(.0775-.0155)*k,ri=.0095*k,n=28;
    for(let i=0;i<n;i++){const a0=(i/n)*2*Math.PI+.02,a1=((i+1)/n)*2*Math.PI-.02,pt=(r,a)=>(cx+r*Math.cos(a)).toFixed(1)+','+(cy+r*Math.sin(a)).toFixed(1);
      o+=`<path class="hx" d="M${pt(ri,a0)}L${pt(ro,a0)}A${ro.toFixed(1)},${ro.toFixed(1)} 0 0 1 ${pt(ro,a1)}L${pt(ri,a1)}Z"/><path class="sm" d="M${pt(ri,a0)}L${pt(ro,a0)}A${ro.toFixed(1)},${ro.toFixed(1)} 0 0 1 ${pt(ro,a1)}L${pt(ri,a1)}Z"/>`}
    [45,135].forEach(d=>{const c=Math.cos(d*Math.PI/180),s=Math.sin(d*Math.PI/180),r=(.0775-.0095)*k;o+=`<line class="sm" stroke-width="2" x1="${(cx-c*r).toFixed(1)}" y1="${(cy-s*r).toFixed(1)}" x2="${(cx+c*r).toFixed(1)}" y2="${(cy+s*r).toFixed(1)}"/>`});
    return o+BPXV.disc(cx,cy,k,.0095,'dt')}}]};

// M999 Barak Eitan 155 mm cargo shell: nose time fuze, expelling charge, carrier body holding a stack of 9 submunitions
// (tungsten fragment liners), base. Parts (data order): 0 fuze, 1 carrier body with 9 submunitions, 2 base. Length not on record: 0.88 m drawn.
BPXS['ARS-M999']={L:.88,ext:[-.02,.90],hy:.17,padTop:6,diaAt:.47,short:'M999 BARAK EITAN · 155 mm',title:'SIDE ELEVATION · HALF SECTION',
 draw(K){const R=.0775,wall=.0095,xb=.83;
  const fz=K.prof([[0,.008],[.015,.014],[.10,.033]],false);
  const og=K.ogive(.10,.25,R,.033);
  const rB=x=>x<.10?fz(x):x<.35?Math.max(.033,og(x)):R;
  const rIn=x=>Math.max(.02,rB(x)-wall);
  // 1 fuze
  let f=K.body(fz,0,.10)+K.shade(fz,.005,.098,[.5])+K.ring(.035,fz(.035),'sh')+K.ring(.07,fz(.07),'sm');
  [.075,.082,.089].forEach(x=>f+=K.ring(x,fz(x),'sh'));f+=K.cn(.068,0,1,7);
  // 2 carrier body
  let b=K.body(rB,.10,xb)+K.shade(rB,.11,xb-.005,[.4,.72])+K.ring(.35,R,'sm',true)+K.half(x=>rB(x)*.9,.12,xb-.005,-1,1,'sh hi');
  b+=K.rect(.37,-R-.002,.39,-R+.004,'dt')+K.rect(.37,R-.004,.39,R+.002,'dt');
  b+=K.rect(.765,-R-.003,.795,-R+.005,'dt')+K.rect(.765,R-.005,.795,R+.003,'dt');
  [.772,.78,.788].forEach(x=>b+=K.ring(x,R+.002,'sh'));
  b+=K.cutbg(rB,.10,xb)+K.half(rIn,.105,xb,1);
  b+=K.rect(.10,-.012,.125,.012,'sm')+K.poly([[.125,0],[.125,.022],[.175,.04],[.19,.04],[.19,0]],'dt');
  b+=K.rect(.19,0,.198,R-wall,'sm');
  b+=K.cn(.26,-.035,2);
  // 2b nine submunitions (cut plane, lower half): case, fragment liner, fill, fuze cap, stabiliser
  let sm='';const s0=.2,s1=.828,n=9,sl=(s1-s0)/n,ro=R-wall-.002;
  for(let i=0;i<n;i++){const a=s0+i*sl+.002,c=a+sl-.004;
    sm+=K.rect(a,0,c,ro,'dt')+K.hatch(`M${K.P(a+.008,0)}L${K.P(c-.008,0)}L${K.P(c-.008,ro-.012)}L${K.P(a+.008,ro-.012)}Z`);
    for(let x=a+.006;x<c-.004;x+=.0075)sm+=K.dot(x,ro-.006,1.1);
    sm+=K.rect(a,0,a+.006,.014,'sm')}
  sm+=K.cn(s0+sl*4.5,.03,2,8);
  // 3 base
  let bs=K.body(x=>R,xb,.88,'b tk')+K.ring(xb+.012,R,'sh')+K.ring(.87,R*.96,'sm');
  [xb+.004,xb+.008].forEach(x=>bs+=K.ring(x,R-.002,'sh'));
  bs+=K.rect(.85,-.012,.88,.012,'dt')+K.cn(.855,-.04,3,7);
  return {groups:[
    {part:0,dx:-70,svg:f,lab:[.02,.095,'start']},
    {part:1,dx:-20,dy:-70,svg:b,lab:[.42,-.115,'middle']},
    {part:1,dx:-20,dy:110,svg:sm,inner:1,lab:[.51,.115,'middle'],name:'9 submunitions, tungsten fragments'},
    {part:2,dx:80,svg:bs,lab:[.855,.13,'middle']}],
   extra:`<line class="hg" x1="${K.F(K.X(.585))}" x2="${K.F(K.X(.585))}" y1="${K.F(K.Y(-R)-16)}" y2="${K.F(K.Y(R)+16)}"/>`+K.nb(.58,-R-.03,'D')+K.nb(.58,R+.036,'D')
    +K.nb(.15,.105,'EXPELLING CHARGE','middle')+K.nb(.37,-R-.01,'BOURRELET')+K.nb(.78,-R-.01,'ROTATING BAND','middle')
    +K.nb(0,-.12,'9 SUBMUNITIONS · TUNGSTEN FRAGMENTS (1,200 PER SUBMUNITION REPORTED)')}},
 views:[
  {r:.0775,size:50,title:'VIEW FROM AFT',sub:'BASE',draw:(cx,cy,k)=>BPXV.disc(cx,cy,k,.0775)+BPXV.disc(cx,cy,k,.0775*.96,'sm')+BPXV.disc(cx,cy,k,.012,'dt')},
  {r:.0775,size:60,title:'SECTION D–D',sub:'CARRIER · SUBMUNITION',draw:(cx,cy,k)=>{let o=BPXV.disc(cx,cy,k,.0775)+BPXV.disc(cx,cy,k,.068,'sm')+BPXV.disc(cx,cy,k,.066,'dt');
    o+=BPXV.hatchDisc(cx,cy,k,.054);const n=40,r=.06*k;
    for(let i=0;i<n;i++){const a=i/n*2*Math.PI;o+=`<circle class="rt" cx="${(cx+r*Math.cos(a)).toFixed(1)}" cy="${(cy+r*Math.sin(a)).toFixed(1)}" r="1.3"/>`}
    return o+BPXV.disc(cx,cy,k,.012,'dt')}}]};

// Mk-80 series GP bomb, drawn as the Mk-82 (dims on record) with a JDAM tail kit, held to the 2.21 m on record.
// Parts (data order): 0 steel case, 1 explosive fill, 2 fuze, 3 JDAM tail kit
(function(){
const sil=(x0,y0,sc,st,fin)=>{const P=(x,y)=>(x0+x*sc).toFixed(1)+','+(y0+y*sc).toFixed(1);
  let o=`<path class="b" d="M${st.map(([x,r])=>P(x,-r)).join('L')}L${st.slice().reverse().map(([x,r])=>P(x,r)).join('L')}Z"/>`;
  if(fin){const[a,b,h]=fin;[-1,1].forEach(sg=>{const r=st[st.length-1][1];o+=`<path class="f fin" d="M${P(a,sg*r)}L${P(b-.1,sg*h)}L${P(b,sg*h)}L${P(b,sg*r)}Z"/>`})}return o};
const T=(x,y,t)=>`<text class="nb" x="${x.toFixed(1)}" y="${y.toFixed(1)}">${t}</text>`;
BPXS['ARS-MK80']={L:2.21,padTop:40,ext:[-.04,2.24],hy:.21,diaAt:.95,short:'Mk-80 SERIES · SHOWN AS Mk-82',title:'SIDE ELEVATION · HALF SECTION',
 draw(K){const R=.1365,wall=.01,og=K.ogive(-.035,.66,R,.03);
  const rB=x=>x<.625?og(x):x<1.15?R:x<1.66?K.prof([[1.15,R],[1.66,.096]])(x):.096;
  const rIn=x=>Math.max(.02,rB(x)-wall);
  const rT=K.prof([[1.62,rB(1.62)+.008],[1.65,rB(1.65)+.008],[1.92,.088],[2.17,.088],[2.21,.068]],false);
  // 1 case
  let b=K.body(rB,0,1.67)+K.shade(rB,.08,1.66)+K.ring(.625,R,'sm',true)+K.ring(1.15,R,'sm',true)+K.half(x=>rB(x)*.93,.03,1.66,-1,1,'sh hi');
  b+=K.poly([[.012,-.032],[-.022,-.024],[-.028,-.012],[-.028,.012],[-.022,.024],[.012,.032]]);
  [.02,.04].forEach(x=>b+=K.ring(x,rB(x)*.97,'sh'));
  b+=K.lug(.70,R)+K.lug(1.056,R)+K.ring(.33,rB(.33),'sh',true)+K.ring(.35,rB(.35),'sh',true);
  b+=K.cutbg(rB,0,1.67)+K.half(rIn,.03,1.665,1)+K.line(1.655,-rB(1.655),1.655,rB(1.655),'sm');
  b+=K.rect(.012,0,.21,.032,'sm')+K.line(.21,.016,1.49,.016,'hg')+K.cn(.42,-R*.45,1);
  // 2 fill
  const fill=K.hatch(K.region(rIn,.21,1.49,.032))+K.cn(.62,.075,2,8);
  // 3 tail fuze
  let fz=K.rect(1.50,-.038,1.645,.038);[1.53,1.565,1.60].forEach(x=>fz+=K.ring(x,.038));fz+=K.circ(1.625,0,.009)+K.cn(1.57,.075,3,8);
  // 4 JDAM tail kit (KMU-572 type): shroud, umbilical cover, X fins
  let tk=K.body(rT,1.62,2.21,'b tk');[1.65,1.92,2.17].forEach(x=>tk+=K.ring(x,rT(x)));tk+=K.shade(rT,1.66,2.2,[.5,.8])+K.rivets(1.635,rT(1.635),5);
  tk+=K.poly([[1.70,-rT(1.70)],[1.72,-rT(1.72)-.02],[1.80,-rT(1.80)-.02],[1.82,-rT(1.82)]]);
  const tip=.20*Math.SQRT1_2+.088*(1-Math.SQRT1_2);
  [-1,1].forEach(sg=>{tk+=K.fin(1.94,2.17,.088,2.06,2.17,tip,sg,2.10)+K.line(2.03,sg*(.088+tip)/2,2.15,sg*(.088+tip)/2)});
  tk+=K.cn(1.82,.03,4);
  return {groups:[
    {part:0,dx:-50,svg:b,lab:[.75,R+.09,'middle']},
    {part:1,dx:-50,dy:120,svg:fill,inner:1,fill:1,lab:[.85,.19,'middle']},
    {part:2,dx:40,dy:120,svg:fz,inner:1,lab:[1.69,.01,'start']},
    {part:3,dx:90,svg:tk,lab:[1.95,.26,'middle']}],
   extra:K.dimx(.70,1.056,-R-.065,'14 in · 356 mm')+`<line class="hg" x1="${K.F(K.X(1.25))}" x2="${K.F(K.X(1.25))}" y1="${K.F(K.Y(-R)-14)}" y2="${K.F(K.Y(R)+14)}"/>`+K.nb(1.255,-R-.05,'A')+K.nb(1.255,R+.075,'A')}},
 views:[
  {r:.2,size:56,title:'VIEW FROM AFT',sub:'JDAM TAIL KIT · X FINS',draw:(cx,cy,k)=>BPXV.disc(cx,cy,k,.1365)+BPXV.disc(cx,cy,k,.088,'sm')+BPXV.disc(cx,cy,k,.068,'dt')+BPXV.fins(cx,cy,k,.088,.2,[45,135,225,315],.012)+BPXV.lugTop(cx,cy,k,.1365)},
  {r:.42,size:62,title:'FAMILY TO SCALE',sub:'CONICAL FIN, NO KIT',draw:(cx,cy,k)=>{const sc=44,x0=cx-86;
    return T(x0,cy-40,'Mk-82 · 500 LB')+sil(x0,cy-26,sc,[[0,.02],[.18,.09],[.62,.1365],[1.15,.1365],[1.66,.096],[2.21,.06]],[1.85,2.19,.17])
     +T(x0,cy-2,'Mk-83 · 1,000 LB')+sil(x0,cy+13,sc,[[0,.025],[.25,.12],[.85,.178],[1.55,.178],[2.25,.12],[3.0,.075]],[2.55,2.98,.23])
     +T(x0,cy+38,'Mk-84 · 2,000 LB')+sil(x0,cy+58,sc,[[0,.03],[.25,.14],[1.02,.229],[2.12,.229],[3.0,.158],[3.84,.07]],[3.30,3.82,.25])}}]};
})();

// Mk-84 2,000-lb low-drag GP bomb with conical fin (no JDAM). Parts (data order):
// 0 nose fuze well / plug, 1 steel case, 2 explosive fill, 3 tail fuze, 4 conical fin
BPXS['ARS-MK84']={L:3.84,padTop:40,ext:[-.06,3.87],hy:.34,diaAt:1.5,short:'Mk-84 · 2,000-LB GP BOMB',title:'SIDE ELEVATION · HALF SECTION',
 draw(K){const R=.229,wall=.016,og=K.ogive(-.06,1.08,R,.05);
  const rB=x=>x<1.02?og(x):x<2.12?R:x<3.0?K.prof([[2.12,R],[3.0,.158]])(x):.158;
  const rIn=x=>Math.max(.03,rB(x)-wall);
  // conical fin: cone continues the boattail taper, closed by a short aft ring
  const rC=K.prof([[2.96,.162],[3.02,.162],[3.76,.098],[3.84,.07]],false);
  // 1 nose plug + fuze well liner
  let np=K.poly([[.02,-.05],[-.035,-.038],[-.045,-.022],[-.045,.022],[-.035,.038],[.02,.05]]);
  [-.03,-.012,.006].forEach(x=>np+=K.line(x,-.036,x,.036,'sh'));
  np+=K.rect(.02,0,.36,.05,'dt')+K.line(.06,.01,.33,.01,'sh')+K.line(.06,.04,.33,.04,'sh')+K.cn(.19,.025,1,7);
  // 2 case: exterior on top, cutaway below
  let b=K.body(rB,0,3.0)+K.shade(rB,.12,2.98)+K.ring(1.02,R,'sm',true)+K.ring(2.12,R,'sm',true)+K.half(x=>rB(x)*.93,.05,2.99,-1,1,'sh hi');
  [.03,.06,.09].forEach(x=>b+=K.ring(x,rB(x)*.97,'sh'));
  b+=K.lug(1.30,R)+K.lug(2.062,R);
  b+=K.ring(.55,rB(.55),'sh',true)+K.ring(.585,rB(.585),'sh',true);
  b+=K.cutbg(rB,0,3.0)+K.half(rIn,.05,2.985,1)+K.line(2.96,-rB(2.96),2.96,rB(2.96),'sm');
  b+=K.line(.36,.025,2.74,.025,'hg')+K.nb(2.18,.088,'CHARGING TUBE')+K.cn(.75,-R*.45,2);
  // 3 fill
  const fill=K.hatch(K.region(rIn,.36,2.74,.05))+K.cn(1.0,.12,3,8);
  // 4 tail fuze in aft well
  let fz=K.rect(2.76,-.06,2.98,.06);[2.80,2.86,2.92].forEach(x=>fz+=K.ring(x,.06));fz+=K.circ(2.95,0,.014)+K.cn(2.84,.12,4,8);
  // 5 conical fin assembly: cone, attach ring with set screws, four fins in X, aft brace ring
  let cf=K.body(rC,2.96,3.84,'b tk')+K.shade(rC,2.99,3.82,[.45,.8]);
  [3.02,3.76].forEach(x=>cf+=K.ring(x,rC(x)));cf+=K.rivets(2.99,rC(2.99),5);
  const rt=.32*Math.SQRT1_2+.10*(1-Math.SQRT1_2);
  [-1,1].forEach(sg=>{cf+=K.fin(3.30,3.80,rC(3.30),3.52,3.82,rt,sg,null)+K.line(3.42,sg*(rC(3.42)+.01),3.74,sg*(rt-.012),'sh')+K.line(3.80,sg*rC(3.80),3.82,sg*rt,'sm')});
  cf+=K.cn(3.15,0,5);
  return {groups:[
    {part:1,dx:-40,svg:b,lab:[1.05,R+.13,'middle']},
    {part:0,dx:-60,dy:-110,svg:np,inner:1,lab:[.42,.0,'start']},
    {part:2,dx:-40,dy:150,svg:fill,inner:1,fill:1,lab:[1.6,.33,'middle']},
    {part:3,dx:40,dy:150,svg:fz,inner:1,lab:[3.06,.02,'start']},
    {part:4,dx:100,svg:cf,lab:[3.40,.42,'middle']}],
   extra:K.dimx(1.30,2.062,-R-.085,'30 in · 762 mm')+`<line class="hg" x1="${K.F(K.X(1.15))}" x2="${K.F(K.X(1.15))}" y1="${K.F(K.Y(-R)-16)}" y2="${K.F(K.Y(R)+16)}"/>`+K.nb(1.15,-R-.09,'A')+K.nb(1.15,R+.12,'A')}},
 views:[
  {r:.32,size:62,title:'VIEW FROM AFT',sub:'CONICAL FIN · FOUR FINS IN X',draw:(cx,cy,k)=>BPXV.disc(cx,cy,k,.229)+BPXV.disc(cx,cy,k,.158,'sm')+BPXV.disc(cx,cy,k,.07,'dt')+BPXV.fins(cx,cy,k,.10,.32,[45,135,225,315])+BPXV.lugTop(cx,cy,k,.229)},
  {r:.229,size:44,title:'SECTION A–A',sub:'STEEL CASE · FILL · CHARGING TUBE',draw:(cx,cy,k)=>BPXV.disc(cx,cy,k,.229)+BPXV.hatchDisc(cx,cy,k,.213)+BPXV.disc(cx,cy,k,.025,'dt')}]};

// MPR-500 multi-purpose bomb (Elbit) with a JDAM tail kit, held to the 1.70 m on record.
// Parts (data order): 0 body with pre-formed fragments, 1 HE fill, 2 JDAM guidance kit
BPXS['ARS-MPR500']={L:1.7,padTop:40,ext:[-.03,1.73],hy:.21,diaAt:.80,short:'MPR-500 · 500-LB CLASS',title:'SIDE ELEVATION · HALF SECTION',
 draw(K){const R=.1365,wall=.008,frag=.016,og=K.ogive(-.02,.46,R,.035);
  const rB=x=>x<.44?og(x):x<1.0?R:x<1.19?K.prof([[1.0,R],[1.19,.104]])(x):.104;
  const rIn=x=>Math.max(.02,rB(x)-wall),rF=x=>Math.max(.02,rB(x)-wall-frag);
  const rT=K.prof([[1.16,.112],[1.19,.112],[1.40,.088],[1.66,.088],[1.70,.068]],false);
  // 1 body: exterior on top; cutaway shows the thin case lined with a layer of pre-formed fragments
  let b=K.body(rB,0,1.19)+K.shade(rB,.06,1.18)+K.ring(.44,R,'sm',true)+K.ring(1.0,R,'sm',true)+K.half(x=>rB(x)*.93,.03,1.18,-1,1,'sh hi');
  b+=K.poly([[.012,-.035],[-.016,-.028],[-.024,-.014],[-.024,.014],[-.016,.028],[.012,.035]]);
  [.02,.04].forEach(x=>b+=K.ring(x,rB(x)*.97,'sh'));
  b+=K.lug(.40,R)+K.lug(.756,R);
  b+=K.cutbg(rB,0,1.19)+K.half(rIn,.03,1.185,1)+K.half(rF,.17,1.03,1)+K.line(1.185,-rB(1.185),1.185,rB(1.185),'sm');
  for(let x=.18;x<1.02;x+=.024){const a=rF(x),c=rIn(x+.012);b+=`<rect class="sm" x="${K.F(K.X(x+.002))}" y="${K.F(K.Y(a+.002))}" width="${K.F(K.Z(.018))}" height="${K.F(Math.max(1,K.Z(c-a-.004)))}"/>`}
  b+=K.rect(1.03,.0,1.17,.035,'sm')+K.rect(.012,0,.17,.035,'sm')+K.nb(.03,R+.075,'NOSE FUZE WELL')+K.nb(.30,R+.075,'PRE-FORMED FRAGMENT LAYER')+K.line(.36,R+.055,.40,R-.014,'hg')+K.cn(.30,-R*.45,1);
  // 2 HE fill
  const fill=K.hatch(K.region(rF,.17,1.02,.035))+K.cn(.60,.065,2,8);
  // 3 JDAM tail kit
  let tk=K.body(rT,1.16,1.70,'b tk');[1.19,1.40,1.66].forEach(x=>tk+=K.ring(x,rT(x)));tk+=K.shade(rT,1.20,1.69,[.5,.8])+K.rivets(1.175,rT(1.175),5);
  tk+=K.poly([[1.22,-rT(1.22)],[1.24,-rT(1.24)-.02],[1.32,-rT(1.32)-.02],[1.34,-rT(1.34)]]);
  const tip=.20*Math.SQRT1_2+.088*(1-Math.SQRT1_2);
  [-1,1].forEach(sg=>{tk+=K.fin(1.43,1.66,.088,1.55,1.66,tip,sg,1.59)+K.line(1.52,sg*(.088+tip)/2,1.64,sg*(.088+tip)/2)});
  tk+=K.cn(1.30,.03,3);
  return {groups:[
    {part:0,dx:-50,svg:b,lab:[.55,-.29,'middle']},
    {part:1,dx:-50,dy:130,svg:fill,inner:1,fill:1,lab:[.62,.17,'middle']},
    {part:2,dx:90,svg:tk,lab:[1.45,.28,'middle']}],
   extra:K.dimx(.40,.756,-R-.065,'14 in · 356 mm')+`<line class="hg" x1="${K.F(K.X(.95))}" x2="${K.F(K.X(.95))}" y1="${K.F(K.Y(-R)-14)}" y2="${K.F(K.Y(R)+14)}"/>`+K.nb(.955,-R-.05,'A')+K.nb(.955,R+.075,'A')}},
 views:[
  {r:.2,size:56,title:'VIEW FROM AFT',sub:'JDAM TAIL KIT · X FINS',draw:(cx,cy,k)=>BPXV.disc(cx,cy,k,.1365)+BPXV.disc(cx,cy,k,.088,'sm')+BPXV.disc(cx,cy,k,.068,'dt')+BPXV.fins(cx,cy,k,.088,.2,[45,135,225,315],.012)+BPXV.lugTop(cx,cy,k,.1365)},
  {r:.1365,size:50,title:'SECTION A–A',sub:'CASE · FRAGMENT LAYER · HE FILL',draw:(cx,cy,k)=>{let o=BPXV.disc(cx,cy,k,.1365)+BPXV.disc(cx,cy,k,.1285,'sm')+BPXV.disc(cx,cy,k,.112,'sm');
    for(let a=0;a<360;a+=10){const c=Math.cos(a*Math.PI/180),s=Math.sin(a*Math.PI/180);o+=`<line class="sm" x1="${(cx+c*.112*k).toFixed(1)}" y1="${(cy+s*.112*k).toFixed(1)}" x2="${(cx+c*.1285*k).toFixed(1)}" y2="${(cy+s*.1285*k).toFixed(1)}"/>`}
    return o+BPXV.hatchDisc(cx,cy,k,.11)}}]};

// Ra'am Eitan 227 mm guided cluster rocket. Parts: 0 guidance, 1 cargo section (64 bomblets reported), 2 rocket motor
BPXS['ARS-RAAMEITAN']={L:3.94,ext:[-.05,4.0],hy:.3,diaAt:2.02,short:"RA'AM EITAN · 227 mm",title:'SIDE ELEVATION · HALF SECTION',
 draw(K){const R=.1135,wall=.006,og=K.ogive(0,.42,R,.008);const rB=x=>x<.42?og(x):R;const rIn=x=>Math.max(.004,rB(x)-wall);
  const seg=(a,b)=>K.body(rB,a,b)+K.shade(rB,a+.006,b-.006,[.45,.75])+K.cutbg(rB,a,b)+K.half(rIn,a+.006,b-.006,1);
  let g=seg(0,.6)+K.ring(.42,R,'sm',true)+K.ring(.59,R,'sm',true);[-1,1].forEach(sg=>g+=K.fin(.44,.58,R,.5,.58,.17,sg,.55));
  g+=K.rect(.2,.01,.55,.07,'dt')+K.nb(.3,-R-.2,'GUIDANCE · CANARDS','middle')+K.cn(.3,-R*.5,1,8);
  let c=seg(.6,2.17)+K.ring(2.16,R,'sm',true)+K.rivets(.62,R,5);
  for(let i=0;i<8;i++){const x=.66+i*.185;c+=K.rect(x,.006,x+.16,rIn(1)-.004,'sm')+K.circ(x+.08,.05,.03,'sh')}
  c+=K.nb(1.38,R+.04,'CARGO SECTION · 64 BOMBLETS (REPORTED)','middle')+K.cn(1.38,-R*.5,2,8);
  let m=seg(2.17,3.94)+K.ring(3.7,R,'sh',true)+K.hatch(`M${K.P(2.2,.02)}L${K.P(3.68,.02)}L${K.P(3.68,rIn(3)-.004)}L${K.P(2.2,rIn(3)-.004)}Z`);
  [-1,1].forEach(sg=>m+=K.fin(3.62,3.92,R,3.8,3.93,.2,sg,3.86));m+=K.poly([[3.94,-.07],[3.98,-.08],[3.98,.08],[3.94,.07]],'sm');
  m+=K.nb(2.95,R+.04,'SOLID PROPELLANT','middle')+K.nb(3.8,R+.24,'WRAP-AROUND FINS','middle')+K.cn(3.0,-R*.5,3,8);
  return {groups:[{part:0,dx:-80,svg:g,lab:[.2,R+.17,'start']},{part:1,dx:0,svg:c,lab:[1.38,-R-.12,'middle']},{part:2,dx:80,svg:m,lab:[3.0,-R-.12,'middle']}]}},
 views:[{r:.2,size:56,title:'VIEW FROM AFT',sub:'WRAP-AROUND FINS DEPLOYED',draw:(cx,cy,k)=>BPXV.fins(cx,cy,k,.1135,.2,[45,135,225,315],.006)+BPXV.disc(cx,cy,k,.1135)+BPXV.disc(cx,cy,k,.07,'sm')},
  {r:.1135,size:44,title:'SECTION · CARGO',sub:'BOMBLETS IN CARRIER',draw:(cx,cy,k)=>BPXV.disc(cx,cy,k,.1135)+[0,60,120,180,240,300].map(a=>`<circle class="sm" cx="${(cx+Math.cos(a*Math.PI/180)*.06*k).toFixed(1)}" cy="${(cy+Math.sin(a*Math.PI/180)*.06*k).toFixed(1)}" r="${(.028*k).toFixed(1)}"/>`).join('')+BPXV.disc(cx,cy,k,.028,'sm')}]};

// Ro'em 155 mm wheeled self-propelled howitzer: armoured cab, 10x10 truck chassis, automated turret at the rear with
// the gun laid forward over the cab in travel position. Side elevation, x from the muzzle. Length not on record: 12.8 m drawn.
// Parts (data order): 0 10x10 truck chassis, 1 automated 155 mm turret and gun. Ground at y = +1.75 m.
BPXS['ARS-ROEM']={L:12.8,ext:[-.2,13.0],hy:2.0,padTop:20,H:470,dia:false,short:"RO'EM 155 mm SP HOWITZER",title:'SIDE ELEVATION · TRAVEL POSITION',
 draw(K){const G=1.75,wr=.6,wy=G-wr,ax=[2.75,4.2,7.95,9.4,10.85],by=-1.5;
  const wheel=x=>{let o=K.circ(x,wy,wr,'b')+K.circ(x,wy,wr*.93,'sh')+K.circ(x,wy,.34,'dt')+K.circ(x,wy,.11,'sm');
    for(let i=0;i<8;i++){const a=i*Math.PI/4;o+=K.dot(x+.24*Math.cos(a),wy+.24*Math.sin(a),1.2)}
    for(let i=0;i<24;i++){const a=i*Math.PI/12;o+=K.line(x+wr*.93*Math.cos(a),wy+wr*.93*Math.sin(a),x+wr*Math.cos(a),wy+wr*Math.sin(a),'sh')}return o};
  // 1 chassis: frame, armoured cab, engine bay, fenders, wheels, stowage, rear stabiliser spade
  let c=K.rect(1.5,.38,12.55,.68,'b')+K.line(1.5,.53,12.55,.53,'sh');
  for(let x=1.9;x<12.5;x+=.6)c+=K.dot(x,.455,1)+K.dot(x,.605,1);
  c+=K.poly([[1.35,.72],[1.35,.0],[1.6,-.25],[1.85,-1.18],[4.55,-1.25],[4.7,-1.1],[4.7,.72]],'b');
  c+=K.poly([[1.95,-1.08],[2.75,-1.1],[2.75,-.38],[1.7,-.32]],'dt win')+K.poly([[2.95,-1.1],[3.7,-1.12],[3.7,-.4],[2.95,-.38]],'dt win');
  c+=K.rect(2.85,-1.18,3.85,.45,'sm')+K.rect(3.95,-1.18,4.6,.45,'sm')+K.line(3.6,-.05,3.75,-.05,'sm');
  c+=K.line(1.85,-1.18,4.55,-1.25,'sm')+K.rect(1.38,.15,1.6,.5,'dt');[.25,.35].forEach(y=>c+=K.line(1.4,y,1.58,y,'sh'));
  for(let x=1.95;x<4.6;x+=.45)c+=K.dot(x,-1.15,1.1);
  // travel lock on cab roof
  c+=K.poly([[2.4,-1.21],[2.5,by+.12],[2.9,by+.12],[3.0,-1.22]],'dt')+K.rect(2.45,by-.13,2.95,by+.12,'sm');
  // engine / equipment bay
  c+=K.poly([[4.7,-.85],[6.2,-.85],[6.2,.38],[4.7,.38]],'b');for(let x=4.85;x<6.1;x+=.12)c+=K.line(x,-.7,x,-.3,'sh');c+=K.rect(4.8,-.75,6.1,-.25,'sm');
  [[ax[0],ax[1]],[ax[2],ax[4]]].forEach(([a,b])=>c+=K.poly([[a-.72,.7],[a-.68,.32],[b+.68,.32],[b+.72,.7]],'f'));
  ax.forEach(x=>c+=wheel(x));
  c+=K.rect(5.2,.7,6.6,1.08,'b')+K.line(5.9,.7,5.9,1.08,'sh')+K.rect(1.9+1.45,.7,3.5,1.25,'sm');
  c+=K.poly([[12.2,.68],[12.55,.68],[12.8,1.6],[12.6,1.68],[12.25,1.0]],'dt')+K.line(12.35,.8,12.65,1.55,'sh');
  c+=K.cn(3.3,-.75,1);
  // 2 turret and gun: turret housing, ammunition magazine, trunnion, cradle, recoil cylinders, barrel, fume extractor, muzzle brake
  let t=K.poly([[6.35,.38],[6.35,-1.25],[6.9,-1.72],[12.65,-1.72],[12.65,.38]],'b');
  t+=K.line(6.35,-1.25,12.65,-1.25,'sh')+K.rect(9.4,-1.6,12.5,.25,'hg');
  [7.6,8.6].forEach(x=>t+=K.line(x,-1.72,x,.38,'sh'));
  for(let x=9.6;x<12.4;x+=.35)t+=K.rect(x,-1.45,x+.25,-.85,'hg');
  t+=K.rect(12.0,-1.95,12.15,-1.72,'sm')+K.circ(12.07,-1.98,.05,'dt')+K.rect(6.5,.38,12.5,.5,'dt');
  // gun: cradle and barrel
  t+=K.rect(5.9,by-.22,7.6,by+.22,'dt')+K.line(5.9,by-.12,7.6,by-.12,'sh')+K.line(5.9,by+.12,7.6,by+.12,'sh')+K.circ(7.25,by,.13,'dt');
  const rb=K.prof([[.55,.09],[3.8,.095],[4.2,.115],[4.7,.115],[5.0,.1],[5.9,.115]],false);
  t+=`<g transform="translate(0,${K.F(K.Z(by))})">${K.body(rb,.55,5.9)+K.shade(rb,.6,5.85,[.5])}</g>`;
  t+=K.rect(3.85,by-.115,4.65,by+.115,'sm');
  t+=K.poly([[0,by-.17],[.55,by-.17],[.55,by+.17],[0,by+.17]],'b');
  [.12,.28,.42].forEach(x=>t+=K.rect(x,by-.17,x+.06,by+.17,'dt'));
  t+=K.line(.55,by,5.9,by,'sh');
  t+=K.cn(8.1,-.9,2);
  return {groups:[
    {part:0,dx:0,dy:25,svg:c,lab:[6.4,1.5,'middle']},
    {part:1,dx:30,dy:-80,svg:t,lab:[9.5,-2.12,'middle']}],
   extra:K.line(-.15,G,12.95,G,'hg')+K.nb(12.75,G-.08,'GROUND','end')+K.nb(10.95,-.4,'AMMUNITION MAGAZINE (HIDDEN)','middle')
    +K.nb(0,-1.98,'CREW 3 · 6-8 ROUNDS PER MINUTE · RANGE UP TO 40 km')}},
 views:[
  {r:1.75,size:66,title:'FRONT VIEW',sub:'CAB · MUZZLE BRAKE',draw:(cx,cy,k)=>{const P=(x,y)=>(cx+x*k).toFixed(1)+','+(cy+(y+.08)*k).toFixed(1),R=(x0,y0,x1,y1,c)=>`<path class="${c}" d="M${P(x0,y0)}L${P(x1,y0)}L${P(x1,y1)}L${P(x0,y1)}Z"/>`;
    let o=R(-1.25,1.75,-.85,.55,'b')+R(.85,1.75,1.25,.55,'b')+R(-1.25,-1.72,1.25,.4,'b')+`<path class="dt" d="M${P(-1.1,.6)}L${P(-1.15,-1.15)}L${P(1.15,-1.15)}L${P(1.1,.6)}Z"/>`;
    o+=R(-1.0,-1.05,-.06,-.35,'dt win')+R(.06,-1.05,1.0,-.35,'dt win')+R(-.85,-.1,.85,.4,'sm')+R(-1.25,.55,1.25,.72,'dt');
    o+=`<circle class="b" cx="${(cx).toFixed(1)}" cy="${(cy+(-1.5+.08)*k).toFixed(1)}" r="${(.17*k).toFixed(1)}"/><circle class="dt" cx="${cx}" cy="${(cy+(-1.5+.08)*k).toFixed(1)}" r="${(.0775*k).toFixed(1)}"/>`;
    return o}}]};

// Spike ER (family). Parts: 0 seeker, 1 tandem warhead, 2 datalink and control, 3 motor
BPXS['ARS-SPIKE']={L:1.67,ext:[-.03,1.7],hy:.2,diaAt:1.13,short:'SPIKE ER · FAMILY',title:'SIDE ELEVATION · SECTIONS BY FUNCTION',
 draw(K){const R=.085,wall=.005;
  const nose=K.prof([[0,.05],[.05,.075],[.12,R]]);const rB=x=>x<.12?nose(x):R;const rIn=x=>Math.max(.004,rB(x)-wall);
  const seg=(a,b)=>K.body(rB,a,b)+K.shade(rB,a+.004,b-.004,[.45,.75])+K.cutbg(rB,a,b)+K.half(rIn,a+.004,b-.004,1);
  const box=(a,b,t)=>K.rect(a,.01,b,rIn((a+b)/2)-.008,'dt')+K.nb((a+b)/2,.045,t,'middle');
  // 1 seeker: faceted window, camera bay
  let s=seg(0,.25)+K.poly([[0,-.05],[.05,-.075],[.05,.075],[0,.05]],'dt win')+K.line(.025,-.062,.025,.062,'sh')+K.ring(.12,R,'sm',true)+K.ring(.24,R,'sm',true);
  s+=box(.06,.23,'IIR / CCD')+K.cn(.17,-R*.5,1,8);
  // 2 tandem warhead: precursor and main charge as hatched blocks
  let w=seg(.25,.75)+K.ring(.74,R,'sm',true)+K.rivets(.26,R,5);
  w+=K.hatch(`M${K.P(.27,.012)}L${K.P(.33,.012)}L${K.P(.33,rIn(.3)-.01)}L${K.P(.27,rIn(.3)-.01)}Z`)+K.hatch(`M${K.P(.45,.012)}L${K.P(.72,.012)}L${K.P(.72,rIn(.6)-.006)}L${K.P(.45,rIn(.6)-.006)}Z`);
  w+=K.nb(.3,R+.035,'PRECURSOR','middle')+K.nb(.585,R+.035,'MAIN CHARGE','middle')+K.cn(.5,-R*.5,2,8);
  // 3 datalink and control: four pop-out wings, electronics, fibre-optic spool
  let c=seg(.75,1.09)+K.ring(1.08,R,'sm',true);
  [-1,1].forEach(sg=>c+=K.fin(.8,1.05,R,.92,1.05,.18,sg,.98));
  c+=box(.77,.9,'AUTOPILOT')+K.circ(.98,.045,.03,'sm')+K.circ(.98,.045,.018,'sh')+K.nb(.98,R+.035,'FIBRE SPOOL','middle')+K.cn(.86,-R*.5,3,8);
  // 4 motor: side nozzles, grain, tail control fins
  let m=seg(1.09,1.67)+K.ring(1.4,R,'sh',true);
  m+=K.hatch(`M${K.P(1.12,.012)}L${K.P(1.55,.012)}L${K.P(1.55,rIn(1.3)-.004)}L${K.P(1.12,rIn(1.3)-.004)}Z`);
  m+=K.poly([[1.18,-R],[1.21,-R-.03],[1.25,-R-.03],[1.26,-R]])+K.nb(1.22,-R-.04,'CANTED NOZZLE','middle');
  [-1,1].forEach(sg=>m+=K.fin(1.55,1.66,R,1.6,1.665,.13,sg,1.62));
  m+=K.poly([[1.67,-.04],[1.69,-.03],[1.69,.03],[1.67,.04]],'sm')+K.nb(1.3,R+.035,'SOLID PROPELLANT','middle')+K.cn(1.35,-R*.5,4,8);
  return {groups:[{part:0,dx:-80,svg:s,lab:[.05,R+.12,'start']},{part:1,dx:-40,svg:w,lab:[.5,-R-.12,'middle']},{part:2,dx:5,svg:c,lab:[.92,R+.24,'middle']},{part:3,dx:60,svg:m,lab:[1.38,R+.12,'middle']}]}},
 views:[{r:.18,size:60,title:'VIEW FROM FRONT',sub:'WINGS DEPLOYED',draw:(cx,cy,k)=>BPXV.fins(cx,cy,k,.085,.18,[45,135,225,315],.006)+BPXV.disc(cx,cy,k,.085)+BPXV.disc(cx,cy,k,.05,'dt win')},
  {r:.085,size:40,title:'SECTION · WARHEAD',sub:'Ø 170 mm',draw:(cx,cy,k)=>BPXV.disc(cx,cy,k,.085)+BPXV.hatchDisc(cx,cy,k,.075)}]};

// ARES-TMID-0011, unidentified: configuration assumed from field photos of a small turbojet missile. Parts: 0 seeker, 1 warhead, 2 rotating wing, 3 turbojet and fins
BPXS['ARS-TMID0011']={L:1.9,ext:[-.03,1.95],hy:.42,diaAt:1.1,short:'ARES-TMID-0011 · UNIDENTIFIED',title:'SIDE ELEVATION · CONFIGURATION ASSUMED',
 note:"INDICATIVE DRAWING OF AN UNIDENTIFIED MUNITION · CONFIGURATION ASSUMED, NOT A MANUFACTURER'S DRAWING",
 draw(K){const R=.0725,wall=.004,og=K.ogive(0,.22,R,.01);const rB=x=>x<.22?og(x):x<1.75?R:K.prof([[1.75,R],[1.9,.045]])(x);const rIn=x=>Math.max(.004,rB(x)-wall);
  const seg=(a,b)=>K.body(rB,a,b)+K.shade(rB,a+.004,b-.004,[.45,.75])+K.cutbg(rB,a,b)+K.half(rIn,a+.004,b-.004,1);
  let s=seg(0,.29)+K.poly([[0,-.012],[.06,-.035],[.06,.035],[0,.012]],'dt win')+K.ring(.28,R,'sm',true)+K.rect(.09,.008,.26,.05,'dt')+K.nb(.17,R+.035,'SEEKER','middle')+K.cn(.17,-R*.5,1,8);
  let w=seg(.29,.76)+K.ring(.75,R,'sm',true)+K.hatch(`M${K.P(.31,.008)}L${K.P(.73,.008)}L${K.P(.73,rIn(.5)-.006)}L${K.P(.31,rIn(.5)-.006)}Z`)+K.nb(.52,R+.035,'WARHEAD','middle')+K.cn(.52,-R*.5,2,8);
  let r=seg(.76,1.14)+K.ring(1.13,R,'sm',true)+K.circ(.95,0,.03,'dt')+K.poly([[.95,-R],[.8,-R-.32],[.87,-R-.33],[1.0,-R]],'f fin')+K.poly([[.95,R],[1.1,R+.32],[1.03,R+.33],[.9,R]],'f fin')+K.nb(.95,R+.37,'ROTATING WING (STOWED → DEPLOYED)','middle')+K.cn(1.03,-R*.4,3,8);
  let t=seg(1.14,1.9)+K.poly([[1.3,R],[1.36,R+.04],[1.5,R+.04],[1.53,R]])+K.nb(1.42,R+.07,'INTAKE','middle')+K.rect(1.38,.008,1.72,.05,'dt')+K.circ(1.45,.03,.018,'sm');
  [-1,1].forEach(sg=>t+=K.fin(1.68,1.86,rB(1.68),1.78,1.88,.16,sg,1.82));t+=K.cn(1.6,-R*.5,4,8);
  return {groups:[{part:0,dx:-80,svg:s,lab:[.1,R+.13,'start']},{part:1,dx:-40,svg:w,lab:[.52,-R-.13,'middle']},{part:2,dx:0,dy:-20,svg:r,lab:[1.25,-R-.2,'start']},{part:3,dx:60,svg:t,lab:[1.55,R+.24,'middle']}]}},
 views:[{r:.16,size:56,title:'VIEW FROM AFT',sub:'Ø ABOUT 135-155 mm (REPORTED)',draw:(cx,cy,k)=>BPXV.fins(cx,cy,k,.06,.16,[45,135,225,315],.005)+BPXV.disc(cx,cy,k,.0725)+BPXV.disc(cx,cy,k,.045,'sm')+BPXV.disc(cx,cy,k,.02,'dt')}]};

// JDAM guidance kit family, drawn in its GBU-31 form: KMU-556 tail kit and strakes on a Mk-84 body.
// Parts (data order): 0 bomb body (supplied separately), 1 strake kit, 2 tail kit, 3 fin actuation system
(function(){
// small side silhouettes for the views column: stations [[x,r],...] in metres, drawn at sc px/m
const sil=(x0,y0,sc,st,fin)=>{const P=(x,y)=>(x0+x*sc).toFixed(1)+','+(y0+y*sc).toFixed(1);
  let d='M'+st.map(([x,r])=>P(x,-r)).join('L')+'L'+st.slice().reverse().map(([x,r])=>P(x,r)).join('L')+'Z';
  let o=`<path class="b" d="${d}"/>`;if(fin){const[a,b,h]=fin;[-1,1].forEach(sg=>{const r=st[st.length-1][1];o+=`<path class="f fin" d="M${P(a,sg*r)}L${P(b-.12,sg*h)}L${P(b,sg*h)}L${P(b,sg*r)}Z"/>`})}return o};
const T=(x,y,t,an='start')=>`<text class="nb" x="${x.toFixed(1)}" y="${y.toFixed(1)}" text-anchor="${an}">${t}</text>`;
BPXS['WPN-00001']={L:3.85,padTop:40,ext:[-.05,3.87],hy:.34,diaAt:1.5,short:'JDAM KIT · GBU-31 FORM (KMU-556)',title:'SIDE ELEVATION · KIT ON Mk-84 BODY',
 draw(K){const R=.229,wall=.016,og=K.ogive(-.06,1.08,R,.05);
  const rB=x=>x<1.02?og(x):x<2.12?R:x<3.0?K.prof([[2.12,R],[3.0,.158]])(x):.158;
  const rT=K.prof([[2.66,rB(2.66)+.012],[2.70,rB(2.70)+.012],[3.34,.142],[3.80,.142],[3.85,.112]],false);
  const rIn=x=>Math.max(.03,rB(x)-wall),rTi=x=>rT(x)-.01;
  // 1 body: exterior on top; below, an empty case outline (the kit carries no warhead)
  let b=K.body(rB,0,2.70)+K.shade(rB,.12,2.68)+K.ring(1.02,R,'sm',true)+K.ring(2.12,R,'sm',true)+K.half(x=>rB(x)*.93,.05,2.69,-1,1,'sh hi');
  b+=K.poly([[.02,-.05],[-.035,-.038],[-.045,-.022],[-.045,.022],[-.035,.038],[.02,.05]]);
  [.03,.06,.09].forEach(x=>b+=K.ring(x,rB(x)*.97,'sh'));
  b+=K.lug(1.30,R)+K.lug(2.062,R);
  b+=K.cutbg(rB,0,2.70)+K.half(rIn,.05,2.69,1)+K.line(2.69,0,2.69,rB(2.69),'sm');
  b+=K.nb(.32,.1,'BODY · NOT PART OF KIT')+K.cn(.6,-R*.45,1);
  // 2 strake kit: two clamp bands with fixed strakes
  let sk='';[-1,1].forEach(sg=>{const r0=R*.72,h=.062;sk+=K.poly([[1.16,sg*r0],[1.24,sg*(r0+h)],[1.95,sg*(r0+h)],[1.98,sg*r0]])});
  [1.34,1.86].forEach(x=>{sk+=K.rect(x-.02,-R,x+.02,R)+K.rivets(x,R,5)});sk+=K.cn(1.57,-R*.72-.031,2,8);
  // 3 tail kit: shroud bolted over the boattail, guidance bay, umbilical cover, X fins; lower half cut away
  let tk=K.body(rT,2.66,3.85,'b tk');[2.70,3.34,3.80].forEach(x=>tk+=K.ring(x,rT(x),'sm',true));tk+=K.shade(rT,2.71,3.83,[.5,.8])+K.rivets(2.685,rT(2.685),4);
  tk+=K.poly([[3.0,-rT(3.0)],[3.04,-rT(3.04)-.034],[3.18,-rT(3.18)-.034],[3.22,-rT(3.22)]])+K.rect(2.82,-rT(2.82)-.02,2.89,-rT(2.82)+.005);
  tk+=K.cutbg(rT,2.66,3.85)+K.half(rTi,2.70,3.84,1)+K.line(2.70,0,2.70,rT(2.70),'sm')+K.line(3.34,0,3.34,rT(3.34),'sh');
  tk+=K.rect(2.80,.03,3.12,.13,'dt')+K.nb(2.84,.095,'GPS/INS');
  tk+=K.rect(3.15,.03,3.28,.11,'dt')+K.nb(3.16,.09,'BATT');
  const tip=.32*Math.SQRT1_2+.142*(1-Math.SQRT1_2);
  [-1,1].forEach(sg=>{tk+=K.fin(3.36,3.79,.142,3.56,3.79,tip,sg,3.63)+K.line(3.5,sg*(.142+tip)/2,3.76,sg*(.142+tip)/2)+K.rect(3.58,sg*.142,3.69,sg*(.142+.024))});
  tk+=K.cn(3.2,-.07,3);
  // 4 fin actuation: actuator housing, drive and fin shaft through the hinge line
  let fa=K.rect(3.40,.025,3.60,.115,'dt')+K.line(3.44,.025,3.44,.115,'sh')+K.line(3.56,.025,3.56,.115,'sh')+K.circ(3.50,.07,.022,'sm');
  fa+=K.line(3.60,.07,3.63,.07,'sm')+K.line(3.63,.05,3.63,.142,'dt')+K.dot(3.63,.07,1.6)+K.cn(3.47,-.06,4,8);
  return {groups:[
    {part:0,dx:-60,svg:b,lab:[1.3,R+.13,'middle']},
    {part:1,dx:-40,dy:-118,svg:sk,lab:[2.05,-.21,'start']},
    {part:2,dx:90,svg:tk,name:'Tail kit (GPS/INS, control fins)',lab:[3.25,.45,'middle']},
    {part:3,dx:60,dy:150,svg:fa,inner:1,lab:[3.68,.07,'start']}],
   extra:K.dimx(1.30,2.062,-R-.085,'30 in · 762 mm')+K.poly([[2.062,-R-.02],[2.45,-R-.05],[2.80,-rT(2.80)-.01]],'hg',false)+`<line class="hg" x1="${K.F(K.X(3.50))}" x2="${K.F(K.X(3.50))}" y1="${K.F(K.Y(-.142)-46)}" y2="${K.F(K.Y(.142)+46)}"/>`+K.nb(3.51,-.142-.2,'C')+K.nb(3.51,.142+.24,'C')}},
 views:[
  {r:.32,size:56,title:'VIEW FROM AFT',sub:'FIN SPAN 0.64 m',draw:(cx,cy,k)=>BPXV.disc(cx,cy,k,.229)+BPXV.disc(cx,cy,k,.142,'sm')+BPXV.disc(cx,cy,k,.05,'dt')+BPXV.fins(cx,cy,k,.142,.32,[45,135,225,315])+BPXV.lugTop(cx,cy,k,.229)},
  {r:.142,size:40,title:'SECTION C–C',sub:'FOUR FIN ACTUATORS',draw:(cx,cy,k)=>{let o=BPXV.disc(cx,cy,k,.142)+BPXV.disc(cx,cy,k,.132,'sm');
    [45,135,225,315].forEach(a=>{const c=Math.cos(a*Math.PI/180),s=Math.sin(a*Math.PI/180),u=.075*k;o+=`<rect class="dt" x="${(cx+c*u-6).toFixed(1)}" y="${(cy+s*u-6).toFixed(1)}" width="12" height="12" transform="rotate(${a} ${(cx+c*u).toFixed(1)} ${(cy+s*u).toFixed(1)})"/><line class="sm" x1="${(cx+c*u*1.25).toFixed(1)}" y1="${(cy+s*u*1.25).toFixed(1)}" x2="${(cx+c*.142*k).toFixed(1)}" y2="${(cy+s*.142*k).toFixed(1)}"/>`});
    return o+`<circle class="dt" cx="${cx}" cy="${cy}" r="5"/>`}},
  {r:.42,size:58,title:'BODIES THE KIT FITS',sub:'SILHOUETTES TO SCALE',draw:(cx,cy,k)=>{const sc=44,x0=cx-86;
    return T(x0,cy-34,'KMU-556 · Mk-84')+sil(x0,cy-20,sc,[[0,.03],[.25,.14],[1.0,.229],[2.12,.229],[3.0,.158],[3.3,.142],[3.85,.142]],[3.36,3.8,.25])
     +T(x0,cy+6,'KMU-557 · BLU-109')+sil(x0,cy+20,sc,[[0,.06],[.18,.15],[.45,.185],[2.4,.185],[2.6,.142],[3.75,.142]],[3.27,3.71,.25])
     +T(x0,cy+44,'KMU-572 · Mk-82')+sil(x0,cy+56,sc,[[0,.02],[.18,.09],[.62,.1365],[1.25,.1365],[1.66,.095],[2.35,.095]],[1.98,2.32,.16])}}]};
})();

// GBU-31: Mk-84 2,000-lb body + KMU-556 JDAM tail kit. Parts (data order): 0 body, 1 fill, 2 strakes, 3 FMU-152 fuze, 4 tail kit
BPXS['WPN-00002']={L:3.85,padTop:40,ext:[-.05,3.87],hy:.33,diaAt:1.5,short:'GBU-31 · Mk-84 + KMU-556 JDAM',title:'SIDE ELEVATION · HALF SECTION',
 draw(K){const R=.229,wall=.016,og=K.ogive(-.06,1.08,R,.05);
  const rB=x=>x<1.02?og(x):x<2.12?R:x<3.0?K.prof([[2.12,R],[3.0,.158]])(x):.158;
  const rT=K.prof([[2.66,rB(2.66)+.012],[2.70,rB(2.70)+.012],[3.34,.142],[3.80,.142],[3.85,.112]],false);
  const rIn=x=>Math.max(.03,rB(x)-wall);
  // 1 body: exterior on top, cutaway below
  let b=K.body(rB,0,3.0)+K.shade(rB,.12,2.98)+K.ring(1.02,R,'sm',true)+K.ring(2.12,R,'sm',true)+K.half(x=>rB(x)*.93,.05,2.99,-1,1,'sh hi');
  b+=K.poly([[.02,-.05],[-.035,-.038],[-.045,-.022],[-.045,.022],[-.035,.038],[.02,.05]]);
  [.03,.06,.09].forEach(x=>b+=K.ring(x,rB(x)*.97,'sh'));
  b+=K.lug(1.30,R)+K.lug(2.062,R);
  b+=K.ring(.55,rB(.55),'sh',true)+K.ring(.585,rB(.585),'sh',true);
  b+=K.cutbg(rB,0,3.0)+K.half(rIn,.05,2.985,1);
  b+=K.rect(.02,0,.36,.05,'sm')+K.line(.36,.025,2.74,.025,'hg')+K.nb(.05,.05+.055,'NOSE FUZE WELL')+K.nb(2.2,.085,'CHARGING TUBE');
  b+=K.cn(.6,-R*.45,1);
  // 2 fill
  const fill=K.hatch(K.region(rIn,.36,2.74,.05))+K.cn(1.0,.12,2,8);
  // 3 strake kit
  let sk='';[-1,1].forEach(sg=>{const r0=R*.72,h=.062;sk+=K.poly([[1.16,sg*r0],[1.24,sg*(r0+h)],[1.95,sg*(r0+h)],[1.98,sg*r0]])});
  [1.34,1.86].forEach(x=>{sk+=K.rect(x-.02,-R,x+.02,R)+K.rivets(x,R,5)});sk+=K.cn(1.57,-R*.72-.031,3,8);
  // 4 fuze
  let fz=K.rect(2.76,-.06,3.0,.06);[2.80,2.86,2.92].forEach(x=>fz+=K.ring(x,.06));fz+=K.circ(2.96,0,.014)+K.cn(2.83,.12,4,8);
  // 5 tail kit: shroud, collar bolts, GPS fairing, umbilical cover, X fins
  let tk=K.body(rT,2.66,3.85,'b tk');[2.70,3.34,3.80].forEach(x=>tk+=K.ring(x,rT(x)));tk+=K.shade(rT,2.71,3.83,[.5,.8])+K.rivets(2.685,rT(2.685));
  tk+=K.poly([[3.0,-rT(3.0)],[3.04,-rT(3.04)-.034],[3.18,-rT(3.18)-.034],[3.22,-rT(3.22)]])+K.rect(2.82,-rT(2.82)-.02,2.89,-rT(2.82)+.005);
  const tip=.32*Math.SQRT1_2+.142*(1-Math.SQRT1_2);
  [-1,1].forEach(sg=>{tk+=K.fin(3.36,3.79,.142,3.56,3.79,tip,sg,3.63)+K.line(3.5,sg*(.142+tip)/2,3.76,sg*(.142+tip)/2)+K.rect(3.58,sg*.142,3.69,sg*(.142+.024))});
  tk+=K.cn(3.2,0,5);
  return {groups:[
    {part:0,dx:-60,svg:b,lab:[.9,R+.13,'end']},
    {part:1,dx:-60,dy:150,svg:fill,inner:1,fill:1,lab:[1.2,.33,'start']},
    {part:2,dx:-40,dy:-118,svg:sk,lab:[2.05,-.21,'start'],n:3},
    {part:3,dx:30,dy:150,svg:fz,inner:1,lab:[3.08,.02,'start']},
    {part:4,dx:90,svg:tk,lab:[3.25,.45,'middle']}],
   extra:K.dimx(1.30,2.062,-R-.085,'30 in · 762 mm')+K.poly([[2.062,-R-.02],[2.45,-R-.05],[2.80,-rT(2.80)-.01]],'hg',false)+`<line class="hg" x1="${K.F(K.X(1.0))}" x2="${K.F(K.X(1.0))}" y1="${K.F(K.Y(-R)-16)}" y2="${K.F(K.Y(R)+16)}"/>`+K.nb(1.0,-R-.09,'B')+K.nb(1.0,R+.12,'B')}},
 views:[
  {r:.32,size:62,title:'VIEW FROM AFT',sub:'FIN SPAN 0.64 m',draw:(cx,cy,k)=>BPXV.disc(cx,cy,k,.229)+BPXV.disc(cx,cy,k,.142,'sm')+BPXV.disc(cx,cy,k,.05,'dt')+BPXV.fins(cx,cy,k,.142,.32,[45,135,225,315])+BPXV.lugTop(cx,cy,k,.229)},
  {r:.229,size:44,title:'SECTION B–B',sub:'CASE · FILL · CHARGING TUBE',draw:(cx,cy,k)=>BPXV.disc(cx,cy,k,.229)+BPXV.hatchDisc(cx,cy,k,.213)+BPXV.disc(cx,cy,k,.025,'dt')}]};

// GBU-39/B Small Diameter Bomb: side elevation with the Diamond Back wings stowed; plan view shows them deployed.
// Parts (data order): 0 penetrating warhead, 1 Diamond Back wing kit, 2 GPS/INS guidance section, 3 tail fins
(function(){
const R=.095,SPAN=1.61;
// plan view helpers: station s (m from nose) runs down the page, y is lateral (m)
const plan=(cx,cy,k)=>{const P=(s,y)=>(cx+y*k).toFixed(1)+','+(cy+(s-.9)*k).toFixed(1);const path=(p,c)=>`<path class="${c}" d="M${p.map(([s,y])=>P(s,y)).join('L')}Z"/>`;
  const r=s=>s<.40?Math.max(.012,R*Math.sqrt(Math.min(1,s/.40))*(1-.0)):s<1.5?R:R-(s-1.5)*.08;
  let side=[];for(let i=0;i<=30;i++){const s=1.8*i/30;side.push([s,r(s)])}
  let o=path(side.concat(side.slice().reverse().map(([s,y])=>[s,-y])),'b');
  // tail fins seen from above (two of the four, X layout)
  [-1,1].forEach(sg=>o+=path([[1.60,sg*.07],[1.72,sg*.20],[1.79,sg*.20],[1.79,sg*.07]],'f fin'));
  // Diamond Back wings: forward panels from the forward pivot, rear panels from the aft pivot, joined at the tips
  const t=SPAN/2;[-1,1].forEach(sg=>{o+=path([[.74,sg*.03],[.98,sg*t],[1.04,sg*t],[.80,sg*.03]],'f fin')+path([[1.12,sg*.03],[1.01,sg*(t-.02)],[1.05,sg*(t-.02)],[1.17,sg*.03]],'f fin')});
  o+=`<circle class="dt" cx="${cx}" cy="${(cy+(.77-.9)*k).toFixed(1)}" r="2.5"/><circle class="dt" cx="${cx}" cy="${(cy+(1.145-.9)*k).toFixed(1)}" r="2.5"/>`;
  o+=`<line class="hg" x1="${(cx-t*k).toFixed(1)}" x2="${(cx+t*k).toFixed(1)}" y1="${(cy+(1.17-.9)*k).toFixed(1)}" y2="${(cy+(1.17-.9)*k).toFixed(1)}" marker-start="url(#ah)" marker-end="url(#ah)"/>`;
  return o};
const section=(cx,cy,k)=>{const h=R*k,c=R*.45*k;
  let o=`<rect class="b" x="${(cx-h).toFixed(1)}" y="${(cy-h).toFixed(1)}" width="${(2*h).toFixed(1)}" height="${(2*h).toFixed(1)}" rx="${c.toFixed(1)}"/>`;
  o+=`<rect class="dt" x="${(cx-h*.8).toFixed(1)}" y="${(cy-h-.028*k).toFixed(1)}" width="${(1.6*h).toFixed(1)}" height="${(.028*k).toFixed(1)}" rx="2"/>`;
  o+=`<circle class="hx" cx="${cx}" cy="${cy}" r="${(h*.62).toFixed(1)}"/><circle class="sm" cx="${cx}" cy="${cy}" r="${(h*.62).toFixed(1)}"/><circle class="sm" cx="${cx}" cy="${cy}" r="${(h*.82).toFixed(1)}"/>`;
  return o};
BPXS['WPN-00006']={L:1.8,padTop:40,ext:[-.03,1.83],hy:.24,diaAt:1.30,short:'GBU-39/B SDB',title:'SIDE ELEVATION · WINGS STOWED',
 draw(K){const og=K.ogive(0,.42,R,.008);
  const rB=x=>x<.42?og(x):x<1.50?R:K.prof([[1.50,R],[1.80,.066]],false)(x);
  const wall=x=>x<.16?rB(x):Math.max(.02,rB(x)-(x<.30?.035:.014));
  // 1 warhead: pointed steel penetrator case, explosive fill seen in the cutaway
  let wh=K.body(rB,0,.99)+K.shade(rB,.04,.98,[.4,.7])+K.ring(.42,R,'sm',true)+K.half(x=>rB(x)*.9,.03,.98,-1,1,'sh hi');
  wh+=K.cutbg(rB,0,.99)+K.half(wall,.16,.97,1)+K.line(.16,0,.16,wall(.16),'sm')+K.line(.97,0,.97,R,'sm')+K.line(.99,-R,.99,R,'sm');
  for(let x=.02;x<.15;x+=.02)wh+=K.line(x,0,x+.015,rB(x+.015)*.95,'sh');
  wh+=K.hatch(K.region(wall,.30,.94,.0))+K.rect(.94,.0,.97,.03,'sm')+K.nb(.03,R+.07,'SOLID NOSE')+K.nb(.48,R+.07,'AFX-757 FILL')+K.cn(.22,-R*.4,1);
  // 2 wing kit: stowed wing pack in a dorsal fairing, pivot fittings
  const wt=-R,wh2=.026;let wk=K.poly([[.64,wt],[.68,wt-wh2],[1.13,wt-wh2],[1.17,wt]],'b tk');
  wk+=K.line(.70,wt-wh2*.5,1.11,wt-wh2*.5,'sh')+K.circ(.77,wt-wh2*.5,.007,'dt')+K.circ(1.145,wt-wh2*.5,.007,'dt')+K.cn(.95,wt-.065,2,8);
  // 3 guidance section: GPS antenna, electronics bay, umbilical, lugs
  const rG=x=>rB(x);let gs=K.body(rG,.99,1.53)+K.shade(rG,1.0,1.52,[.4,.7])+K.ring(1.53,rB(1.53),'sm');
  gs+=K.cutbg(rG,.99,1.53)+K.half(x=>rG(x)-.008,1.0,1.52,1);
  gs+=K.rect(1.03,.012,1.22,.07,'dt')+K.nb(1.045,.052,'GPS/INS')+K.rect(1.25,.012,1.36,.07,'dt')+K.nb(1.26,.052,'BATT')+K.rect(1.39,.012,1.50,.07,'dt')+K.nb(1.40,.052,'CAS');
  gs+=K.rect(1.20,-R-.008,1.30,-R,'sm')+K.cn(1.26,-R*.45,3,8);
  // 4 tail: boat-tail with four deployed fins in X
  let tl=K.body(rB,1.53,1.80,'b tk')+K.shade(rB,1.54,1.79,[.5,.8]);
  const tip=.20*Math.SQRT1_2+.07*(1-Math.SQRT1_2);
  [-1,1].forEach(sg=>{tl+=K.fin(1.60,1.79,rB(1.60)-.004,1.72,1.79,tip,sg,1.66)});
  tl+=K.cn(1.62,0,4,8);
  return {groups:[
    {part:0,dx:-40,svg:wh,lab:[.48,R+.15,'middle']},
    {part:1,dx:0,dy:-90,svg:wk,lab:[1.24,-R-.03,'start']},
    {part:2,dx:30,dy:110,svg:gs,lab:[1.26,R+.15,'middle']},
    {part:3,dx:100,svg:tl,lab:[1.70,-.25,'middle']}],
   extra:`<line class="hg" x1="${K.F(K.X(.70))}" x2="${K.F(K.X(.70))}" y1="${K.F(K.Y(-R-.026)-14)}" y2="${K.F(K.Y(R)+14)}"/>`+K.nb(.705,-R-.06,'A')+K.nb(.705,R+.07,'A')}},
 views:[
  {r:.92,size:96,title:'PLAN · WINGS DEPLOYED',sub:'SPAN 1.61 m',draw:plan},
  {r:.13,size:40,title:'SECTION A–A',sub:'WARHEAD · STOWED WING PACK',draw:section}]};
})();

// AGM-114 Hellfire. Parts (data order): 0 seeker, 1 warhead, 2 guidance and control, 3 rocket motor
BPXS['WPN-00007']={L:1.6,ext:[-.03,1.63],hy:.2,diaAt:1.32,short:'AGM-114 HELLFIRE',title:'SIDE ELEVATION · HALF SECTION',
 draw(K){const R=.09,wall=.006,rd=.062;
  const nose=K.prof([[rd,rd],[.2,R]]);
  const rB=x=>x<rd?Math.sqrt(Math.max(0,rd*rd-(rd-x)**2)):x<.2?nose(x):R;
  const rIn=x=>Math.max(.004,rB(x)-wall);
  const seg=(a,b,c)=>K.body(rB,a,b,c)+K.shade(rB,Math.max(a,.03),b-.003,[.45,.75])+K.cutbg(rB,a,b)+K.half(rIn,a+.004,b-.004,1);
  // 1 seeker: dome, window frame, gimbal optics, detector, electronics
  let sk=seg(0,.24)+K.ring(rd,rd,'sm',true)+K.half(x=>rB(x)*.62,.006,rd,-1,1,'sh hi');
  sk+=K.poly([[.018,.012],[.03,.045],[.045,.052],[.06,.045],[.066,.012]],'sm')+K.line(.042,.012,.042,.05,'sh');
  sk+=K.rect(.075,.008,.105,.04,'dt')+K.line(.09,0,.09,.008,'sm')+K.circ(.09,.024,.008,'sm');
  [.13,.15,.17,.19,.21].forEach(x=>sk+=K.line(x,.012,x,rIn(x)*.9,'sm'));sk+=K.line(.12,.012,.225,.012,'sm');
  sk+=K.ring(.235,R,'sm',true)+K.nb(.005,R+.04,'SEEKER DOME')+K.cn(.15,-R*.5,1,8);
  // 2 warhead: precursor charge, stand-off, main shaped charge with liner, booster
  let wh=seg(.24,.64);wh+=K.ring(.30,R,'sh',true)+K.ring(.62,R,'sh',true);
  wh+=K.hatch(`M${K.P(.255,0)}L${K.P(.255,.035)}L${K.P(.28,.035)}L${K.P(.28,0)}Z`)+K.poly([[.245,.035],[.255,0],[.245,0]],'sm');
  wh+=K.line(.28,.006,.37,.006,'hg');
  wh+=K.hatch(`M${K.P(.37,rIn(.37)-.004)}L${K.P(.5,.006)}L${K.P(.5,0)}L${K.P(.6,0)}L${K.P(.6,rIn(.6)-.004)}Z`);
  wh+=K.poly([[.37,rIn(.37)-.004],[.5,.004],[.51,.004],[.385,rIn(.37)-.004]],'dt');
  wh+=K.rect(.6,0,.62,.018,'dt')+K.nb(.245,R+.04,'PRECURSOR')+K.nb(.63,R+.075,'LINER · MAIN CHARGE','end')+K.cn(.45,-R*.5,2,8);
  // 3 guidance and control: autopilot, battery, wings (cruciform, two seen in profile)
  let gc=seg(.64,.96);gc+=K.rect(.66,.012,.73,.06,'dt')+K.circ(.695,.036,.014,'sm')+K.rect(.75,.01,.86,.07,'dt');
  [.77,.79,.81,.83].forEach(x=>gc+=K.line(x,.014,x,.066,'sh'));gc+=K.rect(.88,.012,.94,.06,'dt');
  [-1,1].forEach(sg=>{gc+=K.fin(.655,.905,R,.82,.905,.165,sg)+K.line(.72,sg*(R+.012),.9,sg*(R+.012),'sh')});
  gc+=K.nb(.66,R+.105,'AUTOPILOT · BATTERY')+K.cn(.8,-.13,3,8);
  // 4 rocket motor: case, propellant grain with bore, nozzle, control actuators and tail fins
  let mt=seg(.96,1.6);mt+=K.ring(1.36,R,'sh',true);
  mt+=K.hatch(`M${K.P(.98,rIn(1)-.004)}L${K.P(1.36,rIn(1)-.004)}L${K.P(1.36,.022)}L${K.P(.98,.022)}Z`);
  mt+=K.line(.98,.011,1.36,.011,'hg')+K.poly([[1.36,.022],[1.44,.012],[1.53,.012],[1.6,.03],[1.6,.012]],'sm',false);
  mt+=K.rect(1.43,.04,1.52,.07,'dt')+K.line(1.475,.07,1.475,.082,'sm');
  [-1,1].forEach(sg=>{mt+=K.fin(1.455,1.595,R,1.53,1.59,.15,sg,1.5)});
  mt+=K.poly([[1.6,-.05],[1.605,-.05],[1.605,.05],[1.6,.05]],'sm')+K.nb(1.0,R+.04,'SOLID PROPELLANT GRAIN')+K.nb(1.6,R+.105,'CONTROL ACTUATORS','end')+K.cn(1.18,-R*.5,4,8);
  return {groups:[
    {part:0,dx:-90,svg:sk,lab:[0,R+.19,'start']},
    {part:1,dx:-45,svg:wh,lab:[.44,-R-.1,'middle']},
    {part:2,dx:0,svg:gc,lab:[.8,R+.22,'middle']},
    {part:3,dx:60,svg:mt,lab:[1.28,-R-.1,'middle']}],
   extra:`<line class="hg" x1="${K.F(K.X(.45))}" x2="${K.F(K.X(.45))}" y1="${K.F(K.Y(-R)-14)}" y2="${K.F(K.Y(R)+14)}"/>`+K.nb(.455,-R-.035,'A')}},
 views:[
  {r:.17,size:62,title:'VIEW FROM FRONT',sub:'SPAN 0.33 m',draw:(cx,cy,k)=>BPXV.fins(cx,cy,k,.09,.165,[0,90,180,270],.008)+BPXV.disc(cx,cy,k,.09)+BPXV.disc(cx,cy,k,.062,'sm')+BPXV.disc(cx,cy,k,.03,'sh')},
  {r:.09,size:40,title:'SECTION A–A',sub:'CASE · CHARGE · LINER',draw:(cx,cy,k)=>BPXV.disc(cx,cy,k,.09)+BPXV.hatchDisc(cx,cy,k,.083)+BPXV.disc(cx,cy,k,.05,'dt')+BPXV.disc(cx,cy,k,.012,'sm')}]};

// PULS / Lahav on an 8x8 HEMTT: forward cab, engine bay, frame rails, two tandem axle pairs; turntable launch module
// with two rocket pods stowed level. Side elevation, x from the front bumper. Length not on record: 10.2 m drawn.
// Parts (data order): 0 truck chassis, 1 launch module and pods. Ground at y = +1.5 m.
BPXS['WPN-00015']={L:10.2,ext:[-.2,10.4],hy:1.55,padTop:50,short:'PULS / LAHAV ON HEMTT 8x8',title:'SIDE ELEVATION',
 draw(K){const G=1.5,wr=.62,wy=G-wr,ax=[1.3,2.85,7.2,8.75];
  const wheel=x=>{let o=K.circ(x,wy,wr,'b')+K.circ(x,wy,wr*.93,'sh')+K.circ(x,wy,.36,'dt')+K.circ(x,wy,.12,'sm');
    for(let i=0;i<8;i++){const a=i*Math.PI/4;o+=K.dot(x+.26*Math.cos(a),wy+.26*Math.sin(a),1.3)}
    for(let i=0;i<24;i++){const a=i*Math.PI/12;o+=K.line(x+wr*.93*Math.cos(a),wy+wr*.93*Math.sin(a),x+wr*Math.cos(a),wy+wr*Math.sin(a),'sh')}return o};
  // 1 chassis: frame, cab, engine bay, fenders, wheels, fuel tank, steps, rear bumper and stabiliser jack
  let c=K.rect(.15,.32,10.05,.6,'b')+K.line(.15,.46,10.05,.46,'sh');
  for(let x=.6;x<10;x+=.55)c+=K.dot(x,.39,1)+K.dot(x,.53,1);
  // cab
  c+=K.poly([[0,.62],[0,-.05],[.08,-.3],[.25,-1.28],[2.05,-1.32],[2.15,-1.2],[2.15,.62]],'b');
  c+=K.poly([[.3,-1.18],[.92,-1.2],[.92,-.42],[.17,-.4]],'dt win')+K.poly([[1.02,-1.2],[1.95,-1.22],[1.95,-.45],[1.02,-.42]],'dt win');
  c+=K.rect(1.0,-1.25,2.0,.4,'sm')+K.line(1.85,-.1,1.95,-.1,'sm')+K.rect(-.05,.15,.14,.62,'dt');
  [.0,.1].forEach(y=>c+=K.line(.02,y,.14,y,'sh'));c+=K.rect(.04,-.22,.14,-.08,'sm');
  c+=K.line(.25,-1.28,2.05,-1.32,'sm')+K.rect(2.05,-1.55,2.13,-1.3,'sm');
  // engine bay and air intake
  c+=K.poly([[2.15,-.95],[3.75,-.95],[3.85,-.8],[3.85,.32],[2.15,.32]],'b');
  for(let x=2.35;x<3.7;x+=.12)c+=K.line(x,-.8,x,-.35,'sh');c+=K.rect(2.25,-.85,3.7,-.3,'sm')+K.rect(3.2,-1.35,3.35,-.95,'sm');
  // fenders, wheels
  [[ax[0],ax[1]],[ax[2],ax[3]]].forEach(([a,b])=>c+=K.poly([[a-.75,.62],[a-.7,.18],[b+.7,.18],[b+.75,.62]],'f'));
  ax.forEach(x=>c+=wheel(x));
  // fuel tank, steps, storage boxes
  c+=K.rect(3.9,.62,5.6,1.02,'b')+K.line(4.2,.62,4.2,1.02,'sh')+K.line(5.3,.62,5.3,1.02,'sh');
  c+=K.rect(5.75,.62,6.4,.95,'dt');
  c+=K.rect(1.92,.62,2.1,1.15,'sm')+K.line(1.92,.8,2.1,.8,'sh')+K.line(1.92,.98,2.1,.98,'sh');
  c+=K.rect(9.75,.6,10.15,.82,'dt')+K.rect(9.5,.6,9.66,1.2,'sm')+K.rect(9.45,1.2,9.71,1.27,'dt');
  c+=K.cn(1.6,-.25,1);
  // 2 launch module: turntable, cradle, elevation actuator, two pods (one seen), pod frame, cable trays
  let m=K.rect(4.1,.05,9.9,.32,'b tk')+K.rect(6.2,-.1,8.0,.05,'dt')+K.line(6.2,-.025,8.0,-.025,'sh');
  for(let x=4.3;x<9.8;x+=.5)m+=K.line(x,.05,x,.32,'sh');
  m+=K.poly([[4.3,-.1],[10.2,-.1],[10.2,-.25],[4.3,-.25]],'dt');
  m+=K.poly([[4.75,-.25],[5.2,-.25],[5.0,-.1]],'sm')+K.rect(7.6,-.25,9.4,-.1,'sm');
  m+=K.poly([[4.4,-.25],[10.2,-.25],[10.2,-1.38],[4.6,-1.38],[4.4,-1.2]],'b');
  [5.2,6.6,8.0,9.4].forEach(x=>m+=K.line(x,-1.38,x,-.25,'sm'));
  m+=K.line(4.5,-1.3,10.1,-1.3,'sh')+K.line(4.5,-.33,10.1,-.33,'sh');
  m+=K.rect(10.08,-1.36,10.2,-.27,'dt');
  for(let y=-1.2;y<-.3;y+=.18)m+=K.line(10.1,y,10.18,y,'sh');
  [5.6,7.3,9.0].forEach(x=>m+=K.rect(x-.12,-1.48,x+.12,-1.38,'dt'));
  m+=K.cn(7.3,-.8,2);
  return {groups:[
    {part:0,dx:0,dy:20,svg:c,lab:[5.0,1.32,'middle']},
    {part:1,dx:40,dy:-95,svg:m,lab:[7.3,-1.84,'middle']}],
   extra:K.line(-.15,G,10.35,G,'hg')+K.nb(9.9,G-.08,'GROUND','end')
    +K.nb(0,-1.7,'36 x 122 mm · 26 x 160 mm · 8 x 306 mm · 4 x 370 mm (POD SETS ON RECORD)')}},
 views:[
  {r:1.55,size:62,title:'FRONT VIEW',sub:'CAB · PODS HIDDEN',draw:(cx,cy,k)=>{const P=(x,y)=>(cx+x*k).toFixed(1)+','+(cy+(y-.06)*k).toFixed(1),R=(x0,y0,x1,y1,c)=>`<path class="${c}" d="M${P(x0,y0)}L${P(x1,y0)}L${P(x1,y1)}L${P(x0,y1)}Z"/>`;
    let o=R(-1.22,1.5,-.8,.26,'b')+R(.8,1.5,1.22,.26,'b')+R(-1.1,-1.15,1.1,.6,'b');
    o+=R(-.98,-1.05,-.05,-.4,'dt win')+R(.05,-1.05,.98,-.4,'dt win')+R(-.9,-.15,.9,.35,'sm');
    for(let y=-.1;y<.32;y+=.09)o+=`<line class="sh" x1="${P(-.85,y).split(',')[0]}" x2="${P(.85,y).split(',')[0]}" y1="${P(0,y).split(',')[1]}" y2="${P(0,y).split(',')[1]}"/>`;
    o+=R(-1.05,.0,-.95,.12,'dt')+R(.95,.0,1.05,.12,'dt')+R(-1.25,.5,1.25,.62,'dt')+R(-1.15,-1.3,1.15,-1.15,'sm');
    o+=`<path class="hg" d="M${P(-1.15,-1.38)}L${P(1.15,-1.38)}"/>`;return o}},
  {r:1.55,size:62,title:'VIEW FROM AFT',sub:'TWO PODS · 2 x 18 x 122 mm',draw:(cx,cy,k)=>{const P=(x,y)=>(cx+x*k).toFixed(1)+','+(cy+(y-.06)*k).toFixed(1),R=(x0,y0,x1,y1,c)=>`<path class="${c}" d="M${P(x0,y0)}L${P(x1,y0)}L${P(x1,y1)}L${P(x0,y1)}Z"/>`;
    let o=R(-1.22,1.5,-.8,.26,'b')+R(.8,1.5,1.22,.26,'b')+R(-1.1,.32,1.1,.6,'b')+R(-1.0,.05,1.0,.32,'dt')+R(-1.15,-.25,1.15,-.1,'dt');
    [-1,1].forEach(sd=>{const x0=sd<0?-1.1:.08,x1=sd<0?-.08:1.1;o+=R(x0,-1.38,x1,-.25,'b');
      for(let i=0;i<6;i++)for(let j=0;j<3;j++){const x=x0+.12+i*(x1-x0-.24)/5,y=-1.15+j*.33;o+=`<circle class="sm" cx="${(cx+x*k).toFixed(1)}" cy="${(cy+(y-.06)*k).toFixed(1)}" r="${(.061*k).toFixed(1)}"/>`}});
    return o}}]};

// AIM-120 AMRAAM: no parts on record, drawn as one assembly with its sections labelled
BPXS['WPN-00016']={L:3.65,ext:[-.05,3.7],hy:.3,short:'AIM-120C AMRAAM',title:'SIDE ELEVATION · SECTIONS LABELLED',
 draw(K){const R=.0889,wall=.005,og=K.ogive(0,.45,R,.004);const rB=x=>x<.45?og(x):R;const rIn=x=>Math.max(.004,rB(x)-wall);
  let o=K.body(rB,0,3.65)+K.shade(rB,.03,3.64,[.45,.75])+K.half(x=>rB(x)*.93,.02,3.64,-1,1,'sh hi');
  [.45,.95,1.35,1.75,2.6].forEach(x=>o+=K.ring(x,R,'sm'));o+=K.rivets(.96,R,5)+K.rivets(1.76,R,5);
  [-1,1].forEach(sg=>{o+=K.fin(1.2,1.65,R,1.48,1.66,.22,sg)+K.fin(3.25,3.62,R,3.45,3.63,.25,sg,3.5)});
  o+=K.poly([[3.65,-.05],[3.68,-.045],[3.68,.045],[3.65,.05]],'sm')+K.rect(1.9,-R,2.4,-R-.012,'dt')+K.nb(2.15,-R-.03,'UMBILICAL · HANGER','middle');
  [[.22,'RADAR SEEKER',.06],[.7,'GUIDANCE',.06],[1.15,'WARHEAD',.06],[1.55,'FUZE · DATALINK',.12],[2.2,'ROCKET MOTOR',.06],[3.1,'CONTROL SECTION',.06]].forEach(([x,t,y])=>o+=K.nb(x,R+y,t,'middle'));
  return {groups:[{part:null,svg:o}]}},
 views:[{r:.25,size:60,title:'VIEW FROM FRONT',sub:'CRUCIFORM WINGS AND FINS',draw:(cx,cy,k)=>BPXV.fins(cx,cy,k,.0889,.25,[45,135,225,315],.006)+BPXV.fins(cx,cy,k,.0889,.22,[0,90,180,270],.005)+BPXV.disc(cx,cy,k,.0889)+BPXV.disc(cx,cy,k,.04,'sm')}]};

// F-35I Adir (F-35A airframe): plan view. Parts (data order): 0 forward fuselage / cockpit, 1 centre fuselage (with wing), 2 rear fuselage (with tails), 3 F135 engine
(()=>{
const mir=h=>h.concat(h.slice().reverse().map(([x,y])=>[x,-y]));
const flip=p=>p.map(([x,y])=>[x,-y]);
const VW=(cx,cy,k)=>{const f=v=>(+v).toFixed(1),P=([x,y])=>f(cx+x*k)+','+f(cy+y*k);return{
  p:(pts,c='b',cl=true)=>`<path class="${c}" d="M${pts.map(P).join('L')}${cl?'Z':''}"/>`,
  m:(pts,c='b',cl=true)=>`<path class="${c}" d="M${pts.concat(pts.slice().reverse().map(([x,y])=>[-x,y])).map(P).join('L')}${cl?'Z':''}"/>`,
  c:(x,y,r,c='dt')=>`<circle class="${c}" cx="${f(cx+x*k)}" cy="${f(cy+y*k)}" r="${f(r*k)}"/>`,
  e:(x,y,rx,ry,c='dt')=>`<ellipse class="${c}" cx="${f(cx+x*k)}" cy="${f(cy+y*k)}" rx="${f(rx*k)}" ry="${f(ry*k)}"/>`,
  l:(x1,y1,x2,y2,c='sm')=>`<line class="${c}" x1="${f(cx+x1*k)}" y1="${f(cy+y1*k)}" x2="${f(cx+x2*k)}" y2="${f(cy+y2*k)}"/>`}};
const L=15.7,HS=5.35;
// wing geometry
const wLE=y=>6.4+(y-1.6)*.733, wTE=y=>10.45+(HS-y)*(1.15/3.75);
BPXS['WPN-NEW-F35']={L,ext:[-.8,16.9],hy:5.75,maxH:520,padTop:10,H:770,short:'F-35I ADIR · F-35A AIRFRAME',title:'PLAN VIEW',
 draw(K){
  const both=(p,c)=>K.poly(p,c)+K.poly(flip(p),c);
  // ---- 1 forward fuselage / cockpit (0 to 5.5 m)
  const fwdH=[[0,0],[.25,.07],[.7,.2],[1.4,.38],[2.2,.56],[3.1,.74],[3.9,.88],[4.5,.97],[4.78,1.5],[5.5,1.6]];
  let fw=K.poly(mir(fwdH),'b');
  fw+=K.poly([[.25,.0],[.7,.15],[1.4,.3]].concat([[1.4,-.3],[.7,-.15]]),'sh',false);
  fw+=K.line(1.4,-.37,1.4,.37,'sm');                                       // radome joint
  fw+=K.poly([[1.6,.42],[2.4,.53],[3.3,.66],[4.3,.82]],'sh',false)+K.poly([[1.6,-.42],[2.4,-.53],[3.3,-.66],[4.3,-.82]],'sh',false); // chine
  // canopy: one-piece, bow frame
  const can=[];for(let i=0;i<=24;i++){const t=i/24,x=2.35+t*3.0;can.push([x,.44*Math.pow(Math.sin(Math.PI*Math.pow(t,.8)),.7)])}
  fw+=K.poly(mir(can),'dt win')+K.line(3.25,-.41,3.25,.41,'sm')+K.poly([[2.8,0],[3.2,0]],'sh',false);
  fw+=K.circ(3.0,0,.12,'sm')+K.nb(3.4,.98,'CANOPY','middle');                     // ejection seat head box
  // caret (DSI) intakes and bumps
  [-1,1].forEach(sg=>{fw+=K.poly([[4.5,sg*.97],[4.78,sg*1.5],[4.92,sg*1.46],[4.66,sg*.98]],'dt');
    fw+=K.poly([[3.9,sg*.86],[4.3,sg*1.0],[4.75,sg*1.02],[5.2,sg*.97]],'sh',false)});
  // sawtooth access panel + DAS apertures
  fw+=K.poly([[4.6,-.55],[4.75,-.45],[4.6,-.35],[4.75,-.25],[4.6,-.15],[5.3,-.15],[5.3,-.55]],'sm');
  fw+=K.circ(5.05,.35,.06,'dt')+K.circ(1.9,.22,.05,'dt')+K.circ(1.9,-.22,.05,'dt');
  fw+=K.cn(1.6,0,1,8);
  // ---- 2 centre fuselage (5.5 to 10.2 m) with wing
  let cf=K.poly(mir([[5.5,0],[5.5,1.6],[6.4,1.62],[8.5,1.68],[10.2,1.72],[10.2,0]]),'b');
  [-1,1].forEach(sg=>{const w=[[6.4,1.6],[wLE(HS),HS],[wTE(HS),HS],[wTE(1.72),1.72]].map(([x,y])=>[x,sg*y]);
    cf+=K.poly(w,'b');
    // leading-edge flap hinge
    cf+=K.line(wLE(1.9)+.5,sg*1.9,wLE(5.2)+.33,sg*5.2,'hg');
    // flaperon
    cf+=K.poly([[wTE(1.95),sg*1.95],[wTE(1.95)-.62,sg*1.95],[wTE(5.15)-.45,sg*5.15],[wTE(5.15),sg*5.15]],'sm');
    // spar / rib panel lines
    cf+=K.line(wLE(1.8)+1.6,sg*1.8,wLE(5.0)+.45,sg*5.0,'sh')+K.line(wLE(2.4)+2.4,sg*2.4,wLE(4.6)+.8,sg*4.6,'sh');
    // wing stations (pylon positions, underside, hidden)
    [2.55,3.55,4.55].forEach(y=>{const xm=(wLE(y)+wTE(y))/2-.35;cf+=K.rect(xm-.75,sg*(y-.06),xm+.75,sg*(y+.06),'hg')});
    // internal weapons bays (underside, hidden): bay outline + door hinge
    cf+=K.rect(6.2,sg*.32,10.0,sg*1.08,'hg')+K.line(6.2,sg*.7,10.0,sg*.7,'hg');
    // sawtooth bay door edge
    cf+=K.poly([[6.2,sg*.32],[6.0,sg*.5],[6.2,sg*.7],[6.0,sg*.9],[6.2,sg*1.08]],'sh',false);
    cf+=K.line(5.5,sg*1.15,10.2,sg*1.3,'sh')});
  cf+=K.poly([[6.6,1.24],[6.9,1.34],[8.3,1.36],[8.5,1.28],[8.3,1.2],[6.9,1.18]],'sm')+K.nb(8.6,1.36,'GUN BULGE');  // GAU-22 on left side
  cf+=K.rect(5.85,-.13,6.35,.13,'dt')+K.nb(5.75,-.24,'AAR DOOR');
  cf+=K.nb(6.4,.6,'WEAPONS BAY (UNDERSIDE)');
  cf+=K.nb(wLE(3.6)-.25,3.62,'WING STATIONS (UNDERSIDE)','end')+K.nb(wTE(4.0)+.25,-4.0,'FLAPERON')+K.nb(wLE(4.0)-.25,-4.0,'LE FLAP','end');
  cf+=K.cn(8.0,-3.0,2,8);
  // ---- 3 rear fuselage (10.2 to 14.1 m) with booms, stabilators, canted fins
  let rf=K.poly(mir([[10.2,0],[10.2,1.72],[11.6,1.7],[12.6,1.56],[13.7,1.36],[15.0,1.22],[15.22,1.05],[15.05,.82],[14.1,.76],[14.1,0]]),'b');
  [-1,1].forEach(sg=>{
    rf+=K.poly([[12.3,sg*1.45],[13.75,sg*3.35],[14.6,sg*3.35],[15.7,sg*1.15],[15.1,sg*1.15]],'f fin');
    rf+=K.circ(13.95,sg*1.62,.06,'dt')+K.line(13.95,sg*1.62,14.5,sg*3.2,'sh');
    rf+=K.poly([[11.3,sg*1.22],[13.35,sg*2.05],[14.55,sg*2.05],[14.3,sg*1.22]],'f fin');
    rf+=K.line(13.75,sg*1.26,14.15,sg*1.95,'hg');                       // rudder hinge
    rf+=K.line(10.2,sg*1.2,14.1,sg*.95,'sh')});
  rf+=K.nb(15.15,-3.0,'STABILATOR','start')+K.nb(12.4,-2.42,'CANTED FIN','middle');
  rf+=K.cn(11.0,-.9,3,8);
  // ---- 4 F135 engine (inner, hidden) and visible nozzle
  const rE=K.prof([[9.2,.5],[9.6,.58],[12.0,.58],[12.6,.52],[14.1,.55]]);
  let en=K.body(rE,9.2,14.1);
  [9.6,10.6,11.4,12.0,12.6].forEach(x=>en+=K.ring(x,rE(x)));
  en+=K.nb(9.65,.82,'FAN')+K.nb(10.95,.82,'CORE')+K.nb(12.75,.82,'AUGMENTOR');
  const rN=K.prof([[14.1,.6],[15.35,.5]],false);
  let nz=K.body(rN,14.1,15.35,'dt');[14.4,14.8].forEach(x=>nz+=K.ring(x,rN(x),'sh'));
  let saw='';for(let i=0;i<=12;i++){const y=-.5+i/12;saw+=(i?'L':'M')+K.P(15.35+(i%2?.08:0),y)}nz+=`<path class="sm" d="${saw}"/>`;
  return {groups:[
    {part:0,dx:-70,svg:fw,lab:[2.2,-1.5,'middle']},
    {part:1,svg:cf,lab:[4.6,-3.0,'middle']},
    {part:2,dx:70,svg:rf,lab:[13.6,-4.3,'middle']},
    {part:3,dx:60,dy:270,svg:en,inner:1,lab:[8.95,.05,'end']},
    {part:null,dx:60,dy:270,svg:nz}],
   extra:K.line(10.45,-HS,16.55,-HS,'sh')+K.line(10.45,HS,16.55,HS,'sh')+
     `<line class="hg" x1="${K.F(K.X(16.4))}" x2="${K.F(K.X(16.4))}" y1="${K.F(K.Y(-HS))}" y2="${K.F(K.Y(HS))}" marker-start="url(#ah)" marker-end="url(#ah)"/>`+
     `<text class="nb" x="${K.F(K.X(16.4)-5)}" y="${K.F(K.Y(0))}" text-anchor="middle" transform="rotate(-90 ${K.F(K.X(16.4)-5)} ${K.F(K.Y(0))})">SPAN 10.7 m</text>`}},
 views:[
  {r:2.7,k:16,size:60,title:'FRONT VIEW',draw:(cx,cy,k)=>{const v=VW(cx,cy,k);let o='';
    o+=v.p([[-1.2,-.5],[-2.05,-2.55],[-1.95,-2.6],[-1.05,-.55]],'f fin');
    o+=v.p([[1.2,-.5],[2.05,-2.55],[1.95,-2.6],[1.05,-.55]],'f fin');
    o+=v.p([[-5.35,.0],[-1.5,-.08],[-1.5,.14],[-5.35,.05]],'b')+v.p([[5.35,.0],[1.5,-.08],[1.5,.14],[5.35,.05]],'b');
    o+=v.l(-3.35,.02,-1.2,.02,'sm')+v.l(3.35,.02,1.2,.02,'sm');
    o+=v.m([[0,-1.25],[.3,-1.15],[.45,-.75],[.9,-.6],[1.5,-.35],[1.62,.05],[1.3,.6],[.6,.8],[0,.82]],'b');
    o+=v.m([[0,-1.25],[.3,-1.15],[.45,-.75],[0,-.72]],'dt win');
    [-1,1].forEach(s=>o+=v.p([[s*1.02,-.42],[s*1.55,-.3],[s*1.55,.25],[s*1.08,.3]],'dt'));
    o+=v.c(0,-.1,.42,'sm')+v.c(0,-.1,.08,'rt');
    [2.55,3.55,4.55].forEach(x=>{o+=v.l(x,.12,x,.35,'hg')+v.l(-x,.12,-x,.35,'hg')});
    return o}},
  {r:1.6,k:11,size:40,title:'SIDE ELEVATION',sub:'F-35A PROFILE',draw:(cx,cy,k)=>{const v=VW(cx,cy,k),T=p=>p.map(([x,y])=>[x-7.85,y]);let o='';
    o+=v.p(T([[11.4,-.82],[13.55,-2.6],[14.6,-2.55],[14.3,-.7]]),'f fin');
    o+=v.p(T([[0,.05],[1.0,-.28],[2.3,-.6],[3.6,-1.13],[4.6,-1.18],[5.6,-1.0],[7,-.92],[10,-.84],[12.5,-.74],[14.2,-.55],[15.35,-.45],[15.35,.35],[14.2,.45],[13,.58],[10,.74],[6,.8],[4.6,.6],[2.5,.42],[1,.22]]),'b');
    o+=v.p(T([[2.3,-.6],[3.6,-1.13],[4.6,-1.18],[5.4,-1.0],[3.5,-.62]]),'dt win')+v.l(3.25-7.85,-.98,3.6-7.85,-.66,'sm');
    o+=v.p(T([[4.55,-.3],[5.0,-.42],[5.0,.3],[4.7,.25]]),'dt');
    o+=v.p(T([[12.3,-.1],[15.7,-.06],[15.7,.02],[12.3,.02]]),'sm')+v.p(T([[6.4,.08],[11.6,.08],[11.6,.14],[6.4,.14]]),'sm');
    o+=v.l(14.2-7.85,-.55,14.2-7.85,.45,'sm')+v.l(1.4-7.85,-.25,1.4-7.85,.2,'sh');
    return o}}]};
})();

// Tomahawk Land Attack Missile with booster. Parts: 0 guidance, 1 warhead, 2 datalink antenna, 3 wings/fuel/actuators, 4 turbofan and tail, 5 booster
BPXS['WPN-NEW-TOMAHAWK']={L:6.25,ext:[-.05,6.3],hy:.75,maxH:230,short:'TOMAHAWK · BLOCK IV/V',title:'SIDE ELEVATION · WINGS DEPLOYED',
 draw(K){const R=.259,wall=.01,og=K.ogive(0,.6,R,.02);
  const rB=x=>x<.6?og(x):x<5.4?R:x<5.56?K.prof([[5.4,R],[5.56,.2]])(x):R*.98;const rIn=x=>Math.max(.01,rB(x)-wall);
  const seg=(a,b,c)=>K.body(rB,a,b,c)+K.shade(rB,a+.01,b-.01,[.45,.75])+K.cutbg(rB,a,b)+K.half(rIn,a+.01,b-.01,1);
  const box=(a,b,t)=>K.rect(a,.03,b,rIn((a+b)/2)-.03,'dt')+K.nb((a+b)/2,.13,t,'middle');
  let g=seg(0,.94)+K.ring(.6,R,'sm',true)+K.poly([[.62,-.12],[.62,.12]],'sm',false)+box(.25,.88,'INS · TERCOM · DSMAC · GPS')+K.rect(.66,-R*.75,.8,-R*.35,'dt win')+K.nb(.73,-R-.05,'DSMAC WINDOW','middle')+K.cn(.45,-R*.5,1);
  let w=seg(.94,2.19)+K.ring(2.18,R,'sm',true)+K.rivets(.96,R)+K.hatch(`M${K.P(1.0,.03)}L${K.P(2.1,.03)}L${K.P(2.1,rIn(1.5)-.02)}L${K.P(1.0,rIn(1.5)-.02)}Z`)+K.nb(1.55,R+.08,'UNITARY WARHEAD','middle')+K.cn(1.55,-R*.5,2);
  let a=K.poly([[1.9,-R],[1.96,-R-.05],[2.4,-R-.05],[2.46,-R]])+K.nb(2.18,-R-.08,'SATCOM','middle')+K.cn(2.18,-R-.025,3,7);
  let f=seg(2.19,4.69)+K.ring(4.68,R,'sm',true)+K.ring(3.2,R,'sh',true);
  [-1,1].forEach(sg=>f+=K.fin(2.9,3.3,R,3.08,3.36,.7,sg)+K.line(3.0,sg*(R+.1),3.25,sg*(R+.1),'sh'));
  f+=K.rect(2.25,.03,4.6,rIn(3)-.02,'sm')+K.nb(3.6,.15,'FUEL TANK','middle')+K.rect(4.3,-.03,4.6,-.18,'dt')+K.nb(4.45,-R-.06,'WING ACTUATOR','middle')+K.cn(3.7,-R*.5,4);
  let e=seg(4.69,5.56)+K.poly([[4.75,R],[4.82,R+.07],[5.0,R+.07],[5.05,R]])+K.nb(4.9,R+.12,'INTAKE','middle');
  e+=K.rect(4.95,.03,5.45,.17,'dt')+K.circ(5.05,.1,.05,'sm')+K.nb(5.2,.22,'TURBOFAN','middle');
  [-1,1].forEach(sg=>e+=K.fin(5.25,5.55,R*.85,5.42,5.56,.52,sg,5.47));e+=K.cn(5.15,-R*.5,5);
  let b=K.body(rB,5.56,6.25)+K.shade(rB,5.57,6.24,[.5,.8])+K.cutbg(rB,5.56,6.25)+K.half(rIn,5.57,6.24,1)+K.ring(5.6,R,'sm')+K.hatch(`M${K.P(5.62,.03)}L${K.P(6.1,.03)}L${K.P(6.1,rIn(6)-.02)}L${K.P(5.62,rIn(6)-.02)}Z`);
  b+=K.poly([[6.25,-.16],[6.3,-.2],[6.3,.2],[6.25,.16]],'sm')+K.nb(5.9,R+.07,'SOLID BOOSTER','middle')+K.cn(5.9,-R*.5,6);
  return {groups:[{part:0,dx:-80,svg:g,lab:[.05,R+.35,'start']},{part:1,dx:-45,svg:w,lab:[1.55,-R-.35,'middle']},{part:2,dx:0,dy:-60,svg:a,lab:[2.6,-R-.06,'start']},{part:3,dx:0,svg:f,lab:[3.7,R+.85,'middle']},{part:4,dx:45,svg:e,lab:[5.0,-R-.62,'middle']},{part:5,dx:90,svg:b,lab:[5.9,R+.45,'middle']}],
   extra:K.dimx(0,5.56,R+.62,'5.56 m WITHOUT BOOSTER')}},
 views:[{r:.7,size:62,title:'VIEW FROM FRONT',sub:'WINGS AND TAIL DEPLOYED',draw:(cx,cy,k)=>BPXV.fins(cx,cy,k,.259,.7,[0,180],.012)+BPXV.fins(cx,cy,k,.22,.52,[45,135,225,315],.01)+BPXV.disc(cx,cy,k,.259)+BPXV.disc(cx,cy,k,.1,'sm')}]};

function blueprint(w,ex){const dx0=typeof bpxDraw==='function'&&bpxDraw(w,ex,makerLabel);if(dx0)return dx0;const form=PROF[w.form]?w.form:'device',dm=w.dims||{},df=BPDEF[form];
  const hasL=+dm.length_m>0,hasD=+dm.diameter_m>0,L=hasL?+dm.length_m:df[0],Dm=hasD?+dm.diameter_m:L*df[1];
  const plan=form==='drone'||form==='aircraft',span=plan?(+dm.span_m||L*(df[2]||.7)):0,hasS=+dm.span_m>0;
  const W=900,ox=80,pr=PROF[form];
  const all=(w.parts&&w.parts.length?w.parts:[{name:w.name,start:0,end:1}]).map((p,i)=>({...p,start:Math.max(0,+p.start||0),end:Math.min(1,p.end!=null?+p.end:1),k:i}));
  // primary parts tile the body; parts lying inside another are internal components
  const srt=all.slice().sort((a,b)=>a.start-b.start||(b.end-b.start)-(a.end-a.start)),prim=[],inner=[];let edge=0;
  srt.forEach(p=>{if(p.start>=edge-.02&&p.end>p.start){prim.push(p);edge=p.end}else inner.push(p)});
  if(!prim.length)prim.push(...inner.splice(0,1));
  const n=prim.length,gap=n>1?Math.min(46,220/(n-1)):0,finMax=(FINS[form]||[]).reduce((m,f)=>Math.max(m,f[2]),1);
  let s=(W-2*ox-gap*(n-1))/L;const maxR=plan?Math.max(Dm,span)/2:Dm/2*finMax,lim=plan?330:form==='device'||form==='launcher'?150:200;if(maxR*s*2>lim)s=lim/(maxR*2);
  const R=Dm/2*s,Lp=L*s,shift=(W-2*ox-Lp)/2,IK=.45,step=Math.max(26,R*IK*2+14),LIFT=j=>-(R*(form==='bomb'||form==='missile'||form==='rocket'?1.3:1)+R*IK+18+j*step),topIn=inner.length?-LIFT(inner.length-1)+R*IK+40:0,cy=Math.max(150,maxR*s+70,topIn),DX=i=>gap*(i-(n-1)/2);
  const x=t=>ox+shift+t*Lp;
  const body=(t0,t1,k=1)=>{const st=24,top=[],bot=[];for(let i=0;i<=st;i++){const t=t0+(t1-t0)*i/st;top.push([x(t),cy-pr(t)*R*k]);bot.push([x(t),cy+pr(t)*R*k])}return 'M'+top.map(p=>p.map(v=>v.toFixed(1)).join(',')).join('L')+'L'+bot.reverse().map(p=>p.map(v=>v.toFixed(1)).join(',')).join('L')+'Z'};
  const fins=(t0,t1)=>{let d='';(FINS[form]||[]).forEach(([a,b,sp,sw])=>{const c=(a+b)/2;if(c<t0||c>t1)return;
      if(plan&&sp===0){const hs=span/2*s,ra=pr(a)*R;d+=`M${x(a)},${cy-ra}L${x(a+(b-a)*.55)},${cy-hs}L${x(b)},${cy-hs}L${x(b)},${cy-pr(b)*R}M${x(a)},${cy+ra}L${x(a+(b-a)*.55)},${cy+hs}L${x(b)},${cy+hs}L${x(b)},${cy+pr(b)*R}`;return}
      const ra=pr(a)*R,rb=pr(b)*R,f=sp*R;d+=`M${x(a)},${cy-ra}L${x(a+(b-a)*sw)},${cy-f}L${x(b)},${cy-f}L${x(b)},${cy-rb}M${x(a)},${cy+ra}L${x(a+(b-a)*sw)},${cy+f}L${x(b)},${cy+f}L${x(b)},${cy+rb}`});return d};
  const rotor=form==='helicopter'?`<line x1="${x(.02)}" x2="${x(.78)}" y1="${cy-R-14}" y2="${cy-R-14}"/><line x1="${x(.4)}" x2="${x(.4)}" y1="${cy-R-14}" y2="${cy-R}"/>`:'';
  // drawing detail: shading, seams, rivets and the fittings each form really carries (lugs, fuze wells, seeker, nozzle, rotating band, canopy, rotors)
  const F1=v=>(+v).toFixed(1),prof=(t0,t1,k,st=18)=>{const a=[];for(let i=0;i<=st;i++){const t=t0+(t1-t0)*i/st;a.push(F1(x(t))+','+F1(cy+pr(t)*R*k))}return 'M'+a.join('L')};
  const det=(t0,t1)=>{let o='';const at=t=>t>=t0-.001&&t<=t1+.001,X=x,rr=t=>pr(t)*R;
    if(!plan&&form!=='device'&&form!=='launcher'){[.56,.72,.85].forEach(k=>o+=`<path class="sh" d="${prof(t0+.006,t1-.006,k)}"/>`);o+=`<path class="sh hi" d="${prof(t0+.01,t1-.01,-.48)}"/>`}
    [t0,t1].forEach((t,j)=>{if(t<=.001||t>=.999)return;const tt=j?t-.007:t+.007,r=rr(tt)*.96;o+=`<line class="sm" x1="${F1(X(tt))}" x2="${F1(X(tt))}" y1="${F1(cy-r)}" y2="${F1(cy+r)}"/>`;const tr=tt+(j?-.008:.008);for(let q=-3;q<=3;q++)o+=`<circle class="rt" cx="${F1(X(tr))}" cy="${F1(cy+q*rr(tr)*.27)}" r="1"/>`});
    (FINS[form]||[]).forEach(([a,b,sp])=>{if(plan||!sp||!at((a+b)/2))return;const f=sp*R,hx=X(b)-(X(b)-X(a))*.22;[-1,1].forEach(sg=>{o+=`<line class="hg" x1="${F1(hx)}" x2="${F1(hx)}" y1="${F1(cy+sg*rr(b))}" y2="${F1(cy+sg*(f-3))}"/><line class="sm" x1="${F1(X(a+(b-a)*.55))}" x2="${F1(hx-4)}" y1="${F1(cy+sg*(rr(a+(b-a)*.55)+3))}" y2="${F1(cy+sg*(f-6))}"/>`})});
    const lug=t=>{const c=X(t),y=cy-rr(t);return `<path class="dt" d="M${F1(c-8)},${F1(y)}L${F1(c-5)},${F1(y-9)}L${F1(c+5)},${F1(y-9)}L${F1(c+8)},${F1(y)}Z"/><circle class="dt" cx="${F1(c)}" cy="${F1(y-5)}" r="2.2"/>`};
    const ring=t=>`<line class="sm" x1="${F1(X(t))}" x2="${F1(X(t))}" y1="${F1(cy-rr(t))}" y2="${F1(cy+rr(t))}"/>`;
    const nozzle=()=>`<path class="dt" d="M${F1(X(1))},${F1(cy-R*.6)}L${F1(X(1)+R*.55)},${F1(cy-R*.82)}L${F1(X(1)+R*.55)},${F1(cy+R*.82)}L${F1(X(1))},${F1(cy+R*.6)}Z"/><line class="sm" x1="${F1(X(1)+R*.3)}" x2="${F1(X(1)+R*.3)}" y1="${F1(cy-R*.72)}" y2="${F1(cy+R*.72)}"/>`;
    const tip=()=>`<path class="dt" d="M${F1(X(0)+2)},${F1(cy-Math.max(3,R*.09))}L${F1(X(0)-9)},${F1(cy-Math.max(2,R*.06))}L${F1(X(0)-9)},${F1(cy+Math.max(2,R*.06))}L${F1(X(0)+2)},${F1(cy+Math.max(3,R*.09))}Z"/>`;
    if(form==='bomb'){if(at(.37))o+=lug(.37);if(at(.57))o+=lug(.57);if(at(0))o+=tip()+ring(.035)+ring(.07);if(at(.66))o+=`<circle class="dt" cx="${F1(X(.66))}" cy="${F1(cy-rr(.66)*.5)}" r="3.2"/><path class="hg" d="M${F1(X(.57))},${F1(cy-rr(.57)-5)}Q${F1(X(.62))},${F1(cy-rr(.6)-14)} ${F1(X(.66))},${F1(cy-rr(.66)*.5-3)}"/>`}
    if(form==='missile'||form==='rocket'){if(at(0)){o+=tip();if(form==='missile')o+=`<path class="dt win" d="${body(.004,.055,.7)}"/>`+ring(.058)}if(at(.6)&&form==='missile')o+=`<rect class="dt" x="${F1(X(.6)-7)}" y="${F1(cy-R-5)}" width="14" height="5"/>`;if(at(.5))o+=`<path class="sm" d="M${F1(X(Math.max(t0,.14)))},${F1(cy-R-2)}L${F1(X(Math.min(t1,.84)))},${F1(cy-R-2)}"/>`;if(at(1))o+=nozzle()}
    if(form==='shell'){if(at(.83))o+=`<rect class="dt hx" x="${F1(X(.8))}" y="${F1(cy-R*1.05)}" width="${F1(X(.85)-X(.8))}" height="${F1(R*2.1)}"/>`;if(at(.39))o+=ring(.37)+ring(.4);if(at(.1))[.05,.08,.11,.14].forEach(t=>o+=ring(t));if(at(.5))o+=`<path class="cav" d="${body(Math.max(t0,.18),Math.min(t1,.9),.74)}"/>`;if(at(.97))o+=ring(.965)}
    if(plan){(FINS[form]||[]).forEach(([a,b,sp])=>{if(sp!==0||!at((a+b)/2))return;const hs=span/2*s,ra=rr(a);[-1,1].forEach(sg=>{[.3,.55,.8].forEach(f=>{const y=cy+sg*(ra+(hs-ra)*f),le=X(a)+(X(a+(b-a)*.55)-X(a))*f;o+=`<line class="sm" x1="${F1(le+2)}" x2="${F1(X(b)-1)}" y1="${F1(y)}" y2="${F1(y)}"/>`});const ax=X(b)-(X(b)-X(a))*.2;o+=`<line class="hg" x1="${F1(ax)}" x2="${F1(ax)}" y1="${F1(cy+sg*(ra+(hs-ra)*.5))}" y2="${F1(cy+sg*(hs-2))}"/>`})});
      if(form==='aircraft'){if(at(.15))o+=`<ellipse class="dt win" cx="${F1(X(.16))}" cy="${cy}" rx="${F1((X(.24)-X(.09))/2)}" ry="${F1(R*.42)}"/>`;if(at(.27))[-1,1].forEach(sg=>o+=`<rect class="dt" x="${F1(X(.23))}" y="${F1(sg<0?cy-R*1.32:cy+R*.98)}" width="${F1(X(.31)-X(.23))}" height="${F1(R*.34)}"/>`);if(at(.99))o+=`<rect class="dt" x="${F1(X(.985))}" y="${F1(cy-R*.36)}" width="7" height="${F1(R*.72)}"/>`}
      if(form==='drone'){if(at(.18))o+=`<ellipse class="dt win" cx="${F1(X(.17))}" cy="${cy}" rx="${F1((X(.24)-X(.1))/2)}" ry="${F1(R*.62)}"/>`;if(at(.995))o+=`<line class="dt" x1="${F1(X(1)+4)}" x2="${F1(X(1)+4)}" y1="${F1(cy-R*1.7)}" y2="${F1(cy+R*1.7)}" stroke-width="2.4"/><circle class="dt" cx="${F1(X(1)+4)}" cy="${cy}" r="3.5"/>`}}
    if(form==='helicopter'){if(at(.4))o+=`<rect class="dt" x="${F1(X(.4)-7)}" y="${F1(cy-R-19)}" width="14" height="7"/>`;if(at(.09))o+=`<path class="dt win" d="M${F1(X(.03))},${F1(cy-R*.1)}Q${F1(X(.05))},${F1(cy-R*.85)} ${F1(X(.15))},${F1(cy-R*.9)}L${F1(X(.15))},${F1(cy-R*.1)}Z"/><line class="sm" x1="${F1(X(.09))}" x2="${F1(X(.09))}" y1="${F1(cy-R*.86)}" y2="${F1(cy-R*.1)}"/>`;
      if(at(.37))o+=`<rect class="dt" x="${F1(X(.32))}" y="${F1(cy+R*.15)}" width="${F1(X(.43)-X(.32))}" height="${F1(R*.16)}"/>`+[.34,.4].map(t=>`<rect class="dt" x="${F1(X(t))}" y="${F1(cy+R*.31)}" width="${F1(X(t+.03)-X(t))}" height="${F1(R*.22)}"/>`).join('');
      [.18,.44].forEach(t=>{if(at(t))o+=`<line class="sm" x1="${F1(X(t))}" x2="${F1(X(t))}" y1="${F1(cy+R)}" y2="${F1(cy+R+12)}"/><circle class="dt" cx="${F1(X(t))}" cy="${F1(cy+R+16)}" r="5"/>`});
      if(at(.96))o+=`<circle class="hg" cx="${F1(X(.965))}" cy="${F1(cy-rr(.965)*1.6)}" r="${F1(R*.55)}"/><circle class="dt" cx="${F1(X(.965))}" cy="${F1(cy-rr(.965)*1.6)}" r="2.5"/>`}
    if(form==='launcher'||form==='device'){const y0=cy-R,y1=cy+R;[-.5,0,.5].forEach(k=>o+=`<line class="sh" x1="${F1(X(t0)+3)}" x2="${F1(X(t1)-3)}" y1="${F1(cy+k*R)}" y2="${F1(cy+k*R)}"/>`);[[t0,y0],[t1,y0],[t0,y1],[t1,y1]].forEach(([t,y],i)=>o+=`<circle class="rt" cx="${F1(X(t)+(i%2?-6:6))}" cy="${F1(y+(i<2?6:-6))}" r="1.6"/>`)}
    return o};
  const isFill=p=>/fill|explos|warhead|charge|\bhe\b|payload|submunition|phosph/i.test(p.name||'');
  const host=p=>{let h=0;prim.forEach((q,i)=>{if((p.start+p.end)/2>=q.start&&(p.start+p.end)/2<=q.end)h=i});return h};
  let num=0;const no=new Map();prim.forEach(p=>no.set(p,++num));inner.forEach(p=>no.set(p,++num));
  const g=prim.map((p,i)=>{const mid=x((p.start+p.end)/2);
    const hatch=[];for(let t=p.start+.02;t<p.end-.01;t+=Math.max(.03,(p.end-p.start)/6))hatch.push(`<line class="h" x1="${x(t)}" x2="${x(t)}" y1="${cy-pr(t)*R*.92}" y2="${cy+pr(t)*R*.92}"/>`);
    const fd=fins(p.start,p.end);
    return `<g class="part" style="--dx:${DX(i).toFixed(1)}px;--dy:${i%2?10:-10}px;--d:${i*70}ms"><path class="b" d="${body(p.start,p.end)}"/>${fd?`<path class="f" d="${fd}"/>`:''}${hatch.join('')}${det(p.start,p.end)}${i===0?rotor:''}<circle class="cn" cx="${mid}" cy="${cy}" r="9"/><text class="cn" x="${mid}" y="${cy+3.5}" text-anchor="middle">${no.get(p)}</text></g>`}).join('');
  // internal components: dashed inside the body, lifted out above it when exploded
  const gi=inner.map((p,j)=>{const h=host(p),mid=x((p.start+p.end)/2),lift=LIFT(j);
    return `<g class="part in${isFill(p)?' fill':''}" style="--dx:${DX(h).toFixed(1)}px;--dy:${lift.toFixed(1)}px;--d:${(n+j)*70}ms"><path class="b" d="${body(p.start,p.end,IK)}"/><circle class="cn" cx="${mid}" cy="${cy}" r="8"/><text class="cn" x="${mid}" y="${cy+3.5}" text-anchor="middle">${no.get(p)}</text></g>`}).join('');
  const top=cy-Math.max(R*finMax,plan?span/2*s:0)-28,x0=x(0),x1=x(1);
  const fmtD=v=>v.toFixed(3).replace(/0+$/,'').replace(/\.$/,'');
  const dim=`<g class="dim"><line x1="${x0}" x2="${x1}" y1="${top}" y2="${top}" marker-start="url(#ah)" marker-end="url(#ah)"/><line x1="${x0}" x2="${x0}" y1="${top-6}" y2="${cy}" class="ext"/><line x1="${x1}" x2="${x1}" y1="${top-6}" y2="${cy}" class="ext"/><rect x="${(x0+x1)/2-90}" y="${top-9}" width="180" height="18" class="bg"/><text x="${(x0+x1)/2}" y="${top+4}" text-anchor="middle">${hasL?`L ${L.toFixed(2)} m`:'LENGTH NOT ON RECORD'}</text>
    ${hasD?`<line x1="${x1+26}" x2="${x1+26}" y1="${cy-R}" y2="${cy+R}" marker-start="url(#ah)" marker-end="url(#ah)"/><text x="${x1+32}" y="${cy+4}">Ø ${fmtD(Dm)} m</text>`:''}${plan?`<text x="${x0}" y="${cy+span/2*s+22}">${hasS?`SPAN ${span} m · `:''}PLAN VIEW</text>`:''}${!hasL||!hasD?`<text x="${x0}" y="${cy+Math.max(R*finMax,plan?span/2*s:0)+(plan?40:form==='helicopter'?44:24)}" class="nb">PROPORTIONS ILLUSTRATIVE WHERE DIMENSIONS ARE NOT ON RECORD</text>`:''}</g>`;
  const base=cy+(plan?span/2*s+10:R*Math.max(2.6,finMax+.4));
  const call=(p,mx,ly,from)=>{const m=makerLabel(p.maker);return `<polyline points="${mx},${from} ${mx},${ly+(ly>from?-12:6)}"/><circle cx="${mx}" cy="${ly+(ly>from?-12:6)}" r="2"/><text x="${mx}" y="${ly}" text-anchor="middle" class="pn">${no.get(p)} · ${esc(p.name.length>34?p.name.slice(0,33)+'…':p.name).toUpperCase()}</text><text x="${mx}" y="${ly+13}" text-anchor="middle" class="mk"${m.id?` data-go="${esc(m.id)}"`:''}>${esc(m.txt.length>40?m.txt.slice(0,39)+'…':m.txt)}${m.id?' ↗':''}</text>`};
  const lab=prim.map((p,i)=>{const mx=x((p.start+p.end)/2)+DX(i),ly=base+36+(i%3)*32;return `<g class="call" style="--d:${500+i*80}ms">${call(p,mx,ly,cy+R+(i%2?10:-10)+4)}</g>`}).join('')+
    inner.map((p,j)=>{const h=host(p),xr=x(p.end)+DX(h)+10,yy=cy+LIFT(j),m=makerLabel(p.maker),right=xr<W-170;const tx=right?xr:x(p.start)+DX(h)-10,an=right?'start':'end';return `<g class="call" style="--d:${500+(n+j)*80}ms"><text x="${tx}" y="${yy-2}" text-anchor="${an}" class="pn">${no.get(p)} · ${esc(p.name.length>34?p.name.slice(0,33)+'…':p.name).toUpperCase()}</text><text x="${tx}" y="${yy+11}" text-anchor="${an}" class="mk"${m.id?` data-go="${esc(m.id)}"`:''}>${esc(m.txt.length>40?m.txt.slice(0,39)+'…':m.txt)}${m.id?' ↗':''}</text></g>`}).join('');
  const H=Math.max(300,base+36+Math.min(n-1,2)*32+46,base+100);
  // section A-A through the middle of the body (round-bodied munitions only)
  const secA=(['bomb','shell','missile','rocket'].includes(form)&&R>8)?(()=>{const t=.5,c=x(t),r=pr(t)*R,cx2=W-110,cy2=base+48,rs=30;
    const inner=form==='bomb'||form==='shell'?`<circle cx="${cx2}" cy="${cy2}" r="${rs*.84}" class="hx dt"/>`:`<circle cx="${cx2}" cy="${cy2}" r="${rs*.84}" class="dt"/><circle cx="${cx2}" cy="${cy2}" r="${rs*.42}" class="dt hx"/>${[0,1,2,3,4,5].map(i=>`<circle cx="${(cx2+Math.cos(i*Math.PI/3)*rs*.63).toFixed(1)}" cy="${(cy2+Math.sin(i*Math.PI/3)*rs*.63).toFixed(1)}" r="1.4" class="rt"/>`).join('')}`;
    return `<g class="secA"><line class="hg" x1="${c}" x2="${c}" y1="${cy-r-14}" y2="${cy+r+14}"/><text x="${c+4}" y="${cy-r-16}" class="nb">A</text><text x="${c+4}" y="${cy+r+24}" class="nb">A</text><circle cx="${cx2}" cy="${cy2}" r="${rs}" class="b"/>${inner}<text x="${cx2}" y="${cy2+rs+14}" text-anchor="middle" class="nb">SECTION A–A</text></g>`})():'';
  return `<svg class="bp${ex?' ex':''}" viewBox="0 0 ${W} ${H}" role="img" aria-label="Line drawing of ${esc(w.name)}${ex?', exploded into parts with their makers':''}"><defs><pattern id="hx" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="6" stroke="currentColor" stroke-width=".8" opacity=".55"/></pattern><marker id="ah" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,1L9,5L0,9" fill="none" stroke="currentColor"/></marker></defs><line class="cl" x1="20" x2="${W-20}" y1="${cy}" y2="${cy}"/>${dim}${secA}${g}${gi}${lab}<text class="tb" x="${W-16}" y="${H-12}" text-anchor="end">BL00D.MONEY · ${esc(w.id)} · SCHEMATIC, NOT A MANUFACTURER'S DRAWING</text></svg>`}
function makersOf(w){const m=new Map();(w.makers||[]).map(x=>[x.entity,x.role]).concat((w.parts||[]).map(p=>[p.maker,p.name])).forEach(([nm,role])=>{const l=makerLabel(nm);if(!l.id&&l.txt==='maker not on record')return;const k=l.id||l.txt;if(!m.has(k))m.set(k,[l.txt,l.id?byId[l.id]:null,[]]);if(role&&!m.get(k)[2].includes(role))m.get(k)[2].push(role)});return [...m.values()]}
function arsWeapon(w){const ev=evOfW(w);
  return `<div class="wh"><div><div class="tiny">${esc((w.class||w.form||'').toUpperCase())} · ${esc(w.id)}</div><h2>${esc(w.name)}</h2>${w.aka&&w.aka.length?`<div class="aka">${esc([].concat(w.aka).join(' · '))}</div>`:''}</div><button class="xbtn" data-explode aria-pressed="${arsExploded}">${arsExploded?'ASSEMBLE':'EXPLODE INTO PARTS'}</button></div>
   <div class="draw">${blueprint(w,arsExploded)}</div>
   ${D.images[w.id]?`<figure class="wph"><img src="${D.images[w.id].data}" alt="${esc(w.name)}" loading="lazy"><figcaption>${esc(D.images[w.id].credit||'')}</figcaption></figure>`:''}
   ${w.summary?`<p class="sum">${esc(w.summary)}</p>`:''}
   <div class="cols"><div><h3>SPECIFICATIONS</h3><dl class="spec">${(w.specs||[]).map(s=>`<div><dt>${esc(s.k)}</dt><dd>${esc(s.v)}</dd></div>`).join('')||'<div><dt>—</dt><dd>Specifications being compiled</dd></div>'}</dl></div>
   <div><h3>WHO MAKES IT</h3><ul class="mk">${makersOf(w).map(([nm,e,roles])=>`<li>${e?`<button data-go="${esc(e.id)}">${esc(e.name)} ↗</button>`:`<span>${esc(nm)}</span>`}<em>${esc(roles.join(' · '))}</em></li>`).join('')}</ul>
   ${w.transfers?`<h3>TRANSFERS TO ISRAEL</h3><p class="tr">${esc([].concat(w.transfers).map(t=>typeof t==='string'?t:[t.date,t.what||t.qty,t.value].filter(Boolean).join(' · ')).join(' / '))}</p>`:''}</div></div>
   <h3>USED IN · ${ev.length} EVENT${ev.length===1?'':'S'} ON RECORD</h3>${ev.length?`<div class="evl">${ev.map(evCard).join('')}</div>`:'<p class="none">No event in the catalogue links to this weapon yet.</p>'}
   ${(()=>{const ids=[...new Set([].concat(w.src||[],...(w.specs||[]).map(x=>x.src||[]),...(w.makers||[]).map(x=>x.src||[]),...(w.parts||[]).map(x=>x.src||[])))];return ids.length?`<h3>SOURCES · ${ids.length}</h3><p class="srcs">${srcLinks(ids)}</p>`:''})()}`}
// dashed leader from the end of the event's title line to its photo, whatever the title's length
function evLeaders(){ars.querySelectorAll('.ev .ldr').forEach(x=>x.remove());if(innerWidth<1180)return;
  ars.querySelectorAll('.ev').forEach(ev=>{const f=ev.querySelector('.evpic.lead'),h=ev.querySelector('h4');if(!f||!h)return;
    const r=document.createRange();r.selectNodeContents(h);const rs=[...r.getClientRects()];if(!rs.length)return;const t=rs[rs.length-1],A=ev.getBoundingClientRect(),F=f.getBoundingClientRect();
    const x0=t.right-A.left+10,x1=F.left-A.left+4,y=t.top+t.height/2-A.top;if(x1-x0<20)return;
    const l=document.createElement('i');l.className='ldr';l.style.cssText=`left:${x0}px;top:${y}px;width:${x1-x0}px`;ev.appendChild(l)})}
addEventListener('resize',()=>{if(typeof arsTab!=='undefined'&&arsTab==='events'&&!ars.hidden)evLeaders()});
let evPicN=0;
function evPic(v){const im=D.images[v.id];if(!im)return '';const i=evPicN++,rot=[-2.6,1.8,-1.2,2.9,-2.1,1.1][i%6],dy=[6,26,0,34,14,20][i%6],lead=i%3!==1;
  return `<figure class="evpic${lead?' lead':''}" style="--r:${rot}deg;--dy:${dy}px"><span class="pin" aria-hidden="true"></span><img src="${im.data}" alt="${esc(im.cap||v.title)}" loading="lazy"><figcaption><b>FIG. ${esc(v.id.replace('EVT-',''))}</b> ${esc(im.cap||v.title)}${im.credit?`<a class="cr" href="${esc(im.url||'#')}" target="_blank" rel="noopener">${esc(im.credit)}</a>`:''}</figcaption></figure>`}
function evCard(v){const toll=[v.killed!=null?`<b>${(+v.killed).toLocaleString('en-US')}</b> killed`:'',v.injured!=null?`<b>${(+v.injured).toLocaleString('en-US')}</b> injured`:''].filter(Boolean).join(' · ');
  return `<article class="ev" id="ev-${esc(v.id)}"><div class="d">${esc(v.date||'')}<span>${esc((v.theatre||'').toUpperCase())}</span></div><div><h4>${esc(v.title)}</h4><div class="pl">${esc(v.place||'')}</div>${toll?`<div class="toll">${toll}${v.toll_note?` <i>${esc(v.toll_note)}</i>`:''}</div>`:''}${v.summary?`<p>${esc(v.summary)}</p>`:''}${v.evidence?`<p class="evd"><b>WEAPON EVIDENCE</b> ${esc(v.evidence)}</p>`:''}<div class="wc">${(v.weapons||[]).map(id=>WBY[id]?`<button data-w="${esc(id)}">${esc(WBY[id].name)}</button>`:'').join('')}<span class="st ${v.status==='documented'?'doc':''}">${v.status==='documented'?'● DOCUMENTED':'○ REPORTED'}</span></div>${(v.src||[]).length?`<div class="srcs">${srcLinks(v.src)}</div>`:''}</div>${evPic(v)}</article>`}
function renderArsenal(){ars.className='st-'+arsStyle;
  const th=[...new Set(ARS.events.map(v=>v.theatre).filter(Boolean))];
  const head=`<header class="ah"><div class="brand"><b>ARSENAL</b><span class="tiny">${ARS.weapons.length} weapons · ${ARS.events.length} events</span></div><div class="seg" role="tablist"><button data-at="weapons" aria-pressed="${arsTab==='weapons'}">WEAPONS</button><button data-at="events" aria-pressed="${arsTab==='events'}">EVENTS</button></div><div class="seg">${['blueprint','ink','paper'].map(s=>`<button data-as="${s}" aria-pressed="${arsStyle===s}">${s.toUpperCase()}</button>`).join('')}</div><button class="close" data-ax>CLOSE ×</button></header>`;
  if(!ARS.weapons.length){ars.innerHTML=head+`<div class="empty">The weapons catalogue is being compiled.</div>`;return}
  if(arsTab==='events'){evPicN=0;const evs=ARS.events.filter(v=>arsTheatre==='ALL'||v.theatre===arsTheatre).sort((a,b)=>String(b.date).localeCompare(String(a.date)));
    ars.innerHTML=head+`<div class="evpage"><div class="intro2"><h2>Events</h2><p>Strikes and attacks where the weapon used is on record. Each one links to the weapons and, through them, to the companies that made them. Bigger events will get their own case files.</p><div class="seg wrap">${['ALL',...th].map(t=>`<button data-th="${esc(t)}" aria-pressed="${arsTheatre===t}">${esc(t.toUpperCase())}</button>`).join('')}</div></div><div class="evl">${evs.map(evCard).join('')}</div></div>`;requestAnimationFrame(evLeaders);try{document.fonts.ready.then(()=>{if(arsTab==="events")evLeaders()})}catch(_){}return}
  if(!arsW)arsW=ARS.weapons[0];
  const list=CLASSES.map(([c,l])=>{const ws=ARS.weapons.filter(w=>(PROF[w.form]?w.form:'device')===c);return ws.length?`<div class="grp"><h4>${esc(l.toUpperCase())}<span>${ws.length}</span></h4>${ws.map(w=>`<button data-w="${esc(w.id)}" aria-pressed="${w===arsW}">${esc(w.name)}<span>${evOfW(w).length||''}</span></button>`).join('')}</div>`:''}).join('');
  ars.innerHTML=head+`<div class="wpage">${PHM()?`<button class="wltog" data-wltog aria-expanded="false"><span>WEAPON ${ARS.weapons.indexOf(arsW)+1} OF ${ARS.weapons.length}</span><b>${esc(arsW.name)}</b><em>ALL WEAPONS ▾</em></button>`:''}<nav class="wl" aria-label="Weapons">${list}</nav><div class="wv">${arsWeapon(arsW)}</div></div>`}
function openArsenal(id){if(id&&WBY[id])arsW=WBY[id];hideInsp();ars.hidden=false;renderArsenal();ars.scrollTop=0}
ars.addEventListener('click',e=>{const b=e.target.closest('button,[data-go]');if(!b)return;
  if(b.dataset.ax!=null){ars.hidden=true;return}
  if(b.dataset.wltog!=null){const o=b.parentNode.classList.toggle('open');b.setAttribute('aria-expanded',o);b.querySelector('em').textContent=o?'CLOSE LIST ▴':'ALL WEAPONS ▾';return}
  if(b.dataset.at){arsTab=b.dataset.at;return renderArsenal()}
  if(b.dataset.as){arsStyle=b.dataset.as;try{localStorage.setItem('bm_ars',arsStyle)}catch(_){}return renderArsenal()}
  if(b.dataset.th){arsTheatre=b.dataset.th;return renderArsenal()}
  if(b.dataset.w){arsW=WBY[b.dataset.w];arsTab='weapons';arsExploded=false;renderArsenal();const wv=ars.querySelector('.wv');if(wv)wv.scrollIntoView({block:'start'});return}
  if(b.dataset.explode!=null){arsExploded=!arsExploded;ars.querySelector('svg.bp').classList.toggle('ex',arsExploded);b.textContent=arsExploded?'ASSEMBLE':'EXPLODE INTO PARTS';b.setAttribute('aria-pressed',arsExploded);return}
  if(b.dataset.go){const n=byId[b.dataset.go];if(n){ars.hidden=true;go(n)}}});

/* ---------- left rail: case files + filters ---------- */
const rail=document.getElementById('rail');let railTab='files';
const FAM=[['own','Ownership'],['contract','Contracts & supply'],['money','Money flows'],['politics','Elections & lobbying'],['role','Roles, pay & control'],['tech','Technology']];
const OFF=[0,62,14,70,30,4,58,22,66];
function renderRail(){
  const tc=d3.rollup(nodes,v=>v.length,n=>n.type),fc=d3.rollup(rels,v=>v.length,r=>r.fam);
  const tabs=`<div class="railtabs"><button data-rt="files" aria-pressed="${railTab==='files'}">CASE FILES</button><button data-rt="filter" aria-pressed="${railTab==='filter'}">FILTER</button></div>`;
  if(railTab==='files'){rail.innerHTML=tabs+`<div><div class="drawer">${CASES.map((c,i)=>`<button class="file${c.special?' special':''}" data-case="${i}" style="--off:${OFF[i%OFF.length]}px;z-index:${i+1}" aria-pressed="${kase===c}"><span class="tab"><b>${c.k}</b>${esc(c.tab)}</span></button>`).join('')}</div><button class="drawerfoot" data-caselist title="See every case file"><span>bl00d.money case files</span><i aria-hidden="true">→</i></button><p class="hint" style="margin-top:10px">Each file pulls one story out of the database. Open one, then pull out the paper to read the full case file.</p><button class="arsbtn" data-ars><svg viewBox="0 0 56 20" aria-hidden="true"><path d="M2 10 Q2 5 8 5 L40 5 L46 7 L46 13 L40 15 L8 15 Q2 15 2 10Z M40 5 L44 1 L52 1 L50 7 M40 15 L44 19 L52 19 L50 13" fill="none" stroke="currentColor" stroke-width=".9"/><line x1="0" x2="56" y1="10" y2="10" stroke="currentColor" stroke-width=".4" stroke-dasharray="3 2"/></svg><div><b>ARSENAL</b><span>Weapons and events catalogue →</span></div></button></div>
    <div><h3><span>HIGHLIGHT A TYPE</span></h3>${TYPES.filter(t=>tc.get(t[0])).map(([t,l])=>`<div class="typ"><span class="dot" style="color:${TCOL[t]};background:currentColor"></span><button class="lab" data-hl="${esc(t)}" style="--hl:${TCOL[t]}" aria-pressed="${hlType===t}">${esc(l.charAt(0)+l.slice(1).toLowerCase())}</button><span class="n">${tc.get(t)}</span></div>`).join('')}</div>`;return}
  rail.innerHTML=tabs+`<div><h3><span>ENTITY TYPE · SHOW / HIGHLIGHT</span><span>${nodes.length}</span></h3>${TYPES.filter(t=>tc.get(t[0])).map(([t,l])=>`<div class="typ"><button class="dotb" data-type="${esc(t)}" aria-pressed="${F.types.has(t)}" aria-label="Show ${esc(l)}" style="color:${TCOL[t]}"><span class="dot"></span></button><button class="lab" data-hl="${esc(t)}" style="--hl:${TCOL[t]}" aria-pressed="${hlType===t}">${esc(l.charAt(0)+l.slice(1).toLowerCase())}</button><span class="n">${tc.get(t)}</span></div>`).join('')}</div>
  <div><h3><span>RELATIONSHIP · SHOW</span><span>${rels.length}</span></h3>${FAM.map(([f,l])=>`<button class="opt" data-fam="${f}" aria-pressed="${F.fam.has(f)}" style="color:${F.fam.has(f)?'var(--fg)':'var(--fg3)'};${F.fam.has(f)?'':'text-decoration:line-through'}"><span class="dot" style="color:${FCOL[f]}"></span>${l}<span class="n">${fc.get(f)||0}</span></button>`).join('')}
   <div class="legend-line" style="margin-top:4px"><svg class="inh" width="26" height="8"><line x1="0" y1="4" x2="22" y2="4" stroke="${FCOL.oppose}"/><line x1="22" y1="0" x2="22" y2="8" stroke="${FCOL.oppose}" stroke-width="2"/></svg>Spent to defeat</div></div>
  <div><h3><span>EVIDENCE · SHOW</span></h3>
   <button class="opt" data-st="documented" aria-pressed="${F.st.has('documented')}"><svg width="26" height="6" aria-hidden="true"><line x1="0" y1="3" x2="26" y2="3" stroke="${C.fg}" stroke-width="1"/></svg>Primary source<span class="n">${rels.filter(r=>r.st==='documented').length}</span></button>
   <button class="opt" data-st="reported" aria-pressed="${F.st.has('reported')}"><svg width="26" height="6" aria-hidden="true"><line x1="0" y1="3" x2="26" y2="3" stroke="${C.fg}" stroke-width="1" stroke-dasharray="3 3"/></svg>Media / data provider<span class="n">${rels.filter(r=>r.st==='reported').length}</span></button></div>
  <div><h3><span>POINT SIZE</span></h3><div class="seg"><button data-size="connections" aria-pressed="${sizeBy==='connections'}">LINKS</button><button data-size="money" aria-pressed="${sizeBy==='money'}">MONEY ON RECORD</button></div><p class="hint" style="margin-top:6px">${sizeBy==='money'?'Bigger points have more money recorded against them in this database.':'Bigger points have more documented links.'}</p></div>
  <div><h3><span>MAP COLOURS</span></h3><div class="seg">${Object.entries(PAL).map(([k,p])=>`<button data-pal="${k}" aria-pressed="${palKey===k}">${p.label}</button>`).join('')}</div></div>
  <div><h3><span>SHAPES</span></h3>
   <div class="legend-line"><svg width="12" height="12"><circle cx="6" cy="6" r="4.5" fill="${C.fg}"/></svg>Company, fund or organization</div>
   <div class="legend-line"><svg width="12" height="12"><circle cx="6" cy="6" r="4.5" fill="${C.fg}"/><circle cx="6" cy="6" r="2" fill="${C.bg}"/></svg>Person</div>
   <div class="legend-line"><svg width="12" height="12"><circle cx="6" cy="6" r="4.5" fill="${C.fg}"/><circle cx="6" cy="6" r="2.5" fill="none" stroke="${C.bg}" stroke-width="1.2"/></svg>Country</div>
   <div class="legend-line"><svg width="12" height="12"><rect x="2.5" y="2.5" width="7" height="7" transform="rotate(45 6 6)" fill="${C.fg}"/></svg>Weapon system or deal</div>
   <div class="legend-line"><svg width="12" height="12"><circle cx="6" cy="6" r="4.5" fill="none" stroke="${C.fg}"/></svg>Budget flow</div>
   <div class="legend-line"><svg width="12" height="12"><rect x="5" y="5" width="2" height="2" fill="${C.fg2}"/></svg>Single fact</div>
   <div class="legend-line"><svg width="12" height="12"><circle cx="6" cy="6" r="1" fill="${C.fg2}"/></svg>Source document</div></div>`}
rail.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;
  if(b.dataset.rt){railTab=b.dataset.rt;return renderRail()}
  if(b.dataset.ars!=null){openArsenal();if(innerWidth<=900)rail.classList.remove('open');return}
  if(b.dataset.caselist!=null){endIntro();openCaseList();if(innerWidth<=900)rail.classList.remove('open');return}
  if(b.dataset.case!=null){const c=CASES[+b.dataset.case];if(c.special){openReport(c);if(innerWidth<=900)rail.classList.remove('open');return}if(kase===c){kase=null;mode='network';apply();renderDossier();renderRail()}else openCase(c);if(innerWidth<=900)rail.classList.remove('open');return}
  if(b.dataset.hl){return setHl(hlType===b.dataset.hl?null:b.dataset.hl)}
  if(b.dataset.pal){palKey=b.dataset.pal;try{localStorage.setItem('bm_pal',palKey)}catch(_){}applyPalette();renderRail();renderDossier();return}
  if(b.dataset.type){F.types.has(b.dataset.type)?F.types.delete(b.dataset.type):F.types.add(b.dataset.type)}
  else if(b.dataset.fam){F.fam.has(b.dataset.fam)?F.fam.delete(b.dataset.fam):F.fam.add(b.dataset.fam)}
  else if(b.dataset.st){F.st.has(b.dataset.st)?F.st.delete(b.dataset.st):F.st.add(b.dataset.st)}
  else if(b.dataset.size){sizeBy=b.dataset.size}
  if(focus&&!visE(focus))focus=null;
  // filters apply in every view: leave a case or holdings view so the change is visible
  if(b.dataset.fam||b.dataset.st||b.dataset.type){if(kase&&mode!=='holdings')kase=null}
  renderRail();apply(!!b.dataset.size);renderDossier()});

/* ---------- search ---------- */
const q=document.getElementById('q'),res=document.getElementById('results');let hits=[],hi=0;
function search(s){s=s.trim().toLowerCase();if(!s){res.hidden=true;return}
  hits=nodes.filter(n=>n.name.toLowerCase().includes(s)||n.id.toLowerCase().includes(s)||(n.role||'').toLowerCase().includes(s)).sort((a,b)=>(b.name.toLowerCase().startsWith(s))-(a.name.toLowerCase().startsWith(s))||b.deg-a.deg).slice(0,24);
  hi=0;const g=d3.groups(hits,n=>n.type);
  res.innerHTML=hits.length?g.map(([t,arr])=>`<div class="grp tiny">${esc(TLAB[t]||t)}</div>`+arr.map(n=>`<button data-go="${esc(n.id)}" class="${hits[0]===n?'on':''}"><span>${esc(n.name)}</span><span>${esc(n.id)}</span></button>`).join('')).join(''):'<div class="grp tiny">No match in the database</div>';res.hidden=false}
q.addEventListener('input',()=>search(q.value));
q.addEventListener('keydown',e=>{if(e.key==='Enter'&&hits[0]){go(hits[0])}if(e.key==='Escape'){q.value='';res.hidden=true;q.blur()}});
res.addEventListener('click',e=>{const b=e.target.closest('[data-go]');if(b)go(byId[b.dataset.go])});
res.addEventListener('pointerover',e=>{const b=e.target.closest('[data-go]');pinN=b?byId[b.dataset.go]:null});
function go(n){q.value='';res.hidden=true;q.blur();endIntro();showView('map');select(n)}
addEventListener('keydown',e=>{if(app.classList.contains('intro')){endIntro();if(e.key!=='/')return}if(e.key==='/'&&document.activeElement!==q){e.preventDefault();q.focus()}if(e.key==='Escape'&&document.activeElement!==q){if(!repEl.hidden)repEl.hidden=true;else if(!insp.hidden)hideInsp();else if(focus)clearFocus();else if(hlType)setHl(null)}});

/* ---------- index view ---------- */
const idx=document.getElementById('index');let sortKey='connections';
function renderIndex(){
  const rows=nodes.map(n=>({n,val:d3.max(n.rels,usd)||0}));
  const S={'a–z':(a,b)=>a.n.name.localeCompare(b.n.name),type:(a,b)=>a.n.type.localeCompare(b.n.type)||b.n.deg-a.n.deg,connections:(a,b)=>b.n.deg-a.n.deg,money:(a,b)=>b.val-a.val};
  rows.sort(S[sortKey]);
  idx.innerHTML=`<div class="head"><h2>Entity index</h2><span class="tiny">${String(nodes.length).padStart(3,'0')} RECORDS · SORTED BY ${esc(sortKey.toUpperCase())} · CLICK A ROW TO OPEN IT ON THE MAP</span></div>
  <div class="tblwrap"><table class="idx"><thead><tr>${[['type','TYPE'],['a–z','ENTITY'],[null,'ID'],[null,'COUNTRY'],['money','LARGEST VALUE'],['connections','LINKS']].map(([k,l],i)=>`<th class="${i>=4?'r':''}">${k?`<button data-sort="${k}" ${k===sortKey?'aria-sort="descending"':''}>${l}</button>`:l}</th>`).join('')}</tr></thead>
  <tbody>${rows.map(({n,val})=>`<tr data-go="${esc(n.id)}"><td class="m" style="color:${TCOL[n.type]}">${esc(n.type.toUpperCase())}</td><td>${esc(n.name)}</td><td class="m">${esc(n.id)}</td><td class="m">${esc(n.country||'—')}</td><td class="m r">${val?esc(money(val,'USD')):'—'}</td><td class="m r">${n.deg}</td></tr>`).join('')}</tbody></table></div>`}
idx.addEventListener('click',e=>{const s=e.target.closest('[data-sort]');if(s){sortKey=s.dataset.sort;return renderIndex()}const r=e.target.closest('[data-go]');if(r)go(byId[r.dataset.go])});

/* ---------- case-file list: every report on the site, most complete first ---------- */
const clEl=document.getElementById('caselist');
function caseFiles(){
  const out=[],seen=new Set();
  const score=(R,c)=>{const secs=R.sections||[],words=secs.reduce((a,x)=>a+(x.body||[]).join(' ').split(/\s+/).length,0),srcs=new Set();secs.forEach(x=>(x.src||[]).forEach(i=>srcs.add(i)));
    const ser=D.series.filter(x=>x.case&&x.case===c).length,q=(R.quotes||[]).length+(R.lead?1:0);
    return {secs:secs.length,words,srcs:srcs.size,ser,q,v:secs.length*4+words/120+srcs.size*.6+ser*5+q*2}};
  CASES.forEach((c,i)=>{const ent=c.entity,R=D.reports[ent?ent.id:'case'+c.rk]||{};if(ent)seen.add(ent.id);
    const m=score(R,ent?ent.id:c.rk);out.push({open:()=>openReport(c),links:c.rels?c.rels.size:0,no:c.k,tag:c.special?'SPECIAL FILE':'CASE FILE',title:R.title||c.title,dek:R.dek||c.blurb||'',special:!!c.special,m,imp:(c.special?60:25)+(c.rels?Math.min(20,c.rels.size/8):0)})});
  Object.keys(D.reports).forEach(id=>{const n=byId[id];if(!n||seen.has(id))return;const R=D.reports[id],m=score(R,id);if(!m.secs)return;
    out.push({open:()=>openReport({entity:n}),no:n.id.replace(/^[A-Z]+-(N-|NEW-)?/,''),tag:'DOSSIER · '+n.type.toUpperCase(),title:R.title||n.name,name:n.name,dek:R.dek||n.role||'',special:!!D.wanted[n.id],m,imp:Math.min(30,n.deg*.6)+(D.wanted[n.id]?30:0)})});
  out.forEach(o=>o.rank=o.m.v+o.imp);out.sort((a,b)=>b.rank-a.rank);
  const top=out[0]?out[0].rank:1;out.forEach(o=>o.pct=Math.max(.08,Math.min(1,o.rank/top)));return out}
let CL=[];
function openCaseList(){CL=caseFiles();idx.hidden=true;clEl.hidden=false;
  document.querySelectorAll('nav.top [data-view]').forEach(b=>b.setAttribute('aria-pressed','false'));
  clEl.innerHTML=`<div class="head"><h2>Case files</h2><span class="tiny">${String(CL.length).padStart(3,'0')} FILES · MOST COMPLETE AND MOST IMPORTANT FIRST · CLICK A FILE TO READ IT</span><button class="closebtn" data-close>BACK TO MAP ×</button></div>
  <ol class="cl">${CL.map((o,i)=>`<li><button class="cf${o.special?' sp':''}" data-cf="${i}"><span class="cft"><b>${String(i+1).padStart(2,'0')}</b>${esc(o.tag)}</span>
    <span class="cfb"><span class="cfh">${esc(o.title)}</span>${o.name&&o.name!==o.title?`<span class="cfn">${esc(o.name)}</span>`:''}<span class="cfd">${esc(o.dek)}</span>
    <span class="cfm">${o.m.secs?`<span>${o.m.secs} SECTIONS</span><span>${o.m.words.toLocaleString('en-US')} WORDS</span><span>${o.m.srcs} SOURCES</span>`:`<span>${o.links} DOCUMENTED LINKS</span>`}${o.m.ser?`<span>${o.m.ser} CHARTS</span>`:''}${o.m.q?`<span>${o.m.q} QUOTES</span>`:''}</span>
    <span class="cfbar" aria-hidden="true"><i style="width:${(o.pct*100).toFixed(0)}%"></i></span></span></button></li>`).join('')}</ol>`;
  clEl.scrollTop=0}
function closeCaseList(){clEl.hidden=true;showView('map')}
clEl.addEventListener('click',e=>{if(e.target.closest('[data-close]'))return closeCaseList();const b=e.target.closest('[data-cf]');if(b)CL[+b.dataset.cf].open()});

/* ---------- tips: tell us what we missed ---------- */
// at launch set url and key to the project's Supabase project (insert-only `tips` table); empty in the preview
const TIPS_CFG=Object.assign({url:'',key:'',site:''},window.BM_TIPS||{});
// with a Turnstile site key, submissions go through the `submit-tip` edge function, which checks the token before saving
let tsWidget=null;
function loadTurnstile(){return window.turnstile?Promise.resolve(window.turnstile):new Promise((ok,no)=>{const s=document.createElement('script');s.src='https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';s.async=true;s.onload=()=>window.turnstile?ok(window.turnstile):no();s.onerror=no;document.head.appendChild(s)})}
const tipsEl=document.getElementById('tips');
function renderTips(){tipsEl.innerHTML=`<div class="wrap"><div class="head"><h2>Missed <mark>something?</mark></h2><button class="closebtn" data-tclose>BACK TO MAP ×</button></div>
  <p class="lede">If you know of money, weapons, contracts or people profiting from the genocide in Gaza, the destruction of South Lebanon or Israel's war on Iran that this record leaves out, or a figure we got wrong, tell us. We investigate every submission against filings and primary sources before anything is added.</p>
  <p class="note">You do not need to give your name. Links to filings, contracts, court records or reporting help us verify faster.</p>
  <form id="tipform" novalidate>
   <label>WHAT DID WE MISS <span>Who, what, how much, when.</span><textarea name="body" maxlength="4000" required></textarea></label>
   <label>TOPIC<select name="topic"><option value="">Choose one (optional)</option><option>A company or investor</option><option>A person</option><option>A weapon or strike</option><option>Lobby or political money</option><option>A correction</option><option>Something else</option></select></label>
   <label>SOURCES OR LINKS <span>Optional. One per line.</span><textarea name="links" maxlength="2000" style="min-height:80px"></textarea></label>
   <label>A WAY TO REACH YOU <span>Optional. Leave blank to stay anonymous. A Signal number or Proton address is safest.</span><input name="contact" maxlength="200" autocomplete="off"></label>
   <label class="hp" aria-hidden="true">Leave empty<input name="website" tabindex="-1" autocomplete="off"></label>
   ${TIPS_CFG.site?'<div class="ts" id="tsbox"></div>':''}
   <div class="row"><span class="count" id="tcount">0 / 4000</span><button class="send" type="submit">SEND SUBMISSION</button></div>
   <div class="msg" id="tmsg" hidden></div>
  </form>
  <ul class="safe"><li>We don't ask for an account, and your IP address is not saved with your submission.</li><li>For sensitive material, use a device and network that are not tied to your work.</li></ul></div>`;
  const f=tipsEl.querySelector('#tipform'),ta=f.elements.body,cnt=tipsEl.querySelector('#tcount'),msg=tipsEl.querySelector('#tmsg');
  ta.addEventListener('input',()=>{cnt.textContent=ta.value.length+' / 4000'});
  tsWidget=null;
  if(TIPS_CFG.site)loadTurnstile().then(ts=>{const box=tipsEl.querySelector('#tsbox');if(box)tsWidget=ts.render(box,{sitekey:TIPS_CFG.site,theme:'dark',size:'flexible',appearance:'always'})}).catch(()=>{const box=tipsEl.querySelector('#tsbox');if(box)box.textContent='The human check did not load. A content blocker may be stopping it; please allow challenges.cloudflare.com or try another browser.'});
  f.addEventListener('submit',async e=>{e.preventDefault();const v=Object.fromEntries(new FormData(f));const say=t=>{msg.hidden=false;msg.textContent=t};
    if(v.website)return say('Thank you. Your submission has been received.');
    if((v.body||'').trim().length<20)return say('Please tell us a little more, at least a sentence or two.');
    if(!TIPS_CFG.url){return say('Submissions are not switched on yet. Nothing was sent.')}
    const btn=f.querySelector('.send');
    const rec={body:v.body.trim().slice(0,4000),topic:v.topic||null,links:(v.links||'').trim().slice(0,2000)||null,contact:(v.contact||'').trim().slice(0,200)||null};
    const base=TIPS_CFG.url.replace(/\/$/,'');let req;
    if(TIPS_CFG.site){const token=tsWidget!=null&&window.turnstile?window.turnstile.getResponse(tsWidget):'';
      if(!token)return say('Please complete the human check above the button first.');
      req=[base+'/functions/v1/submit-tip',{method:'POST',headers:{'apikey':TIPS_CFG.key,'Content-Type':'application/json'},body:JSON.stringify({...rec,token})}]}
    else req=[base+'/rest/v1/tips',{method:'POST',headers:{'apikey':TIPS_CFG.key,'Authorization':'Bearer '+TIPS_CFG.key,'Content-Type':'application/json','Prefer':'return=minimal'},body:JSON.stringify(rec)}];
    btn.disabled=true;
    try{const r=await fetch(...req);
      if(!r.ok)throw new Error(r.status);f.reset();cnt.textContent='0 / 4000';say('Thank you. Your submission has been received and will be investigated.')}
    catch(_){say('It did not go through. Please try again in a moment.')}finally{btn.disabled=false;if(tsWidget!=null&&window.turnstile)window.turnstile.reset(tsWidget)}});
  tipsEl.querySelector('[data-tclose]').onclick=()=>showView('map')}

/* ---------- about ---------- */
function renderAbout(){focus=null;kase=null;renderPhoto();dos.innerHTML=`<div class="idrow"><span class="tiny">ABOUT / METHOD</span><button class="closebtn" data-back>BACK TO MAP ×</button></div>
  <h1>How the facts are checked</h1>
  <div class="intro"><p>Each fact in this database is tied to at least one document: a regulatory filing, an official record, a UN or court document, or a news investigation. The source is shown wherever the fact appears.</p>
  <p><span class="mono">●</span> Confirmed by a primary source: an SEC filing, company report, government record or similar, with the quoted passage stored.</p>
  <p><span class="mono">○</span> Reported: supported by media or a financial data provider. These stay visibly marked until a primary record is found.</p>
  <p>Company-wide figures such as revenue or profit are shown for scale. Holdings by asset managers are held largely on behalf of clients, which does not make the profit any less real.</p>
  <p class="tiny" style="margin-top:18px">ONGOING INVESTIGATION · STILL GROWING</p></div>`;
  dos.querySelector('[data-back]').onclick=()=>showView('map')}

/* ---------- views ---------- */
function showView(v){clEl.hidden=true;tipsEl.hidden=v!=='tips';if(v==='tips'){renderTips();tipsEl.scrollTop=0}document.querySelectorAll('nav.top [data-view]').forEach(b=>b.setAttribute('aria-pressed',b.dataset.view===v));
  idx.hidden=v!=='index';if(v==='index')renderIndex();if(v==='about'){mode='network';renderAbout();apply()}else if(v==='map')renderDossier();renderPhoto()}
document.querySelector('nav.top').addEventListener('click',e=>{const b=e.target.closest('[data-view]');if(b){endIntro();showView(b.dataset.view)}});
const rt=document.getElementById('railtoggle');rt.addEventListener('click',()=>{const o=rail.classList.toggle('open');rt.setAttribute('aria-expanded',o)});

/* ---------- controls + meta ---------- */
document.getElementById('zin').onclick=()=>sel.transition().duration(400).call(zoom.scaleBy,1.5);
document.getElementById('zout').onclick=()=>sel.transition().duration(400).call(zoom.scaleBy,1/1.5);
document.getElementById('zreset').onclick=()=>{focus=null;selRel=null;kase=null;hlType=null;mode='network';hideInsp();apply();renderDossier();renderRail()};
document.getElementById('zfull').onclick=()=>{try{document.fullscreenElement?document.exitFullscreen():document.documentElement.requestFullscreen().catch(()=>{})}catch(_){}};
const meta=document.getElementById('meta'),zl=document.getElementById('zoomlbl');
const ZL=['01 — SYSTEM','02 — ORGANIZATION','03 — TRANSACTION','04 — EVIDENCE'];
function updateMeta(){const k=T.k;const lvl=focus?2:k<.9?0:k<1.8?1:k<3?2:3;zl.textContent='ZOOM '+ZL[lvl]+' · ×'+k.toFixed(2);
  const wx=(mouse[0]-T.x)/T.k,wy=(mouse[1]-T.y)/T.k;meta.innerHTML=`X ${wx.toFixed(1).padStart(7)} · Y ${wy.toFixed(1).padStart(7)}<br>${mode.toUpperCase()}${focus?' · '+esc(focus.id):''} · θ ${((theta*57.3)%360).toFixed(1)}°<br>DATA BUILT ${esc(D.built.split('-').reverse().join('.'))}`}

/* ---------- intro: a wordless dial fills with the database, then bursts into the network ---------- */
let introTimer=null;
function startIntro(){
  app.classList.add('intro');resize();
  const m=layoutNetwork();const end=fitT(nodes.map(n=>m.get(n)),24,true);sel.call(zoom.transform,end);
  const R=Math.min(W,H)*(W<=900?.3:.2),cx=(W/2-end.x)/end.k,cy=(H/2-end.y)/end.k,Rw=R/end.k,t0=performance.now();
  intro={t0,R,cx,cy,k:end.k};
  const order=[...nodes].sort((a,b)=>TYPES.findIndex(t=>t[0]===a.type)-TYPES.findIndex(t=>t[0]===b.type)||b.deg-a.deg);
  order.forEach((n,i)=>{const a=i/order.length*6.283-Math.PI/2;n.x=cx+Math.cos(a)*Rw;n.y=cy+Math.sin(a)*Rw;n.al=0;n.at=t0+i/order.length*1500});
  [...fnodes,...Object.values(snodes)].forEach(n=>{n.x=cx;n.y=cy;n.al=0;n.at=t0+2000+Math.random()*1400});
  introTimer=setTimeout(()=>{boost=.18;setTargets(m,2300,d3.easeCubicInOut);nodes.forEach(n=>n.dl=n.rank*7);fnodes.forEach(f=>f.dl=300+Math.random()*900);Object.values(snodes).forEach(s=>s.dl=600+Math.random()*1100);
    introTimer=setTimeout(endIntro,3400)},1750)}
function endIntro(){if(!app.classList.contains('intro'))return;clearTimeout(introTimer);app.classList.remove('intro');intro=null;boost=0;all.forEach(n=>{n.dl=0;n.at=0});apply(true);renderPaper();if(PHM())setTimeout(()=>phNote(0),700)}
document.getElementById('skip').onclick=endIntro;
// keep the dial and the beads on the same centre if the frame is resized while the intro plays
function introRecenter(){if(!intro)return;resize();sel.call(zoom.transform,d3.zoomIdentity.translate(W/2-intro.k*intro.cx,H/2-intro.k*intro.cy).scale(intro.k));draw()}
addEventListener('resize',introRecenter);
try{new ResizeObserver(()=>{if(intro&&(cv.clientWidth!==W||cv.clientHeight!==H))introRecenter()}).observe(cv)}catch(_){}

/* ---------- phone: one long scrolling page instead of the map (only at 760px and narrower) ---------- */
const phEl=document.createElement('section');phEl.id='phone';phEl.hidden=true;phEl.setAttribute('aria-label','BL00D.MONEY');app.appendChild(phEl);
const phBack=document.createElement('button');phBack.id='phback';phBack.hidden=true;phBack.textContent='← BACK';app.appendChild(phBack);
phBack.onclick=()=>clearFocus();
let phBuilt=false,phType=null;
function phList(){const box=phEl.querySelector('#phlist');if(!box)return;const qv=(phEl.querySelector('#phq').value||'').trim().toLowerCase();
  let L=nodes.filter(n=>(!phType||n.type===phType)&&(!qv||n.name.toLowerCase().includes(qv)||(n.role||'').toLowerCase().includes(qv))).sort((a,b)=>b.deg-a.deg);
  const tot=L.length;L=L.slice(0,qv?80:25);
  box.innerHTML=L.map(n=>`<button class="phrow" data-go="${esc(n.id)}"><i style="background:${TCOL[n.type]}"></i><span class="n">${esc(n.name)}${n.role?`<small>${esc(n.role)}</small>`:''}</span><span class="d">${n.deg}<small>LINKS</small></span></button>`).join('')||'<p class="phnone">Nothing matches that search.</p>';
  phEl.querySelector('#phcount').textContent=`SHOWING ${L.length} OF ${tot}`}
function buildPhone(){phBuilt=true;CL=caseFiles();const A=D.arsenal||{},nW=(A.weapons||[]).length,nEv=(A.events||[]).length;
  const nE=nodes.length,nR=rels.length+D.facts.length,nS=Object.keys(snodes).length,doc=rels.filter(r=>r.st==='documented').length;
  const types=TYPES.filter(([t])=>nodes.some(n=>n.type===t));
  const H2=(n,s)=>`<h2 class="phh"><span>${n}</span>${s}</h2>`;
  phEl.innerHTML=`<div class="phbar"><b>BL<i>0</i><i>0</i>D.MONEY</b><nav><button data-ph="ph-files">FILES</button><button data-ph="ph-who">WHO</button><button data-ph="ph-arsenal">ARSENAL</button><button data-ph="ph-submit">SUBMIT</button></nav></div>
  <div class="phhero"><div class="phhead"><span class="tiny">THE 2026 RECORD</span><h1>${esc(HEADLINE)}</h1><p>${esc(SUBHEAD)}</p><button class="phdown" data-ph="ph-money">SCROLL ↓</button></div></div>
  <div class="phbody">
   <section class="phsec" id="ph-money">${H2('01','The money')}
    <div class="stat3"><div><b>${nE}</b><span class="tiny">entities</span></div><div><b>${nR}</b><span class="tiny">facts</span></div><div><b>${nS}</b><span class="tiny">sources</span></div></div>
    <div class="moneystat"><b>${esc(money(TRACKED.total,'USD'))}</b><span class="tiny">money tracked, Oct 2023 to 2026</span>${TRACKED.parts.length?`<div class="blocks" role="img" aria-label="Breakdown of money tracked">${TRACKED.parts.map((p,i)=>`<i style="flex:${p.usd};background:${HEATB[i%8]}"></i>`).join('')}</div><ul class="mparts">${TRACKED.parts.map((p,i)=>`<li><span class="sw" style="background:${HEATB[i%8]}"></span><span class="l">${esc(p.label)}</span><span class="v">${esc(money(p.usd,'USD'))}</span></li>`).join('')}</ul>`:''}</div></section>
   <section class="phsec" id="ph-files">${H2('02','Case files')}<p class="phlede">Each file pulls one story out of the record: who paid, who profited and what it bought.</p>
    <ol class="cl">${CL.slice(0,8).map((o,i)=>`<li><button class="cf${o.special?' sp':''}" data-phcf="${i}"><span class="cft"><b>${String(i+1).padStart(2,'0')}</b>${esc(o.tag)}</span><span class="cfb"><span class="cfh">${esc(o.title)}</span>${o.name&&o.name!==o.title?`<span class="cfn">${esc(o.name)}</span>`:''}<span class="cfd">${esc(o.dek)}</span></span></button></li>`).join('')}</ol>
    <button class="phmore" data-phall>ALL ${CL.length} CASE FILES →</button></section>
   <section class="phsec" id="ph-arsenal">${H2('03','Arsenal')}<button class="arsbtn pharsbtn" data-pharsenal><svg viewBox="0 0 56 20" aria-hidden="true"><path d="M2 10 Q2 5 8 5 L40 5 L46 7 L46 13 L40 15 L8 15 Q2 15 2 10Z M40 5 L44 1 L52 1 L50 7 M40 15 L44 19 L52 19 L50 13" fill="none" stroke="currentColor" stroke-width=".9"/><line x1="0" x2="56" y1="10" y2="10" stroke="currentColor" stroke-width=".4" stroke-dasharray="3 2"/></svg><div><b>ARSENAL</b><span>${nW} weapons and ${nEv} events: what was dropped, who made each part, and where it fell.</span><em>OPEN THE CATALOGUE →</em></div></button></section>
   <section class="phsec" id="ph-who">${H2('04','Who profits')}<p class="phlede">Every company, investor, politician and lobby in the record, most connected first. Tap one to open its file.</p>
    <input id="phq" type="search" placeholder="Search a name…" autocomplete="off" spellcheck="false" aria-label="Search the record">
    <div class="phchips"><button data-pht="" aria-pressed="true">ALL</button>${types.map(([t,l])=>`<button data-pht="${esc(t)}" aria-pressed="false"><i style="background:${TCOL[t]}"></i>${esc(l)}</button>`).join('')}</div>
    <div class="phcount tiny" id="phcount"></div><div id="phlist"></div>
    <button class="phmore" data-phindex>FULL INDEX →</button></section>
   <section class="phsec" id="ph-about">${H2('05','How the facts are checked')}
    <p>Each fact in this database is tied to at least one document: a regulatory filing, an official record, a UN or court document, or a news investigation. The source is shown wherever the fact appears.</p>
    <p><span class="mono">●</span> Confirmed by a primary source: an SEC filing, company report, government record or similar, with the quoted passage stored (${doc} links).</p>
    <p><span class="mono">○</span> Reported: supported by media or a financial data provider. These stay visibly marked until a primary record is found (${rels.length-doc} links).</p>
    <p>Company-wide figures such as revenue or profit are shown for scale. Holdings by asset managers are held largely on behalf of clients, which does not make the profit any less real.</p>
    <p class="phnote">The full interactive map is on the desktop version of this site.</p></section>
   <section class="phsec" id="ph-submit">${H2('06','Missed something?')}<p>If you know of money, weapons, contracts or people profiting that this record leaves out, or a figure we got wrong, tell us. You do not need to give your name.</p><button class="phcta" data-phtips>SUBMIT A TIP →</button></section>
   <footer class="phfoot"><b>BL<i>0</i><i>0</i>D.MONEY</b><span class="tiny">BUILT ${esc(D.built)}</span></footer>
  </div>`;
  phList()}
phEl.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;const d=b.dataset;
  if(d.ph){const s=document.getElementById(d.ph);if(s)phEl.scrollTo({top:s.offsetTop-52,behavior:RM?'auto':'smooth'});return}
  if(d.phcf!=null)return CL[+d.phcf].open();
  if(d.phall!=null)return openCaseList();
  if(d.pharsenal!=null)return openArsenal();
  if(d.phindex!=null)return showView('index');
  if(d.phtips!=null)return showView('tips');
  if(d.pht!=null){phType=d.pht||null;phEl.querySelectorAll('[data-pht]').forEach(x=>x.setAttribute('aria-pressed',x===b));return phList()}
  if(d.go)return go(byId[d.go])});
phEl.addEventListener('input',e=>{if(e.target.id==='phq')phList()});
// overlays opened from the phone page go back to it, not to a map
new MutationObserver(()=>{if(!PHM())return;document.querySelectorAll('#caselist .closebtn,#tips .closebtn,#index .closebtn,#arsenal .closebtn').forEach(b=>{if(/BACK TO MAP/.test(b.textContent))b.textContent='BACK ×'});
  const it=document.querySelector('#index .head .tiny');if(it&&/ON THE MAP/.test(it.textContent))it.textContent=it.textContent.replace('CLICK A ROW TO OPEN IT ON THE MAP','TAP A ROW TO OPEN ITS FILE')}).observe(app,{childList:true,subtree:true});
const PHNOTE=[['Best on a desktop','BL00D.MONEY was made to be explored on a desktop screen, where you get the full interactive network map, the holdings matrix, layout modes and much more.'],
 ['There is more on a desktop','You are reading the phone edition. On a computer, every company, fund and politician sits on one live map, and you can follow the money line by line.'],
 ['You have reached the end','The full record, with the interactive map and every connection drawn out, is on the desktop version. Open it on a computer to keep digging.']];
const phSeen=new Set();let phTimer=null;
function phNote(i){if(!PHM()||phSeen.has(i))return;phSeen.add(i);let el=document.getElementById('phnote');if(!el){el=document.createElement('div');el.id='phnote';el.setAttribute('role','dialog');el.setAttribute('aria-modal','true');app.appendChild(el)}
  const [h,p]=PHNOTE[i],url=location.hostname&&!/claude|localhost|^$/.test(location.hostname)?location.hostname:'bl00d.money';
  el.innerHTML=`<div class="box"><span class="tiny">${i===0?'BEFORE YOU START':'A NOTE'}</span><h3>${esc(h)}</h3><p>${esc(p)}</p><div class="url"><span>${esc(url)}</span><button data-copy>COPY LINK</button></div><button class="ok" data-ok>CONTINUE ON PHONE</button></div>`;el.hidden=false;
  el.onclick=e=>{if(e.target.closest('[data-copy]')){const b=e.target.closest('[data-copy]');const done=()=>{b.textContent='COPIED'};try{navigator.clipboard.writeText('https://'+url).then(done,()=>{})}catch(_){}return}
    if(e.target.closest('[data-ok]')||e.target===el){el.hidden=true;if(i===0&&!phTimer)phTimer=setTimeout(()=>phNote(1),120000)}}}
phEl.addEventListener('scroll',()=>{if(phEl.scrollTop>400&&phEl.scrollTop+phEl.clientHeight>=phEl.scrollHeight-60)phNote(2)},{passive:true});
function phoneMode(){const on=PHM();app.classList.toggle('ph',on);phEl.hidden=!on;if(on&&!phBuilt)buildPhone();if(on){dos.classList.toggle('page',!!focus);phBack.hidden=!focus}else{dos.classList.remove('page');phBack.hidden=true}}
PHQ.addEventListener?PHQ.addEventListener('change',phoneMode):PHQ.addListener(phoneMode);

/* ---------- boot ---------- */
renderRail();renderDossier();renderModes();renderCrumbs();phoneMode();
addEventListener('resize',()=>{if(!app.classList.contains('intro')&&!focus&&!kase&&mode==='network')apply(true)});
const h=location.hash.slice(1),hn=h&&nodes.find(x=>x.slug===h||x.id===h);
if(RM||hn){app.classList.remove('intro');if(PHM())setTimeout(()=>phNote(0),1200);fitTo(nodes.map(n=>rot(n.nx,n.ny,theta)),0,30);if(hn)setTimeout(()=>select(hn),50)}
else startIntro();
if(innerWidth<=900)dos.classList.add('collapsed');
dos.addEventListener('click',e=>{if(innerWidth>900)return;
  if(dos.classList.contains('collapsed')){if(!e.target.closest('button'))dos.classList.remove('collapsed');return}
  if(e.clientY-dos.getBoundingClientRect().top<26){if(dos.classList.contains('full'))dos.classList.remove('full');else dos.classList.add('collapsed')}});
// phone bottom sheet: swipe up to open it fully, swipe down from the top to shrink it
{let y0=null,s0=0;dos.addEventListener('touchstart',e=>{y0=e.touches[0].clientY;s0=dos.scrollTop},{passive:true});
 dos.addEventListener('touchend',e=>{if(innerWidth>900||y0==null)return;const dy=e.changedTouches[0].clientY-y0;y0=null;const c=dos.classList;
  if(c.contains('collapsed')){if(dy<-30)c.remove('collapsed');return}
  if(dy>60&&s0<=0){if(c.contains('full'))c.remove('full');else c.add('collapsed')}
  else if(dy<-40&&!c.contains('full'))c.add('full')},{passive:true})}
requestAnimationFrame(frame);
})();
</script>

</html><script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/v4bc70e2c01a94c73b74392e4234840661791215815920" integrity="sha512-L0ha0OXavK/8okipN9F8BtP84dg9DUhPERbBXzwI6dgTA55d2+yweo3pn5CSFYs45/r8md2+xvUPtTdvTNRfjA==" data-cf-beacon='{"version":"2024.11.0","token":"0aaaab6de25c4ca090e2a6a0918def59","r":1,"spa":2}' crossorigin="anonymous"></script>


