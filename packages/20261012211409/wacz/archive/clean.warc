RC-W0078","SRC-W0092","SRC-W0063","SRC-W0075","SRC-W0069","SRC-W0073","SRC-W0065","SRC-W0080","SRC-W0089","SRC-W0121","SRC-W0080","SRC-W0069","SRC-W0076","SRC-W0072","SRC-W0096","SRC-W0072","SRC-W0080","SRC-W0071","SRC-W0068","SRC-W0091","SRC-W0080","SRC-W0082","SRC-W0076","SRC-W0096","SRC-W0064","SRC-W0077","SRC-W0068","SRC-W0065","SRC-W0065","SRC-W0068","SRC-W0074","SRC-W0080","SRC-W0087","SRC-W0070","SRC-W0064","SRC-W0074","SRC-W0093"]},{"name":"Combustible cartridge case / propellant","maker":"COM-00007","start":0.55,"end":1,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0071","SRC-W0071","SRC-W0071","SRC-W0070","SRC-W0068","SRC-W0090","SRC-W0091","SRC-W0072","SRC-W0063","SRC-W0065","SRC-W0094","SRC-W0065","SRC-W0063","SRC-W0068","SRC-W0096","SRC-W0065","SRC-W0070","SRC-W0082","SRC-W0076","SRC-W0096","SRC-W0067","SRC-W0065","SRC-W0072","SRC-W0063","SRC-W0068","SRC-W0065","SRC-W0067","SRC-W0074","SRC-W0068","SRC-W0093","SRC-W0075","SRC-W0085","SRC-W0090","SRC-W0063","SRC-W0067","SRC-W0093","SRC-W0072","SRC-W0090","SRC-W0068","SRC-W0065","SRC-W0067","SRC-W0086","SRC-W0087","SRC-W0086","SRC-W0088","SRC-W0092","SRC-W0087","SRC-W0086","SRC-W0067","SRC-W0082","SRC-W0075","SRC-W0063","SRC-W0075","SRC-W0090","SRC-W0076","SRC-W0078","SRC-W0092","SRC-W0063","SRC-W0075","SRC-W0069","SRC-W0073","SRC-W0065","SRC-W0080","SRC-W0089","SRC-W0121","SRC-W0080","SRC-W0069","SRC-W0076","SRC-W0072","SRC-W0096","SRC-W0072","SRC-W0080","SRC-W0071","SRC-W0068","SRC-W0091","SRC-W0080","SRC-W0082","SRC-W0076","SRC-W0096","SRC-W0064","SRC-W0077","SRC-W0068","SRC-W0065","SRC-W0065","SRC-W0068","SRC-W0074","SRC-W0080","SRC-W0087","SRC-W0070","SRC-W0064","SRC-W0074","SRC-W0093"]}],"summary":"The M339 is a 120mm multipurpose tank round with a programmable fuze, built by IMI Systems and now sold by Elbit Systems Land for the Merkava tanks. It weighs about 27 kg and carries 2.3 kg of explosive. It is linked by name to the killing of Reuters videographer Issam Abdallah near Alma al-Shaab in South Lebanon on 13 October 2023. Amnesty's weapons experts examined fragments, trajectory and footage and concluded the first strike on the clearly identifiable group of journalists was a 120mm tank round, most likely an M339 made by IMI Systems. Six other journalists from AFP, Reuters and Al Jazeera were injured, some in a second strike that Amnesty assessed was most likely a small guided missile. Amnesty called for the attack to be investigated as a war crime. How these rounds reach Israel's army, and in what quantities, is not public.","transfers":[],"status":"documented"},{"id":"ARS-M825","name":"M825 / M825A1 155mm white phosphorus projectile","aka":["M825E1","WP smoke shell"],"class":"incendiary","form":"shell","dims":{"length_m":null,"diameter_m":0.155,"span_m":null,"weight_kg":46},"specs":[{"k":"Weight","v":"about 102 lb (46 kg)","src":["SRC-W0131"]},{"k":"Payload","v":"116 felt wedges impregnated with about 12.75 lb of white phosphorus","src":["SRC-W0131"]},{"k":"Function","v":"base-ejection carrier projectile; airburst scatters burning wedges","src":["SRC-W0131"]},{"k":"Spread","v":"burning wedges up to 125 m in all directions (HRW)","src":["SRC-W0132"]},{"k":"Burn temperature","v":"815 C; ignites on contact with oxygen","src":["SRC-W0132"]},{"k":"Markings in Lebanon","v":"M825A1 shells marked D528, from US depots in Arkansas and Louisiana (Amnesty)","src":["SRC-W0133"]}],"makers":[{"entity":"US Army ammunition supply chain (Arkansas and Louisiana production per shell markings)","role":"prime / loading (exact plants not named in sources reviewed)","src":["SRC-W0134"]}],"parts":[{"name":"Fuze","maker":"unattributed","start":0,"end":0.12,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0071","SRC-W0071","SRC-W0071","SRC-W0070","SRC-W0078","SRC-W0090","SRC-W0076","SRC-W0091","SRC-W0075","SRC-W0090","SRC-W0065","SRC-W0068","