<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><style>body{margin:0;background:#080808}[hidden]{display:none!important}</style>
<title>BL00D.MONEY · The Genocide Economy, Mapped</title>
<meta name="description" content="Who is profiting from Israel's genocidal campaign on the Middle East? A sourced map of the money, weapons and people.">
<meta name="referrer" content="no-referrer">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
/* Layout: one full-bleed network canvas; thin index rail left, dossier right, mode strip bottom. Single dark world by design. */
:root{
  --bg:#080808; --panel:#0e0e0d; --fg:#f1f1ed; --fg2:#949494; --fg3:#5c5c5a; --line:#343434; --rule:#1f1f1e;
  --signal:#e8ff00;
  --c-person:#a7d8e0; --c-company:#e8ff00; --c-gov:#4f9dff; --c-country:#b48cff; --c-fund:#ff5c2b; --c-weapon:#e5322d; --c-contract:#e2e2da; --c-org:#6fd38a; --c-agg:#8b8b86; --sel:#ffffff;
  --paper:#ecebe4; --ink:#141412; --ink2:#5d5b54; --red:#c8102e;
  --f-own:#ff5c2b; --f-contract:#e5322d; --f-money:#ffc93c; --f-politics:#6fd38a; --f-oppose:#ff3b8d; --f-role:#a7d8e0; --f-tech:#4f9dff;
  --sans:"Hanken Grotesk","Helvetica Neue",Helvetica,Arial,sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,"SFMono-Regular",Menlo,Consolas,monospace;
  color-scheme:dark;
}
html,body{height:100%}
body{background:var(--bg);color:var(--fg);font-family:var(--sans);overflow:hidden;-webkit-font-smoothing:antialiased}
*{box-sizing:border-box;scrollbar-width:none}
*::-webkit-scrollbar{display:none}
::selection{background:var(--fg);color:var(--bg)}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;padding:0}
:focus-visible{outline:1px solid var(--signal);outline-offset:2px}
.mono{font-family:var(--mono);letter-spacing:.02em}
.tiny{font-family:var(--mono);font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--fg2)}
#app{position:fixed;inset:0;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
canvas#net{position:absolute;inset:0;width:100%;height:100%;display:block;cursor:grab}
canvas#net.hovering{cursor:pointer}

/* header */
header{position:absolute;left:0;right:0;top:env(safe-area-inset-top,0px);display:grid;grid-template-columns:auto 1fr auto;align-items:start;gap:16px;padding:14px 18px;pointer-events:none;z-index:8}
header>*{pointer-events:auto}
.mark{display:flex;flex-direction:column;gap:3px}
.mark b{font-weight:500;font-size:15px;letter-spacing:.08em}
.mark b i{font-style:normal;color:var(--signal)}
.searchwrap{justify-self:center;width:min(440px,100%);position:relative}
#q{width:100%;background:transparent;border:0;border-bottom:1px solid var(--line);color:var(--fg);font-family:var(--mono);font-size:12px;letter-spacing:.06em;padding:6px 0 6px 18px;text-transform:uppercase}
#q::placeholder{color:var(--fg3)}
.searchwrap:before{content:"/";position:absolute;left:0;top:6px;font-family:var(--mono);font-size:12px;color:var(--signal)}
#results{position:absolute;top:34px;left:0;right:0;background:var(--panel);border:1px solid var(--rule);max-height:60vh;overflow:auto;padding:6px 0}
#results .grp{padding:8px 12px 2px}
#results button{display:flex;justify-content:space-between;gap:12px;width:100%;text-align:left;padding:5px 12px;font-size:13px}
#results button:hover,#results button.on{background:#161615;color:var(--signal)}
#results button span:last-child{font-family:var(--mono);font-size:10px;color:var(--fg3)}
nav.top{display:flex;gap:18px;align-items:center}
nav.top button{font-family:var(--mono);font-size:11px;letter-spacing:.1em;color:var(--fg2)}
nav.top button[aria-pressed="true"],nav.top button:hover{color:var(--fg)}
nav.top button[aria-pressed="true"]:before{content:"● ";color:var(--signal)}

/* left rail */
#rail{position:absolute;left:0;top:78px;bottom:64px;width:224px;padding:10px 18px;overflow:auto;z-index:4;display:flex;flex-direction:column;gap:22px;scrollbar-width:none}
#rail h3{font-family:var(--mono);font-weight:400;font-size:10px;letter-spacing:.12em;color:var(--fg3);margin:0 0 8px;padding-bottom:6px;border-bottom:1px solid var(--rule);display:flex;justify-content:space-between}
.opt{display:flex;align-items:center;gap:8px;width:100%;padding:3px 0;font-size:12.5px;color:var(--fg2);text-align:left}
.opt .dot{width:8px;height:8px;border-radius:50%;border:1px solid currentColor;flex:none}
.opt[aria-pressed="true"]{color:var(--fg)}
.opt[aria-pressed="true"] .dot{background:currentColor}
.opt .n{margin-left:auto;font-family:var(--mono);font-size:10px;color:var(--fg3)}
.opt .sw{width:6px;height:6px;flex:none}
.typ{display:flex;align-items:center;gap:8px;padding:2px 0;font-size:12.5px}
.typ .dotb{width:16px;height:16px;display:grid;place-items:center;flex:none}
.typ .dot{width:8px;height:8px;border-radius:50%;border:1px solid currentColor}
.typ .dotb[aria-pressed="true"] .dot{background:currentColor}
.typ .lab{color:var(--fg2);text-align:left;flex:1;padding:2px 4px;margin-left:-4px;border-radius:2px}
.typ .lab:hover{color:var(--fg)}
.typ .lab[aria-pressed="true"]{color:var(--bg);background:var(--hl,var(--fg))}
.typ .n{font-family:var(--mono);font-size:10px;color:var(--fg3)}
.railtabs{display:flex;border-bottom:1px solid var(--line);gap:18px;margin-bottom:-8px}
.railtabs button{font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;color:var(--fg3);padding:4px 0 7px;border-bottom:1px solid transparent;margin-bottom:-1px}
.railtabs button[aria-pressed="true"]{color:var(--fg);border-color:var(--signal)}
.hint{font-size:11.5px;line-height:1.5;color:var(--fg3);margin:0}
/* case files: a drawer of index cards, tabs staggered like a card catalogue */
.drawer{display:flex;flex-direction:column;padding-top:4px}
.file{position:relative;height:31px;width:100%;text-align:left;color:var(--fg2)}
.file:before{content:"";position:absolute;left:0;right:0;bottom:0;height:9px;border:1px solid var(--line);border-bottom:0;border-radius:4px 4px 0 0;background:var(--bg)}
.file .tab{position:absolute;bottom:8px;left:var(--off);width:118px;height:22px;display:flex;justify-content:space-between;align-items:center;padding:0 12px;font-size:11px;letter-spacing:.02em;z-index:1}
.file .tab:before{content:"";position:absolute;inset:0;border:1px solid var(--line);border-bottom:0;border-radius:5px 5px 0 0;background:var(--bg);transform:perspective(26px) rotateX(7deg);transform-origin:bottom;z-index:-1;transition:background .3s,border-color .3s}
.file .tab b{font-family:var(--mono);font-weight:400;font-size:10px;color:var(--fg3)}
.file:hover{color:var(--fg)}.file:hover .tab:before{border-color:var(--fg2)}
.file[aria-pressed="true"]{color:var(--bg)}.file[aria-pressed="true"] .tab b{color:var(--bg)}
.file[aria-pressed="true"] .tab:before{background:var(--fg);border-color:var(--fg)}
.drawerfoot{width:100%;height:34px;border:1px solid var(--line);border-top:0;display:flex;justify-content:center;align-items:center;gap:8px;margin-top:-1px;cursor:pointer;transition:border-color .2s,background .2s}.drawerfoot span{white-space:nowrap}.drawerfoot i{font-style:normal;font-family:var(--mono);font-size:12px;color:var(--fg3);transition:color .2s}.drawerfoot:hover{border-color:var(--signal);background:rgba(232,255,0,.04)}.drawerfoot:hover i{color:var(--signal)}
.drawerfoot span{font-family:var(--mono);font-size:9.5px;letter-spacing:.1em;color:#111;background:var(--signal);padding:2px 8px;border-radius:3px}
.seg{display:flex;gap:0;border:1px solid var(--rule)}
.seg button{flex:1;font-family:var(--mono);font-size:10px;letter-spacing:.08em;padding:5px 0;color:var(--fg2)}
.seg button[aria-pressed="true"]{background:var(--fg);color:var(--bg)}
.legend-line{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--fg2);padding:2px 0}
.legend-line svg{flex:none}

/* right dossier */
#dossier{position:absolute;right:0;top:78px;bottom:64px;width:360px;padding:6px 20px 24px;overflow:auto;z-index:4;background:linear-gradient(90deg,rgba(8,8,8,0),rgba(8,8,8,.86) 14%);scrollbar-width:none}
#dossier .idrow{display:flex;justify-content:space-between}
#dossier h1{font-weight:400;font-size:clamp(26px,3vw,38px);line-height:1.02;letter-spacing:-.015em;margin:10px 0 14px;text-wrap:balance}
.kv{display:grid;grid-template-columns:96px 1fr;gap:6px 12px;font-size:12.5px;padding:10px 0;border-top:1px solid var(--rule)}
.kv dt{font-family:var(--mono);font-size:10px;letter-spacing:.1em;color:var(--fg3);padding-top:2px}
.kv dd{margin:0;color:var(--fg)}
.sec{border-top:1px solid var(--rule);padding:12px 0 6px}
.sec h4{margin:0 0 10px;font-family:var(--mono);font-weight:400;font-size:10px;letter-spacing:.12em;color:var(--fg3);display:flex;justify-content:space-between}
.prose{font-size:13.5px;line-height:1.55;color:#d8d8d3;max-width:62ch}
.srcs{display:flex;flex-wrap:wrap;gap:4px 10px;margin-top:8px}
.srcs a{font-family:var(--mono);font-size:10px;color:var(--fg2);text-decoration:none;border-bottom:1px solid var(--line)}
.srcs a:hover{color:var(--signal);border-color:var(--signal)}
.big{font-size:40px;font-weight:300;letter-spacing:-.02em;font-variant-numeric:tabular-nums;line-height:1}
.counts{display:grid;grid-template-columns:repeat(2,1fr);gap:8px 16px}
.counts div{display:flex;align-items:baseline;gap:8px}
.counts b{font-weight:400;font-size:22px;font-variant-numeric:tabular-nums}
.own{display:grid;grid-template-columns:1fr auto 52px;gap:4px 10px;align-items:center;font-size:12px}
.own .dots{font-family:var(--mono);font-size:9px;letter-spacing:1px;color:var(--fg2);white-space:nowrap}
.own .pct{font-family:var(--mono);font-size:11px;text-align:right;font-variant-numeric:tabular-nums}
.rel{display:grid;grid-template-columns:14px 1fr auto;gap:2px 8px;width:100%;text-align:left;padding:7px 0;border-bottom:1px solid #141413;font-size:12.5px;align-items:baseline}
.rel:hover .who{color:var(--signal)}
.rel .g{font-size:10px;color:var(--fg2)}
.rel .what{grid-column:2/4;font-family:var(--mono);font-size:10px;letter-spacing:.06em;color:var(--fg3);text-transform:uppercase}
.rel .amt{font-family:var(--mono);font-size:11px;font-variant-numeric:tabular-nums}
.nums{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:12px 0;border-top:1px solid var(--rule)}
.nums b{display:block;font-weight:300;font-size:21px;font-variant-numeric:tabular-nums;letter-spacing:-.01em;color:var(--signal)}
.nums b.dim{color:var(--fg)}
.hold{display:grid;grid-template-columns:1fr 64px;gap:2px 10px;width:100%;text-align:left;padding:7px 0;border-bottom:1px solid #141413;font-size:12.5px}
.hold:hover .who{color:var(--signal)}
.hold .v{font-family:var(--mono);font-size:12px;text-align:right;font-variant-numeric:tabular-nums;color:var(--signal)}
.hold .bar{grid-column:1/3;height:3px;background:#1a1a19;position:relative}
.hold .bar i{position:absolute;left:0;top:0;bottom:0;background:var(--c-fund)}
.hold .sub{grid-column:1/3;font-family:var(--mono);font-size:10px;color:var(--fg3);letter-spacing:.04em}
.grp{font-family:var(--mono);font-size:10px;letter-spacing:.12em;color:var(--fg2);margin:14px 0 2px;display:flex;align-items:center;gap:8px}
.grp i{width:10px;height:2px;display:inline-block}
.rel .ctx{grid-column:2/4;font-size:11.5px;line-height:1.45;color:var(--fg2)}
.mx{width:100%;border-collapse:collapse;font-size:11px;font-variant-numeric:tabular-nums}
.mx th{font-family:var(--mono);font-weight:400;font-size:9px;letter-spacing:.06em;color:var(--fg3);padding:4px 2px;text-align:right;white-space:nowrap}
.mx th:first-child,.mx td:first-child{text-align:left}
.mx td{padding:0;border-bottom:1px solid #141413;text-align:right}
.mx td button{width:100%;text-align:right;font-family:var(--mono);font-size:10px;padding:6px 2px}
.mx td button:hover{outline:1px solid var(--signal)}
.mx td.co{font-size:11.5px;padding:6px 6px 6px 0;white-space:nowrap;max-width:104px;overflow:hidden;text-overflow:ellipsis}
.mx td.tot{font-family:var(--mono);color:var(--signal);padding-left:6px}
.case h1{margin-top:6px}
.chips{display:flex;flex-wrap:wrap;gap:4px 6px}
.chips button{font-size:11.5px;border:1px solid var(--line);padding:3px 8px;border-radius:999px;color:var(--fg2);display:flex;gap:6px;align-items:center}
.chips button:hover{color:var(--fg);border-color:var(--fg2)}
.chips i{width:6px;height:6px;border-radius:50%;display:inline-block}
.plain{font-size:15px;line-height:1.4;margin:8px 0 10px;color:var(--fg)}
.plain em{font-style:normal;color:var(--signal);font-family:var(--mono);font-size:14px}
.path{font-family:var(--mono);font-size:10.5px;line-height:1.8;color:var(--fg2)}
.path button{color:var(--fg2);text-decoration:underline;text-decoration-color:var(--line);text-underline-offset:3px}
.path button:hover{color:var(--signal)}
.intro p{font-size:13.5px;line-height:1.55;color:#cfcfca;margin:0 0 12px;max-width:60ch}
.stat3{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:8px 0 10px}
#dossier p.sub{font-size:13.5px;line-height:1.45;color:var(--signal);margin:-4px 0 16px;max-width:40ch}
.moneystat{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:10px 0 12px;margin:0 0 18px;display:grid;grid-template-columns:auto 1fr;column-gap:12px;align-items:baseline}
.moneystat b{font-weight:300;font-size:30px;color:var(--signal);font-variant-numeric:tabular-nums}
.moneystat.casetot,.moneystat.profit{margin:8px 0 12px}.moneystat .mparts{grid-column:1/-1}
.wantedS{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;border:3px solid #e5322d;color:#e5322d;padding:4px 10px 6px;margin:8px 0 10px;transform:rotate(-1deg);width:max-content;max-width:100%}.wantedS b{font-weight:800;font-size:34px;letter-spacing:.08em;line-height:1}.wantedS span{font-family:var(--mono);font-size:9.5px;letter-spacing:.1em}
.moneystat .blocks{grid-column:1/-1;display:flex;height:14px;gap:2px;margin:10px 0 8px}.moneystat .blocks i{display:block;min-width:3px}
.mparts{grid-column:1/-1;list-style:none;margin:0;padding:0;display:grid;gap:3px}.mparts li{display:grid;grid-template-columns:10px 1fr auto;gap:8px;align-items:baseline;font-size:11px;color:var(--fg2)}.mparts .sw{width:10px;height:10px;align-self:center}.mparts .v{font-variant-numeric:tabular-nums;color:var(--fg)}
.moneystat .note{grid-column:1/-1;font-size:11px;line-height:1.45;color:var(--fg3);margin-top:4px}
.stat3 b{display:block;font-weight:300;font-size:30px;font-variant-numeric:tabular-nums}
.closebtn{font-family:var(--mono);font-size:10px;letter-spacing:.1em;color:var(--fg2)}
.closebtn:hover{color:var(--signal)}

/* bottom bar */
#modes{position:absolute;left:50%;transform:translateX(-50%);bottom:calc(16px + env(safe-area-inset-bottom,0px));display:flex;gap:6px;z-index:5;max-width:calc(100% - 32px);overflow-x:auto;scrollbar-width:none}
#modes button{font-family:var(--mono);font-size:10.5px;letter-spacing:.1em;padding:7px 14px;border:1px solid var(--line);border-radius:999px;color:var(--fg2);white-space:nowrap;transition:border-color .4s,color .4s,background .4s}
#modes button:hover{color:var(--fg);border-color:var(--fg2)}
#modes button[aria-pressed="true"]{color:var(--bg);background:var(--fg);border-color:var(--fg)}
#modes button[disabled]{opacity:.35;cursor:not-allowed}
#crumbs{position:absolute;left:18px;bottom:calc(20px + env(safe-area-inset-bottom,0px));z-index:5;font-family:var(--mono);font-size:10px;letter-spacing:.08em;color:var(--fg3);max-width:28vw}
#crumbs button{color:var(--fg2)}#crumbs button:hover{color:var(--signal)}#crumbs .back{font-size:13px;line-height:1;padding:0 8px 0 0;margin-right:4px;border-right:1px solid var(--line);color:var(--fg3)}
#meta{position:absolute;right:378px;bottom:calc(62px + env(safe-area-inset-bottom,0px));z-index:5;text-align:right;line-height:1.6}
#ctrls{position:absolute;right:386px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:4px;z-index:5}
#ctrls button{width:30px;height:30px;border:1px solid var(--rule);font-family:var(--mono);font-size:12px;color:var(--fg2);background:rgba(8,8,8,.7)}
#ctrls button:hover{color:var(--fg);border-color:var(--fg2)}
#zoomlbl{position:absolute;left:242px;top:84px;z-index:3}

/* relationship inspector */
#insp{position:absolute;z-index:8;width:min(380px,calc(100vw - 32px));max-height:min(62vh,560px);overflow:auto;background:var(--panel);border:1px solid var(--line);padding:14px 16px 12px;font-size:12.5px;box-shadow:0 10px 40px rgba(0,0,0,.6)}
#insp .ends{font-size:15px;line-height:1.3;margin:8px 0 10px}
#insp .ends .arr{font-family:var(--mono);color:var(--signal);display:block;margin:2px 0}
#insp .ex{font-size:12px;line-height:1.5;color:#c9c9c4;border-left:1px solid var(--line);padding-left:10px;margin:8px 0}
#insp a{color:var(--fg);font-family:var(--mono);font-size:10.5px;letter-spacing:.06em}
#insp a:hover{color:var(--signal)}

/* overlays scroll under the header: give it a ground while one is open */
#app:has(#tips:not([hidden])) header,#app:has(#caselist:not([hidden])) header,#app:has(#index:not([hidden])) header{background:var(--bg)}
@media (max-width:900px){nav.top{gap:11px}nav.top button{font-size:10px;letter-spacing:.06em;white-space:nowrap}#tips{padding-top:120px}}
/* tips page */
#tips{position:absolute;inset:0;z-index:7;background:var(--bg);overflow:auto;overscroll-behavior:contain;padding:84px 18px 90px;scrollbar-width:none}#tips::-webkit-scrollbar{display:none}
#tips .wrap{max-width:720px;margin:0 auto}
#tips .head{display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;margin-bottom:18px}
#tips h2{font-weight:400;font-size:clamp(30px,5vw,56px);letter-spacing:-.02em;margin:0;line-height:1}
#tips h2 mark{background:none;color:var(--signal)}
#tips p.lede{font-size:16px;line-height:1.6;color:var(--fg);max-width:62ch;margin:0 0 10px}
#tips p.note{font-size:13px;line-height:1.6;color:var(--fg2);max-width:62ch;margin:0 0 22px}
#tips form{display:grid;gap:16px;border:1px solid var(--line);padding:20px;background:#0b0b0a}
#tips label{display:grid;gap:6px;font-family:var(--mono);font-size:10px;letter-spacing:.12em;color:var(--fg2)}
#tips label span{color:var(--fg3);letter-spacing:.04em;text-transform:none;font-family:inherit}
#tips textarea,#tips input,#tips select{font:inherit;font-family:system-ui,-apple-system,"Segoe UI",sans-serif;font-size:14px;letter-spacing:0;color:var(--fg);background:#050505;border:1px solid var(--line);padding:10px 12px;border-radius:0;width:100%;box-sizing:border-box}
#tips textarea{min-height:170px;resize:vertical;line-height:1.5}
#tips textarea:focus,#tips input:focus,#tips select:focus{outline:none;border-color:var(--signal)}
#tips .hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
#tips .row{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
#tips button.send{font-family:var(--mono);font-size:11px;letter-spacing:.14em;background:var(--signal);color:#111;padding:11px 18px}
#tips button.send:disabled{opacity:.5}
#tips .count{font-family:var(--mono);font-size:10px;color:var(--fg3)}
#tips .msg{font-size:13.5px;line-height:1.5;padding:12px 14px;border-left:2px solid var(--signal);background:rgba(232,255,0,.05)}
#tips .ts{min-height:65px;font-size:12.5px;line-height:1.5;color:var(--fg2)}
#tips ul.safe{margin:22px 0 0;padding-left:18px;color:var(--fg2);font-size:12.5px;line-height:1.6}

/* case-file list */
#caselist .head .closebtn{margin-left:auto}@media (max-width:900px){#caselist{padding-top:120px}}
ol.cl{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,340px),1fr));gap:22px 18px;max-width:1500px}
.cf{display:flex;flex-direction:column;width:100%;height:100%;text-align:left;cursor:pointer;color:var(--ink,#141412)}
.cft{align-self:flex-start;display:flex;gap:8px;align-items:center;background:#e7e2d3;color:#141412;font-family:var(--mono);font-size:9px;letter-spacing:.12em;padding:5px 14px 4px 10px;clip-path:polygon(0 0,calc(100% - 10px) 0,100% 100%,0 100%)}
.cft b{font-weight:700}
.cfb{flex:1;display:flex;flex-direction:column;gap:8px;background:#e7e2d3;color:#141412;padding:14px 16px 14px;border-top:0;transition:transform .25s ease,box-shadow .25s}
.cf.sp .cft,.cf.sp .cfb{background:var(--signal)}
.cf:hover .cfb{transform:translateY(-3px);box-shadow:0 10px 30px rgba(0,0,0,.6)}
.cfh{font-size:18px;line-height:1.15;letter-spacing:-.01em;text-wrap:balance}
.cfn{font-family:var(--mono);font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:#4b4a44;margin-top:-4px}
.cfd{font-size:12.5px;line-height:1.45;color:#3a3934;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.cfm{display:flex;flex-wrap:wrap;gap:4px 12px;font-family:var(--mono);font-size:8.5px;letter-spacing:.1em;color:#4b4a44;margin-top:auto;padding-top:6px;border-top:1px solid rgba(20,20,18,.2)}
.cfbar{display:block;height:3px;background:rgba(20,20,18,.14)}.cfbar i{display:block;height:100%;background:#141412}

/* index */
#index,#caselist{position:absolute;inset:0;z-index:7;background:var(--bg);overflow:auto;padding:84px 18px 90px;scrollbar-width:none}#caselist::-webkit-scrollbar{display:none}
#caselist .head,#index .head{display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;margin-bottom:18px}
#caselist h2,#index h2{font-weight:400;font-size:clamp(28px,5vw,56px);letter-spacing:-.02em;margin:0;line-height:1}
.tblwrap{overflow-x:auto}
table.idx{width:100%;border-collapse:collapse;font-size:12.5px;min-width:640px}
table.idx th{font-family:var(--mono);font-weight:400;font-size:10px;letter-spacing:.1em;color:var(--fg3);text-align:left;padding:6px 10px 6px 0;border-bottom:1px solid var(--line);white-space:nowrap}
table.idx th button{color:inherit;letter-spacing:inherit}
table.idx th button[aria-sort]:after{content:" ↓";color:var(--signal)}
table.idx td{padding:3px 10px 3px 0;border-bottom:1px solid #121211;vertical-align:baseline}
table.idx td.m{font-family:var(--mono);font-size:11px;color:var(--fg2);white-space:nowrap;font-variant-numeric:tabular-nums}
table.idx td.r,table.idx th.r{text-align:right}
table.idx tr{cursor:pointer}
table.idx tr:hover td{color:var(--signal)}


#rail,#dossier,#modes,#ctrls,#zoomlbl,#meta,#crumbs,header{transition:opacity 1.4s ease}
#app.intro #rail,#app.intro #dossier,#app.intro #modes,#app.intro #ctrls,#app.intro #zoomlbl,#app.intro #meta,#app.intro #crumbs{opacity:0;pointer-events:none}
#skip{position:absolute;right:18px;bottom:calc(18px + env(safe-area-inset-bottom,0px));z-index:6;width:34px;height:34px;border:1px solid var(--line);border-radius:50%;color:var(--fg2);font-family:var(--mono);font-size:13px;opacity:0;pointer-events:none;transition:opacity .6s}
#app.intro #skip{opacity:1;pointer-events:auto}#skip:hover{color:var(--fg);border-color:var(--fg2)}
#app.intro header{opacity:0;pointer-events:none}
#names{position:absolute;left:242px;top:102px;z-index:3;display:flex;gap:8px;align-items:center}
#backbtn{position:absolute;left:242px;top:126px;z-index:3;font-family:var(--mono);font-size:10px;letter-spacing:.12em;color:var(--fg2);padding:3px 8px 3px 6px;border:1px solid var(--line);background:rgba(8,8,8,.6)}#backbtn:hover{color:var(--signal);border-color:var(--signal)}#app.intro #backbtn{opacity:0;pointer-events:none}
#names button{font-family:var(--mono);font-size:10px;letter-spacing:.08em;color:var(--fg3);padding:2px 0}
#names button[aria-pressed="true"]{color:var(--fg);border-bottom:1px solid var(--signal)}
#app.intro #names{opacity:0;pointer-events:none}
/* ---------- arsenal ---------- */
#arsenal{--abg:#0f3260;--aln:#e3eeff;--adim:rgba(227,238,255,.55);--agrid:rgba(227,238,255,.07);--aacc:#ffe14d;--apan:rgba(5,20,45,.45);position:absolute;inset:0;z-index:11;overflow:auto;background:var(--abg);color:var(--aln);
  background-image:linear-gradient(var(--agrid) 1px,transparent 1px),linear-gradient(90deg,var(--agrid) 1px,transparent 1px);background-size:24px 24px}
#arsenal.st-ink{--abg:#080808;--aln:#f1f1ed;--adim:rgba(241,241,237,.5);--agrid:rgba(255,255,255,.035);--aacc:var(--signal);--apan:rgba(255,255,255,.03)}
#arsenal.st-paper{--abg:#e7e2d3;--aln:#141412;--adim:rgba(20,20,18,.55);--agrid:rgba(20,20,18,.06);--aacc:#c8102e;--apan:rgba(20,20,18,.04)}
#arsenal .tiny{color:var(--adim)}
#arsenal .ah{position:sticky;top:0;z-index:2;display:flex;flex-wrap:wrap;align-items:center;gap:10px 18px;padding:14px 20px;background:var(--abg);border-bottom:1px solid var(--adim)}
#arsenal .brand{display:flex;align-items:baseline;gap:12px;margin-right:auto}#arsenal .brand b{font-family:var(--mono);font-weight:500;letter-spacing:.3em;font-size:14px}
#arsenal .seg{display:flex;gap:0}#arsenal .seg.wrap{flex-wrap:wrap;gap:4px}
#arsenal .seg button,#arsenal .close,#arsenal .xbtn{font-family:var(--mono);font-size:10px;letter-spacing:.1em;color:var(--aln);border:1px solid var(--adim);padding:5px 10px;margin-left:-1px}
#arsenal .seg button[aria-pressed=true],#arsenal .xbtn[aria-pressed=true]{background:var(--aln);color:var(--abg)}
#arsenal .close{border:0}
#arsenal .wpage{display:grid;grid-template-columns:250px minmax(0,1fr);gap:0}
#arsenal .wl{border-right:1px solid var(--adim);padding:14px 0;position:sticky;top:53px;align-self:start;max-height:calc(100vh - 53px);overflow:auto;scrollbar-width:none}
#arsenal .grp{display:block;margin:0 0 14px;font-family:var(--sans);letter-spacing:0;color:inherit;font-size:13px}#arsenal button{font-family:var(--sans,inherit)}#arsenal .grp h4{font-family:var(--mono);font-weight:400;font-size:9.5px;letter-spacing:.14em;color:var(--adim);margin:0 20px 4px;display:flex;justify-content:space-between}
#arsenal .wl button{display:flex;justify-content:space-between;gap:8px;width:100%;text-align:left;padding:5px 20px;font-size:13px;color:var(--aln)}
#arsenal .wl button span{font-family:var(--mono);font-size:10px;color:var(--adim)}
#arsenal .wl button:hover{background:var(--apan)}#arsenal .wl button[aria-pressed=true]{background:var(--aln);color:var(--abg)}#arsenal .wl button[aria-pressed=true] span{color:var(--abg)}
#arsenal .wv{padding:22px clamp(16px,3vw,40px) 60px;min-width:0}
#arsenal .wh{display:flex;justify-content:space-between;align-items:flex-end;gap:14px;flex-wrap:wrap}
#arsenal h2{font-weight:400;font-size:clamp(28px,4vw,44px);letter-spacing:-.01em;margin:6px 0 2px;line-height:1.05}
#arsenal .aka{font-family:var(--mono);font-size:11px;color:var(--adim)}
#arsenal .xbtn{border-color:var(--aacc);color:var(--aacc);padding:8px 14px}#arsenal .xbtn[aria-pressed=true]{background:var(--aacc);color:var(--abg)}
#arsenal .draw{margin:16px 0 8px;border:1px solid var(--adim);background:var(--apan);overflow-x:auto}
#arsenal svg.bp{display:block;width:100%;min-width:560px;height:auto;color:var(--aln);font-family:var(--mono);font-size:11px}
.bp .cl{stroke:var(--adim);stroke-dasharray:14 4 2 4;stroke-width:.7}
.bp .b{fill:var(--apan);stroke:var(--aln);stroke-width:1.3}.bp .f{fill:none;stroke:var(--aln);stroke-width:1.1}.bp .h{stroke:var(--adim);stroke-width:.6}
.bp line{stroke:var(--aln)}.bp .part line:not(.h){stroke-width:1.2}
.bp circle.cn{fill:var(--abg);stroke:var(--aln);stroke-width:.8}.bp text.cn{fill:var(--aln);font-size:9.5px}
.bp .part{transition:transform .9s cubic-bezier(.6,0,.2,1);transition-delay:var(--d)}
.bp.ex .part{transform:translate(var(--dx),var(--dy))}
.bp .dim{transition:opacity .4s}.bp.ex .dim{opacity:0}
.bp .dim line{stroke:var(--adim);stroke-width:.8}.bp .dim text{fill:var(--aln);font-size:11px}.bp .dim .bg{fill:var(--abg)}
.bp .call{opacity:0;transition:opacity .5s;transition-delay:0ms;pointer-events:none}.bp.ex .call{opacity:1;transition-delay:var(--d);pointer-events:auto}
.bp .call polyline{fill:none;stroke:var(--aacc);stroke-width:.9}.bp .call circle{fill:var(--aacc)}
.bp .call .pn{fill:var(--aln);font-size:10px;letter-spacing:.06em}.bp .call .mk{fill:var(--aacc);font-size:11px}.bp .call .mk[data-go]{cursor:pointer;text-decoration:underline}
.bp .in .b{fill:none;stroke-dasharray:4 3;stroke-width:1}.bp.ex .in .b{fill:var(--abg);stroke-dasharray:none;stroke-width:1.2}.bp .nb{fill:var(--adim);font-size:9px;letter-spacing:.1em}
#arsenal .evd{font-size:12.5px!important;color:var(--adim)}#arsenal .evd b{font-family:var(--mono);font-weight:500;font-size:9.5px;letter-spacing:.12em;color:var(--aln);margin-right:6px}
.bp .sh{fill:none;stroke:var(--adim);stroke-width:.55}.bp .sh.hi{stroke-dasharray:2 3}.bp .sm{fill:none;stroke:var(--aln);stroke-width:.7;opacity:.85}.bp .hg{fill:none;stroke:var(--aln);stroke-width:.7;stroke-dasharray:3 2}.bp circle.rt{fill:var(--aln);stroke:none}.bp .dt{fill:var(--abg);stroke:var(--aln);stroke-width:.9}.bp .dt.win{fill:var(--agrid)}.bp .hx{fill:url(#hx);color:var(--aln)}.bp .cav{fill:none;stroke:var(--adim);stroke-dasharray:3 2;stroke-width:.8}.bp .in.fill .b{fill:url(#hx);color:var(--aln)}.bp.ex .in.fill .b{fill:url(#hx)}.bp .secA{transition:opacity .4s}.bp.ex .secA{opacity:0}
.bpx .hx{fill:url(#hx2);color:var(--aln);stroke:none}.bpx .cutbg{fill:var(--abg);stroke:none}.bpx .tk{fill:var(--apan)}.bpx .fin{fill:var(--apan);stroke-width:1.1}
.bpx .sta line{stroke:var(--adim);stroke-width:.7}.bpx .sta text{fill:var(--adim);font-size:8.5px}
.bpx .tblock rect,.bpx .tblock line{fill:none;stroke:var(--adim);stroke-width:.8}.bpx .tblock text{fill:var(--aln);font-size:9px;letter-spacing:.1em}
.bpx .asm{transition:opacity .4s}.bpx.ex .asm{opacity:0}
.bp .tb{fill:var(--adim);font-size:8.5px;letter-spacing:.12em}
#arsenal .wph{margin:10px 0 0;display:grid;grid-template-columns:minmax(0,320px) 1fr;gap:12px;align-items:end}#arsenal .wph img{width:100%;display:block;filter:grayscale(1) contrast(1.1);border:1px solid var(--adim)}#arsenal .wph figcaption{font-family:var(--mono);font-size:9px;color:var(--adim);line-height:1.4}
#arsenal .sum{font-size:15.5px;line-height:1.6;max-width:72ch;margin:14px 0 6px}
#arsenal h3{font-family:var(--mono);font-weight:500;font-size:10.5px;letter-spacing:.16em;margin:28px 0 10px;padding-top:8px;border-top:1px solid var(--adim)}
#arsenal .cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:0 34px}
#arsenal .spec{margin:0;display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--adim);border-left:1px solid var(--adim)}
#arsenal .spec div{border-right:1px solid var(--adim);border-bottom:1px solid var(--adim);padding:6px 9px 8px;min-width:0}
#arsenal .spec dt{font-family:var(--mono);font-size:8.5px;letter-spacing:.14em;color:var(--adim);text-transform:uppercase}#arsenal .spec dd{margin:3px 0 0;font-size:13.5px;overflow-wrap:anywhere}
#arsenal ul.mk{list-style:none;margin:0;padding:0}#arsenal ul.mk li{display:flex;justify-content:space-between;gap:12px;padding:6px 0;border-bottom:1px solid var(--agrid);font-size:13.5px}
#arsenal ul.mk button{color:var(--aacc);text-align:left;font-size:13.5px}#arsenal ul.mk em{font-style:normal;font-family:var(--mono);font-size:10px;color:var(--adim);text-align:right}
#arsenal .tr{font-size:13px;line-height:1.5;color:var(--aln)}
#arsenal .evl{display:grid;gap:0}
#arsenal .ev{position:relative}
#arsenal .evpic{grid-column:2;width:min(240px,78%);margin:4px 0 6px 6px;padding:6px 6px 8px;background:var(--abg);border:1px solid var(--aln);transform:rotate(var(--r));position:relative}
#arsenal .evpic img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover}#arsenal .evpic figcaption{font-family:var(--mono);font-size:8.5px;line-height:1.4;color:var(--aln);margin-top:5px}#arsenal .evpic .cr{display:block;font-size:7.5px;color:var(--adim);text-decoration:none;overflow-wrap:anywhere}#arsenal .evpic figcaption b{color:var(--aacc);font-weight:500;margin-right:4px}
@media (min-width:1180px){
 #arsenal .evpage.evpage{max-width:1560px}#arsenal .evl .ev{border-bottom-color:var(--agrid)}#arsenal .ev .toll{max-width:680px}
 #arsenal .evl .ev{grid-template-columns:120px minmax(0,680px) minmax(300px,1fr)}
 #arsenal .evpic{display:block;grid-column:3;justify-self:start;align-self:start;position:relative;width:300px;max-width:calc(100% - 40px);margin:var(--dy) 0 10px 80px;padding:8px 8px 10px;background:var(--abg);border:1px solid var(--aln);transform:rotate(var(--r));box-shadow:0 14px 34px rgba(0,0,0,.45)}
 #arsenal .evpic img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;filter:grayscale(.35) contrast(1.05)}
 #arsenal .evpic figcaption{font-family:var(--mono);font-size:9px;line-height:1.4;letter-spacing:.04em;color:var(--aln);margin-top:6px}
 #arsenal .evpic figcaption b{color:var(--aacc);font-weight:500;margin-right:4px}
 #arsenal .evpic .cr{display:block;font-size:7.5px;color:var(--adim);margin-top:3px;text-decoration:none;overflow-wrap:anywhere}
 #arsenal .evpic .pin{position:absolute;top:-5px;left:50%;width:9px;height:9px;border:1px solid var(--aacc);border-radius:50%;background:var(--abg);transform:translateX(-50%)}
 #arsenal .ev .ldr{position:absolute;height:0;border-top:1px dashed var(--aacc);opacity:.8;pointer-events:none}#arsenal .ev .ldr:before{content:"";position:absolute;left:-3px;top:-3px;width:5px;height:5px;border-radius:50%;background:var(--aacc)}
}
#arsenal .ev{display:grid;grid-template-columns:120px minmax(0,1fr);gap:16px;padding:14px 0;border-bottom:1px solid var(--agrid)}
#arsenal .ev .d{font-family:var(--mono);font-size:12px;display:flex;flex-direction:column;gap:4px}#arsenal .ev .d span{font-size:9.5px;letter-spacing:.12em;color:var(--aacc)}
#arsenal .ev h4{margin:0 0 2px;font-size:17px;font-weight:500}#arsenal .ev .pl{font-family:var(--mono);font-size:10.5px;color:var(--adim)}
#arsenal .ev .toll{margin:8px 0 2px;font-size:13px}#arsenal .ev .toll b{font-size:20px;font-weight:500;color:var(--aacc)}#arsenal .ev .toll i{font-style:normal;color:var(--adim);font-size:11px}
#arsenal .ev p{font-size:14px;line-height:1.55;max-width:70ch;margin:6px 0}
#arsenal .wc{display:flex;flex-wrap:wrap;gap:4px;align-items:center}#arsenal .wc button{font-family:var(--mono);font-size:10px;letter-spacing:.04em;border:1px solid var(--aln);color:var(--aln);padding:2px 7px}
#arsenal .wc button:hover{background:var(--aln);color:var(--abg)}#arsenal .wc .st{font-family:var(--mono);font-size:9.5px;color:var(--adim);margin-left:6px}
#arsenal .srcs{font-size:11px;color:var(--adim);margin-top:6px}#arsenal .srcs a{color:var(--adim)}
#arsenal .none,#arsenal .empty{color:var(--adim);font-size:13px}#arsenal .empty{padding:60px 20px;font-family:var(--mono)}
#arsenal .evpage{padding:22px clamp(16px,3vw,40px) 60px;max-width:1100px}#arsenal .intro2 p{max-width:66ch;font-size:15px;line-height:1.55;color:var(--aln)}
.arsbtn{display:grid;grid-template-columns:44px 1fr;gap:10px;align-items:center;width:100%;text-align:left;margin-top:10px;padding:6px 10px;border:1px solid var(--line);background:#0c0c0b;color:#e9e6dc;background-image:linear-gradient(rgba(233,230,220,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(233,230,220,.05) 1px,transparent 1px);background-size:8px 8px}
.arsbtn{animation:arsglow 3.6s ease-in-out infinite}@keyframes arsglow{0%,100%{box-shadow:0 0 0 1px rgba(232,255,0,.22),0 0 12px rgba(232,255,0,.2)}50%{box-shadow:0 0 0 1px rgba(232,255,0,.5),0 0 24px rgba(232,255,0,.38)}}@media (prefers-reduced-motion:reduce){.arsbtn{animation:none;box-shadow:0 0 0 1px rgba(232,255,0,.35),0 0 18px rgba(232,255,0,.28)}}
.arsbtn:hover{border-color:#e9e6dc}.arsbtn svg{width:44px;height:16px}.arsbtn b{display:inline;font-family:var(--mono);font-weight:500;font-size:10.5px;letter-spacing:.24em;margin-right:8px}.arsbtn span{font-size:10.5px;opacity:.6}
.file.special .tab:before{border-color:var(--signal);background:#1a1800}.file.special{color:var(--signal)}.file.special[aria-pressed=true] .tab:before{background:var(--signal)}.file.special[aria-pressed=true]{color:#0a0a0a}
@media (max-width:900px){#arsenal .wpage{grid-template-columns:1fr}#arsenal .wl{position:static;max-height:none;border-right:0;border-bottom:1px solid var(--adim);display:flex;overflow-x:auto;padding:10px 0}#arsenal .grp{flex:0 0 auto;margin:0}#arsenal .grp h4{display:none}#arsenal .wl button{white-space:nowrap;padding:5px 12px}#arsenal .wl button span{display:none}#arsenal .ev{grid-template-columns:1fr;gap:4px}#arsenal .spec{grid-template-columns:1fr}}
/* slide-out photo tab, attached to the left edge of the dossier */
#photo{position:absolute;right:360px;top:96px;z-index:3;display:flex;align-items:flex-start;transition:transform .5s cubic-bezier(.2,.8,.2,1),opacity .4s}
#photo.tucked{transform:translateX(128px)}#photo .card{transition:opacity .45s,transform .5s}#photo.tucked .card{opacity:0;pointer-events:none}
#photo .card{width:128px;background:#d8ceb2;color:#1b1a16;padding:10px 10px 12px;box-shadow:0 12px 40px rgba(0,0,0,.6);position:relative;transform:rotate(-1.5deg)}
#photo .clip{position:absolute;top:-14px;left:22px;width:16px;height:40px;border:2px solid #9a9a96;border-radius:9px;border-bottom-color:transparent}
#photo .lab{font-family:var(--mono);font-size:9px;letter-spacing:.08em;display:flex;justify-content:space-between;margin-bottom:6px}
#photo .pic{aspect-ratio:35/45;background:#2a2926;overflow:hidden;display:grid;place-items:center;position:relative}
#photo .pic img{width:100%;height:100%;object-fit:cover;display:block}
#photo .pic.person img{filter:grayscale(1) contrast(1.15) brightness(.95)}
#photo .pic svg{width:100%;height:100%;display:block}
#photo .nm{font-family:var(--mono);font-size:9.5px;letter-spacing:.06em;margin-top:7px;text-transform:uppercase;line-height:1.35}
#photo .cr,#report .dpic .cr{display:block;font-family:var(--mono);font-size:7px;line-height:1.3;letter-spacing:.02em;color:#5d5b54;margin-top:4px;text-decoration:none;overflow-wrap:anywhere}
#photo .stamp{position:absolute;right:8px;top:118px;font-family:var(--mono);font-size:8.5px;letter-spacing:.1em;color:var(--red);border:1px solid var(--red);padding:1px 4px;transform:rotate(-8deg);opacity:.85;background:rgba(216,206,178,.6)}
#photo .arrow{width:18px;height:46px;margin-top:22px;background:#d8ceb2;color:#1b1a16;font-family:var(--mono);font-size:12px;display:grid;place-items:center;border-radius:3px 0 0 3px;order:-1}
#photo.tucked .arrow{transform:rotate(180deg);border-radius:0 3px 3px 0}
/* case-file paper peeking out from the rail */
#paperwrap{position:absolute;left:224px;top:150px;width:230px;height:300px;overflow:hidden;z-index:4;pointer-events:none}
#paper{position:absolute;left:0;top:10px;width:200px;height:260px;background:var(--paper);color:var(--ink);padding:14px 14px;transform:translateX(-180px) rotate(-2deg);transition:transform .45s cubic-bezier(.2,.8,.2,1);pointer-events:auto;text-align:left;box-shadow:6px 8px 30px rgba(0,0,0,.6)}
#paper:hover,#paper:focus-visible{transform:translateX(-24px) rotate(-1deg)}
#paper .k{font-family:var(--mono);font-size:9px;letter-spacing:.1em;color:var(--ink2)}
#paper .t{font-size:16px;line-height:1.15;margin:8px 0;font-weight:500;padding-right:30px}
#paper .lines{height:90px;background:repeating-linear-gradient(var(--paper) 0 9px,#cfcdc3 9px 10px);margin:8px 0;padding-right:30px}
#paper .go{font-family:var(--mono);font-size:9.5px;letter-spacing:.1em;color:var(--red)}
#paper .edge{position:absolute;right:6px;top:14px;writing-mode:vertical-rl;font-family:var(--mono);font-size:9px;letter-spacing:.14em;color:var(--red)}
/* case-file report: a paper document over the map */
#report{position:absolute;inset:0;z-index:9;background:rgba(5,5,5,.86);overflow:auto;overscroll-behavior:contain;padding:70px 16px 60px;backdrop-filter:blur(2px)}#report.solid{background:#050505;backdrop-filter:none}#caselist{overscroll-behavior:contain}
#report .doc{--pp:#e7e2d3;--pp2:#d9d3c1;--hi:var(--signal);--rule2:rgba(20,20,18,.2);max-width:880px;margin:0 auto;background:var(--pp);color:var(--ink);padding:30px clamp(18px,5vw,60px) 56px;position:relative;box-shadow:0 30px 80px rgba(0,0,0,.7)}
#report .x{position:fixed;top:14px;right:14px;font-family:var(--mono);font-size:11px;letter-spacing:.1em;color:var(--fg);z-index:10;background:#141412;border:1px solid #3a3a36;padding:7px 11px}
#report .hd{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px 12px;font-family:var(--mono);font-size:10px;letter-spacing:.12em;color:var(--ink2);padding-bottom:10px}
#report .dossier{position:relative;display:grid;grid-template-columns:1fr;gap:16px;border:1.5px solid var(--ink);padding:26px 16px 14px;margin-top:14px}
#report .dossier.withpic{grid-template-columns:120px 1fr}
#report .tabno{position:absolute;top:-1px;left:-1px;background:var(--ink);color:var(--pp);font-family:var(--mono);font-size:11px;letter-spacing:.12em;padding:4px 10px 4px 8px}
#report .tabno::after{content:"";position:absolute;right:-26px;top:0;width:26px;height:100%;background:var(--signal)}
#report .dpic{position:relative;background:#d8ceb2;padding:8px;transform:rotate(-1.5deg);box-shadow:0 4px 14px rgba(0,0,0,.25);align-self:start}
#report .dpic .clip{position:absolute;top:-12px;left:18px;width:14px;height:34px;border:2px solid #77766f;border-radius:8px;border-bottom-color:transparent}
#report .dpic .pic{aspect-ratio:35/45;background:#2a2926;overflow:hidden}#report .dpic .pic svg,#report .dpic .pic img{width:100%;height:100%;display:block;object-fit:cover}#report .dpic img.person{filter:grayscale(1) contrast(1.15)}
#report .fields{margin:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--ink);border-left:1px solid var(--ink);align-self:start}
#report .fields div{border-right:1px solid var(--ink);border-bottom:1px solid var(--ink);padding:5px 8px 7px;min-width:0}
#report .fields .wide{grid-column:1/-1}
#report .fields dt{font-family:var(--mono);font-size:8.5px;letter-spacing:.14em;color:var(--ink2)}
#report .fields dd{margin:2px 0 0;font-family:var(--mono);font-size:12.5px;letter-spacing:.02em;overflow-wrap:anywhere}
#report .fields .wide dd{font-size:15px}
#report h1{font-weight:500;font-size:clamp(30px,5vw,50px);letter-spacing:-.02em;line-height:1.02;margin:30px 0 14px;text-wrap:balance}
#report h1 mark{background:linear-gradient(transparent 58%,var(--hi) 58%);color:inherit;box-decoration-break:clone;-webkit-box-decoration-break:clone}
#report .dek{font-size:17px;line-height:1.5;max-width:62ch;margin:0 0 22px}
#report h2{font-family:var(--mono);font-weight:500;font-size:11px;letter-spacing:.16em;margin:38px 0 14px;padding:6px 0 0;border-top:2px solid var(--ink);display:flex;justify-content:space-between;gap:12px}
#report h3{font-size:19px;font-weight:600;letter-spacing:-.01em;margin:24px 0 6px;text-wrap:balance}
#report .kf{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:4px;margin-top:6px}
#report .kf div{padding:12px 12px 14px;min-height:96px;display:flex;flex-direction:column;justify-content:space-between;gap:10px;background:var(--ink);color:var(--pp)}
#report .kf div:nth-child(4n+2){background:var(--signal);color:var(--ink)}
#report .kf div:nth-child(4n+3){background:#6f7a00;color:#f4f6d8}
#report .kf div:nth-child(4n+4){background:var(--pp2);color:var(--ink)}
#report .kf b{display:block;font-size:28px;font-weight:500;font-variant-numeric:tabular-nums;letter-spacing:-.01em;line-height:1}
#report .kf span{font-family:var(--mono);font-size:9.5px;letter-spacing:.06em;text-transform:uppercase;line-height:1.4;opacity:.9}
#report p{font-size:15.5px;line-height:1.62;max-width:66ch}
#report p.fn{font-family:var(--mono);font-size:10px;letter-spacing:.04em;margin-top:-6px}#report p.fn a{text-decoration:none;color:var(--ink2)}
#report p.cap{font-family:var(--mono);font-size:10px;color:var(--ink2);margin-top:6px}
#report blockquote{margin:22px 0;padding:4px 0 4px 18px;border-left:6px solid var(--hi)}
#report blockquote p{font-size:20px;line-height:1.4;font-weight:500;margin:0 0 6px}
#report blockquote cite{font-family:var(--mono);font-size:10px;letter-spacing:.08em;font-style:normal;color:var(--ink2);text-transform:uppercase}
#report .chart{overflow-x:auto}
#report .chart svg{display:block;max-width:100%;height:auto}
#report .bkey{display:flex;flex-wrap:wrap;gap:4px 14px;margin-top:8px;font-size:12px}#report .bkey i{display:inline-block;width:10px;height:10px;margin-right:5px;vertical-align:-1px}#report .bkey b{font-family:var(--mono);font-weight:400;font-size:11px}
#report .chain{list-style:none;margin:0;padding:0;display:grid;gap:0}
#report .chain li{display:grid;grid-template-columns:52px 1fr;gap:14px;position:relative;padding-bottom:18px}
#report .chain li::before{content:"";position:absolute;left:25px;top:44px;bottom:0;width:1.5px;background:var(--ink)}
#report .chain li:last-child::before{display:none}
#report .chain .n{width:52px;height:44px;display:grid;place-items:center;background:var(--ink);color:var(--pp);font-family:var(--mono);font-size:15px;letter-spacing:.05em}
#report .chain li:nth-child(odd) .n{background:var(--signal);color:var(--ink)}
#report .chain h4{margin:2px 0 4px;font-size:17px;font-weight:600}
#report .chain p{margin:0 0 8px;font-size:14.5px}
#report .chips{display:flex;flex-wrap:wrap;gap:4px}
#report .chips span{font-family:var(--mono);font-size:10px;letter-spacing:.04em;padding:2px 6px;border:1px solid var(--ink)}
#report .chips .sys{background:var(--ink);color:var(--pp)}
#report table{width:100%;border-collapse:collapse;font-size:12.5px}
#report th{font-family:var(--mono);font-weight:400;font-size:9.5px;letter-spacing:.1em;color:var(--ink2);text-align:left;border-bottom:1px solid var(--ink);padding:5px 8px 5px 0}
#report td{border-bottom:1px solid var(--rule2);padding:6px 8px 6px 0;vertical-align:top}
#report td.v{font-family:var(--mono);text-align:right;white-space:nowrap}
#report a{color:var(--ink);text-underline-offset:3px}
#report .pending{border:1px dashed var(--ink2);padding:14px 16px;font-family:var(--mono);font-size:11px;letter-spacing:.04em;color:var(--ink2);line-height:1.6}
#report .src{font-size:12px;line-height:1.5;color:var(--ink2);padding-left:22px;margin:0}#report .src li{margin-bottom:3px}
#report .tblwrap{overflow-x:auto}
@media (max-width:600px){#report .kf{grid-template-columns:repeat(2,minmax(0,1fr))}#report .kf div{min-height:84px}#report .fields{grid-template-columns:repeat(2,minmax(0,1fr))}#report .dossier.withpic{grid-template-columns:84px 1fr}#report .kf b{font-size:22px}}
#report .doc{overflow:visible}
#report .hd .dl{font:inherit;font-size:9.5px;letter-spacing:.14em;color:var(--ink);border:1px solid var(--ink);padding:4px 9px}#report .hd .dl:hover{background:var(--ink);color:var(--pp)}
#report .spine{position:absolute;top:120px;bottom:60px;right:-30px;width:30px;pointer-events:none}
#report .spine div{position:sticky;top:90px;filter:drop-shadow(5px 6px 8px rgba(0,0,0,.4));color:var(--ink);writing-mode:vertical-rl;padding:18px 0 20px;width:30px;display:flex;align-items:center;gap:12px;font-family:var(--mono);font-size:9px;letter-spacing:.2em;isolation:isolate}
#report .spine div::before{content:"";position:absolute;inset:0;background:var(--pp);border-radius:0 7px 7px 0;clip-path:polygon(0 0,100% 9px,100% calc(100% - 9px),0 100%);z-index:-1}
#report .spine b{font-weight:500;color:var(--ink);background:linear-gradient(90deg,transparent 22%,var(--signal) 22%,var(--signal) 78%,transparent 78%);padding:4px 0}
#report .wanted{grid-column:1/-1;display:grid;grid-template-columns:auto 1fr;align-items:center;gap:4px 18px;border:4px solid #c8102e;color:#c8102e;padding:8px 16px 10px;transform:rotate(-1.2deg);margin:6px 4px 2px;background:repeating-linear-gradient(135deg,transparent 0 9px,rgba(200,16,46,.05) 9px 10px)}
#report .wanted b{grid-row:span 2;font-family:var(--sans);font-weight:800;font-size:clamp(46px,9vw,84px);letter-spacing:.06em;line-height:.9}
#report .wanted span{font-family:var(--mono);font-size:11.5px;letter-spacing:.12em;font-weight:500}
#report .wanted i{font-style:normal;font-family:var(--mono);font-size:10.5px;letter-spacing:.04em;line-height:1.45;color:#7d0b1d}
#report .rs{position:relative}
#report .sn{font-family:var(--mono);font-size:10px;letter-spacing:.16em;color:var(--ink2);margin:28px 0 -14px}
#report .sn::after{content:"";display:inline-block;width:38px;height:6px;background:var(--signal);margin-left:10px;vertical-align:middle}
#report p.dc::first-letter{float:left;font-size:58px;line-height:.86;font-weight:600;padding:6px 10px 0 0;color:var(--ink);text-shadow:4px 4px 0 var(--signal)}
#report .inter{margin:30px 0;display:grid;grid-template-columns:150px 1fr;gap:18px;align-items:end;border-top:1px solid var(--ink);border-bottom:1px solid var(--ink);padding:14px 0}
#report .inter .ph{aspect-ratio:35/45;background:#2a2926;overflow:hidden;filter:grayscale(1) contrast(1.08)}#report .inter .ph img,#report .inter .ph svg{width:100%;height:100%;object-fit:cover;display:block}
#report .inter figcaption{font-family:var(--mono);font-size:10px;letter-spacing:.06em;line-height:1.5;color:var(--ink2);display:grid;gap:4px}
#report .inter figcaption b{font-family:var(--sans);font-size:22px;font-weight:600;letter-spacing:-.01em;color:var(--ink);cursor:pointer;background:linear-gradient(transparent 62%,var(--signal) 62%);justify-self:start}
#report .inter .cr{color:var(--ink2);font-size:8px;text-decoration:none}
#report blockquote{font-size:inherit}#report blockquote p{font-size:clamp(20px,3vw,26px);line-height:1.3;max-width:30ch}
#report .brk{display:flex;align-items:center;gap:12px;margin:30px 0 8px;font-family:var(--mono);font-size:9px;letter-spacing:.2em;color:var(--ink2)}#report .brk::before,#report .brk::after{content:"";flex:1;height:1px;background:var(--rule2)}
#report blockquote.lead{border:0;padding:18px 0 22px;margin:8px 0 26px;border-top:2px solid var(--ink);border-bottom:2px solid var(--ink)}#report blockquote.lead p{font-size:clamp(30px,5.4vw,52px);line-height:1.04;font-weight:600;letter-spacing:-.02em;max-width:none;background:linear-gradient(transparent 70%,var(--signal) 70%);display:inline;box-decoration-break:clone;-webkit-box-decoration-break:clone}#report blockquote.lead cite{display:block;margin-top:14px}
#report .endmark{margin-top:36px;padding-top:10px;border-top:2px solid var(--ink);font-family:var(--mono);font-size:10px;letter-spacing:.2em;text-align:center}
#report .rv{opacity:0;transform:translateY(10px);transition:opacity .45s ease,transform .45s cubic-bezier(.2,.7,.2,1)}
#report .rv.in{opacity:1;transform:none}
#report .chart.rv svg rect{transform-box:fill-box;transform-origin:left center;transform:scaleX(0);transition:transform .9s cubic-bezier(.2,.7,.2,1)}
#report .chart.rv.in svg rect{transform:scaleX(1)}
#report .chart.rv svg path{opacity:0;transition:opacity .9s ease}#report .chart.rv.in svg path{opacity:1}
@media (prefers-reduced-motion:reduce){#report .rv,#report .chart.rv svg rect,#report .chart.rv svg path{opacity:1;transform:none;transition:none}}
@media (max-width:1000px){#report .spine{right:0;width:22px}#report .spine div{width:22px;font-size:8px}#report .doc{padding-right:clamp(34px,6vw,60px)}}
@media (max-width:600px){#report .inter{grid-template-columns:96px 1fr}#report .inter figcaption b{font-size:18px}#report .wanted{grid-template-columns:1fr}#report .wanted b{grid-row:auto}}
.legend-line .inh{width:26px;height:6px;flex:none}
#railtoggle,#dossiertoggle{display:none}
@media (max-width:900px){
  header{grid-template-columns:1fr auto;padding:12px 16px}
  .searchwrap{grid-column:1/3;grid-row:2;justify-self:stretch;width:100%}
  #rail{display:none;background:rgba(8,8,8,.96);width:min(280px,86vw);top:100px;bottom:0;padding-bottom:80px}
  #rail.open{display:flex}
  #dossier{width:100%;top:auto;height:48%;bottom:calc(56px + env(safe-area-inset-bottom,0px));background:rgba(8,8,8,.96);border-top:1px solid var(--line);padding-bottom:20px}
  #dossier.collapsed{height:auto;max-height:46px;overflow:hidden}
  #ctrls{right:16px;top:116px;transform:none}
  #zoomlbl,#meta,#crumbs,#names{display:none}#backbtn{left:16px;top:calc(64px + env(safe-area-inset-top,0px))}
  #photo{display:none}
  #paperwrap{left:0;top:118px}
  #railtoggle{display:inline}
  #modes{bottom:calc(10px + env(safe-area-inset-bottom,0px))}
  nav.top{gap:12px}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}

/* ---------- phone layout: these rules apply only at 900px and narrower, desktop is untouched ---------- */
@media (max-width:900px){
  header{padding:12px 16px 12px;row-gap:12px;background:linear-gradient(var(--bg) 72%,rgba(8,8,8,0))}
  #app.intro header{background:none}
  .mark .tiny{display:none}
  .mark b{font-size:14px;line-height:18px}
  #backbtn{top:calc(100px + env(safe-area-inset-top,0px))}
  #ctrls{top:calc(100px + env(safe-area-inset-top,0px))}
  #zin,#zout,#zfull,#paperwrap{display:none}
  #modes{-webkit-mask-image:linear-gradient(90deg,#000 82%,transparent);mask-image:linear-gradient(90deg,#000 82%,transparent);left:16px;transform:none;max-width:calc(100% - 16px);padding-right:40px}
  #rail{top:calc(92px + env(safe-area-inset-top,0px));left:0;width:100%;background:var(--bg);z-index:9;border-top:1px solid var(--line);padding:14px 16px calc(40px + env(safe-area-inset-bottom,0px));overscroll-behavior:contain}
  #app:has(#rail.open) #modes,#app:has(#rail.open) #dossier,#app:has(#rail.open) #ctrls,#app:has(#rail.open) #backbtn{visibility:hidden}
  #dossier{height:56%;padding-top:0;border-radius:14px 14px 0 0;overscroll-behavior:contain;transition:height .3s ease,max-height .3s ease,top .3s ease}
  #dossier::before{content:"";display:block;position:sticky;top:0;z-index:2;height:24px;margin:0 -20px 2px;background:linear-gradient(#5b5b55,#5b5b55) center 10px/40px 4px no-repeat,linear-gradient(rgba(8,8,8,.98) 75%,rgba(8,8,8,0))}
  #dossier.collapsed{height:84px;max-height:84px;-webkit-mask-image:linear-gradient(#000 72%,transparent);mask-image:linear-gradient(#000 72%,transparent)}
  #dossier.collapsed h1{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:22px;margin:8px 0 0}
  #dossier.full{height:auto;max-height:none;top:calc(92px + env(safe-area-inset-top,0px));bottom:0;padding-bottom:calc(36px + env(safe-area-inset-bottom,0px))}
  #app:has(#dossier.full) #modes{opacity:0;pointer-events:none}
  #index table.idx th:nth-child(3),#index table.idx td:nth-child(3),#index table.idx th:nth-child(4),#index table.idx td:nth-child(4){display:none}
}
@media (max-width:600px){
  #report{padding:62px 0 40px}
  #report .spine{display:none}
  #report .doc{padding:24px 18px 44px}
  #report .chart svg.wide{min-width:620px;max-width:none}
}

/* ---------- phone page (760px and narrower): one long scroll, the map is only the backdrop of the opening screen ---------- */
#phone{display:none}
#app.ph>header,#app.ph #rail,#app.ph #modes,#app.ph #ctrls,#app.ph #names,#app.ph #backbtn,#app.ph #meta,#app.ph #zoomlbl,#app.ph #crumbs,#app.ph #photo,#app.ph #paperwrap,#app.ph #skip{display:none!important}
#app.ph #dossier{display:none}
#app.ph #phone:not([hidden]){display:block;position:absolute;inset:0;z-index:6;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;scrollbar-width:none}
#phone::-webkit-scrollbar{display:none}
#phone .phbar{position:sticky;top:0;z-index:3;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:calc(12px + env(safe-area-inset-top,0px)) 16px 12px;background:linear-gradient(var(--bg) 70%,rgba(8,8,8,0))}
#phone .phbar b,#phone .phfoot b{font-weight:500;font-size:14px;letter-spacing:.08em}
#phone .phbar b i,#phone .phfoot b i{font-style:normal;color:var(--signal)}
#phone .phbar nav{display:flex;gap:12px}
#phone .phbar nav button{font-family:var(--mono);font-size:10px;letter-spacing:.08em;color:var(--fg2);padding:6px 0}
#phone .phhero{height:calc(100svh - 48px);min-height:520px;display:flex;align-items:flex-end;pointer-events:none}
#phone .phhead{padding:0 16px 28px;pointer-events:auto;background:linear-gradient(rgba(8,8,8,0),rgba(8,8,8,.85) 30%);width:100%;box-sizing:border-box;padding-top:40px}
#phone .phhead h1{font-weight:400;font-size:clamp(34px,10vw,46px);line-height:1;letter-spacing:-.02em;margin:8px 0 10px;text-wrap:balance}
#phone .phhead p{font-size:15px;line-height:1.45;color:var(--signal);margin:0 0 18px;max-width:30ch}
#phone .phdown{font-family:var(--mono);font-size:10px;letter-spacing:.14em;color:var(--fg2);border:1px solid var(--line);border-radius:999px;padding:8px 14px}
#phone .phbody{background:var(--bg);padding:8px 16px calc(40px + env(safe-area-inset-bottom,0px))}
#phone .phsec{padding:34px 0 30px;border-top:1px solid var(--line)}
#phone .phsec:first-child{border-top:0}
#phone .phh{display:flex;align-items:baseline;gap:12px;font-weight:400;font-size:28px;letter-spacing:-.015em;margin:0 0 16px;line-height:1.05}
#phone .phh span{font-family:var(--mono);font-size:11px;letter-spacing:.1em;color:var(--signal)}
#phone .phlede,#phone .phsec>p{font-size:15px;line-height:1.55;color:var(--fg);margin:0 0 14px}
#phone .phsec>p.phnote{font-size:13px;color:var(--fg3)}
#phone .stat3 b{font-size:28px}
#phone .moneystat b{font-size:34px}
#phone .mparts li{font-size:12.5px;line-height:1.35}
#phone ol.cl{list-style:none;margin:0 0 14px;padding:0;display:grid;gap:12px}
#phone .phmore{display:block;width:100%;font-family:var(--mono);font-size:11px;letter-spacing:.12em;color:var(--fg);border:1px solid var(--line);padding:14px;text-align:center}
#phone .pharsenal{display:grid;gap:8px;width:100%;text-align:left;padding:20px 18px;border:1px solid var(--adim,#4a5a2a);background:#0d1830;color:#e9eef8}
#phone .pharsenal b{font-family:var(--mono);font-weight:500;font-size:13px;letter-spacing:.3em}
#phone .pharsenal span{font-size:14px;line-height:1.5;color:#c7d0e2}
#phone .pharsenal em{font-style:normal;font-family:var(--mono);font-size:10.5px;letter-spacing:.12em;color:var(--signal)}
#phone #phq{width:100%;box-sizing:border-box;background:#050505;border:1px solid var(--line);color:var(--fg);font-size:16px;padding:12px 14px;border-radius:0;margin:0 0 12px}
#phone #phq:focus{outline:none;border-color:var(--signal)}
#phone .phchips{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;margin:0 -16px 12px;padding:0 16px}
#phone .phchips::-webkit-scrollbar{display:none}
#phone .phchips button{flex:0 0 auto;display:flex;align-items:center;gap:6px;font-family:var(--mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--fg2);border:1px solid var(--line);border-radius:999px;padding:7px 12px;white-space:nowrap}
#phone .phchips button i{width:7px;height:7px;border-radius:50%;display:block}
#phone .phchips button[aria-pressed="true"]{background:var(--fg);color:var(--bg);border-color:var(--fg)}
#phone .phcount{margin:0 0 6px}
#phone .phrow{display:grid;grid-template-columns:10px 1fr auto;gap:12px;align-items:center;width:100%;text-align:left;padding:13px 0;border-bottom:1px solid var(--rule)}
#phone .phrow i{width:9px;height:9px;border-radius:50%}
#phone .phrow .n{font-size:15.5px;line-height:1.25;min-width:0}
#phone .phrow .n small{display:block;font-size:12.5px;line-height:1.35;color:var(--fg3);margin-top:3px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
#phone .phrow .d{font-family:var(--mono);font-size:14px;color:var(--fg);text-align:right}
#phone .phrow .d small{display:block;font-size:8.5px;letter-spacing:.1em;color:var(--fg3)}
#phone #phlist{margin:0 0 16px}
#phone .phnone{color:var(--fg3);font-size:14px}
#phone .phcta{display:block;width:100%;font-family:var(--mono);font-size:12px;letter-spacing:.14em;background:var(--signal);color:#111;padding:16px}
#phone .phfoot{display:flex;justify-content:space-between;align-items:baseline;padding:24px 0 0;border-top:1px solid var(--line)}
#app.ph #dossier.page{display:block;position:absolute;inset:0;top:0;bottom:0;width:auto;height:auto;max-height:none;z-index:8;background:var(--bg);border:0;border-radius:0;padding:calc(58px + env(safe-area-inset-top,0px)) 18px calc(40px + env(safe-area-inset-bottom,0px));-webkit-mask-image:none;mask-image:none;overflow-y:auto}
#app.ph #dossier.page::before{display:none}
#app.ph #dossier.page h1{white-space:normal;font-size:34px}
#phback{display:none}
#app.ph #phback:not([hidden]){display:block;position:absolute;top:0;left:0;right:0;z-index:8;text-align:left;font-family:var(--mono);font-size:11px;letter-spacing:.12em;color:var(--fg);background:var(--bg);border-bottom:1px solid var(--line);padding:calc(14px + env(safe-area-inset-top,0px)) 16px 14px}
#app.ph #insp{z-index:10;left:16px!important;right:16px;width:auto}
#app.ph #index,#app.ph #caselist,#app.ph #tips{padding-top:calc(24px + env(safe-area-inset-top,0px))}

#app.ph #arsenal .wltog{display:grid;grid-template-columns:1fr auto;gap:4px 12px;width:100%;text-align:left;padding:14px 16px;border-bottom:1px solid var(--adim);color:var(--aln)}
#app.ph #arsenal .wltog span{grid-column:1/-1;font-family:var(--mono);font-size:10px;letter-spacing:.12em;opacity:.7}
#app.ph #arsenal .wltog b{font-weight:500;font-size:17px;line-height:1.25}
#app.ph #arsenal .wltog em{font-style:normal;font-family:var(--mono);font-size:10px;letter-spacing:.1em;align-self:center;white-space:nowrap;border:1px solid currentColor;padding:6px 9px}
#app.ph #arsenal .wl{display:none;overflow:visible;padding:4px 0 10px}
#app.ph #arsenal .wpage.open .wl{display:block}
#app.ph #arsenal .grp{margin:6px 0 10px}
#app.ph #arsenal .grp h4{display:flex;justify-content:space-between;margin:10px 16px 4px;font-family:var(--mono);font-weight:400;font-size:10px;letter-spacing:.12em;opacity:.7}
#app.ph #arsenal .wl button{white-space:normal;font-size:15px;padding:11px 16px;line-height:1.3}
#app.ph #arsenal .wl button span{display:inline}
#phone .pharsbtn{grid-template-columns:1fr;gap:14px;margin:0;padding:22px 18px 20px;animation:phglow 3s ease-in-out infinite}
#phone .pharsbtn svg{width:100%;height:58px}
#phone .pharsbtn b{display:block;font-size:14px;letter-spacing:.32em;margin:0 0 8px}
#phone .pharsbtn span{display:block;font-size:14px;line-height:1.5;opacity:.75}
#phone .pharsbtn em{display:block;margin-top:12px;font-style:normal;font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;color:var(--signal)}
@keyframes phglow{0%,100%{box-shadow:0 0 0 1px rgba(232,255,0,.35),0 0 18px rgba(232,255,0,.25)}50%{box-shadow:0 0 0 1px rgba(232,255,0,.75),0 0 38px rgba(232,255,0,.5)}}
@media (prefers-reduced-motion:reduce){#phone .pharsbtn{animation:none;box-shadow:0 0 0 1px rgba(232,255,0,.5),0 0 26px rgba(232,255,0,.35)}}
#phnote{display:none}
#app.ph #phnote:not([hidden]){display:flex;position:absolute;inset:0;z-index:12;align-items:flex-end;justify-content:center;background:rgba(5,5,5,.72);backdrop-filter:blur(3px);padding:16px 16px calc(20px + env(safe-area-inset-bottom,0px))}
#phnote .box{width:100%;max-width:440px;background:#0c0c0b;border:1px solid var(--signal);box-shadow:0 0 30px rgba(232,255,0,.25);padding:22px 20px 18px;display:grid;gap:12px;animation:phin .45s ease-out}
@keyframes phin{from{transform:translateY(24px);opacity:0}to{transform:none;opacity:1}}
#phnote h3{font-weight:400;font-size:26px;line-height:1.1;margin:0;letter-spacing:-.01em}
#phnote p{font-size:15px;line-height:1.5;margin:0;color:var(--fg)}
#phnote .url{display:flex;justify-content:space-between;align-items:center;gap:12px;border:1px solid var(--line);padding:10px 12px;font-family:var(--mono);font-size:13px;color:var(--signal)}
#phnote .url button{font-family:var(--mono);font-size:10px;letter-spacing:.1em;color:var(--fg);border:1px solid var(--line);padding:6px 9px}
#phnote .ok{font-family:var(--mono);font-size:11.5px;letter-spacing:.14em;background:var(--signal);color:#111;padding:14px}
</style>

<div id="app" class="intro">
  <canvas id="net" aria-label="Network map of entities and relationships" role="img"></canvas>

  <header>
    <div class="mark">
      <b>BL<i>0</i><i>0</i>D.MONEY</b>
      <span class="tiny">Database / 2026 · ongoing investigation</span>
