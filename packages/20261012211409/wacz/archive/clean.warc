      <input id="q" type="search" placeholder="Search entity, system, fund…" autocomplete="off" spellcheck="false" aria-label="Search the database">
      <div id="results" hidden></div>
    </div>
    <nav class="top" aria-label="Views">
      <button id="railtoggle" aria-expanded="false">FILES</button>
      <button data-view="map" aria-pressed="true">MAP</button>
