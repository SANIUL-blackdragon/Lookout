65","SRC-W0068","SRC-W0074","SRC-W0092","SRC-W0072","SRC-W0069","SRC-W0092","SRC-W0072","SRC-W0077","SRC-W0075","SRC-W0069","SRC-W0072","SRC-W0075","SRC-W0069","SRC-W0092","SRC-W0065","SRC-W0082","SRC-W0062","SRC-W0076","SRC-W0076","SRC-W0090","SRC-W0092","SRC-W0065","SRC-W0063","SRC-W0077","SRC-W0072","SRC-W0073","SRC-W0068","SRC-W0092","SRC-W0063","SRC-W0062","SRC-W0075","SRC-W0063","SRC-W0092","SRC-W0073","SRC-W0072","SRC-W0090","SRC-W0090","SRC-W0068","SRC-W0074","SRC-W0092","SRC-W0096","SRC-W0085","SRC-W0090","SRC-W0063","SRC-W0072","SRC-W0064","SRC-W0090","SRC-W0068","SRC-W0092","SRC-W0082","SRC-W0062","SRC-W0072","SRC-W0090","SRC-W0074","SRC-W0077","SRC-W0068","SRC-W0069","SRC-W0067"]},{"name":"Turbofan engine and tail","maker":"unattributed","start":0.75,"end":0.9,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0068","SRC-W0069","SRC-W0070","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0064","SRC-W0068","SRC-W0074","SRC-W0072","SRC-W0075","SRC-W0070","SRC-W0076","SRC-W0077","SRC-W0078","SRC-W0067","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0067","SRC-W0150","SRC-W0076","SRC-W0096","SRC-W0075","SRC-W0062","SRC-W0075","SRC-W0071","SRC-W0073","SRC-W0080","SRC-W0128","SRC-W0096","SRC-W0072","SRC-W0065","SRC-W0065","SRC-W0072","SRC-W0090","SRC-W0068","SRC-W0129"]},{"name":"Booster","maker":"unattributed","start":0.9,"end":1,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0068","SRC-W0069","SRC-W0070","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0064","SRC-W0068","SRC-W0074","SRC-W0072","SRC-W0075","SRC-W0070","SRC-W0076","SRC-W0077","SRC-W0078","SRC-W0067","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0067","SRC-W0150","SRC-W0076","SRC-W0096","SRC-W0075","SRC-W0062","SRC-W0075","SRC-W0071","SRC-W0073","SRC-W0080","SRC-W0128","SRC-W0096","SRC-W0072","SRC-W0065","SRC-W0065","SRC-W0072","SRC-W0090","SRC-W0068","SRC-W0129"]}],"summary":"The Tomahawk is RTX's Raytheon cruise missile, flying 1,600 km to hit fixed targets; a Block V cost about $2.5M in FY2026. It is a US weapon, used in the joint US-Israeli war on Iran that began on 28 February 2026. That morning a Tomahawk struck the Shajareh Tayyebeh elementary school in Minab, Hormozgan. Bellingcat and BBC Verify identified the missile in video, and debris included a satellite data link antenna stamped by Ball Aerospace, now owned by BAE Systems, plus a Raytheon electronics board and a Globe Motors motor (AOAV). Amnesty found the US responsible and reported at least 170 killed, most of them children. A preliminary US inquiry pointed to outdated target coordinates. Bellingcat's March 2026 review lists Tomahawks among the first US weapons fired at Iran.","transfers":[],"status":"documented"},{"id":"ARS-GBU57","name":"GBU-57A/B Massive Ordnance Penetrator","aka":["MOP"],"class":"bunker buster","form":"bomb","dims":{"length_m":6.2,"diameter_m":0.8,"span_m":null,"weight_kg":12304},"specs":[{"k":"Weight","v":"30,000-lb class; bomb body 12,304 kg","src":["SRC-W0155"]},{"k":"Explosive","v":"2,082 kg AFX-757 + 341 kg PBXN-114","src":["SRC-W0156"]},{"k":"Penetration","v":"estimated ~18 m of reinforced concrete or up to 60 m of earth","src":["SRC-W0156"]},{"k":"Guidance","v":"GPS-aided inertial navigation; smart fuze","src":["SRC-W0156"]},{"k":"Carrier","v":"B-2 Spirit only","src":["SRC-W0156"]},{"k":"June 2025 use","v":"12 on Fordow, 2 on Natanz (14 total)","src":["SRC-W0156"]}],"makers":[{"entity":"COM-00003","role":"prime / developer","src":["SRC-W0156"]},{"entity":"COM-00005","role":"carrier aircraft (B-2 Spirit)","src":["SRC-W0156"]}],"parts":[{"name":"Hardened penetrator body","maker":"COM-00003","start":0,"end":0.8,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0068","SRC-W0069","SRC-W0070","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0064","SRC-W0068","SRC-W0074","SRC-W0072","SRC-W0075","SRC-W0070","SRC-W0076","SRC-W0077","SRC-W0078","SRC-W0067","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0067","SRC-W0119","SRC-W0115","SRC-W0117","SRC-W0092","SRC-W0088","SRC-W0121","SRC-W0083","SRC-W0067","SRC-W0115","SRC-W0080","SRC-W0084","SRC-W0154","SRC-W0106"]},{"name":"Explosive fill (AFX-757 / PBXN-114)","maker":"unattributed","start":0.2,"end":0.7,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0068","SRC-W0069","SRC-W0070","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0064","SRC-W0068","SRC-W0074","SRC-W0072","SRC-W0075","SRC-W0070","SRC-W0076","SRC-W0077","SRC-W0078","SRC-W0067","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0067","SRC-W0119","SRC-W0115","SRC-W0117","SRC-W0092","SRC-W0088","SRC-W0121","SRC-W0083","SRC-W0067","SRC-W0115","SRC-W0080","SRC-W0084","SRC-W0154","SRC-W0106"]},{"name":"Guidance tail kit and fins","maker":"COM-00003","start":0.8,"end":1,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0068","SRC-W0069","SRC-W0070","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0064","SRC-W0068","SRC-W0074","SRC-W0072","SRC-W0075","SRC-W0070","SRC-W0076","SRC-W0077","SRC-W0078","SRC-W0067","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0067","SRC-W0119","SRC-W0115","SRC-W0117","SRC-W0092","SRC-W0088","SRC-W0121","SRC-W0083","SRC-W0067","SRC-W0115","SRC-W0080","SRC-W0084","SRC-W0154","SRC-W0106"]}],"summary":"The GBU-57 Massive Ordnance Penetrator is a 30,000-lb Boeing-developed bomb that only Northrop Grumman's B-2 bomber can carry, built to bore through rock and concrete before exploding. It is a US weapon, but its only combat use so far came inside Israel's war on Iran. On 22 June 2025 Iranian time, in Operation Midnight Hammer, US B-2s from Whiteman Air Force Base dropped a dozen on the Fordow enrichment plant, the Pentagon said, and two more on Natanz. The strike came nine days into Israel's bombing campaign and was coordinated with it. The sources reviewed give no casualty figure tied to the GBU-57 strikes themselves, so the event carries no toll. Its inclusion shows the US moving from supplying Israel's bombs to dropping its own in the same campaign.","transfers":[],"status":"documented"},{"id":"ARS-AR924","name":"Weaponized AR-924 pager","aka":["Gold Apollo-branded AR-924","BAC Consulting AR-924"],"class":"weaponized device","form":"device","dims":{"length_m":null,"diameter_m":null,"span_m":null,"weight_kg":0.056},"specs":[{"k":"Base device","v":"AR-924 pager, 56 g, one AAA battery (listed specs)","src":["SRC-W0157"]},{"k":"Explosive","v":"PETN concealed in the battery (about 3 g reported)","src":["SRC-W0158"]},{"k":"Order","v":"about 5,000 pagers ordered by Hezbollah (reported)","src":["SRC-W0158"]},{"k":"Brand","v":"Gold Apollo trademark, licensed to BAC Consulting (Budapest)","src":["SRC-W0159"]},{"k":"Purchase price / payment route","v":"not public; Gold Apollo said remittances were 'very strange' and came via the Middle East","src":["SRC-W0159"]},{"k":"Actual manufacturer","v":"unresolved; NYT reported BAC was a Mossad front (via Wikipedia)","src":["SRC-W0158"]}],"makers":[{"entity":"Gold Apollo (Taiwan)","role":"brand licensor only; says it did not design or make the device","src":["SRC-W0159"]},{"entity":"BAC Consulting Kft (Budapest)","role":"licensee named by Gold Apollo; reported intelligence front","src":["SRC-W0158"]}],"parts":[{"name":"Pager casing and electronics","maker":"unresolved","start":0,"end":0.6,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0071","SRC-W0071","SRC-W0071","SRC-W0070","SRC-W0072","SRC-W0069","SRC-W0105","SRC-W0068","SRC-W0065","SRC-W0063","SRC-W0072","SRC-W0069","SRC-W0078","SRC-W0070","SRC-W0082","SRC-W0076","SRC-W0096","SRC-W0067","SRC-W0069","SRC-W0068","SRC-W0071","SRC-W0065","SRC-W0067","SRC-W0071","SRC-W0076","SRC-W0077","SRC-W0090","SRC-W0074","SRC-W0092","SRC-W0069","SRC-W0068","SRC-W0071","SRC-W0065","SRC-W0067","SRC-W0078","SRC-W0076","SRC-W0090","SRC-W0074","SRC-W0092","SRC-W0075","SRC-W0064","SRC-W0076","SRC-W0090","SRC-W0090","SRC-W0076","SRC-W0092","SRC-W0065","SRC-W0075","SRC-W0094","SRC-W0065","SRC-W0092","SRC-W0072","SRC-W0063","SRC-W0092","SRC-W0074","SRC-W0072","SRC-W0074","SRC-W0092","SRC-W0069","SRC-W0076","SRC-W0063","SRC-W0092","SRC-W0096","SRC-W0075","SRC-W0073","SRC-W0068","SRC-W0092","SRC-W0064","SRC-W0075","SRC-W0078","SRC-W0068","SRC-W0077","SRC-W0065","SRC-W0092","SRC-W0085","SRC-W0065","SRC-W0068","SRC-W0074","SRC-W0092","SRC-W0072","SRC-W0069","SRC-W0092","SRC-W0090","SRC-W0068","SRC-W0091","SRC-W0075","SRC-W0069","SRC-W0076","SRC-W0069","SRC-W0092","SRC-W0068","SRC-W0104","SRC-W0064","SRC-W0090","SRC-W0076","SRC-W0065","SRC-W0072","SRC-W0076","SRC-W0069","SRC-W0092","SRC-W0101","SRC-W0108","SRC-W0086","SRC-W0087","SRC-W0088","SRC-W0086","SRC-W0089"]},{"name":"Battery pack with PETN charge and detonator","maker":"unresolved","start":0.6,"end":1,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0068","SRC-W0069","SRC-W0070","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0064","SRC-W0068","SRC-W0074","SRC-W0072","SRC-W0075","SRC-W0070","SRC-W0076","SRC-W0077","SRC-W0078","SRC-W0067","SRC-W0071","SRC-W0072","SRC-W0073","SRC-W0072","SRC-W0067","SRC-W0086","SRC-W0087","SRC-W0086","SRC-W0097","SRC-W0080","SRC-W0116","SRC-W0068","SRC-W0091","SRC-W0075","SRC-W0069","SRC-W0076","SRC-W0069","SRC-W0080","SRC-W0068","SRC-W0090","SRC-W0068","SRC-W0082","SRC-W0063","SRC-W0077","SRC-W0076","SRC-W0069","SRC-W0072","SRC-W0082","SRC-W0080","SRC-W0074","SRC-W0068","SRC-W0105","SRC-W0072","SRC-W0082","SRC-W0068","SRC-W0080","SRC-W0075","SRC-W0063","SRC-W0063","SRC-W0075","SRC-W0082","SRC-W0073","SRC-W0065"]}],"summary":"The weaponized AR-924 pager turned an everyday device into a bomb. Gold Apollo of Taiwan said the model was made and sold by its licensee BAC Consulting in Budapest and that it only licensed the brand; its president called BAC's payments 'very strange', routed through the Middle East. The New York Times later reported BAC was run as a front for Israeli intelligence. Explosives were hidden in the battery, reportedly about 3 g of PETN. On 17 September 2024 thousands of pagers exploded at once in homes, shops and streets across Lebanon; Al Jazeera, citing Lebanese figures, says at least 12 were killed and more than 3,000 wounded, children among them. UN human rights experts said the attacks violated international law because they could not distinguish civilians from fighters. The price, payment route and real manufacturer remain unresolved.","transfers":[{"date":"2024 (before Sept)","what":"about 5,000 AR-924 pagers acquired by Hezbollah (reported); price not public","value_usd":null,"src":"https://en.wikipedia.org/wiki/2024_Lebanon_electronic_device_attacks"}],"status":"reported"},{"id":"ARS-ICV82","name":"Weaponized IC-V82-labelled radio","aka":["Icom-branded walkie-talkie"],"class":"weaponized device","form":"device","dims":{"length_m":null,"diameter_m":null,"span_m":null,"weight_kg":null},"specs":[{"k":"Explosive","v":"PETN in the battery packs (Lebanese investigation, Reuters)","src":["SRC-W0160"]},{"k":"Branding","v":"Icom IC-V82 label; Icom said the model was discontinued and the devices were very likely not genuine (Reuters)","src":["SRC-W0160"]},{"k":"Quantity","v":"over 16,000 radios reportedly sold (unverified)","src":["SRC-W0158"]},{"k":"Attack date","v":"18 September 2024","src":["SRC-W0161"]}],"makers":[{"entity":"Icom (brand on device)","role":"brand only; manufacturer not established, Icom disowned the devices","src":["SRC-W0160"]}],"parts":[{"name":"Radio casing and electronics","maker":"unresolved","start":0,"end":0.55,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0071","SRC-W0071","SRC-W0071","SRC-W0070","SRC-W0077","SRC-W0068","SRC-W0085","SRC-W0063","SRC-W0068","SRC-W0077","SRC-W0065","SRC-W0070","SRC-W0082","SRC-W0076","SRC-W0096","SRC-W0067","SRC-W0071","SRC-W0076","SRC-W0077","SRC-W0090","SRC-W0074","SRC-W0067","SRC-W0096","SRC-W0072","SRC-W0074","SRC-W0074","SRC-W0090","SRC-W0068","SRC-W0092","SRC-W0068","SRC-W0075","SRC-W0065","SRC-W0063","SRC-W0067","SRC-W0091","SRC-W0075","SRC-W0063","SRC-W0063","SRC-W0068","SRC-W0077","SRC-W0072","SRC-W0068","SRC-W0065","SRC-W0092","SRC-W0071","SRC-W0075","SRC-W0090","SRC-W0073","SRC-W0072","SRC-W0068","SRC-W0092","SRC-W0063","SRC-W0075","SRC-W0090","SRC-W0073","SRC-W0072","SRC-W0068","SRC-W0065","SRC-W0092","SRC-W0063","SRC-W0062","SRC-W0075","SRC-W0063","SRC-W0092","SRC-W0068","SRC-W0104","SRC-W0064","SRC-W0090","SRC-W0076","SRC-W0074","SRC-W0068","SRC-W0074","SRC-W0092","SRC-W0090","SRC-W0068","SRC-W0091","SRC-W0075","SRC-W0069","SRC-W0076","SRC-W0069","SRC-W0092","SRC-W0071","SRC-W0068","SRC-W0077","SRC-W0068","SRC-W0092","SRC-W0090","SRC-W0075","SRC-W0082","SRC-W0068","SRC-W0074","SRC-W0092","SRC-W0071","SRC-W0072","SRC-W0063","SRC-W0062","SRC-W0092","SRC-W0064","SRC-W0068","SRC-W0063","SRC-W0069","SRC-W0092","SRC-W0090","SRC-W0068","SRC-W0091","SRC-W0075","SRC-W0069","SRC-W0068","SRC-W0065","SRC-W0068","SRC-W0092","SRC-W0086","SRC-W0087","SRC-W0086","SRC-W0097","SRC-W0092","SRC-W0087","SRC-W0102","SRC-W0092","SRC-W0086","SRC-W0087","SRC-W0067"]},{"name":"Battery pack with PETN","maker":"unresolved","start":0.55,"end":1,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0071","SRC-W0071","SRC-W0071","SRC-W0070","SRC-W0077","SRC-W0068","SRC-W0085","SRC-W0063","SRC-W0068","SRC-W0077","SRC-W0065","SRC-W0070","SRC-W0082","SRC-W0076","SRC-W0096","SRC-W0067","SRC-W0071","SRC-W0076","SRC-W0077","SRC-W0090","SRC-W0074","SRC-W0067","SRC-W0096","SRC-W0072","SRC-W0074","SRC-W0074","SRC-W0090","SRC-W0068","SRC-W0092","SRC-W0068","SRC-W0075","SRC-W0065","SRC-W0063","SRC-W0067","SRC-W0091","SRC-W0075","SRC-W0063","SRC-W0063","SRC-W0068","SRC-W0077","SRC-W0072","SRC-W0068","SRC-W0065","SRC-W0092","SRC-W0071","SRC-W0075","SRC-W0090","SRC-W0073","SRC-W0072","SRC-W0068","SRC-W0092","SRC-W0063","SRC-W0075","SRC-W0090","SRC-W0073","SRC-W0072","SRC-W0068","SRC-W0065","SRC-W0092","SRC-W0063","SRC-W0062","SRC-W0075","SRC-W0063","SRC-W0092","SRC-W0068","SRC-W0104","SRC-W0064","SRC-W0090","SRC-W0076","SRC-W0074","SRC-W0068","SRC-W0074","SRC-W0092","SRC-W0090","SRC-W0068","SRC-W0091","SRC-W0075","SRC-W0069","SRC-W0076","SRC-W0069","SRC-W0092","SRC-W0071","SRC-W0068","SRC-W0077","SRC-W0068","SRC-W0092","SRC-W0090","SRC-W0075","SRC-W0082","SRC-W0068","SRC-W0074","SRC-W0092","SRC-W0071","SRC-W0072","SRC-W0063","SRC-W0062","SRC-W0092","SRC-W0064","SRC-W0068","SRC-W0063","SRC-W0069","SRC-W0092","SRC-W0090","SRC-W0068","SRC-W0091","SRC-W0075","SRC-W0069","SRC-W0068","SRC-W0065","SRC-W0068","SRC-W0092","SRC-W0086","SRC-W0087","SRC-W0086","SRC-W0097","SRC-W0092","SRC-W0087","SRC-W0102","SRC-W0092","SRC-W0086","SRC-W0087","SRC-W0067"]}],"summary":"The second wave of the device attacks used hand-held radios labelled as Icom IC-V82s whose battery packs, according to Lebanon's preliminary investigation reported by Reuters, were laced with PETN. Icom said that model had been discontinued years earlier and that the exploded devices were very unlikely to be its own products, so the brand on the casing is not evidence of who made them; the real manufacturer is not established. On 18 September 2024 the radios blew up across Lebanon, including at funerals for people killed by the pagers the day before. Al Jazeera, citing Lebanese figures, reports 20 killed and more than 450 wounded. Over the two days, Time reported Lebanese Health Ministry figures of 37 killed and about 3,000 hospitalised. The card is kept separate from Icom to avoid implying the company made bombs.","transfers":[],"status":"reported"},{"id":"ARS-TMID0011","name":"ARES-TMID-0011 unidentified Israeli guided munition","aka":["ARES TMID-0011"],"class":"missile","form":"missile","dims":{"length_m":null,"diameter_m":0.145,"span_m":null,"weight_kg":null},"specs":[{"k":"Type","v":"turbojet-powered precision missile resembling a loitering munition or small cruise missile","src":["SRC-W0162"]},{"k":"Diameter","v":"about 135-155 mm","src":["SRC-W0162"]},{"k":"Payload","v":"about 40 kg; HE-fragmentation or shaped-charge warheads","src":["SRC-W0162"]},{"k":"Accuracy","v":"documented impacts about 30 cm apart","src":["SRC-W0162"]},{"k":"Seen","v":"Lebanon (Sept-Oct 2024, Mar 2026), Gaza (Mar 2025-Jan 2026), Iran (Mar 2026)","src":["SRC-W0162"]},{"k":"Manufacturer","v":"unknown","src":["SRC-W0162"]}],"makers":[{"entity":"unknown (Israeli)","role":"prime unknown","src":["SRC-W0162"]}],"parts":[{"name":"Seeker / nose","maker":"unknown","start":0,"end":0.15,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0075","SRC-W0077","SRC-W0096","SRC-W0075","SRC-W0096","SRC-W0068","SRC-W0069","SRC-W0063","SRC-W0077","SRC-W0068","SRC-W0065","SRC-W0068","SRC-W0075","SRC-W0077","SRC-W0082","SRC-W0062","SRC-W0070","SRC-W0082","SRC-W0076","SRC-W0096","SRC-W0067","SRC-W0085","SRC-W0069","SRC-W0072","SRC-W0074","SRC-W0068","SRC-W0069","SRC-W0063","SRC-W0072","SRC-W0093","SRC-W0072","SRC-W0068","SRC-W0074","SRC-W0092","SRC-W0072","SRC-W0065","SRC-W0077","SRC-W0075","SRC-W0068","SRC-W0090","SRC-W0072","SRC-W0092","SRC-W0096","SRC-W0085","SRC-W0069","SRC-W0072","SRC-W0063","SRC-W0072","SRC-W0076","SRC-W0069","SRC-W0092","SRC-W0074","SRC-W0076","SRC-W0082","SRC-W0085","SRC-W0096","SRC-W0068","SRC-W0069","SRC-W0063","SRC-W0068","SRC-W0074","SRC-W0092","SRC-W0072","SRC-W0069","SRC-W0092","SRC-W0090","SRC-W0068","SRC-W0091","SRC-W0075","SRC-W0069","SRC-W0076","SRC-W0069","SRC-W0092","SRC-W0078","SRC-W0075","SRC-W0103","SRC-W0075","SRC-W0092","SRC-W0072","SRC-W0077","SRC-W0075","SRC-W0069","SRC-W0067"]},{"name":"Warhead","maker":"unknown","start":0.15,"end":0.4,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0075","SRC-W0077","SRC-W0096","SRC-W0075","SRC-W0096","SRC-W0068","SRC-W0069","SRC-W0063","SRC-W0077","SRC-W0068","SRC-W0065","SRC-W0068","SRC-W0075","SRC-W0077","SRC-W0082","SRC-W0062","SRC-W0070","SRC-W0082","SRC-W0076","SRC-W0096","SRC-W0067","SRC-W0085","SRC-W0069","SRC-W0072","SRC-W0074","SRC-W0068","SRC-W0069","SRC-W0063","SRC-W0072","SRC-W0093","SRC-W0072","SRC-W0068","SRC-W0074","SRC-W0092","SRC-W0072","SRC-W0065","SRC-W0077","SRC-W0075","SRC-W0068","SRC-W0090","SRC-W0072","SRC-W0092","SRC-W0096","SRC-W0085","SRC-W0069","SRC-W0072","SRC-W0063","SRC-W0072","SRC-W0076","SRC-W0069","SRC-W0092","SRC-W0074","SRC-W0076","SRC-W0082","SRC-W0085","SRC-W0096","SRC-W0068","SRC-W0069","SRC-W0063","SRC-W0068","SRC-W0074","SRC-W0092","SRC-W0072","SRC-W0069","SRC-W0092","SRC-W0090","SRC-W0068","SRC-W0091","SRC-W0075","SRC-W0069","SRC-W0076","SRC-W0069","SRC-W0092","SRC-W0078","SRC-W0075","SRC-W0103","SRC-W0075","SRC-W0092","SRC-W0072","SRC-W0077","SRC-W0075","SRC-W0069","SRC-W0067"]},{"name":"Rotating wing assembly","maker":"unknown","start":0.4,"end":0.6,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0075","SRC-W0077","SRC-W0096","SRC-W0075","SRC-W0096","SRC-W0068","SRC-W0069","SRC-W0063","SRC-W0077","SRC-W0068","SRC-W0065","SRC-W0068","SRC-W0075","SRC-W0077","SRC-W0082","SRC-W0062","SRC-W0070","SRC-W0082","SRC-W0076","SRC-W0096","SRC-W0067","SRC-W0085","SRC-W0069","SRC-W0072","SRC-W0074","SRC-W0068","SRC-W0069","SRC-W0063","SRC-W0072","SRC-W0093","SRC-W0072","SRC-W0068","SRC-W0074","SRC-W0092","SRC-W0072","SRC-W0065","SRC-W0077","SRC-W0075","SRC-W0068","SRC-W0090","SRC-W0072","SRC-W0092","SRC-W0096","SRC-W0085","SRC-W0069","SRC-W0072","SRC-W0063","SRC-W0072","SRC-W0076","SRC-W0069","SRC-W0092","SRC-W0074","SRC-W0076","SRC-W0082","SRC-W0085","SRC-W0096","SRC-W0068","SRC-W0069","SRC-W0063","SRC-W0068","SRC-W0074","SRC-W0092","SRC-W0072","SRC-W0069","SRC-W0092","SRC-W0090","SRC-W0068","SRC-W0091","SRC-W0075","SRC-W0069","SRC-W0076","SRC-W0069","SRC-W0092","SRC-W0078","SRC-W0075","SRC-W0103","SRC-W0075","SRC-W0092","SRC-W0072","SRC-W0077","SRC-W0075","SRC-W0069","SRC-W0067"]},{"name":"Turbojet and control fins","maker":"unknown","start":0.6,"end":1,"note":"","src":["SRC-W0062","SRC-W0063","SRC-W0063","SRC-W0064","SRC-W0065","SRC-W0066","SRC-W0067","SRC-W0067","SRC-W0075","SRC-W0077","SRC-W0096","SRC-W0075","SRC-W0096","SRC-W0068","SRC-W0069","SRC-W0063","SRC-W0077","SRC-W0068","SRC-W0065","SRC-W0068","SRC-W0075","SRC-W0077","SRC-W0082","SRC-W0062","SRC-W0070","SRC-W0082","SRC-W0076","SRC-W0096","SRC-W0067","SRC-W0085","SRC-W0069","SRC-W0072","SRC-W0074","SRC-W0068","SRC-W0069","SRC-W0063","SRC-W0072","SRC-W0093","SRC-W0072","SRC-W0068","SRC-W0074","SRC-W0092","SRC-W0072","SRC-W0065","SRC-W0077","SRC-W0075","SRC-W0068","SRC-W0090","SRC-W0072","SRC-W0092","SRC-W0096","SRC-W0085","SRC-W0069","SRC-W0072","SRC-W0063","SRC-W0072","SRC-W0076","SRC-W0069","SRC-W0092","SRC-W0074","SRC-W0076","SRC-W0082","SRC-W0085","SRC-W0096","SRC-W0068","SRC-W0069","SRC-W0063","SRC-W0068","SRC-W0074","SRC-W0092","SRC-W0072","SRC-W0069","SRC-W0092","SRC-W0090","SRC-W0068","SRC-W0091","SRC-W0075","SRC-W0069","SRC-W0076","SRC-W0069","SRC-W0092","SRC-W0078","SRC-W0075","SRC-W0103","SRC-W0075","SRC-W0092","SRC-W0072","SRC-W0077","SRC-W0075","SRC-W0069","SRC-W0067"]}],"summary":"ARES-TMID-0011 is the temporary name Armament Research Services gave an Israeli guided munition nobody has publicly identified. It is a small turbojet-powered missile, 135-155 mm wide, with a rotating wing, about 40 kg of payload and either fragmentation or shaped-charge warheads. Its impacts have been documented about 30 cm apart. ARES reported in April 2026 that it had been found in Lebanon near Tripoli in September-October 2024 and at the Ramada Hotel strike in Beirut in March 2026, in Gaza from March 2025 to January 2026 in strikes on hospitals, schools and civilian buildings, and in Iran near the Imam Ali missile base in Khorramabad in March 2026. The maker is unknown. It is kept in the catalogue because the missing manufacturer is itself a finding: a weapon used across three fronts with no public supply chain.","transfers":[],"status":"documented"},{"id":"WPN-00016","name":"AIM-120 AMRAAM (procurement only)","aka":["AIM-120C-8"],"class":"missile","form":"missile","dims":{"length_m":null,"diameter_m":null,"span_m":null,"weight_kg":null},"specs":[{"k":"Type","v":"radar-guided air-to-air missile","src":["SRC-V0317"]},{"k":"Aug 2024 approval","v":"30 AIM-120C-8 for Israel, est. $102.5M (owner-verified DSCA notice; page returned 403 to us)","src":["SRC-V0317"]}],"makers":[{"entity":"COM-00001","role":"prime (Raytheon)","src":["SRC-V0317"]}],"parts":[],"summary":"The AIM-120 AMRAAM is Raytheon's radar-guided air-to-air missile. Per the owner's check of the DSCA notice, the US approved 30 AIM-120C-8s for Israel in August 2024, estimated at $102.5M. We found no investigation tying a specific AMRAAM to a strike in Gaza, Lebanon or Iran, so this card is procurement only and has no events attached. Its role is air control: air-to-air missiles protect the F-15s, F-16s and F-35s that drop the JDAM, Mk-80 and GBU-39 bombs documented at homes, schools and shelters in Gaza and Lebanon. On 28 September 2026 RTX announced a $20.7B five-year contract to raise AMRAAM output to what it called record levels, weeks after the 2026 US-Israeli war on Iran, a windfall for the maker even without strike evidence. Treat the quantity as an approval, not a confirmed delivery.","transfers":[{"date":"2024-08","what":"30 AIM-120C-8 approved (procurement; not a confirmed delivery)","value_usd":102500000,"src":"https://www.dsca.mil/sites/default/files/mas/Press%20Release%20-%20Israel%2024-08%20CN_0.pdf"},{"date":"2026-09-28","what":"$20.7B five-year US multi-year AMRAAM production contract to Raytheon (all customers; not Israel-specific)","value_usd":20700000000,"src":"https://raytheon.mediaroom.com/2026-09-28-RTXs-Raytheon-awarded-20-7-billion-multi-year-contract-for-AMRAAM-under-landmark-production-agreement"}],"status":"documented"}],"events":[{"id":"EVT-001","date":"2023-10-09","place":"Jabalia market, North Gaza","theatre":"Gaza","title":"Jabalia market strike","weapons":["WPN-00002","ARS-MK84"],"evidence":"OHCHR assessed from the destruction and ground subsidence that one or two GBU-31 2,000-lb bombs were likely used.","killed":42,"injured":null,"toll_note":"OHCHR verified at least 42 killed, including 14 children and one woman, and received information on 18 more deaths (OHCHR thematic report, June 2024).","summary":"An Israeli air strike on the crowded Jabalia market destroyed two multi-storey buildings and severely damaged many others. OHCHR, examining the attack as one of six emblematic strikes from the first weeks of the Gaza genocide, assessed that one or two GBU-31 bombs, a 2,000-lb Mk-84 body with a Boeing JDAM kit, were likely used. It verified 42 deaths, including 14 children, and received information on 18 more. OHCHR said attacks of this kind raise serious concerns under the laws of war on distinction and proportionality.","lat":31.531,"lon":34.483,"src":["SRC-W0163","SRC-W0164"],"status":"documented"},{"id":"EVT-002","date":"2023-10-10","place":"al-Najjar family home, Deir al-Balah","theatre":"Gaza","title":"al-Najjar family home","weapons":["WPN-00001"],"evidence":"Amnesty identified JDAM fragments from the rubble by their rivets, harness and a stamped Boeing-linked code (70P862352), manufactured in 2017; damage indicated a bomb of about 2,000 lb.","killed":24,"injured":null,"toll_note":"Amnesty (5 Dec 2023): 21 members of the al-Najjar family and three neighbours killed; nine children among the dead.","summary":"At about 8.30pm an Israeli air strike destroyed the al-Najjar family home in Deir al-Balah, in the south where Israel had told residents of the north to go. Twenty-one family members and three neighbours were killed. Amnesty found JDAM kit fragments in the rubble with a Boeing-linked code, a rare case where the US supply chain can be read off the debris. Amnesty said the strike should be investigated as a war crime and called for a halt to US arms transfers.","lat":31.417,"lon":34.351,"src":["SRC-V0253"],"status":"documented"},{"id":"EVT-003","date":"2023-10-22","place":"Abu Mu'eileq family homes, north of Deir al-Balah","theatre":"Gaza","title":"Abu Mu'eileq family homes","weapons":["WPN-00001"],"evidence":"Amnesty identified US-made JDAM fragments (code 70P862352, manufactured 2018); the bomb likely weighed at least 1,000 lb.","killed":19,"injured":null,"toll_note":"Amnesty (5 Dec 2023): 18 members of the Abu Mu'eileq family, 12 children and six women, plus a neighbour.","summary":"At about noon an air strike hit three houses belonging to three Abu Mu'eileq brothers north of Deir al-Balah. Eighteen family members, 12 of them children and six women, and their neighbour Rajab Ghazi Mezyed were killed. Amnesty traced JDAM parts from the rubble to the US; together with the al-Najjar strike, it documented 43 civilian deaths in the two JDAM cases and found no military target at either site.","lat":31.425,"lon":34.36,"src":["SRC-V0253"],"status":"documented"},{"id":"EVT-004","date":"2023-10-25","place":"Taj3 Tower, al-Yarmouk, Gaza City","theatre":"Gaza","title":"Taj3 Tower","weapons":["WPN-00002","ARS-MK84"],"evidence":"OHCHR assessed that several GBU-31 munitions were likely used.","killed":105,"injured":null,"toll_note":"OHCHR verified 105 killed, including 47 children and 32 women, and received information on seven more (OHCHR, June 2024).","summary":"An Israeli strike on the Taj3 residential tower in Gaza City flattened about 5,700 square metres, completely destroying seven structures, including the tower, and severely damaging three others. OHCHR assessed several GBU-31 2,000-lb guided bombs as likely used and verified 105 deaths, 47 of them children, the deadliest of the six emblematic strikes it examined. Its figures are minimums: OHCHR said the real toll of these attacks could be considerably higher.","lat":31.51,"lon":34.46,"src":["SRC-W0163","SRC-W0164"],"status":"documented"},{"id":"EVT-005","date":"2023-10-31","place":"Jabalia refugee camp, North Gaza","theatre":"Gaza","title":"Jabalia camp strike","weapons":["WPN-00001","ARS-MK80"],"evidence":"OHCHR assessed at least four GBU-32 (1,000-lb Mk-83 with JDAM) bombs, while the larger GBU-31 could not be ruled out.","killed":56,"injured":null,"toll_note":"OHCHR verified 56 killed, including 23 children and 12 women, and received information on 43 more (OHCHR, June 2024). Contemporary reports gave higher figures.","summary":"Israeli bombs struck a dense residential block in Jabalia refugee camp, destroying 10 structures, damaging at least 10 more and flattening about 2,500 square metres. OHCHR assessed at least four GBU-32 JDAM-guided bombs, and said the larger GBU-31 could not be ruled out. It verified 56 deaths, including 23 children, and received information on 43 more. OHCHR's account is a minimum; others gave higher tolls.","lat":31.535,"lon":34.495,"src":["SRC-W0163","SRC-W0164"],"status":"documented"},{"id":"EVT-006","date":"2023-11-02","place":"al-Bureij refugee camp","theatre":"Gaza","title":"al-Bureij camp","weapons":["WPN-00006"],"evidence":"OHCHR assessed that at least four GBU-39 Small Diameter Bombs were used.","killed":15,"injured":null,"toll_note":"OHCHR verified 15 killed, including nine children and five women, and received information on seven more (OHCHR, June 2024).","summary":"An Israeli strike on al-Bureij refugee camp in central Gaza destroyed at least 12 buildings and severely damaged nine more across about 6,000 square metres. OHCHR assessed at least four Boeing GBU-39 bombs, showing that a 'small diameter' weapon used in dense camps can still level a block. It verified 15 deaths, nine of them children, and received information on seven more.","lat":31.44,"lon":34.4,"src":["SRC-W0163"],"status":"documented"},{"id":"EVT-007","date":"2023-11-10","place":"al-Buraq school, Gaza City","theatre":"Gaza","title":"al-Buraq school","weapons":["WPN-00006"],"evidence":"OHCHR assessed from the damage that the strike likely involved two GBU-39s.","killed":34,"injured":null,"toll_note":"OHCHR received information of at least 34 killed (not counted among its 218 verified deaths); contemporary reports gave higher figures.","summary":"An Israeli strike destroyed a two-storey section of al-Buraq school in Gaza City while displaced people were sheltering there. OHCHR assessed two GBU-39 bombs as likely used and received information of at least 34 deaths. The attack is one of the earliest documented GBU-39 strikes on a school used as a shelter, a pattern Bellingcat later traced across 20 school strikes.","lat":31.53,"lon":34.455,"src":["SRC-W0163"],"status":"documented"},{"id":"EVT-008","date":"2023-12-02","place":"Shuja'iya, Gaza City","theatre":"Gaza","title":"Shuja'iya bombing","weapons":["WPN-00002","ARS-MK84"],"evidence":"OHCHR analysis indicated approximately nine GBU-31 2,000-lb bombs.","killed":60,"injured":null,"toll_note":"OHCHR received information of at least 60 killed (OHCHR, June 2024); not among its 218 verified deaths.","summary":"Israeli bombs struck the Shuja'iya neighbourhood of Gaza City, destroying 15 buildings and damaging at least 14 others along a line about 130 metres long. OHCHR's analysis indicated about nine GBU-31 2,000-lb guided bombs, one of the clearest cases of a cluster of one-ton bombs dropped on a residential area. It received information of at least 60 deaths. OHCHR verified 218 deaths across the four of its six emblematic attacks where verification was possible, and said the true number was probably much higher.","lat":31.5,"lon":34.48,"src":["SRC-W0163","SRC-W0164"],"status":"documented"},{"id":"EVT-009","date":"2024-01-09","place":"Nofal family building, Tal al-Sultan, Rafah","theatre":"Gaza","title":"Nofal family home","weapons":["WPN-00006"],"evidence":"Amnesty's weapons experts identified a Boeing GBU-39 from photographs of fragments recovered from the rubble.","killed":18,"injured":null,"toll_note":"Amnesty (Feb 2024): 18 civilians killed, 10 children, four men and four women.","summary":"Just before 11pm an Israeli strike hit the top two floors of the Nofal family's five-storey building in Tal al-Sultan, Rafah, an area where displaced people had gathered after Israeli orders to move south. Eighteen civilians, including 10 children, were killed. Amnesty identified a Boeing GBU-39 from fragments and found no evidence of a military target, calling it part of a pattern of unlawful attacks amid a real risk of genocide.","lat":31.32,"lon":34.24,"src":["SRC-W0133","SRC-W0165"],"status":"documented"},{"id":"EVT-010","date":"2024-01-29","place":"Tel al-Hawa, Gaza City","theatre":"Gaza","title":"Killing of Hind Rajab","weapons":[],"evidence":"Forensic Architecture concluded an Israeli tank likely fired 335 rounds at the family car and likely also attacked the ambulance sent to rescue her. The Washington Post reported a hole in the ambulance consistent with an Israeli tank round; Responsible Statecraft, citing the Post, names a US-made M830A1 120mm round fragment (not independently verified by us).","killed":null,"injured":null,"toll_note":"Hind Rajab (5), six relatives in the car and PRCS paramedics Yusuf al-Zeino and Ahmed al-Madhoun were killed (Wikipedia summary of FA, Washington Post and Sky News reporting).","summary":"Six-year-old Hind Rajab was trapped in her family's car with her dead relatives after Israeli tanks opened fire in Tel al-Hawa, and spent hours on the phone to the Palestine Red Crescent. The ambulance sent for her was destroyed and both paramedics were killed. Forensic Architecture found an Israeli tank likely fired 335 rounds at the car from close range, when crews could have seen children inside. The exact tank munitions remain unconfirmed here.","lat":31.5136,"lon":34.4369,"src":["SRC-W0166","SRC-W0167","SRC-W0168"],"status":"reported"},{"id":"EVT-011","date":"2024-04-01","place":"al-Rashid coastal road, Deir al-Balah","theatre":"Gaza","title":"World Central Kitchen convoy","weapons":["ARS-H450"],"evidence":"Haaretz reported a Hermes 450 drone carried out the strikes. Bellingcat found the damage consistent with a precision strike using low-yield or inert munitions but could not identify the exact munition without fragments. Munition: UNRESOLVED.","killed":7,"injured":null,"toll_note":"Seven WCK aid workers killed: British, Australian, Polish, Palestinian and a US-Canadian dual national (Wikipedia, citing BBC and others).","summary":"Israeli drone strikes hit three World Central Kitchen cars one after another as they drove a coordinated route along the coastal road, killing seven aid workers. The IDF admitted the strikes, blamed misidentification, dismissed two officers and reprimanded three; in August 2026 several governments issued a joint statement on Israel closing the investigation. Haaretz named the Hermes 450 as the drone. The missile type has not been established, so this card does not attribute it to Spike or Hellfire.","lat":31.41,"lon":34.33,"src":["SRC-W0169","SRC-W0170","SRC-W0171"],"status":"reported"},{"id":"EVT-012","date":"2024-04-16","place":"al-Maghazi refugee camp","theatre":"Gaza","title":"al-Maghazi market","weapons":[],"evidence":"Amnesty: damage pattern and electronic components in recovered fragments matched small precision-guided missiles and glide bombs launched by Israeli drones. CNN's experts agreed on a guided munition but could not name the model. The owner's outline linked this strike to an MPR-500; the sources do not support that.","killed":15,"injured":null,"toll_note":"Amnesty (27 May 2024): 10 children aged 4-15 and five men killed. CNN reported 11 children killed, one dying 16 days later.","summary":"In the afternoon an Israeli strike hit a street in al-Maghazi camp where children were playing foosball. Ten children and five men were killed. Amnesty found the fragments matched small drone-launched precision munitions and called the strike further evidence of war crimes; the exact weapon is unidentified. CNN's experts reached the same conclusion. The MPR-500 identification in the owner's outline belongs to the Rafah strike three days later.","lat":31.42,"lon":34.385,"src":["SRC-W0099","SRC-W0172"],"status":"documented"},{"id":"EVT-013","date":"2024-04-19","place":"Abu Radwan family home, Tal al-Sultan, Rafah","theatre":"Gaza","title":"Abu Radwan family home","weapons":["ARS-MPR500","WPN-00001"],"evidence":"Amnesty's weapons expert identified an MPR 500 made by IMI from fragment photographs; its precision guidance package carried CAGE code 0UVG2 (AeroAntenna, California).","killed":9,"injured":5,"toll_note":"Amnesty (27 May 2024): six children, two women and one man killed; five relatives injured.","summary":"An Israeli strike on the Abu Radwan family home in Tal al-Sultan, west Rafah, killed nine members of the family, six of them children. Amnesty identified an Israeli-made MPR-500 bomb whose guidance package was partly made by AeroAntenna in California, a component-level trail from an Israeli bomb body to a US supplier. Amnesty found no military objective and called for the strike to be investigated as a war crime.","lat":31.318,"lon":34.242,"src":["SRC-W0099"],"status":"documented"},{"id":"EVT-014","date":"2024-05-26","place":"Kuwaiti Peace Camp, Tal al-Sultan, Rafah","theatre":"Gaza","title":"Rafah tent-camp strike","weapons":["WPN-00006"],"evidence":"Amnesty identified remnants of two US-made GBU-39s; CNN found a GBU-39 tail in footage, confirmed by four explosive-weapons experts.","killed":36,"injured":100,"toll_note":"Amnesty (27 Aug 2024): at least 36 killed, including six children, more than 100 injured. CNN reported at least 45 killed and more than 200 injured.","summary":"Two Israeli GBU-39 bombs hit a camp for displaced people in Tal al-Sultan, starting a fire through the tents. Amnesty counted at least 36 killed, including six children, among them at least four fighters, and noted the 113-kg bombs throw fragments hundreds of metres into overcrowded shelters. CNN put the toll at 45 or more. Amnesty said the attack should be investigated as a war crime.","lat":31.322,"lon":34.236,"src":["SRC-W0122","SRC-V0257"],"status":"documented"},{"id":"EVT-015","date":"2024-06-06","place":"UNRWA al-Sardi school, Nuseirat","theatre":"Gaza","title":"al-Sardi UN school","weapons":["WPN-00006"],"evidence":"A Pentagon official and a former US Air Force official told NPR the munition was a GBU-39.","killed":32,"injured":null,"toll_note":"NPR (6 June 2024): at least 32 killed, including seven children.","summary":"A 2am Israeli strike hit the UN-run al-Sardi school in Nuseirat camp, where displaced families were sheltering. At least 32 people were killed, including seven children. US officials told NPR the bomb was a Boeing GBU-39. The UN school was being used as a shelter by families displaced by Israeli evacuation orders. The strike is one of the 28 school strikes involving US-made munitions in Bellingcat's 2026 count, which found GBU-39 remnants at 20 of them.","lat":31.45,"lon":34.39,"src":["SRC-V0258","SRC-V0093"],"status":"documented"},{"id":"EVT-016","date":"2024-06-08","place":"Nuseirat refugee camp","theatre":"Gaza","title":"Nuseirat hostage-rescue massacre","weapons":[],"evidence":"Bellingcat found American-made munitions used alongside other unidentified munitions; no single weapon can be assigned.","killed":274,"injured":null,"toll_note":"274 people reportedly killed during the overall operation (Bellingcat, Feb 2026, citing Gaza reporting). The deaths cannot be attributed to any one weapon.","summary":"During the Israeli hostage-rescue operation in Nuseirat camp, Israeli forces attacked the densely populated camp. Reports cited by Bellingcat put the toll at 274 Palestinians killed. Bellingcat identified US-made munitions among many others that could not be individually identified, so this event links to no single weapon. It is recorded as a multi-weapon assault in which deaths cannot be divided between weapons.","lat":31.45,"lon":34.385,"src":["SRC-V0093"],"status":"documented"},{"id":"EVT-017","date":"2024-06","place":"Health clinic, Gaza City","theatre":"Gaza","title":"Clinic strike killing Hani al-Jafarawi","weapons":["WPN-00007"],"evidence":"Bellingcat identified a Hellfire missile in the strike.","killed":null,"injured":null,"toll_note":"Killed Hani al-Jafarawi, director of Gaza's ambulance and emergency services (Bellingcat). Responsible Statecraft lists 5 killed on 23 June 2024 (secondary, unverified).","summary":"A Hellfire missile struck a health clinic in Gaza City, killing Hani al-Jafarawi, the director of ambulance and emergency services in Gaza, Bellingcat found. The strike is part of a wider pattern Bellingcat documented of Hellfires used around medical sites, including four strikes on tents within about 150 metres of Al-Aqsa Martyrs Hospital. The total toll and exact date need confirmation.","lat":31.505,"lon":34.465,"src":["SRC-V0093","SRC-W0168"],"status":"documented"},{"id":"EVT-018","date":"2024-07-13","place":"al-Mawasi (al-Nas junction), Khan Younis","theatre":"Gaza","title":"al-Mawasi strike targeting Mohammed Deif","weapons":["ARS-MK84"],"evidence":"The Wall Street Journal reported eight 2,000-lb bombs, at least one US-made (via Wikipedia); the NYT found a 60-foot crater consistent with a 2,000-lb bomb. Specific remnant identification not verified by us.","killed":90,"injured":300,"toll_note":"At least 90 killed and over 300 wounded (initial reports compiled by Wikipedia). Airwars records 54-150 civilians killed.","summary":"Israel struck a tent area in al-Mawasi, a zone it had designated humanitarian since December 2023, saying it targeted Hamas commanders Mohammed Deif and Rafa Salama. At least 90 people were reported killed and more than 300 wounded, with rescuers hit in a second strike. Reports describe eight 2,000-lb bombs, at least one US-made, dropped among displaced families. The toll cannot be assigned to any one bomb.","lat":31.362882,"lon":34.27123,"src":["SRC-W0173","SRC-W0174"],"status":"reported"},{"id":"EVT-019","date":"2024-07-27","place":"Khadija school, Deir al-Balah","theatre":"Gaza","title":"Khadija school","weapons":["WPN-00006","ARS-MK80","WPN-00001"],"evidence":"Bellingcat: three rounds of strikes used both GBU-39 bombs and Mk-80 series bombs with JDAM kits; an unexploded GBU-39 body was found inside the school.","killed":30,"injured":100,"toll_note":"At least 30 killed, including 15 children and eight women (Airwars, cited by Bellingcat, Feb 2026); 100+ injured (Gaza Health Ministry via Wikipedia).","summary":"Three rounds of Israeli air strikes hit the Khadija school complex in Deir al-Balah, which was sheltering displaced people. Bellingcat found both Boeing GBU-39s and JDAM-guided Mk-80 bombs, and an unexploded GBU-39 inside the school. Airwars counted at least 30 dead, including 15 children and eight women, and Gaza's Health Ministry reported more than 100 injured. The deaths cannot be split between the two bomb types, so both are linked with an attribution warning.","lat":31.42,"lon":34.35,"src":["SRC-V0093"],"status":"documented"},{"id":"EVT-020","date":"2024-08-10","place":"al-Tabi'in school and mosque, Gaza City","theatre":"Gaza","title":"al-Tabi'in school","weapons":["WPN-00006"],"evidence":"Video from the scene showed a US-made Boeing GBU-39 remnant (CNN).","killed":93,"injured":null,"toll_note":"Gaza authorities reported at least 93 killed (CNN, 10 Aug 2024); the Israeli military disputed this and claimed 20-25 fighters were killed. CNN could not verify either figure.","summary":"An Israeli strike hit the al-Tabi'in school compound in Gaza City around dawn prayers while displaced people were sheltering there. Gaza authorities reported at least 93 killed, including children; the Israeli military said it hit a command centre and killed 20-25 fighters, which CNN could not verify. CNN identified a US-made GBU-39 remnant in footage from the scene, one of the school strikes in which Boeing's bomb was found.","lat":31.51,"lon":34.46,"src":["SRC-W0175"],"status":"documented"},{"id":"EVT-021","date":"2024-09-10","place":"al-Mawasi, Khan Younis","theatre":"Gaza","title":"al-Mawasi tent camp","weapons":["ARS-MK84"],"evidence":"Two weapons experts said the visual evidence suggested 2,000-lb bombs (CNN, via Wikipedia); Sanad suggested US-made Mk-84s. Remnant identification not verified by us.","killed":19,"injured":60,"toll_note":"At least 19 killed and 60 wounded per reports compiled by Wikipedia (range 19-40+). The outline's OHCHR figure and Amnesty JDAM finding were not independently fetched.","summary":"Israeli strikes overnight left huge craters among tents in al-Mawasi, the zone Israel had told civilians to move to, burying families in sand. At least 19 people were reported killed and 60 wounded. Weapons experts said the damage suggested 2,000-lb bombs. UN Secretary-General Antonio Guterres's spokesperson called the use of heavy weapons in densely populated areas 'unconscionable', adding that there is no safe place in Gaza.","lat":31.36,"lon":34.27,"src":["SRC-W0176"],"status":"reported"},{"id":"EVT-022","date":"2025-05-26","place":"Fahmi al-Jarjawi school, al-Daraj, Gaza City","theatre":"Gaza","title":"Fahmi al-Jarjawi school","weapons":["WPN-00006"],"evidence":"Bellingcat identified at least three US-made GBU-39s; Disclose reports MBDA Inc wing fragments at the site.","killed":36,"injured":55,"toll_note":"Hospitals in Gaza reported 36 killed (Bellingcat, Feb 2026); 18 children among them and 55+ injured (AP/AFP via Wikipedia). Wikipedia dates the strike 25 May late night.","summary":"Israeli bombs hit the Fahmi al-Jarjawi school in Gaza City, a shelter for hundreds of displaced people, and fire swept through the classrooms. Hospitals reported 36 killed, half of them children. Bellingcat identified at least three GBU-39s; Disclose reported fragments of MBDA Inc's wings. Five-year-old Hanin al-Wadie survived with severe burns after losing her parents and sister. Ursula von der Leyen called the bombing 'abhorrent'.","lat":31.51,"lon":34.465,"src":["SRC-V0093","SRC-W0177","SRC-W0123"],"status":"documented"},{"id":"EVT-023","date":"2025-07","place":"Cairo Basic School, Gaza","theatre":"Gaza","title":"Cairo Basic School","weapons":["WPN-00007"],"evidence":"Bellingcat found remnants of a Hellfire missile after the strike.","killed":5,"injured":null,"toll_note":"Five people reported killed (Bellingcat, Feb 2026). Exact date not given in the source.","summary":"An Israeli strike on Cairo Basic School, sheltering displaced people, reportedly killed five. Bellingcat found Hellfire missile remnants at the site, giving the Lockheed Martin missile its own documented school strike. It came amid a wider pattern Bellingcat documented of Hellfire strikes on clinics and on tents beside Al-Aqsa Martyrs Hospital. The exact date and location within Gaza need confirming from Bellingcat's dataset, and the toll is a report Bellingcat could not independently verify.","lat":31.52,"lon":34.45,"src":["SRC-V0093"],"status":"documented"},{"id":"EVT-024","date":"2026-01-07","place":"Al Tuffah, Gaza City","theatre":"Gaza","title":"Al Tuffah apartment block","weapons":["WPN-00006"],"evidence":"Bellingcat identified at least three US-made GBU-39 Small Diameter Bombs.","killed":2,"injured":null,"toll_note":"Two people reported killed (Bellingcat, Feb 2026).","summary":"In January 2026, three 250-lb bombs hit an apartment block in the Al Tuffah neighbourhood of Gaza City at night. Two people were reported killed. Bellingcat identified at least three US-made GBU-39s, evidence that Boeing's bomb kept falling on Gaza into 2026. Bellingcat opened its February 2026 investigation with this strike, the latest of the 79 geolocated incidents in which remnants of GBU-39s, JDAMs or Hellfires were found.","lat":31.51,"lon":34.48,"src":["SRC-V0093"],"status":"documented"},{"id":"EVT-025","date":"2023-10-13","place":"Near Alma al-Shaab, Tyre district","theatre":"Lebanon","title":"Journalists struck near Alma al-Shaab","weapons":["ARS-M339"],"evidence":"Amnesty reconstructed the attack from fragments, trajectory and video: the first strike was a 120mm tank round, most likely an M339 made by Israel's IMI Systems; the second most likely a small guided missile.","killed":1,"injured":6,"toll_note":"Amnesty (7 Dec 2023): Reuters videographer Issam Abdallah killed; six journalists from AFP, Reuters and Al Jazeera injured.","summary":"Israeli forces struck a group of seven clearly identifiable journalists filming near the border at Alma al-Shaab twice in quick succession. Reuters videographer Issam Abdallah was killed and six colleagues from AFP, Reuters and Al Jazeera, including Christina Assi, were wounded. Amnesty identified the first projectile as an IMI M339 tank round and said the attack on civilians must be investigated as a war crime.","lat":33.1,"lon":35.18,"src":["SRC-W0178","SRC-W0133"],"status":"documented"},{"id":"EVT-026","date":"2023-10-16","place":"Dhayra, Tyre district","theatre":"Lebanon","title":"White phosphorus on Dhayra","weapons":["ARS-M825"],"evidence":"Amnesty verified white phosphorus shelling and identified 155mm M825A1 shells marked D528 from US depots in Arkansas and Louisiana; the Washington Post found three US-made WP casings.","killed":null,"injured":9,"toll_note":"At least nine civilians treated for respiratory symptoms (Amnesty NSM-20 submission, Apr 2024).","summary":"Israeli artillery fired white phosphorus over Dhayra, a village on the border. Residents described houses, cars and land burning and could not leave their homes until the next morning. At least nine civilians needed treatment for smoke inhalation. Amnesty identified the shells as US-made M825A1s and the Washington Post traced three casings to Arkansas and Louisiana, tying the US arsenal directly to an unlawful incendiary attack on a populated village.","lat":33.08,"lon":35.2,"src":["SRC-W0133","SRC-W0134"],"status":"documented"},{"id":"EVT-027","date":"2023-10 to 2024-05","place":"17 municipalities in South Lebanon (Kfar Kila, Mays al-Jabal, Boustane, Markaba, Aita al-Shaab and others)","theatre":"Lebanon","title":"White phosphorus campaign, 2023-24","weapons":["ARS-M825"],"evidence":"HRW verified white phosphorus use in at least 17 municipalities, with unlawful airbursts over populated residential areas in five, from photo/video geolocation and interviews.","killed":null,"injured":173,"toll_note":"Lebanon's Ministry of Public Health: at least 173 people injured by white phosphorus as of 28 May 2024 (HRW, 5 June 2024). Mays al-Jabal's mayor said around 25 civilians were sent to hospital.","summary":"Over eight months Israeli artillery repeatedly airburst white phosphorus over South Lebanese villages. HRW verified use in at least 17 municipalities and burning wedges landing on homes in Kfar Kila, Mays al-Jabal, Boustane, Markaba and Aita al-Shaab. The Health Ministry counted 173 injured by 28 May 2024. HRW said airbursting white phosphorus over populated areas is unlawful and puts civilians at grave risk.","lat":33.17,"lon":35.45,"src":["SRC-W0179"],"status":"documented"},{"id":"EVT-028","date":"2024-03-27","place":"Habbarieh, Hasbaya district","theatre":"Lebanon","title":"Emergency and Relief Corps centre, Habbarieh","weapons":["ARS-MPR500","WPN-00001"],"evidence":"HRW identified a US-made Boeing JDAM guidance kit and an Elbit-made 500-lb bomb marked 'MPR 500' among the remnants.","killed":7,"injured":null,"toll_note":"HRW (7 May 2024): seven emergency and relief volunteers killed.","summary":"An Israeli air strike destroyed a building used by the Emergency and Relief Corps of the Lebanese Succour Association in Habbarieh, killing seven volunteer paramedics. The Israeli military said it struck a 'military compound'. HRW found no evidence of a military target and identified an Elbit MPR-500 bomb with a Boeing JDAM kit, and said the strike was unlawful and should be investigated as a possible war crime.","lat":33.4,"lon":35.73,"src":["SRC-W0126"],"status":"documented"},{"id":"EVT-029","date":"2024-09-17","place":"Across Lebanon","theatre":"Lebanon","title":"Pager attacks","weapons":["ARS-AR924"],"evidence":"Thousands of AR-924 pagers fitted with PETN charges detonated simultaneously; attribution to Israeli intelligence rests on media reporting, and the device supply chain is unresolved.","killed":12,"injured":3000,"toll_note":"Al Jazeera (17 Sept 2025), citing Lebanese figures: at least 12 killed and more than 3,000 wounded on 17 Sept. Time reported children among the dead and a two-day Health Ministry toll of 37 killed.","summary":"Thousands of pagers carried by people in Lebanon exploded at once in homes, shops, cars and streets. At least 12 people were killed, children among them, and more than 3,000 wounded, many with injuries to hands and eyes. UN human rights experts said the attack violated international law because devices were detonated without distinguishing civilians from fighters. The pagers' real manufacturer is unresolved.","lat":33.85,"lon":35.51,"src":["SRC-W0161","SRC-W0180","SRC-W0158"],"status":"reported"},{"id":"EVT-030","date":"2024-09-18","place":"Across Lebanon","theatre":"Lebanon","title":"Radio (walkie-talkie) attacks","weapons":["ARS-ICV82"],"evidence":"Hand-held radios labelled Icom IC-V82 exploded; Lebanon's preliminary investigation found PETN in the batteries (Reuters). Icom said the devices were very unlikely to be genuine.","killed":20,"injured":450,"toll_note":"Al Jazeera (17 Sept 2025), citing Lebanese figures: 20 killed and more than 450 wounded on 18 Sept. Time reported 37 killed over both days (Health Ministry).","summary":"A day after the pagers, booby-trapped radios exploded across Lebanon, including at a funeral for people killed the day before. Twenty people were killed and more than 450 wounded. Lebanese investigators found PETN in the battery packs. The radios bore Icom branding, but Icom said the model had been discontinued years earlier, so the brand is not evidence of who built them.","lat":33.85,"lon":35.51,"src":["SRC-W0161","SRC-W0180","SRC-W0160"],"status":"reported"},{"id":"EVT-031","date":"2024-09-23","place":"South Lebanon, Bekaa and beyond","theatre":"Lebanon","title":"23 September 2024 bombardment","weapons":[],"evidence":"Hundreds of strikes involving many weapon types; no single munition can be assigned to the toll. Individually identified strikes that day (e.g. al-Saksakieh) are separate events.","killed":558,"injured":1835,"toll_note":"Lebanon's Health Ministry, cited by HRW (25 Sept 2024): 558 killed, including 50 children and 94 women, and over 1,835 injured.","summary":"On 23 September 2024 Israel launched its mass bombing of Lebanon, striking hundreds of locations in the south and the Bekaa in a single day and setting off a mass exodus. Lebanon's Health Ministry reported 558 people killed, including 50 children and 94 women, and more than 1,835 injured. The day marks the shift to the destruction of South Lebanon; individual identified strikes sit beneath it.","lat":33.27,"lon":35.4,"src":["SRC-W0181"],"status":"documented"},{"id":"EVT-032","date":"2024-09-23","place":"al-Saksakieh, Sidon district","theatre":"Lebanon","title":"al-Saksakieh family home","weapons":["ARS-BLU109","WPN-00001"],"evidence":"Debris found by Al Jazeera was classified by Armament Research Services as a 2,000-lb penetrator used with a JDAM guidance kit (Airwars' text says 'GBU-109'; its tentative model is BLU-109).","killed":2,"injured":1,"toll_note":"Airwars: at least two civilians, Hajja Fatima Faqih and her daughter Hasnaa Abbas Haider, killed; Mohammad Haider injured.","summary":"Shortly before 1pm on 23 September an Israeli air strike destroyed a family home and car in al-Saksakieh, south of Sidon, killing Fatima Faqih and her daughter Hasnaa Abbas Haider and injuring Mohammad Haider. ARS classified the debris as a 2,000-lb BLU-109 penetrator with a JDAM kit, the US bunker-buster family, used here against a family home in a residential village south of Sidon.","lat":33.416883,"lon":35.300219,"src":["SRC-W0182"],"status":"documented"},{"id":"EVT-033","date":"2024-09-25","place":"Younine, Baalbek district","theatre":"Lebanon","title":"Younine: Syrian family home","weapons":["ARS-MK80","WPN-00001"],"evidence":"HRW identified remnants of a Mk-80 series general-purpose bomb with a US-made JDAM kit.","killed":23,"injured":null,"toll_note":"HRW (23 Apr 2025): 22 members of one Syrian family killed, including 13 children; another died eight days later. Seven survived.","summary":"After 10pm an Israeli strike destroyed a residential building on the Baalbek-Qaa highway in Younine, where an extended Syrian family was preparing to return to Syria. Twenty-two died at once, 13 of them children, and another died of his wounds eight days later. HRW found a US JDAM kit and no military target or warning, and documented further Mk-80 strikes in Younine on 1 and 21 November 2024 that killed 14 more people.","lat":34.08,"lon":36.25,"src":["SRC-W0183"],"status":"documented"},{"id":"EVT-034","date":"2024-09-27","place":"Haret Hreik, Beirut southern suburbs","theatre":"Lebanon","title":"Strike that killed Hassan Nasrallah","weapons":["ARS-BLU109","WPN-00001","ARS-F15I"],"evidence":"An IDF image analysed by OSMP showed three BLU-109 bombs with JDAM kits on a 69 Squadron F-15I; the IDF confirmed bunker-busting bombs; the NYT cited an analyst saying eight F-15Is carried at least 15 2,000-lb munitions with US guidance.","killed":null,"injured":null,"toll_note":"No reliable civilian toll for this strike was found in the sources reviewed; rubble searches were ongoing in initial Health Ministry reporting.","summary":"Israeli jets dropped dozens of bunker-busting bombs on Hezbollah's underground headquarters in the densely built Haret Hreik district, killing Secretary-General Hassan Nasrallah and other commanders. Eight F-15Is reportedly carried at least 15 one-ton bombs with US guidance, and an IDF photo shows BLU-109 penetrators with Boeing JDAM kits. ARS's director said the repeated impacts were aimed at penetrating a heavily protected space. The toll among residents is not established here.","lat":33.85,"lon":35.51,"src":["SRC-W0139","SRC-W0184"],"status":"documented"},{"id":"EVT-035","date":"2024-10-10","place":"Bachoura (Basta / Ras al-Nabaa), central Beirut","theatre":"Lebanon","title":"Bachoura strike, central Beirut","weapons":["WPN-00001","ARS-MK80"],"evidence":"HRW researcher Richard Weir verified a recovered remnant as a US-made JDAM guidance kit for Mk-80 series bombs (reported by The Guardian, via Wikipedia).","killed":22,"injured":117,"toll_note":"Lebanese Health Ministry: at least 22 killed and 117 wounded (BBC, via Wikipedia).","summary":"Israeli strikes levelled an apartment building in the Bachoura area of central Beirut, killing at least 22 people and wounding 117 in the deadliest attack on the capital up to that point. The reported target, Hezbollah official Wafiq Safa, survived. A JDAM kit remnant verified by HRW tied the strike to the US supply chain in the heart of Beirut, far from the border.","lat":33.887,"lon":35.503,"src":["SRC-W0185"],"status":"documented"},{"id":"EVT-036","date":"2024-10-14","place":"Aitou, Zgharta district","theatre":"Lebanon","title":"Aitou: displaced families","weapons":["ARS-MK80"],"evidence":"Amnesty identified a recovered fragment as most likely from a Mk-80 series aerial bomb, meaning at least 500 lb.","killed":24,"injured":null,"toll_note":"Amnesty (13 Dec 2024): 23 displaced civilians and Ahmad Fakih killed; the youngest was a five-month-old baby.","summary":"An Israeli strike destroyed a four-storey building sheltering displaced families in the village of Aitou in north Lebanon, more than 115 km from the border, minutes after a man named Ahmad Fakih arrived. Twenty-three displaced civilians and Fakih were killed; the youngest was five months old. Amnesty identified a Mk-80 series bomb fragment and called the strike further evidence of war crimes.","lat":34.29,"lon":35.92,"src":["SRC-W0112"],"status":"documented"},{"id":"EVT-037","date":"2024-10-16","place":"Mhaibib (Mhaybib), Marjayoun district","theatre":"Lebanon","title":"Mhaibib controlled demolition","weapons":[],"evidence":"Method, not munition: explosives emplaced through the village and detonated (IDF video, satellite imagery and NYT analysis cited by Lebanon's National Human Rights Commission).","killed":null,"injured":null,"toll_note":"No verified toll tied to the detonation; residents had largely fled.","summary":"Israeli forces wired the village of Mhaibib with explosives and blew it up. The New York Times found at least 76 buildings destroyed, only a few left standing, and a centuries-old shrine partly destroyed. Across five villages (Blida, Kfar Kila, Mhaibib, Ramyah and Aita al-Shaab) it counted at least 200 buildings blown up in controlled demolitions. No munition model applies; it is recorded as a method of destruction.","lat":33.18,"lon":35.52,"src":["SRC-W0186"],"status":"documented"},{"id":"EVT-038","date":"2024-09-30 to 2025-01","place":"26 border municipalities, South Lebanon","theatre":"Lebanon","title":"Destruction of the southern border belt","weapons":[],"evidence":"Mixed methods: air strikes, manually laid explosives and bulldozers, including after the Nov 2024 ceasefire (Amnesty satellite and video analysis). Not attributable to one weapon.","killed":null,"injured":null,"toll_note":"Destruction event: no casualty figure assigned.","summary":"Amnesty mapped 10,803 structures severely damaged or destroyed across 26 border municipalities between late September 2024 and late January 2025. Yarin, Dhayra and Boustane each lost over 70% of their buildings; Kfar Kila lost over 1,300 structures (52%) and 133 acres of orchards, Maroun el-Ras 700 (67%), Odeisseh over 580 (52%), Aita al-Shaab over 1,000 (48%) and Dhayra 264 buildings (71%), much of it by manually laid explosives and bulldozers while Israeli troops held the area.","lat":33.12,"lon":35.35,"src":["SRC-W0187"],"status":"documented"},{"id":"EVT-039","date":"2024-10-25","place":"Hasbaya Village Club resort, Hasbaya","theatre":"Lebanon","title":"Hasbaya journalists","weapons":["WPN-00001"],"evidence":"HRW identified an air-dropped bomb with a US-produced JDAM kit; a fragment of the actuation system that moves the fins carried CAGE code 81873 (Woodward).","killed":3,"injured":4,"toll_note":"HRW (25 Nov 2024): three journalists killed and four injured.","summary":"An Israeli strike hit chalets at a resort in Hasbaya where journalists were staying, away from any military target. Ghassan Najjar and Mohammad Reda of Al Mayadeen and Wissam Kassem of Al Manar were killed and four others injured. HRW traced a fin-actuator fragment to the US firm Woodward and called it most likely a deliberate attack on civilians and an apparent war crime, urging a halt to US arms sales.","lat":33.4,"lon":35.68,"src":["SRC-V0100"],"status":"documented"},{"id":"EVT-040","date":"2025-08-06","place":"Deir Seryan, Marjayoun district","theatre":"Lebanon","title":"Deir Seryan reconstruction machinery","weapons":["WPN-00001"],"evidence":"HRW found remnants of a Boeing-produced JDAM tail unit assembly at one of the sites.","killed":1,"injured":2,"toll_note":"HRW (15 Dec 2025): one Syrian worker killed and two people injured; owners estimated $1.3-1.4M in losses.","summary":"Months after the November 2024 ceasefire, Israeli strikes hit sites storing bulldozers and excavators used to clear rubble and rebuild in Deir Seryan, damaging 15 heavy machines and nearby homes and killing a Syrian worker. HRW found a Boeing JDAM tail unit and said attacks on reconstruction equipment without a verified military purpose were unlawful and apparent war crimes, since the machines were needed to clear rubble and rebuild homes destroyed in 2024.","lat":33.27,"lon":35.55,"src":["SRC-W0188"],"status":"documented"},{"id":"EVT-041","date":"2025-10-11","place":"Msayleh, Sidon-Zahrani","theatre":"Lebanon","title":"Msayleh heavy-machinery showrooms","weapons":["WPN-00001"],"evidence":"HRW found remnants consistent with a JDAM guidance kit, including a fin with Boeing CAGE code 76301.","killed":1,"injured":7,"toll_note":"HRW (15 Dec 2025): one Syrian national killed, seven injured.","summary":"Israeli strikes hit heavy-machinery showrooms and yards in Msayleh, destroying more than 300 vehicles, including more than 100 small Bobcat loaders bound for reconstruction. One Syrian man was killed and seven people injured. A JDAM fin stamped with Boeing's CAGE code tied the attack directly to the US supplier. HRW documented it among a series of Israeli attacks on reconstruction equipment that it called unlawful and apparent war crimes.","lat":33.47,"lon":35.4,"src":["SRC-W0188"],"status":"documented"},{"id":"EVT-042","date":"2025-11-20","place":"Wadi Zibqin, Wadi Barghouz, Wadi Deir Siryan (south of the Litani)","theatre":"Lebanon","title":"Cluster munition remnants in South Lebanon","weapons":["ARS-RAAMEITAN","ARS-M999"],"evidence":"The Guardian published photographs of remnants of 227mm Ra'am Eitan rockets and 155mm M999 Barak Eitan shells; six independent arms experts confirmed the identifications. Date is the publication date; firing dates unknown.","killed":null,"injured":null,"toll_note":"No casualty figure tied to these remnants in the sources reviewed.","summary":"The Guardian revealed remnants of two Elbit-attributed cluster munitions, the Ra'am Eitan rocket and the M999 Barak Eitan shell, in forested valleys south of the Litani. Lebanon's National Human Rights Commission said it was Israel's first known cluster-munition use in nearly twenty years and warned that up to 10% of bomblets may not explode, contaminating land that families need to return to.","lat":33.33,"lon":35.45,"src":["SRC-W0149","SRC-W0148"],"status":"reported"},{"id":"EVT-043","date":"2026-03-03","place":"Yohmor (al-Shqif), Nabatieh district","theatre":"Lebanon","title":"White phosphorus over Yohmor","weapons":["ARS-M825"],"evidence":"HRW verified at least two artillery-delivered WP munitions airburst over a residential neighbourhood; the smoke 'knuckle' was entirely consistent with M825-series 155mm projectiles.","killed":null,"injured":null,"toll_note":"HRW could not verify whether anyone was injured; fires were documented in homes and a vehicle within 160 m (HRW, 9 Mar 2026).","summary":"On the second day of Israel's 2026 offensive in Lebanon, Israeli artillery airburst white phosphorus over a residential neighbourhood of Yohmor, after evacuation orders telling residents to move at least 1,000 m away. HRW documented fires in homes and a car and found the smoke pattern matched US-designed M825-series shells, showing the WP story did not end in 2024.","lat":33.33,"lon":35.57,"src":["SRC-W0189"],"status":"documented"},{"id":"EVT-044","date":"2026-03 to 2026-05","place":"South Lebanon (23 verified incidents)","theatre":"Lebanon","title":"White phosphorus, March-May 2026","weapons":["ARS-M825"],"evidence":"HRW and Harvard Law School's International Human Rights Clinic verified 23 incidents of Israeli white phosphorus use.","killed":null,"injured":null,"toll_note":"No consolidated casualty figure in the source.","summary":"Human Rights Watch and Harvard's International Human Rights Clinic verified 23 incidents of Israeli white phosphorus use in South Lebanon between March and May 2026, nearly three years after the first documented uses in October 2023. Their September 2026 report 'Uncontrolled Burn' calls for stronger international law on incendiary weapons ahead of UN disarmament talks in October 2026. No consolidated casualty figure is given for the 2026 incidents.","lat":33.25,"lon":35.45,"src":["SRC-W0190"],"status":"documented"},{"id":"EVT-045","date":"2026-03","place":"South Lebanon","theatre":"Lebanon","title":"Lahav launchers fire Bar (EXTRA) rockets","weapons":["WPN-00015"],"evidence":"Elbit-published N12 article: more than 50 Bar (EXTRA) rockets launched from Lahav/PULS at the start of the 2026 operation at anti-tank squads, buildings and Hezbollah targets.","killed":null,"injured":null,"toll_note":"No casualty figure; the article claims nine fighters killed in one engagement (unverified military claim).","summary":"Israel's artillery corps fired more than 50 of Elbit's new Bar (EXTRA) precision rockets from Lahav (PULS) launchers into Lebanon at the start of the 2026 offensive, including at buildings, according to an N12 article republished by Elbit. The company presented the combat use as a showcase for the system it sells to European armies, including Greece's $750M order for 36 launchers in April 2026.","lat":33.25,"lon":35.45,"src":["SRC-V0091"],"status":"documented"},{"id":"EVT-046","date":"2026-03-28","place":"Jezzine highway, South Lebanon","theatre":"Lebanon","title":"Ali Shoaib, Fatima Ftouni and Mohamad Ftouni","weapons":[],"evidence":"Israeli strike on a media car; the IDF confirmed the strike. No publicly verified remnant identification: WEAPON MODEL UNIDENTIFIED.","killed":3,"injured":null,"toll_note":"CPJ (Mar 2026): journalists Ali Shoaib (Al-Manar), Fatima Ftouni (Al-Mayadeen) and photojournalist Mohamad Ftouni killed.","summary":"An Israeli strike hit a car carrying journalists on the Jezzine highway, killing Al-Manar's Ali Shoaib, Al-Mayadeen's Fatima Ftouni and her brother, photojournalist Mohamad Ftouni. The IDF confirmed the strike and claimed Shoaib was a member of Hezbollah's Radwan Force, without providing evidence; when CPJ asked, it said the incident was 'being further investigated'. The weapon is deliberately left unidentified here.","lat":33.54,"lon":35.58,"src":["SRC-W0191"],"status":"documented"},{"id":"EVT-047","date":"2026-04-05","place":"Ain Saadeh, Metn","theatre":"Lebanon","title":"Ain Saadeh apartment","weapons":["WPN-00006"],"evidence":"Lebanese Army field examination: two GBU-39 bombs penetrated the roof and fourth floor before detonating on the targeted third floor.","killed":3,"injured":null,"toll_note":"Lebanese Army statement: three residents of the third floor killed, others injured.","summary":"At about 9pm two bombs crashed through the roof of an apartment building in Ain Saadeh, in the Metn hills east of Beirut, and exploded on the third floor, killing three residents. The Lebanese Army's own investigators identified both as GBU-39s, an official field identification of Boeing's bomb that carries more weight than remote analysis. Ain Saadeh is a residential area in the Metn, far from the southern border.","lat":33.88,"lon":35.59,"src":["SRC-W0192"],"status":"documented"},{"id":"EVT-048","date":"2026-04","place":"South Lebanon","theatre":"Lebanon","title":"First combat firing of the Ro'em howitzer","weapons":["ARS-ROEM"],"evidence":"Breaking Defense reported the IDF's first operational firing of Elbit's Ro'em during operations in Lebanon.","killed":null,"injured":null,"toll_note":"No casualty figure tied to the system.","summary":"The Israeli army fired Elbit's new automated Ro'em 155mm howitzer in combat for the first time during its 2026 operations in Lebanon, Breaking Defense reported. The gun fires six to eight 155mm shells a minute out to 40 km with a crew of three. Its debut in the destruction of South Lebanon is recorded here as a procurement-and-use event; no specific strike has been attributed to it, and no casualty figure is tied to the system.","lat":33.25,"lon":35.45,"src":["SRC-V0077"],"status":"documented"},{"id":"EVT-049","date":"2026-04-08","place":"Beirut, South Lebanon, Bekaa, Sidon, Tyre","theatre":"Lebanon","title":"8 April 2026 mass strikes","weapons":[],"evidence":"The IDF said some 50 jets used about 160 munitions on more than 100 targets in about ten minutes. Exact munitions are not verified in the sources reviewed (the Washington Post visual analysis could not be fetched).","killed":357,"injured":1223,"toll_note":"Lebanon's Health Ministry (non-final tally, 10 Apr 2026): 357 killed and 1,223 wounded; an earlier count included 30 children, 71 women and nine elderly people (Long War Journal). Israel claimed over 200-250 fighters killed, unverified.","summary":"Less than a day after the US-Iran ceasefire was announced, Israel hit more than 100 targets across Lebanon in about ten minutes, including central Beirut neighbourhoods without warning at rush hour and a funeral in Shmustar. Lebanon's Health Ministry put the toll at 357 killed and 1,223 wounded. Like 23 September 2024, it is a campaign-level event: the deaths cannot be assigned to one bomb model.","lat":33.89,"lon":35.5,"src":["SRC-W0193","SRC-W0194"],"status":"documented"},{"id":"EVT-050","date":"2026-04-22","place":"al-Tiri, Bint Jbeil district","theatre":"Lebanon","title":"Amal Khalil and Zainab Faraj","weapons":[],"evidence":"Exact munitions unknown. HRW, Amnesty and The Legal Agenda documented repeated strikes while Israeli quadcopters watched; a stun grenade was fired at rescuers.","killed":1,"injured":1,"toll_note":"Al Jazeera (6 Aug 2026): journalist Amal Khalil killed; photojournalist Zainab Faraj critically injured.","summary":"Israeli forces bombed a car carrying al-Akhbar journalist Amal Khalil and photojournalist Zainab Faraj in al-Tiri, then struck the building where they sheltered. Khalil was killed and Faraj critically injured; drones tracked them throughout and a stun grenade was fired at rescuers. HRW, Amnesty and The Legal Agenda concluded the forces knew or should have known they were civilians and called it a war crime.","lat":33.17,"lon":35.43,"src":["SRC-W0195"],"status":"documented"},{"id":"EVT-051","date":"2025-06-22","place":"Fordow and Natanz enrichment sites","theatre":"Iran","title":"Operation Midnight Hammer","weapons":["ARS-GBU57"],"evidence":"Pentagon: B-2 bombers dropped a dozen GBU-57s on Fordow; Wikipedia reports two more on Natanz.","killed":null,"injured":null,"toll_note":"No casualty figure tied to these strikes in the sources reviewed.","summary":"Nine days into Israel's June 2025 bombing campaign against Iran, US B-2 bombers dropped 30,000-lb GBU-57 penetrators on the Fordow enrichment plant at 2:15am Iranian time, and on Natanz. Fourteen of the bombs were dropped in total, twelve on Fordow, according to the Pentagon and Wikipedia. It was the bomb's first combat use and turned the US from Israel's supplier into a direct participant in the war on Iran. No casualty figure for the strikes is given in the sources reviewed.","lat":34.885,"lon":50.996,"src":["SRC-W0155","SRC-W0156"],"status":"documented"},{"id":"EVT-052","date":"2026-02-28","place":"Shajareh Tayyebeh elementary school, Minab, Hormozgan","theatre":"Iran","title":"Minab school strike","weapons":["WPN-NEW-TOMAHAWK"],"evidence":"Bellingcat and BBC Verify identified a Tomahawk in video; debris included a satellite data link antenna marked Ball Aerospace, a Raytheon electronics board and a Globe Motors motor (AOAV). Amnesty concluded a US Tomahawk was likely used.","killed":170,"injured":95,"toll_note":"Amnesty (16 Mar 2026, via Al Jazeera): at least 170 killed, most of them children. Wikipedia's breakdown: 156 killed incl. 120 students; 95 injured.","summary":"On the first morning of the US-Israeli war on Iran, a US Tomahawk struck the Shajareh Tayyebeh elementary school in Minab in mid-morning. Amnesty found the US responsible for at least 170 deaths, most of them children. A preliminary US inquiry pointed to outdated coordinates. Whether AI targeting tools played a role is contested and unresolved. Debris tied the missile to Raytheon and to Ball Aerospace, now part of BAE Systems.","lat":27.1098,"lon":57.0848,"src":["SRC-W0196","SRC-V0007","SRC-W0153"],"status":"documented"},{"id":"EVT-053","date":"2026-03-04","place":"Over Tehran","theatre":"Iran","title":"F-35I shoots down Iranian Yak-130","weapons":["WPN-NEW-F35"],"evidence":"IDF statement and cockpit footage: an F-35I Adir shot down an Iranian Air Force Yak-130.","killed":null,"injured":null,"toll_note":"No casualty figure in the sources reviewed.","summary":"During the 2026 US-Israeli war on Iran, an Israeli F-35I Adir shot down an Iranian Yak-130 over Tehran, which the IDF called the first-ever shoot-down of a manned aircraft by an F-35. The event documents the F-35I operating deep over the Iranian capital during the bombing campaign in which HRANA counted more than 1,700 civilian deaths (as compiled by Wikipedia).","lat":35.69,"lon":51.39,"src":["SRC-W0197","SRC-V0020"],"status":"documented"},{"id":"EVT-054","date":"2026-03","place":"Near Imam Ali missile base, Khorramabad","theatre":"Iran","title":"Unidentified Israeli munition in Iran","weapons":["ARS-TMID0011"],"evidence":"ARES documented remnants of ARES-TMID-0011, an unidentified Israeli turbojet-powered guided munition, previously seen in Lebanon and Gaza.","killed":null,"injured":null,"toll_note":"No casualty figure in the source.","summary":"Armament Research Services documented the unidentified Israeli guided munition it calls ARES-TMID-0011 near the Imam Ali missile base in Khorramabad, western Iran, in March 2026, the same weapon it had found in Lebanon from 2024 and in strikes on hospitals and schools in Gaza in 2025-26. Its impacts have been documented about 30 cm apart. The maker is unknown, which makes it a weapon used across three fronts with no public supply chain.","lat":33.49,"lon":48.36,"src":["SRC-W0162"],"status":"documented"}]},"tracked":{"usd":150226804857.76,"parts":[{"label":"US military aid to Israel, Oct 2023 to Sep 2026","usd":25702500000,"ids":["SRC-0085","SRC-W0135","SRC-W0135","SRC-W0247","SRC-W0294","SRC-W0295"],"note":"Unchanged. Costs of War has published no update past Sep 2025 (homepage checked 2026-10-05; Al Jazeera 28 Jul 2026 still cites the same estimate). The Oct 2025-Sep 2026 increment is the FY2026 appropriation part (no overlap: different fiscal years). No 2026 supplemental for Israel enacted: the $87.6B Iran-war supplemental request (Jun 2026) has no Israel-specific line in reporting. Costs of War says the figure excludes arms-sale agreements, so it is kept separate from the arms-sales part."},{"label":"US regional operations and Gaza force funding for Israel, Oct 2023 to Sep 2026","usd":12276000000,"ids":["SRC-0086","SRC-W0296","SRC-W0296","SRC-W0296","SRC-W0297"],"note":"Unchanged, upper estimate. Already includes June 2025 Operation Midnight Hammer and THAAD interceptors fired defending Israel ($1.80-1.95B within $2.04-2.26B Iran line). From 28 Feb 2026 all defence-of-Israel interceptor/THAAD costs fall inside the Pentagon Iran-war total (part 3), so adding a 2026 regional figure would double count. No published figure found for Oct 2025 to 27 Feb 2026."},{"label":"US war on Iran, 28 Feb to 3 Sep 2026","usd":43600000000,"ids":["SRC-W0249","SRC-W0250"],"note":"Pentagon estimate to Congress (reported 18 Sep 2026) replaces CBO $38B (to 1 Aug). The extra $1.5B 'set aside for supplementary fuel needs' (giving the $45.1B headline) is excluded as a reserve, not a cost incurred. Includes interceptors used defending Israel in 2026. No later official figure found as of 5 Oct 2026; CBO projects $2-3B per month going forward."},{"label":"US arms sales to Israel notified, Oct 2023 to Oct 2026","usd":39684300000,"ids":["SRC-W0251","SRC-W0251","SRC-W0251","SRC-W0251","SRC-W0252","SRC-W0253","SRC-W0253","SRC-V0331","SRC-W0254","SRC-W0255","SRC-W0256"],"note":"Sum of every formal FMS notification to Congress. Added: 2023 ($254.0M), 2024 ($20,505.4M incl. F-15IA $18.82B), 2025 D9 $295M, Eitan $180M, JDAM $510M, 2026 AW119Kx $150M. The 8 Mar 2026 '$650 million' (Times of Israel, officials' description of a package) is replaced by the formal notification of $151.8M. Forum on the Arms Trade's 2025 row prints 11,100.7 but its own items sum to 11,110.7; items used. Itemised: 2023-12-08 120mm M830A1 tank cartridges (emergency) $106.5M; 2023-12-29 fuzes for 155mm artillery ammunition (emergency) $147.5M; 2024-08-13 50 F-15IA / F-15I+ aircraft $18,820.0M; 2024-08-13 120mm tank cartridges $774.1M; 2024-08-13 Family of Medium Tactical Vehicles $583.1M; 2024-08-13 AIM-120C-8 AMRAAM $102.5M; 2024-08-13 120mm HE mortar cartridges $61.1M; 2024-09-12 heavy duty tank trailers $164.6M; 2025-02-07 munitions, guidance kits, fuzes $6,750.0M; 2025-02-07 AGM-114 Hellfire $660.0M; 2025-02-28 2,000-lb bombs, I-2000 warheads (emergency) $2,040.0M; 2025-02-28 1,000-lb bombs and guidance kits (emergency) $675.7M; 2025-02-28 Caterpillar D9 bulldozers (emergency) $295.0M; 2025-04-14 Eitan powerpack engines $180.0M; 2025-06-30 JDAM guidance kits $510.0M; 2026-01-30 30 AH-64E Apache $3,800.0M; 2026-01-30 Joint Light Tactical Vehicles $1,980.0M; 2026-01-30 Namer APC power packs $740.0M; 2026-01-30 AW119Kx light utility helicopters $150.0M; 2026-03-06 12,000 BLU-110A/B 1,000-lb bomb bodies (emergency) $151.8M; 2026-05-01 10,000 APKWS-II rounds (emergency) $992.4M. FMF (part 1/9) pays for part of these FMS cases, so some overlap with aid remains (Costs of War itself keeps arms-sale agreements out of its aid total)."},{"label":"European arms licences and exports to Israel, Oct 2023 to Jun 2026","usd":3202095053.76,"ids":["SRC-W0257","SRC-W0257","SRC-W0258","SRC-W0259","SRC-W0259","SRC-V0039"],"note":"Same method (largest recorded figure per country, licences and deliveries never added; $1.16/EUR, $1.34/GBP). Changes: UK GBP127.6M (Q4 2024 SIELs) -> GBP180M (military extant licences at 31 Jul 2025, F-35 excluded; GBP142M of it supports re-exports to third countries); Italy EUR16.2M (2023 exports) -> EUR22.6M (2025 movements of Italian military materiel to Israel incl. re-exports, Rete Pace Disarmo from UAMA report); Serbia EUR55.5M (H1 2025) -> EUR162M (EUR48M 2024 + EUR114M 2025 exports, same series). Germany EUR1.41B (Oct 2023 to Jun 2026, Forensis) already current. France EUR362M (2024 licences) kept: French 2026 report to parliament found no Israel 2025 figure in fetched text. Other countries unchanged."},{"label":"Israeli arms deals with European buyers, 2023 to Sep 2026","usd":25493000000,"ids":["SRC-W0298","SRC-W0299","SRC-W0300","SRC-W0301","SRC-W0301","SRC-V0306","SRC-W0302","SRC-W0303"],"note":"Europe share of Israeli arms export deals 2023 to 2025 (Israeli military ministry), plus five deals signed with European buyers in 2026: Greece Achilles Shield, Greece PULS, Greece Drone Dome, Trophy for four EU armies, and $1.4B for an unnamed European customer of Elbit."},{"label":"United Democracy Project independent expenditures, 2024 cycle and 2026 cycle to 31 Aug 2026","usd":88210000,"ids":["SRC-V0080","SRC-V0284"],"note":"Replaces the race-by-race sum ($79.96M) with UDP's cycle totals of independent expenditures: 2024 cycle $34.8M (OpenSecrets via FactCheck) + 2026 cycle $53.41M by 31 Aug 2026 (FEC via Legis1). Race-level rows stay on the site as detail but must not be added to this. Excludes AIPAC PAC direct/bundled contributions and UDP transfers; the broader AIPAC network figure ($104.3M in the 2026 cycle, Sludge) is in excluded. The 2024 cycle starts Jan 2023, a few months before Oct 2023."},{"label":"Donations to Friends of the IDF, 2024","usd":180699804,"ids":["SRC-W0261","SRC-W0261"],"note":"FIDF's total contributions for calendar 2024 from its Form 990 (filed 29 Oct 2025); replaces the $2.2M single Fidelity Charitable flow, which is contained within it. 2023 ($280.0M contributions) left out because the calendar year includes Jan-Sep 2023; no 2025 990 is filed yet."}],"fx":"$1.16 per € and $1.34 per £"},"images":{"COM-00001":{"data":"img/9b8c403779d16685.jpg","credit":"Photo: Israel Defense Forces from Israel / Wikimedia Commons, CC BY 2.0","url":"https://commons.wikimedia.org/wiki/File:Iron_Dome_in_Operation_Protective_Edge.jpg"},"COM-00002":{"data":"img/8f8dc73580ac5137.jpg","credit":"Photo: Official Navy Page from United States of America Andy Wolfe/U.S. Navy / Wikimedia Commons, Public domain","url":"https://commons.wikimedia.org/wiki/File:Flickr_-_Official_U.S._Navy_Imagery_-_F-35B_conducts_its_first_aerial_weapons_release..jpg"},"COM-00003":{"data":"img/a1185a71db4fe6b0.jpg","credit":"Photo: U.S. Air Force photo / Wikimedia Commons, Public domain","url":"https://commons.wikimedia.org/wiki/File:US_Air_Force_090318-F-0000K-900_Dropping_bombs.jpg"},"COM-00004":{"data":"img/0fae426837400141.jpg","credit":"Photo: IDF Spokesperson's Unit photographer / Wikimedia Commons, CC BY-SA 3.0","url":"https://commons.wikimedia.org/wiki/File:Israeli_F-35I_bearing_Mk-84_bombs_fitted_with_GBU-31_JDAM.jpg"},"COM-00005":{"data":"img/901fef8e0233324f.jpg","credit":"Photo: USAF / Wikimedia Commons, Public domain","url":"https://commons.wikimedia.org/wiki/File:B-2_Spirit_bombing,_1994.jpg"},"COM-00006":{"data":"img/11797195c3ae682c.jpg","credit":"Photo: Oroo / Wikimedia Commons, CC BY 2.5","url":"https://commons.wikimedia.org/wiki/File:Israeli_Doher_M109_Firing.jpg"},"COM-00007":{"data":"img/57c42cc505ac7fac.jpg","credit":"Photo: Amit Agronov / Wikimedia Commons, CC BY-SA 3.0","url":"https://commons.wikimedia.org/wiki/File:Elbit_Hermes_450,_November_2023_(96585).jpg"},"COM-00008":{"data":"img/463ba33d6d359dfe.jpg","credit":"Photo: Photographer's name not specified / Wikimedia Commons, Public domain","url":"https://commons.wikimedia.org/wiki/File:Arrow_anti-ballistic_missile_launch.jpg"},"COM-00010":{"data":"img/677edcf24c072d37.jpg","credit":"Photo: Rathfelder / Wikimedia Commons, CC BY-SA 4.0","url":"https://commons.wikimedia.org/