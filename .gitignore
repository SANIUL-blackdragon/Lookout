# Deps
node_modules/
.pnp/
.pnp.js

# Env and secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Crawler working output (raw collections, browser profiles, crawl state)
crawls/

# Local WACZ rebuilds (rebuilt from packages/ by script, never committed)
*.wacz
.cache/
cache/

# Package upload inbox (unpacked packages/<slug>/ dirs are committed, ZIPs are not)
packages/*.zip

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Editors
.vscode/
.idea/
*.swp
*~

# Python helpers (pywb, scripts)
__pycache__/
*.py[cod]
.venv/
venv/

# Playwright artifacts
test-results/
playwright-report/

# ffmpeg temp files
*.tmp
*.temp
